---
import SiteHeader from '../components/SiteHeader.astro';
import ReaderFeedback from '../components/ReaderFeedback.astro';
import { withBase } from '../lib/paths';
import '../styles/global.css';

interface Props {
  title: string;
  description?: string;
  section?: string;
}

const {
  title,
  description = '從資訊到生成——沿著論文，一句一句讀懂 large language model。',
  section = 'home',
} = Astro.props;

const pageTitle =
  title === 'THE LLM' ? 'THE LLM: From Information to Generation' : `${title} — THE LLM`;

// Canonical absolute URL that survives the /the-llm base path.
const siteBase = (import.meta.env.BASE_URL || '/').replace(/\/+$/, '');
const rawPath = Astro.url.pathname;
const pathWithBase =
  rawPath === siteBase || rawPath.startsWith(`${siteBase}/`) ? rawPath : `${siteBase}${rawPath}`;
const canonicalUrl = new URL(pathWithBase, Astro.site ?? 'https://gloomcheng.github.io').toString();

const jsonLd = JSON.stringify({
  '@context': 'https://schema.org',
  '@type': 'WebPage',
  name: pageTitle,
  description,
  url: canonicalUrl,
  inLanguage: 'zh-Hant',
  isPartOf: { '@type': 'WebSite', name: 'THE LLM' },
});
---

<!doctype html>
<html lang="zh-Hant">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width" />
    <meta name="description" content={description} />
    <link rel="canonical" href={canonicalUrl} />
    <meta property="og:title" content={pageTitle} />
    <meta property="og:description" content={description} />
    <meta property="og:type" content="website" />
    <meta property="og:url" content={canonicalUrl} />
    <meta property="og:locale" content="zh_TW" />
    <meta property="og:site_name" content="THE LLM" />
    <meta name="twitter:card" content="summary" />
    <meta name="twitter:title" content={pageTitle} />
    <meta name="twitter:description" content={description} />
    {/* eslint-disable-next-line astro/no-set-html-directive -- static schema.org metadata, no user input */}
    <script type="application/ld+json" set:html={jsonLd} is:inline></script>
    <link rel="icon" type="image/svg+xml" href={withBase('/favicon.svg')} />
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link
      href="https://fonts.googleapis.com/css2?family=BIZ+UDPMincho:wght@400;700&family=Shippori+Mincho:wght@500;700&family=Zen+Old+Mincho:wght@500;700&display=swap"
      rel="stylesheet"
    />
    <title>{pageTitle}</title>
  </head>
  <body
    data-section={section}
    class="min-w-[320px] bg-paper font-sans text-base leading-8 text-ink"
  >
    <SiteHeader />
    <main id="main-content" class="min-h-screen">
      <slot />
    </main>
    <footer class="grid items-center gap-3 border-t border-ink px-4 py-8 text-sm sm:px-8 md:grid-cols-[auto_1fr_auto] md:gap-8 lg:px-[max(2rem,calc((100vw-1280px)/2))]">
      <div class="font-display text-xl font-semibold leading-none">THE LLM</div>
      <p class="m-0 leading-none">從資訊到生成。</p>
      <p class="m-0 leading-none text-muted md:text-right">
        沿著論文，一句一句讀懂 large language model。
      </p>
    </footer>
    <ReaderFeedback />
  </body>
</html>
