---
interface Props {
  kicker: string;
  title: string;
  subtitle?: string;
  id?: string;
  class?: string;
}

const { kicker, title, subtitle, id, class: className = '' } = Astro.props;
---

<header class:list={['border-b border-line pb-4 mb-8', className]} data-slot="paper-section-header">
  <p class="font-mono text-xs font-semibold uppercase tracking-[0.14em] text-red mb-2">{kicker}</p>
  <h2
    id={id ? `${id}-heading` : undefined}
    class="m-0 font-display text-3xl sm:text-4xl text-ink tracking-tight"
  >
    {title}
  </h2>
  {subtitle && <p class="mt-3 text-base text-muted leading-relaxed max-w-2xl">{subtitle}</p>}
</header>
