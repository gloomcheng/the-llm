---
import type { AuthorBrief } from '../content/paper-schema';
import { withBase } from '../lib/paths';

interface Props {
  authors: AuthorBrief[];
  kicker?: string;
  title?: string;
  description?: string;
  id?: string;
  class?: string;
}

const {
  authors,
  kicker = '研發團隊 · 核心檔案 / THE AUTHORS',
  title = '作者團隊特寫',
  description = '依原始論文署名順序排列。採用經典鋼筆線雕肖像呈現作者歷史形象與經文獻考證之關鍵貢獻。',
  id = 'authors',
  class: className = '',
} = Astro.props;

const shell = 'mx-auto w-[calc(100%-2rem)] max-w-[1120px]';
---

<section
  id={id}
  class:list={[shell, 'border-t border-ink py-16 sm:py-20 lg:py-24 scroll-mt-24', className]}
  data-slot="author-grid-section"
  aria-labelledby={`${id}-heading`}
>
  <div class="border-b border-line pb-4 mb-8">
    <p class="font-mono text-xs font-semibold uppercase tracking-[0.14em] text-red mb-2">
      {kicker}
    </p>
    <h2 id={`${id}-heading`} class="m-0 font-display text-3xl sm:text-4xl text-ink tracking-tight">
      {title}
    </h2>
    {description && <p class="mt-3 text-sm text-muted leading-relaxed">{description}</p>}
  </div>

  <slot />

  <div class="grid grid-cols-1 gap-6 sm:grid-cols-2 lg:grid-cols-4" data-slot="author-grid">
    {authors.map((author) => (
      <article class="group flex flex-col justify-between border border-line bg-surface p-6 transition-all duration-300 hover:border-ink hover:shadow-md">
        <div>
          {author.portraitUrl && (
            <div class="mb-5 aspect-square overflow-hidden border border-ink/10 bg-paper-deep/30">
              <picture>
                <source
                  srcset={withBase(author.portraitUrl.replace(/\.png$/, '.webp'))}
                  type="image/webp"
                />
                <img
                  src={withBase(author.portraitUrl)}
                  alt={`${author.name} 線稿人像`}
                  class="h-full w-full object-cover grayscale contrast-125 transition-transform duration-500 group-hover:scale-105"
                  loading="lazy"
                  decoding="async"
                  width="1024"
                  height="1024"
                />
              </picture>
            </div>
          )}
          <p class="m-0 font-mono text-xs uppercase tracking-wider text-red">
            {author.affiliationAtPublication}
          </p>
          <h3 class="mt-2 mb-3 font-display text-2xl font-bold leading-tight text-ink">
            {author.name}
          </h3>
          <p class="m-0 font-display text-base font-semibold leading-snug text-ink">
            {author.roleInPaper}
          </p>
          <p class="mt-3 mb-0 text-sm leading-relaxed text-muted">{author.verifiedContext}</p>
        </div>
      </article>
    ))}
  </div>
</section>
