---
interface Props {
  class?: string;
}

const { class: className } = Astro.props;
const hasRail = Astro.slots.has('rail');
---

<div
  class:list={[
    hasRail
      ? 'grid gap-12 lg:grid-cols-[minmax(0,1fr)_20rem] lg:items-start lg:gap-16'
      : 'max-w-2xl',
    className,
  ]}
  data-slot="paper-reading-layout"
>
  <div class="min-w-0 max-w-2xl">
    <slot />
  </div>
  {hasRail && (
    <div class="min-w-0 space-y-8" data-slot="paper-reading-rail">
      <slot name="rail" />
    </div>
  )}
</div>
