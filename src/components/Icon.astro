---
interface Props {
  name:
    | 'alert'
    | 'lock'
    | 'shuffle'
    | 'check'
    | 'message'
    | 'question'
    | 'bulb'
    | 'search'
    | 'pencil'
    | 'copy'
    | 'external';
  class?: string;
}

const { name, class: className = 'h-4 w-4' } = Astro.props;
---

<svg
  class={className}
  viewBox="0 0 24 24"
  fill="none"
  stroke="currentColor"
  stroke-width="2"
  stroke-linecap="round"
  stroke-linejoin="round"
  aria-hidden="true"
  focusable="false"
>
  {name === 'alert' && (
    <>
      <path d="M12 3 2.5 20h19L12 3Z" />
      <path d="M12 9.5v4.5" />
      <circle cx="12" cy="17" r="0.5" />
    </>
  )}
  {name === 'lock' && (
    <>
      <rect x="5" y="10.5" width="14" height="9.5" rx="1.5" />
      <path d="M8 10.5V7.5a4 4 0 0 1 8 0v3" />
    </>
  )}
  {name === 'shuffle' && (
    <>
      <path d="M3 6h4l10 12h4" />
      <path d="M17 6h4v4" />
      <path d="M17 18h4v-4" />
      <path d="M3 18h4l2.5-3" />
      <path d="M13.5 9 16 6" />
    </>
  )}
  {name === 'check' && <path d="M4.5 12.5 10 18 19.5 6.5" />}
  {name === 'message' && <path d="M4 5.5h16v10H9l-5 4v-14Z" />}
  {name === 'question' && (
    <>
      <circle cx="12" cy="12" r="8.5" />
      <path d="M9.5 9.5a2.5 2.5 0 1 1 3.6 2.2c-.8.4-1.1 1-1.1 1.8" />
      <circle cx="12" cy="17" r="0.5" />
    </>
  )}
  {name === 'bulb' && (
    <>
      <path d="M9 18h6" />
      <path d="M10 21h4" />
      <path d="M12 3a6 6 0 0 0-3.5 10.9c.8.6 1.5 1.4 1.5 2.1h4c0-.7.7-1.5 1.5-2.1A6 6 0 0 0 12 3Z" />
    </>
  )}
  {name === 'search' && (
    <>
      <circle cx="11" cy="11" r="6.5" />
      <path d="m16 16 5 5" />
    </>
  )}
  {name === 'pencil' && <path d="m14.5 5.5 4 4L8 20l-5 1 1-5L14.5 5.5Z" />}
  {name === 'copy' && (
    <>
      <rect x="9" y="9" width="11" height="11" rx="1.5" />
      <path d="M5 15V5a1.5 1.5 0 0 1 1.5-1.5H15" />
    </>
  )}
  {name === 'external' && (
    <>
      <path d="M14 4h6v6" />
      <path d="M20 4 11 13" />
      <path d="M19 13.5V19a1.5 1.5 0 0 1-1.5 1.5h-12A1.5 1.5 0 0 1 4 19V7a1.5 1.5 0 0 1 1.5-1.5h5.5" />
    </>
  )}
</svg>
