---
import Icon from './Icon.astro';
// 共讀訊號：讀者在段落留下理解狀態，元件即時給出下一步閱讀建議。
// 註記預設只存本機；送出至討論區是選用的公開動作，不是勘誤回報。
---

<!-- FLOATING FEEDBACK TRIGGER BUTTON -->
<aside aria-label="共讀訊號與學習回饋">
  <button
    id="feedback-toggle-btn"
    type="button"
    class="fixed bottom-6 right-6 z-40 inline-flex items-center gap-2 border-2 border-ink bg-surface px-4 py-2.5 font-mono text-xs sm:text-sm font-bold text-ink shadow-editorial hover:border-red hover:text-red transition-all cursor-pointer"
    aria-expanded="false"
    aria-controls="feedback-drawer"
  >
    <Icon name="message" class="h-4 w-4" />
    <span>共讀訊號</span>
    <span
      id="feedback-counter"
      class="ml-1 rounded-full bg-red px-2 py-0.5 text-xs text-white"
      aria-live="polite"
      aria-label="本頁共讀註記數量"
    >
      0
    </span>
  </button>
</aside>

<!-- INLINE PARAGRAPH POPOVER (DYNAMICALLY POSITIONED) -->
<div
  id="inline-feedback-popover"
  class="fixed z-50 hidden w-80 max-w-[calc(100vw-2rem)] border-2 border-ink bg-surface p-4 shadow-editorial transition-opacity"
  role="dialog"
  aria-modal="false"
  aria-label="段落共讀註記表單"
>
  <div class="flex items-center justify-between border-b border-line pb-2 mb-3">
    <p class="font-mono text-xs font-bold uppercase tracking-wider text-red m-0">
      標註此段落 / ANNOTATE
    </p>
    <button
      id="popover-close-btn"
      type="button"
      class="text-muted hover:text-ink font-mono text-xs font-bold cursor-pointer p-1"
      aria-label="關閉註記視窗"
    >
      關閉
    </button>
  </div>

  <p id="popover-quote-preview" class="font-serif italic text-xs text-muted mb-3 line-clamp-2">
    段落預覽...
  </p>

  <fieldset class="mb-3 border-0 p-0 m-0">
    <legend class="font-mono text-xs text-ink font-bold mb-2">目前的閱讀狀態：</legend>
    <div class="grid grid-cols-1 gap-1.5 font-mono text-xs">
      <label class="flex items-center gap-2 p-1.5 border border-line bg-paper/50 cursor-pointer hover:border-red">
        <input type="radio" name="feedback-type" value="stuck" checked class="accent-red" />
        <Icon name="question" class="h-4 w-4 shrink-0 text-red" />
        <span>這段卡住了，想先補前提</span>
      </label>
      <label class="flex items-center gap-2 p-1.5 border border-line bg-paper/50 cursor-pointer hover:border-red">
        <input type="radio" name="feedback-type" value="derivation" class="accent-red" />
        <Icon name="search" class="h-4 w-4 shrink-0 text-red" />
        <span>想看一步計算或對比例子</span>
      </label>
      <label class="flex items-center gap-2 p-1.5 border border-line bg-paper/50 cursor-pointer hover:border-red">
        <input type="radio" name="feedback-type" value="clear" class="accent-red" />
        <Icon name="bulb" class="h-4 w-4 shrink-0 text-red" />
        <span>這段讀懂了</span>
      </label>
      <label class="flex items-center gap-2 p-1.5 border border-line bg-paper/50 cursor-pointer hover:border-red">
        <input type="radio" name="feedback-type" value="wording" class="accent-red" />
        <Icon name="pencil" class="h-4 w-4 shrink-0 text-red" />
        <span>用詞可以再斟酌</span>
      </label>
    </div>
  </fieldset>

  <p
    id="popover-hint"
    class="mb-3 border-l-2 border-red bg-paper/60 p-2 font-mono text-xs leading-relaxed text-ink"
    aria-live="polite"
  >
    建議：先記下哪個名詞或哪一步斷掉，存檔後會給一條回讀路線。
  </p>

  <div class="mb-3">
    <label for="popover-note-input" class="block font-mono text-xs text-muted mb-1">
      補充一句卡點或疑問（選填）：
    </label>
    <textarea
      id="popover-note-input"
      rows="2"
      class="w-full border border-line bg-paper p-2 font-mono text-xs text-ink focus:border-red focus:outline-none"
      placeholder="例如：第 2 步的矩陣相乘維度是怎麼對齊的？"
    ></textarea>
  </div>

  <div class="flex justify-end gap-2">
    <button
      id="popover-cancel-btn"
      type="button"
      class="border border-line bg-surface px-3 py-1.5 font-mono text-xs text-muted hover:text-ink cursor-pointer"
    >
      取消
    </button>
    <button
      id="popover-save-btn"
      type="button"
      class="border-2 border-red bg-red px-3 py-1.5 font-mono text-xs font-bold text-white hover:bg-red/90 cursor-pointer"
    >
      儲存註記
    </button>
  </div>
</div>

<!-- SLIDE-OVER FEEDBACK DRAWER -->
<div
  id="feedback-drawer-overlay"
  class="fixed inset-0 z-50 hidden bg-ink/40 backdrop-blur-xs transition-opacity"
  aria-hidden="true"
></div>

<div
  id="feedback-drawer"
  class="fixed inset-y-0 right-0 z-50 hidden w-full max-w-md border-l-2 border-ink bg-surface shadow-2xl transition-transform"
  role="dialog"
  aria-modal="true"
  aria-label="共讀訊號抽屜"
>
  <div class="flex h-full flex-col justify-between p-6">
    <div>
      <!-- Drawer Header -->
      <div class="flex items-start justify-between border-b border-line pb-4 mb-4">
        <div>
          <p class="font-mono text-xs font-semibold uppercase tracking-wider text-red m-0">
            共讀訊號 / LEARNING SIGNALS
          </p>
          <h2 class="font-display text-2xl text-ink m-0 mt-1">本頁註記</h2>
        </div>
        <button
          id="drawer-close-btn"
          type="button"
          class="border border-line px-2 py-1 text-muted hover:text-ink hover:border-ink font-mono text-xs cursor-pointer"
          aria-label="關閉抽屜"
        >
          關閉
        </button>
      </div>

      <p class="text-sm text-muted leading-relaxed mb-4">
        註記是你留給自己的閱讀座標，預設只存放在本機瀏覽器。每一則註記都會附一條回讀建議；只有當你主動送出，內容才會離開本機，成為作者改善教學的訊號。
      </p>

      <!-- Annotation Items Container -->
      <div
        id="annotations-list"
        class="max-h-[50vh] overflow-y-auto space-y-3 pr-1 divide-y divide-line"
      >
        <!-- Injected dynamically via JS -->
      </div>

      <div id="annotations-empty" class="py-8 text-center border border-dashed border-line">
        <p class="font-mono text-sm text-muted m-0">目前尚無註記</p>
        <p class="text-xs text-muted mt-2 mb-0">
          在文章任意段落旁點「標註此段」，記下卡點或讀懂的瞬間。
        </p>
      </div>
    </div>

    <!-- Drawer Footer Actions -->
    <div class="border-t border-line pt-4 space-y-2">
      <div class="grid grid-cols-2 gap-2">
        <button
          id="btn-copy-markdown"
          type="button"
          class="inline-flex items-center justify-center gap-1.5 border border-ink bg-paper p-2.5 font-mono text-xs font-bold text-ink hover:bg-surface cursor-pointer"
        >
          <Icon name="copy" class="h-4 w-4" />
          <span>複製共讀筆記</span>
        </button>
        <a
          id="btn-github-issue"
          href="https://github.com/gloomcheng/the-llm/issues/new"
          target="_blank"
          rel="noreferrer"
          class="inline-flex items-center justify-center gap-1.5 border-2 border-red bg-red p-2.5 font-mono text-xs font-bold text-white hover:bg-red/90 no-underline cursor-pointer"
        >
          <Icon name="external" class="h-4 w-4" />
          <span>送出共讀問題</span>
        </a>
      </div>
      <button
        id="btn-clear-annotations"
        type="button"
        class="w-full border border-line bg-surface p-2 font-mono text-xs text-muted hover:text-red hover:border-red cursor-pointer"
      >
        清除本頁註記
      </button>
    </div>
  </div>
</div>

<script>
  interface Annotation {
    id: string;
    url: string;
    pageTitle: string;
    paragraphIndex: number;
    quote: string;
    type: 'stuck' | 'derivation' | 'clear' | 'wording';
    typeLabel: string;
    note: string;
    createdAt: string;
  }

  const STORAGE_KEY = 'the-llm-annotations-v1';

  const typeLabels: Record<string, string> = {
    stuck: '卡住：想先補前提',
    derivation: '想看一步計算或例子',
    clear: '讀懂了',
    wording: '用詞可以再斟酌',
  };

  const typeHints: Record<string, string> = {
    stuck: '建議：記下斷掉的名詞或步驟，存檔後先回讀本章機制段與名詞表，再往下走。',
    derivation: '建議：寫下你想改動的輸入，存檔後去操作本章沙盒，看數字如何跟著動。',
    clear: '建議：用一句話寫下这一段的結論，存檔後直接進入下一節驗證。',
    wording: '建議：寫下你覺得更貼切的台灣學術用詞，作者會對照譯名政策處理。',
  };

  const typeFollowups: Record<string, string> = {
    stuck: '回讀路線：本章機制段與名詞表，確認前提後再回來重讀此段。',
    derivation: '下一步：操作本章互動沙盒，改一個輸入，看輸出如何變化。',
    clear: '下一步：帶著結論進入下一節，看它如何被使用。',
    wording: '處理方式：作者對照台灣學術譯名政策檢視，不會只當錯字改掉。',
  };

  function loadAnnotations(): Annotation[] {
    try {
      const raw = localStorage.getItem(STORAGE_KEY);
      return raw ? JSON.parse(raw) : [];
    } catch {
      return [];
    }
  }

  function saveAnnotations(list: Annotation[]): void {
    try {
      localStorage.setItem(STORAGE_KEY, JSON.stringify(list));
    } catch (e) {
      console.error('Failed to save annotations to localStorage:', e);
    }
  }

  function initReaderFeedback(): void {
    const toggleBtn = document.getElementById('feedback-toggle-btn');
    const counter = document.getElementById('feedback-counter');
    const drawer = document.getElementById('feedback-drawer');
    const overlay = document.getElementById('feedback-drawer-overlay');
    const drawerCloseBtn = document.getElementById('drawer-close-btn');
    const listContainer = document.getElementById('annotations-list');
    const emptyState = document.getElementById('annotations-empty');
    const btnCopy = document.getElementById('btn-copy-markdown');
    const btnGithub = document.getElementById('btn-github-issue') as HTMLAnchorElement | null;
    const btnClear = document.getElementById('btn-clear-annotations');

    // Popover elements
    const popover = document.getElementById('inline-feedback-popover');
    const popoverCloseBtn = document.getElementById('popover-close-btn');
    const popoverCancelBtn = document.getElementById('popover-cancel-btn');
    const popoverSaveBtn = document.getElementById('popover-save-btn');
    const popoverQuotePreview = document.getElementById('popover-quote-preview');
    const popoverNoteInput = document.getElementById(
      'popover-note-input',
    ) as HTMLTextAreaElement | null;
    const popoverHint = document.getElementById('popover-hint');

    let activeParagraph: HTMLParagraphElement | null = null;
    let activeParagraphIndex = -1;
    let lastFocused: HTMLElement | null = null;

    function refreshHint(): void {
      const selected = document.querySelector<HTMLInputElement>(
        'input[name="feedback-type"]:checked',
      );
      const type = selected?.value || 'stuck';
      if (popoverHint) popoverHint.textContent = typeHints[type] || typeHints['stuck'];
    }

    document.querySelectorAll<HTMLInputElement>('input[name="feedback-type"]').forEach((radio) => {
      radio.addEventListener('change', refreshHint);
    });

    function refreshUI(): void {
      const allAnnotations = loadAnnotations();
      const currentPageUrl = window.location.pathname;
      const pageAnnotations = allAnnotations.filter((a) => a.url === currentPageUrl);

      if (counter) {
        counter.textContent = String(pageAnnotations.length);
      }

      // Update drawer list
      if (listContainer && emptyState) {
        if (pageAnnotations.length === 0) {
          listContainer.innerHTML = '';
          emptyState.classList.remove('hidden');
        } else {
          emptyState.classList.add('hidden');
          listContainer.innerHTML = '';

          pageAnnotations.forEach((item) => {
            const card = document.createElement('div');
            card.className = 'py-3 text-xs';
            const followup = typeFollowups[item.type] || '';
            card.innerHTML = `
              <div class="flex items-center justify-between mb-1">
                <span class="font-mono font-bold text-red">${item.typeLabel}</span>
                <button type="button" class="del-btn text-muted hover:text-red font-mono cursor-pointer" data-id="${item.id}" aria-label="刪除註記">刪除</button>
              </div>
              <p class="font-serif italic text-muted m-0 mb-1.5 border-l-2 border-line pl-2 line-clamp-3">"${item.quote}"</p>
              ${item.note ? `<p class="font-mono text-ink m-0 bg-paper/60 p-1.5 border border-line">${item.note}</p>` : ''}
              ${followup ? `<p class="font-mono text-muted m-0 mt-1.5">${followup}</p>` : ''}
              <p class="font-mono text-[10px] text-muted/80 mt-1 m-0">${item.createdAt}</p>
            `;
            listContainer.appendChild(card);
          });

          // Attach delete listeners
          listContainer.querySelectorAll('.del-btn').forEach((btn) => {
            btn.addEventListener('click', (e) => {
              const target = e.currentTarget as HTMLElement;
              const id = target.getAttribute('data-id');
              const updated = loadAnnotations().filter((a) => a.id !== id);
              saveAnnotations(updated);
              refreshUI();
            });
          });
        }
      }

      // Update discussion link: frame as a learning question, not an errata report
      if (btnGithub) {
        const issueTitle = encodeURIComponent(`[共讀問題] ${document.title.split('—')[0].trim()}`);
        let issueBody = `### 共讀問題\n\n**章節頁面**：${window.location.href}\n\n**我目前的理解**：\n\n**卡住或想深挖的點**：\n\n`;
        if (pageAnnotations.length > 0) {
          pageAnnotations.forEach((a, i) => {
            issueBody += `#### 註記 #${i + 1}：${a.typeLabel}\n`;
            issueBody += `> ${a.quote}\n\n`;
            if (a.note) {
              issueBody += `**補充**：${a.note}\n\n`;
            }
            issueBody += `---\n\n`;
          });
        } else {
          issueBody += `（請寫下哪一段卡住、你已理解的部分，以及你期望看到的例子或推導...）\n`;
        }
        btnGithub.href = `https://github.com/gloomcheng/the-llm/issues/new?title=${issueTitle}&body=${encodeURIComponent(issueBody)}`;
      }

      // Highlight paragraphs on the page
      document.querySelectorAll<HTMLParagraphElement>('article p').forEach((p) => {
        p.classList.remove('border-l-4', 'border-red', 'pl-3', 'bg-red-soft/10');
      });
      pageAnnotations.forEach((a) => {
        const paragraphs = document.querySelectorAll<HTMLParagraphElement>('article p');
        if (paragraphs[a.paragraphIndex]) {
          paragraphs[a.paragraphIndex].classList.add(
            'border-l-4',
            'border-red',
            'pl-3',
            'bg-red-soft/10',
          );
        }
      });
    }

    // Drawer Open / Close
    function openDrawer(): void {
      lastFocused = document.activeElement as HTMLElement | null;
      drawer?.classList.remove('hidden');
      overlay?.classList.remove('hidden');
      toggleBtn?.setAttribute('aria-expanded', 'true');
      (drawerCloseBtn as HTMLElement | null)?.focus();
    }

    function closeDrawer(): void {
      drawer?.classList.add('hidden');
      overlay?.classList.add('hidden');
      toggleBtn?.setAttribute('aria-expanded', 'false');
      lastFocused?.focus();
    }

    toggleBtn?.addEventListener('click', openDrawer);
    drawerCloseBtn?.addEventListener('click', closeDrawer);
    overlay?.addEventListener('click', closeDrawer);
    document.addEventListener('keydown', (e) => {
      if (e.key === 'Escape') {
        if (popover && !popover.classList.contains('hidden')) closePopover();
        else if (drawer && !drawer.classList.contains('hidden')) closeDrawer();
      }
    });

    // Popover Close
    function closePopover(): void {
      popover?.classList.add('hidden');
      activeParagraph = null;
      activeParagraphIndex = -1;
      if (popoverNoteInput) popoverNoteInput.value = '';
    }

    popoverCloseBtn?.addEventListener('click', closePopover);
    popoverCancelBtn?.addEventListener('click', closePopover);

    // Save Annotation
    popoverSaveBtn?.addEventListener('click', () => {
      if (!activeParagraph || activeParagraphIndex < 0) return;

      const selectedRadio = document.querySelector<HTMLInputElement>(
        'input[name="feedback-type"]:checked',
      );
      const type = (selectedRadio?.value || 'stuck') as Annotation['type'];
      const note = popoverNoteInput?.value.trim() || '';
      const quote = activeParagraph.textContent?.trim().slice(0, 200) || '';

      const newAnnotation: Annotation = {
        id: `ann-${Date.now()}-${Math.random().toString(36).slice(2, 7)}`,
        url: window.location.pathname,
        pageTitle: document.title,
        paragraphIndex: activeParagraphIndex,
        quote,
        type,
        typeLabel: typeLabels[type] || '卡住：想先補前提',
        note,
        createdAt: new Date().toLocaleString('zh-TW', { hour12: false }),
      };

      const existing = loadAnnotations();
      existing.push(newAnnotation);
      saveAnnotations(existing);

      closePopover();
      refreshUI();
      openDrawer();
    });

    // Copy Markdown
    btnCopy?.addEventListener('click', () => {
      const pageAnnotations = loadAnnotations().filter((a) => a.url === window.location.pathname);
      if (pageAnnotations.length === 0) {
        alert('目前尚無註記可複製。');
        return;
      }
      let md = `## 共讀筆記 (${document.title})\n\n`;
      pageAnnotations.forEach((a, i) => {
        md += `### ${i + 1}. ${a.typeLabel}\n`;
        md += `> ${a.quote}\n\n`;
        if (a.note) md += `**補充**：${a.note}\n\n`;
        const followup = typeFollowups[a.type];
        if (followup) md += `${followup}\n\n`;
      });
      navigator.clipboard.writeText(md).then(() => {
        alert('已複製共讀筆記至剪貼簿。');
      });
    });

    // Clear Annotations
    btnClear?.addEventListener('click', () => {
      if (confirm('確定要清除本頁的所有註記嗎？此動作只影響本機瀏覽器。')) {
        const remaining = loadAnnotations().filter((a) => a.url !== window.location.pathname);
        saveAnnotations(remaining);
        refreshUI();
      }
    });

    // Attach Inline Trigger Buttons to article paragraphs.
    // Always visible so keyboard and touch readers can discover them;
    // never hover-only.
    const paragraphs = document.querySelectorAll<HTMLParagraphElement>('article p');
    paragraphs.forEach((p, idx) => {
      const trigger = document.createElement('button');
      trigger.type = 'button';
      trigger.className =
        'feedback-inline-trigger ml-2 inline-flex items-center gap-1 font-mono text-xs text-muted underline underline-offset-4 decoration-line hover:text-red hover:decoration-red focus-visible:text-red cursor-pointer';
      trigger.setAttribute('aria-label', `標註第 ${idx + 1} 段`);
      trigger.textContent = '標註此段';

      p.classList.add('group', 'relative');
      p.appendChild(trigger);

      trigger.addEventListener('click', (e) => {
        e.stopPropagation();
        activeParagraph = p;
        activeParagraphIndex = idx;

        if (popoverQuotePreview) {
          popoverQuotePreview.textContent = `"${p.textContent?.trim().slice(0, 120)}..."`;
        }
        refreshHint();

        if (popover) {
          popover.classList.remove('hidden');
          const rect = trigger.getBoundingClientRect();
          // Position popover near button or center on mobile
          const top = Math.min(window.innerHeight - 380, Math.max(20, rect.bottom + 8));
          const left = Math.min(window.innerWidth - 340, Math.max(16, rect.left - 100));
          popover.style.top = `${top}px`;
          popover.style.left = `${left}px`;
        }
      });
    });

    refreshHint();
    refreshUI();
  }

  document.addEventListener('DOMContentLoaded', initReaderFeedback);
</script>
