---
interface Props {
  kicker?: string;
  title?: string;
  variant?: 'note' | 'editorial' | 'paper' | 'alert';
  class?: string;
  as?: 'aside' | 'div';
}

const {
  kicker,
  title,
  variant = 'note',
  class: className = '',
  as: Component = 'aside',
} = Astro.props as Props;

const variantClasses: Record<NonNullable<Props['variant']>, string> = {
  // note: cool note blue (#355b70), architectural takeaways, computational complexity, model mechanics
  note: 'border-l-2 border-blue bg-blue/5 text-blue',
  // editorial: vermilion border with warm deep paper background, conceptual reflections & continuity pivots
  editorial: 'border-l-2 border-red bg-paper-deep/60 text-ink',
  // paper: neutral line border with warm paper background
  paper: 'border-l-2 border-line bg-paper-deep/40 text-ink',
  // alert: high-contrast vermilion alert block
  alert: 'border-l-4 border-red bg-red-soft/30 text-ink',
};

const hasTitle = Astro.slots.has('title') || Boolean(title);
---

<Component
  class:list={[
    'my-8 block p-5 sm:p-6 text-base leading-8 [&>p:first-child]:mt-0 [&>p:last-child]:mb-0',
    variantClasses[variant] || variantClasses.note,
    className,
  ]}
  data-slot="callout"
>
  {kicker && (
    <p class="mb-2 font-mono text-xs font-semibold uppercase tracking-[0.12em] opacity-80">
      {kicker}
    </p>
  )}
  {hasTitle && (
    <h3 class="mt-0 mb-3 font-display text-xl sm:text-2xl leading-snug text-ink">
      <slot name="title">{title}</slot>
    </h3>
  )}
  <div class="space-y-4">
    <slot />
  </div>
</Component>
