---
interface StoryEvent {
  year: string;
  label: string;
  title: string;
  body: string;
  status?: 'past' | 'current' | 'future';
}

interface Props {
  events: StoryEvent[];
  variant?: 'rail' | 'list';
  label?: string;
}

const { events, variant = 'rail', label = '論文發展時間線' } = Astro.props;
---

{variant === 'list' ? (
  <ol class="grid grid-cols-1 border-t border-ink" tabindex="0" aria-label={label}>
    {events.map((event) => (
      <li
        class:list={[
          'grid grid-cols-[12px_5rem_1fr] gap-x-3 gap-y-2 border-b border-line py-5 md:grid-cols-[12px_6rem_11rem_minmax(14rem,0.8fr)_minmax(18rem,1fr)] md:items-start md:gap-5 md:py-6',
          event.status === 'current' && 'bg-red-soft/30 px-3 md:px-4',
        ]}
      >
        <div
          class:list={[
            'static mt-1.5 h-3 w-3 rounded-full border-2 border-paper bg-ink shadow-[0_0_0_1px_theme(colors.ink)]',
            event.status === 'current' && 'bg-red shadow-[0_0_0_2px_theme(colors.red)]',
          ]}
          aria-hidden="true"
        />
        <p class="m-0 font-mono text-xs sm:text-sm font-semibold tracking-wider text-muted col-start-2 row-start-1">
          {event.year}
        </p>
        <p class="m-0 font-mono text-xs font-semibold uppercase tracking-wider text-red col-start-3 row-start-1 md:col-start-3">
          {event.label}
        </p>
        <h3 class="m-0 font-display text-xl leading-snug col-start-3 row-start-2 md:col-start-4 md:row-start-1 text-ink">
          {event.title}
        </h3>
        <p class="m-0 text-sm leading-relaxed text-muted col-start-3 row-start-3 md:col-start-5 md:row-start-1">
          {event.body}
        </p>
      </li>
    ))}
  </ol>
) : (
  <ol
    class="grid grid-cols-1 gap-6 md:grid-cols-3 lg:gap-8 list-none p-0 m-0"
    tabindex="0"
    aria-label={label}
  >
    {events.map((event, idx) => {
      const isCurrent = event.status === 'current';
      const isLast = idx === events.length - 1;

      return (
        <li
          class:list={[
            'relative flex flex-col justify-between p-6 sm:p-7 transition-colors',
            isCurrent
              ? 'border-2 border-red bg-surface shadow-editorial ring-1 ring-red/20'
              : 'border border-line bg-surface/80 hover:bg-surface',
          ]}
        >
          <div>
            <!-- Top Timeline Milestone Connector -->
            <div class="flex items-center gap-3 mb-5" aria-hidden="true">
              <span
                class:list={[
                  'flex h-4 w-4 items-center justify-center rounded-full border-2 shrink-0 transition-all',
                  isCurrent
                    ? 'border-surface bg-red shadow-[0_0_0_3px_theme(colors.red/25%)]'
                    : 'border-surface bg-ink shadow-[0_0_0_2px_theme(colors.ink/20%)]',
                ]}
              >
                <span class="h-1.5 w-1.5 rounded-full bg-surface" />
              </span>
              <div
                class:list={[
                  'h-px flex-1',
                  isCurrent ? 'bg-red/40' : 'bg-line',
                  isLast && 'bg-gradient-to-r from-line to-transparent',
                ]}
              />
              <span class="font-mono text-xs font-semibold tracking-wider text-muted shrink-0">
                {event.year}
              </span>
            </div>

            <!-- Stage Kicker -->
            <p class="m-0 mb-2 font-mono text-xs font-semibold uppercase tracking-wider text-red">
              {event.label}
            </p>

            <!-- Stage Title -->
            <h3 class="m-0 font-display text-xl sm:text-2xl text-ink leading-snug tracking-tight mb-3">
              {event.title}
            </h3>

            <!-- Stage Body -->
            <p class="m-0 text-sm sm:text-base leading-relaxed text-muted">{event.body}</p>
          </div>
        </li>
      );
    })}
  </ol>
)}
