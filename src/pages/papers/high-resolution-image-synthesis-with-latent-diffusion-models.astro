    },
    32: {
      spatial: '16 × 16',
      spatialSub: '空間縮減 1024×',
      values: '4,096',
      valuesSub: '資料量壓縮 192.0×',
      attn: '6.55 × 10⁴',
      attnSub: '運算降低 1,048,576×',
      quality: '嚴重失真',
      qualitySub: '解碼重建產生強烈偽影',
      boxScale: 'scale-60',
      gridCols: 'grid-cols-2',
      dotCount: 4,
      tag: '16 × 16 × 16',
    },
  };

  function initModule1(): void {
    const buttons = document.querySelectorAll<HTMLButtonElement>('.factor-btn');
    const metricSpatial = document.getElementById('metric-spatial');
    const metricSpatialSub = document.getElementById('metric-spatial-sub');
    const metricValues = document.getElementById('metric-values');
    const metricValuesSub = document.getElementById('metric-values-sub');
    const metricAttn = document.getElementById('metric-attn');
    const metricAttnSub = document.getElementById('metric-attn-sub');
    const metricQuality = document.getElementById('metric-quality');
    const metricQualitySub = document.getElementById('metric-quality-sub');
    const svgFactorLabel = document.getElementById('svg-factor-label');
    const latentBox = document.getElementById('latent-box');
    const latentGrid = document.getElementById('latent-grid');
    const latentSpecTag = document.getElementById('latent-spec-tag');
    const latentBoxDesc = document.getElementById('latent-box-desc');

    buttons.forEach((btn) => {
      btn.addEventListener('click', () => {
        const factor = Number(btn.getAttribute('data-factor') || '8');
        const data = factorData[factor] || factorData[8];

        buttons.forEach((b) => {
          b.classList.remove('border-red', 'bg-red', 'text-white');
          b.classList.add('border-line', 'bg-surface', 'text-ink');
          b.setAttribute('aria-pressed', 'false');
        });
        btn.classList.remove('border-line', 'bg-surface', 'text-ink');
        btn.classList.add('border-red', 'bg-red', 'text-white');
        btn.setAttribute('aria-pressed', 'true');

        if (metricSpatial) metricSpatial.textContent = data.spatial;
        if (metricSpatialSub) metricSpatialSub.textContent = data.spatialSub;
        if (metricValues) metricValues.textContent = data.values;
        if (metricValuesSub) metricValuesSub.textContent = data.valuesSub;
        if (metricAttn) metricAttn.textContent = data.attn;
        if (metricAttnSub) metricAttnSub.textContent = data.attnSub;
        if (metricQuality) metricQuality.textContent = data.quality;
        if (metricQualitySub) metricQualitySub.textContent = data.qualitySub;
        if (svgFactorLabel) svgFactorLabel.textContent = `f = ${factor} (空間下採樣)`;
        if (latentSpecTag) latentSpecTag.textContent = data.tag;
        if (latentBoxDesc) {
          latentBoxDesc.textContent = `感知隱空間 z (${data.values} 數值)`;
        }

        if (latentGrid) {
          latentGrid.className = `grid h-16 w-16 ${data.gridCols} gap-1`;
          latentGrid.innerHTML = '';
          for (let i = 0; i < data.dotCount; i++) {
            const dot = document.createElement('div');
            dot.className = 'bg-red/60 rounded-[1px]';
            latentGrid.appendChild(dot);
          }
        }

        if (latentBox) {
          latentBox.className = `relative mx-auto flex h-36 w-36 items-center justify-center border-2 border-red bg-red-soft/20 shadow-editorial transition-all duration-300 ${data.boxScale}`;
        }
      });
    });
  }

  interface PromptTokens {
    tokens: string[];
    weights: number[]; // relative emphasis
  }

  const promptTokenDict: Record<string, PromptTokens> = {
    cyberpunk: {
      tokens: ['A', 'cyberpunk', 'street', 'in', 'Taipei', 'rainy', 'night', 'neon', 'reflections'],
      weights: [0.1, 0.95, 0.7, 0.1, 0.85, 0.8, 0.75, 0.9, 0.65],
    },
    portrait: {
      tokens: [
        'Cinematic',
        'portrait',
        'elderly',
        'watchmaker',
        'examining',
        'gears',
        'dramatic',
        'lighting',
      ],
      weights: [0.6, 0.8, 0.85, 0.95, 0.7, 0.9, 0.6, 0.75],
    },
    landscape: {
      tokens: [
        'A',
        'majestic',
        'snowy',
        'mountain',
        'crystalline',
        'lake',
        'starry',
        'aurora',
        'sky',
      ],
      weights: [0.1, 0.6, 0.9, 0.95, 0.75, 0.85, 0.7, 0.95, 0.8],
    },
  };

  function initModule2(): void {
    const sliderCfg = document.getElementById('slider-cfg') as HTMLInputElement | null;
    const sliderTimestep = document.getElementById('slider-timestep') as HTMLInputElement | null;
    const cfgValue = document.getElementById('cfg-value');
    const timestepValue = document.getElementById('timestep-value');
    const promptSelect = document.getElementById('prompt-select') as HTMLSelectElement | null;
    const stageName = document.getElementById('stage-name');
    const stageDesc = document.getElementById('stage-desc');
    const cfgWarning = document.getElementById('cfg-warning');
    const valUncond = document.getElementById('val-uncond');
    const valCond = document.getElementById('val-cond');
    const valDelta = document.getElementById('val-delta');
    const valFinal = document.getElementById('val-final');
    const tokenChips = document.getElementById('token-chips');

    function updateWindTunnel(): void {
      const cfg = parseFloat(sliderCfg?.value || '7.5');
      const t = parseInt(sliderTimestep?.value || '500', 10);
      const promptKey = promptSelect?.value || 'cyberpunk';
      const promptData = promptTokenDict[promptKey] || promptTokenDict['cyberpunk'];

      if (cfgValue) cfgValue.textContent = cfg.toFixed(1);
      if (timestepValue) timestepValue.textContent = `${t} / 1000`;

      // Warning check
      if (cfgWarning) {
        if (cfg >= 11.5) {
          cfgWarning.classList.remove('hidden');
        } else {
          cfgWarning.classList.add('hidden');
        }
      }

      // Stage description
      if (stageName && stageDesc) {
        if (t >= 750) {
          stageName.textContent = '初期階段：低頻宏觀構圖 (t = 750–1000)';
          stageDesc.textContent =
            '噪聲強度極高。畫面呈現大面積混沌雪花，模型專注於決定全域色彩分佈、地平線位置與宏觀氛圍，尚未形成具體幾何輪廓。';
        } else if (t >= 300) {
          stageName.textContent = '中度去噪：幾何輪廓與實體塑造 (t = 300–749)';
          stageDesc.textContent =
            '噪聲顯著衰減。主體物件邊界、肢體走向、主要光影面與空間遮擋關係被快速確立，畫面具備清晰可辨的語意拓撲。';
        } else {
          stageName.textContent = '末期精修：高頻紋理與反光刻畫 (t = 0–299)';
          stageDesc.textContent =
            '噪聲微乎其微。模型負責微觀毛孔、髮絲走向、雨滴反光與材質光澤等高頻細節雕刻，此時大幅改變引導係數已難以撼動大局。';
        }
      }

      // Math components simulation
      const baseUncond = 1.0;
      const baseCond = 1.0 + (t / 1000) * 0.4 + 0.1;
      const delta = baseCond - baseUncond;
      const finalVal = baseUncond + cfg * delta;

      if (valUncond) valUncond.textContent = baseUncond.toFixed(2);
      if (valCond) valCond.textContent = baseCond.toFixed(2);
      if (valDelta) valDelta.textContent = `+${delta.toFixed(2)}`;
      if (valFinal) valFinal.textContent = finalVal.toFixed(2);

      // Render tokens
      if (tokenChips) {
        tokenChips.innerHTML = '';
        promptData.tokens.forEach((tok, idx) => {
          const w = promptData.weights[idx] || 0.5;
          // Timestep influence: early stages focus on scene words; late stages focus on texture words
          const focusModifier = t > 600 ? 1.0 : 0.8;
          const effectiveEmphasis = Math.min(1.0, w * focusModifier * (cfg / 7.5));

          const chip = document.createElement('span');
          chip.className =
            'inline-block px-2.5 py-1 font-mono text-xs border rounded transition-all duration-200';

          if (effectiveEmphasis > 0.8) {
            chip.classList.add('border-red', 'bg-red', 'text-white', 'font-bold');
          } else if (effectiveEmphasis > 0.4) {
            chip.classList.add('border-line', 'bg-red-soft/40', 'text-ink', 'font-medium');
          } else {
            chip.classList.add('border-line', 'bg-surface', 'text-muted');
          }

          chip.textContent = tok;
          tokenChips.appendChild(chip);
        });
      }
    }

    sliderCfg?.addEventListener('input', updateWindTunnel);
    sliderTimestep?.addEventListener('input', updateWindTunnel);
    promptSelect?.addEventListener('change', updateWindTunnel);

    updateWindTunnel();
  }

  document.addEventListener('DOMContentLoaded', () => {
    initModule1();
    initModule2();
  });
</script>
