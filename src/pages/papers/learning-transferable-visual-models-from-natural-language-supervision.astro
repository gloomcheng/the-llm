---
import BaseLayout from '../../layouts/BaseLayout.astro';
import { withBase } from '../../lib/paths';
import PaperReadingLayout from '../../components/PaperReadingLayout.astro';
import PaperSectionHeader from '../../components/PaperSectionHeader.astro';
import AsideCard from '../../components/AsideCard.astro';
import Callout from '../../components/Callout.astro';
import AuthorGrid from '../../components/AuthorGrid.astro';
import EvidenceList from '../../components/EvidenceList.astro';
import PaperNavigation from '../../components/PaperNavigation.astro';
import PaperMeta from '../../components/PaperMeta.astro';
import StoryRail from '../../components/StoryRail.astro';
import {
  paper,
  clipSources,
  clipTimelineEpochs,
} from '../../content/papers/learning-transferable-visual-models-from-natural-language-supervision';

const shell = 'mx-auto w-[calc(100%-2rem)] max-w-[1120px]';

interface StoryEvent {
  year: string;
  label: string;
  title: string;
  body: string;
  status?: 'past' | 'current' | 'future';
}

const timelineEvents: StoryEvent[] = [
  {
    year: '2012',
    label: '封閉標籤 / IMAGENET 1K',
    title: '離散整數標籤的監督式學習統治',
    body: 'AlexNet 引爆深度學習革命，確立以 ImageNet 1,000 個固定整數類別進行交叉熵訓練的經典典範，但同時也將電腦視覺鎖死在封閉集合的語意孤島中。',
    status: 'past',
  },
  {
    year: '2018',
    label: '對比奠基 / INFONCE & CPC',
    title: '互資訊最大化與對比預測編碼',
    body: 'van den Oord 等人提出 InfoNCE 對比損失函數，證明透過區分正負樣本對最大化互資訊下界，能從無標註訊號中萃取深層結構表徵，奠定對比學習數學基石。',
    status: 'past',
  },
  {
    year: '2020',
    label: '視覺純粹 / VIT & SIMCLR',
    title: '純粹 Transformer 骨幹與超大批次經驗',
    body: 'ViT 廢除卷積以純 Transformer 處理影像圖塊，SimCLR 驗證超大批次與精準溫度係數在對比表徵學習中的威力，為跨模態雙塔對齊備妥了算力與演算法基礎。',
    status: 'past',
  },
  {
    year: '2021.02',
    label: '本篇焦點 / CONTRASTIVE ALIGNMENT',
    title: '文字與影像共享同一套世界座標：CLIP',
    body: 'OpenAI 發表 CLIP，爬取網路 4 億圖文資料進行雙塔對比預訓練，以極簡的對稱 InfoNCE 幾何將文字與影像拉入同一個高維超球體，實現震撼業界的零樣本開放分類。',
    status: 'current',
  },
  {
    year: '2022–至今',
    label: '跨模態繁榮 / DIFFUSION & MLLM',
    title: '文字生圖語意羅盤與多模態感官起點',
    body: 'DALL-E 2 與 Stable Diffusion 以 CLIP 特徵導航擴散去噪，LLaVA 以凍結的 CLIP-ViT 賦予大型語言模型視覺感官，CLIP 成為現代多模態 AI 的底層大一統基礎。',
    status: 'future',
  },
];
---

<BaseLayout title={`${paper.chineseTitle} | THE LLM`} description={paper.abstractSummary}>
  <!-- HERO HEADER (UNIVERSAL INVARIANT) -->
  <header class={`${shell} pt-10`}>
    <div class="flex gap-3 font-mono text-sm uppercase tracking-[0.08em] text-muted">
      <a class="text-red underline underline-offset-4" href={withBase('/')}>
        THE LLM
      </a>
      <span aria-hidden="true">/</span>
      <span>第十二章</span>
    </div>

    <div class="grid grid-cols-1 items-end gap-12 py-16 lg:grid-cols-[1.15fr_0.85fr] lg:gap-24">
      <div>
        <p class="mb-5 font-mono text-sm font-semibold uppercase tracking-[0.12em] text-red">
          VOL. 12 / CONTRASTIVE ALIGNMENT
        </p>
        <h1 class="m-0 font-display text-4xl sm:text-5xl lg:text-6xl xl:text-7xl leading-tight tracking-[-0.04em] text-ink">
          <span class="block">Learning Transferable Visual Models</span>
          <em class="block font-serif italic">From Natural Language Supervision.</em>
        </h1>
        <p class="mt-8 max-w-[52ch] text-lg leading-8 text-muted">
          在 2021 年以前，電腦視覺如同被困在一千個固定號碼牌裡的啞巴學徒。CLIP
          以四億對圖文資料進行對稱對比學習，將文字與影像狠狠拉入同一座高維超球體，讓機器第一次用人類豐富的自然語言看懂了整個世界。
        </p>
      </div>

      <aside
        class="border-t-4 border-red bg-surface p-6 shadow-editorial"
        aria-label="這篇論文的一句評語"
      >
        <p class="mb-4 sm:mb-6 font-mono text-xs sm:text-sm font-semibold uppercase tracking-[0.12em] text-red">
          一句評語 / THE SHORT VERDICT
        </p>
        <p class="m-0 max-w-[20ch] sm:max-w-[22ch] font-display text-2xl sm:text-3xl leading-tight text-ink">
          文字與影像不是兩座孤島，而是同一座高維幾何宇宙中的不同投影。
        </p>
        <p class="mt-6 mb-0 text-sm sm:text-base leading-relaxed sm:leading-7 text-muted">
          CLIP 徹底廢除固定標籤的封閉牢籠，以極簡的對稱 InfoNCE
          幾何，讓電腦第一次以人類的開放語言凝視並理解真實世界，成為後續文字生圖與多模態大模型的通用語意羅盤。
        </p>
      </aside>
    </div>

    <PaperMeta
      year={paper.year}
      venue={paper.venue}
      readTime="28 分鐘"
      difficulty="核心概念"
      doi={paper.doi}
    />
  </header>

  <!-- STORY RAIL -->
  <section class="border-y border-line py-12 bg-surface/50" aria-label="論文歷史時間線">
    <div class={shell}>
      <StoryRail events={timelineEvents} variant="list" />
    </div>
  </section>

  <!-- MAIN READING LAYOUT -->
  <PaperReadingLayout>
    <!-- ========================================== -->
    <!-- 章節 01 · 封閉集合的語意孤島 -->
    <!-- ========================================== -->
    <section id="chapter-01" class="scroll-mt-24" aria-labelledby="heading-chapter-01">
      <PaperSectionHeader
        kicker="章節 01 / CHAPTER 01"
        title="封閉集合的語意孤島：ImageNet 標籤與監督式學習的盡頭"
        subtitle="THE CLOSED-SET SEMANTIC ISLAND AND THE SUPERVISION CLIFF"
      />

      <div class="space-y-6 text-base leading-8 text-ink">
        <p>
          在 2021
          年春季以前，整個電腦視覺領域的輝煌成果背後，潛藏著一個極其荒謬且頑固的工程現實：無論神經網路架構多麼深邃、卷積核或自注意力層設計得多麼精巧，絕大多數視覺模型在本質上都是「封閉集合的分類機器」。
        </p>
        <p>
          自 2012 年 AlexNet 掀起深度學習巨浪以來，學界評估視覺智慧的黃金標尺始終是
          ImageNet-1K。這項包含 1,000
          個固定類別的基準，將每張輸入影像強制壓縮為一個千維的一熱編碼（One-Hot
          Vector）目標。在數學上，神經網路最後一層的全連接權重矩陣{' '}
          <math class="font-serif"><msub><mi>W</mi><mtext>cls</mtext></msub></math>{' '}
          負責將高維特徵投影至 1,000 個離散通道，再透過 Softmax 函數計算各類別的條件機率。
        </p>
        <p>
          這種受限監督方式帶來了致命的語意隔絕。在標準交叉熵損失的眼中，類別編號 0
          的「丁鯛（Tench）」與類別編號 1 的「金魚（Goldfish）」之間的數學距離，和「丁鯛」與類別編號
          500 的「懸崖懸居（Cliff Dwelling）」完全等價——所有錯誤類別在目標分佈中都被均勻賦予機率
          0。分類器完全不知道金魚與丁鯛同屬於水生魚類，更不知道懸崖是一處地理景觀。它所學會的，僅僅是尋找能在千維輸出端點上最大化正確整數標籤的像素高頻捷徑。
        </p>

        <Callout variant="alert" title="人工標註懸崖：為什麼封閉標籤無法擴展至真實世界？">
          <p class="m-0 text-sm leading-relaxed">
            真實世界是由無限豐富的連續語意構成的。當一張照片呈現「一隻戴著草帽在蔚藍海灘上熟練衝浪的柴犬」時，傳統
            ImageNet
            分類器只能尷尬地輸出「柴犬：0.82、衝浪板：0.11、草帽：0.04」。模型缺乏任何語法結構來表達物體之間的動態關聯、環境氛圍或因果情境。更嚴峻的是，若工程師希望讓系統辨識「草帽衝浪犬」這個全新概念，唯一的途徑就是重新動員數千名標註員、人工清洗並框選數萬張圖片、重寫輸出層維度，並耗費昂貴算力重新微調。這座標註成本的懸崖，將視覺人工智慧死死錮禁在少數受資助的封閉任務中。
          </p>
        </Callout>

        <p>
          與此同時，自然語言處理（NLP）領域正在上演一場翻天覆地的典範轉移。從 2018 年的 GPT-1、BERT
          到 2020 年的
          GPT-3，語言研究者早已徹底拋棄了為「情緒分析」、「命名實體識別」或「文本蘊涵」單獨微調專用分類頭的傳統做法。語言模型直接在網際網路未經清洗的海量文本上進行自監督下一個詞預測，自主吸收了語言的文法、常識與世界模型。
        </p>
        <p>
          OpenAI 的研究團隊（由 Alec Radford 領軍，匯聚了 Jong Wook Kim、Chris Hallacy、Aditya
          Ramesh、Gabriel Goh 與 Ilya Sutskever
          等核心學者）敏銳地意識到這個尖銳的矛盾：人類在嬰兒時期認識世界，從來不是靠父母拿著一千張字卡、強制要求背誦離散類別編號；人類是聽著伴隨視覺場景流動的連續語言描述（「看！那隻狗狗正在追皮球」）來理解世界的。如果能直接以網際網路上海量的自然語言作為監督信號，電腦視覺是否也能一舉掙脫固定標籤的牢籠，獲得與生俱來的開放詞彙理解力？
        </p>
      </div>
    </section>

    <!-- ========================================== -->
    <!-- 章節 02 · 雙塔對比架構 -->
    <!-- ========================================== -->
    <section id="chapter-02" class="scroll-mt-24 mt-20" aria-labelledby="heading-chapter-02">
      <PaperSectionHeader
        kicker="章節 02 / CHAPTER 02"
        title="雙塔對比架構：將文字與影像拉入同一個超球體座標系"
        subtitle="THE DUAL-TOWER CONTRASTIVE ARCHITECTURE AND HYPERSPHERE ALIGNMENT"
      />

      <div class="space-y-6 text-base leading-8 text-ink">
        <p>
          要將自然語言引入視覺預訓練，最直觀的想法是構建一個「圖說生成器（Image
          Captioner）」：讓卷積網路或視覺 Transformer
          提取影像特徵，隨後由自回歸語言模型逐字預測這張圖片的文字說明。
        </p>
        <p>
          然而，Radford
          等人在早期探索中遭遇了巨大的算力壁壘。語言具有高度的靈活性與冗餘性：同一張小狗的照片，圖說可以是「一隻棕色的可愛幼犬」、「陽光下的米克斯犬」，或是「我家剛領養的寵物在客廳打瞌睡」。自回歸生成模型必須耗費極其龐大的計算容量去預測「一隻」、「的」、「在」等語法虛詞，並因為預測與真實標籤略有出入的同義詞而承受無謂的交叉熵懲罰。
        </p>

        <AsideCard
          title="計算效率量化對決：生成式圖說 vs 對比預測"
          kicker="COMPUTATIONAL EFFICIENCY / 12X ACCELERATION"
        >
          <div class="space-y-3 text-sm leading-relaxed text-muted">
            <p class="m-0">
              OpenAI 在嚴格對齊的硬體與資料預算下進行了消融實驗，對比了三種不同的多模態學習目標：
            </p>
            <ul class="m-0 list-disc pl-5 space-y-1">
              <li>
                <strong class="text-ink">自回歸圖說生成（Predictive Language Modeling）：</strong>
                模型需逐字解碼完整句子，計算開銷最為沉重，收斂速度極其緩慢。
              </li>
              <li>
                <strong class="text-ink">詞袋預測（Bag-of-Words Prediction）：</strong>
                僅預測文本中出現的關鍵詞彙集合，速度提升約 4 倍，但丟失了詞序與語意深層結構。
              </li>
              <li>
                <strong class="text-ink">
                  對比表徵學習（Contrastive Representation Learning）：
                </strong>
                完全不生成文字，僅要求模型在批次中正確辨別「哪段文字與哪張圖片成對」，學習效率比自回歸生成高出整整{' '}
                <strong>12 倍</strong>！
              </li>
            </ul>
          </div>
        </AsideCard>

        <p>
          對比學習的哲學本質是「化繁為簡」：我們不需要模型逐字繪製文字，只需要模型能夠判斷「意境是否相符」。這催生了
          CLIP 標誌性的雙塔對比架構（Dual-Tower Architecture）。
        </p>
        <p>整個系統由兩個獨立的神經網路構成：</p>
        <ul class="list-disc pl-6 space-y-2">
          <li>
            <strong class="text-ink">影像編碼塔（Image Encoder）：</strong>接收解析度為
            224×224（或更高）的原始影像 <math class="font-serif"><mi>x</mi></math>。架構可採用改進版
            ResNet（如 ResNet-50、ResNet-101、RN50x4）或純視覺
            Transformer（ViT-B/32、ViT-B/16、ViT-L/14）。視覺主幹提取出全域表徵後，透過線性投影矩陣
            <math class="font-serif"><msub><mi>W</mi><mi>I</mi></msub></math> 映射至共用特徵維度
            <math class="font-serif"><mi>d</mi></math>（如 512 或 768）。
          </li>
          <li>
            <strong class="text-ink">文字編碼塔（Text Encoder）：</strong>接收長度限制為 76 個 Token
            的文字序列（前後分別插入序列起始標記 <code>[SOS]</code> 與結束標記 <code>[EOS]</code>
            ）。採用標準 Transformer 結構（12 層、8 頭、隱藏維度 512）。取 <code>[EOS]</code>{' '}
            位置的啟動向量，透過線性投影矩陣{' '}
            <math class="font-serif"><msub><mi>W</mi><mi>T</mi></msub></math>{' '}
            投影至相同的共用特徵維度 <math class="font-serif"><mi>d</mi></math>。
          </li>
        </ul>

        <p>
          在完成線性投影後，CLIP 施加了一項至關重要的幾何變換：
          <strong>L2 向量正規化（L2 Normalization）</strong>
          。所有影像特徵向量與文字特徵向量均被除以其自身的歐幾里得範數，被精確強制約束在半徑為 1
          的高維超球體（Unit Hypersphere{' '}
          <math class="font-serif"><msup><mi mathvariant="double-struck">S</mi><mrow><mi>d</mi><mo>-</mo><mn>1</mn></mrow></msup></math>
          ）表面：
        </p>

        <math display="block" class="editorial-math my-6" aria-label="向量 L2 正規化公式">
          <mrow>
            <msub><mover><mi>I</mi><mo>~</mo></mover><mi>i</mi></msub>
            <mo>=</mo>
            <mfrac>
              <mrow><msubsup><mi>W</mi><mi>I</mi><mi>T</mi></msubsup><msub><mi>f</mi><mi>I</mi></msub><mo stretchy="false">(</mo><msub><mi>x</mi><mi>i</mi></msub><mo stretchy="false">)</mo></mrow>
              <msub><mrow><mo>&#x2225;</mo><msubsup><mi>W</mi><mi>I</mi><mi>T</mi></msubsup><msub><mi>f</mi><mi>I</mi></msub><mo stretchy="false">(</mo><msub><mi>x</mi><mi>i</mi></msub><mo stretchy="false">)</mo><mo>&#x2225;</mo></mrow><mn>2</mn></msub>
            </mfrac>
            <mo>,</mo>
            <mspace width="1.5em"/>
            <msub><mover><mi>T</mi><mo>~</mo></mover><mi>j</mi></msub>
            <mo>=</mo>
            <mfrac>
              <mrow><msubsup><mi>W</mi><mi>T</mi><mi>T</mi></msubsup><msub><mi>f</mi><mi>T</mi></msub><mo stretchy="false">(</mo><msub><mi>t</mi><mi>j</mi></msub><mo stretchy="false">)</mo></mrow>
              <msub><mrow><mo>&#x2225;</mo><msubsup><mi>W</mi><mi>T</mi><mi>T</mi></msubsup><msub><mi>f</mi><mi>T</mi></msub><mo stretchy="false">(</mo><msub><mi>t</mi><mi>j</mi></msub><mo stretchy="false">)</mo><mo>&#x2225;</mo></mrow><mn>2</mn></msub>
            </mfrac>
          </mrow>
        </math>

        <div class="border-l-2 border-red pl-4 text-sm leading-relaxed text-muted">
          <p class="m-0 font-bold text-ink">變數與維度定義規格：</p>
          <ul class="m-0 mt-2 list-disc pl-5 space-y-1">
            <li>
              <math class="font-serif"><msub><mi>x</mi><mi>i</mi></msub></math> 與{' '}
              <math class="font-serif"><msub><mi>t</mi><mi>j</mi></msub></math>：批次中第{' '}
              <math class="font-serif"><mi>i</mi></math> 張原始影像與第{' '}
              <math class="font-serif"><mi>j</mi></math> 段文字提示。
            </li>
            <li>
              <math class="font-serif"><msub><mi>f</mi><mi>I</mi></msub><mo stretchy="false">(</mo><mo>·</mo><mo stretchy="false">)</mo><mo>&#x2208;</mo><msup><mi mathvariant="double-struck">R</mi><msub><mi>d</mi><mi>I</mi></msub></msup></math>
              {' '} 與{' '}
              <math class="font-serif"><msub><mi>f</mi><mi>T</mi></msub><mo stretchy="false">(</mo><mo>·</mo><mo stretchy="false">)</mo><mo>&#x2208;</mo><msup><mi mathvariant="double-struck">R</mi><msub><mi>d</mi><mi>T</mi></msub></msup></math>
              ：影像與文字骨幹網路提取之原始高維表徵向量。
            </li>
            <li>
              <math class="font-serif"><msub><mi>W</mi><mi>I</mi></msub><mo>&#x2208;</mo><msup><mi mathvariant="double-struck">R</mi><mrow><msub><mi>d</mi><mi>I</mi></msub><mo>&#xd7;</mo><mi>d</mi></mrow></msup></math>
              {' '} 與{' '}
              <math class="font-serif"><msub><mi>W</mi><mi>T</mi></msub><mo>&#x2208;</mo><msup><mi mathvariant="double-struck">R</mi><mrow><msub><mi>d</mi><mi>T</mi></msub><mo>&#xd7;</mo><mi>d</mi></mrow></msup></math>
              ：跨模態對齊線性投影權重矩陣。
            </li>
            <li>
              <math class="font-serif"><msub><mover><mi>I</mi><mo>~</mo></mover><mi>i</mi></msub><mo>,</mo><msub><mover><mi>T</mi><mo>~</mo></mover><mi>j</mi></msub><mo>&#x2208;</mo><msup><mi mathvariant="double-struck">S</mi><mrow><mi>d</mi><mo>-</mo><mn>1</mn></mrow></msup></math>
              ：投影至單位超球體表面之單位特徵向量，滿足{' '}
              <math class="font-serif"><mo>&#x2225;</mo><mover><mi>I</mi><mo>~</mo></mover><msub><mo>&#x2225;</mo><mn>2</mn></msub><mo>=</mo><mo>&#x2225;</mo><mover><mi>T</mi><mo>~</mo></mover><msub><mo>&#x2225;</mo><mn>2</mn></msub><mo>=</mo><mn>1</mn></math>
              。
            </li>
          </ul>
        </div>

        <p>
          這項幾何約束帶來了深遠的數學優勢：兩個單位向量的內積，完全等價於它們之間的夾角餘弦值（Cosine
          Similarity）：
          <math class="font-serif"><msub><mi>S</mi><mrow><mi>i</mi><mo>,</mo><mi>j</mi></mrow></msub><mo>=</mo><msub><mover><mi>I</mi><mo>~</mo></mover><mi>i</mi></msub><mo>&#xb7;</mo><msub><mover><mi>T</mi><mo>~</mo></mover><mi>j</mi></msub><mo>=</mo><mo>cos</mo><mo stretchy="false">(</mo><msub><mi>&#952;</mi><mrow><mi>i</mi><mo>,</mo><mi>j</mi></mrow></msub><mo stretchy="false">)</mo><mo>&#x2208;</mo><mo stretchy="false">[</mo><mo>-</mo><mn>1</mn><mo>,</mo><mn>1</mn><mo stretchy="false">]</mo></math>
          。
          這消除了特徵向量長度（模長）對相似度計算的干擾，避免模型透過無限制放大向量範數來操縱損失函數，保證所有特徵比較均在純粹的角度幾何空間中進行。
        </p>

        <p>
          在一個包含 <math class="font-serif"><mi>N</mi></math>{' '}
          個樣本的微批次（Mini-batch）中，我們擁有 <math class="font-serif"><mi>N</mi></math>{' '}
          個真實配對的圖文對{' '}
          <math class="font-serif"><msubsup><mrow><mo>&#123;</mo><mo stretchy="false">(</mo><msub><mi>x</mi><mi>i</mi></msub><mo>,</mo><msub><mi>t</mi><mi>i</mi></msub><mo stretchy="false">)</mo><mo>&#125;</mo></mrow><mrow><mi>i</mi><mo>=</mo><mn>1</mn></mrow><mi>N</mi></msubsup></math>
          。影像塔輸出矩陣{' '}
          <math class="font-serif"><mover><mi>I</mi><mo>~</mo></mover><mo>&#x2208;</mo><msup><mi mathvariant="double-struck">R</mi><mrow><mi>N</mi><mo>&#xd7;</mo><mi>d</mi></mrow></msup></math>
          {' '} 與文字塔輸出矩陣{' '}
          <math class="font-serif"><mover><mi>T</mi><mo>~</mo></mover><mo>&#x2208;</mo><msup><mi mathvariant="double-struck">R</mi><mrow><mi>N</mi><mo>&#xd7;</mo><mi>d</mi></mrow></msup></math>
          {' '} 進行矩陣相乘，瞬間構成一個尺寸為{' '}
          <math class="font-serif"><mi>N</mi><mo>&#xd7;</mo><mi>N</mi></math> 的餘弦相似度方陣：
        </p>

        <math display="block" class="editorial-math my-6" aria-label="CLIP 對稱 InfoNCE 損失函數">
          <mtable displaystyle="true">
            <mtr>
              <mtd columnalign="right"><msub><mi>L</mi><mrow><mi>i</mi><mo>,</mo><mi>j</mi></mrow></msub></mtd>
              <mtd columnalign="left"><mo>=</mo><mfrac><mrow><msub><mover><mi>I</mi><mo>~</mo></mover><mi>i</mi></msub><mo>&#xb7;</mo><msub><mover><mi>T</mi><mo>~</mo></mover><mi>j</mi></msub></mrow><mi>&#964;</mi></mfrac></mtd>
            </mtr>
            <mtr>
              <mtd columnalign="right"><msub><mi mathvariant="script">L</mi><mrow><mi>I</mi><mo>&#x2192;</mo><mi>T</mi></mrow></msub></mtd>
              <mtd columnalign="left"><mo>=</mo><mo>-</mo><mfrac><mn>1</mn><mi>N</mi></mfrac><munderover><mo>&#x2211;</mo><mrow><mi>i</mi><mo>=</mo><mn>1</mn></mrow><mi>N</mi></munderover><mo>log</mo><mfrac><mrow><mo>exp</mo><mo stretchy="false">(</mo><msub><mi>L</mi><mrow><mi>i</mi><mo>,</mo><mi>i</mi></mrow></msub><mo stretchy="false">)</mo></mrow><mrow><msubsup><mo>&#x2211;</mo><mrow><mi>j</mi><mo>=</mo><mn>1</mn></mrow><mi>N</mi></msubsup><mo>exp</mo><mo stretchy="false">(</mo><msub><mi>L</mi><mrow><mi>i</mi><mo>,</mo><mi>j</mi></mrow></msub><mo stretchy="false">)</mo></mrow></mfrac></mtd>
            </mtr>
            <mtr>
              <mtd columnalign="right"><msub><mi mathvariant="script">L</mi><mrow><mi>T</mi><mo>&#x2192;</mo><mi>I</mi></mrow></msub></mtd>
              <mtd columnalign="left"><mo>=</mo><mo>-</mo><mfrac><mn>1</mn><mi>N</mi></mfrac><munderover><mo>&#x2211;</mo><mrow><mi>j</mi><mo>=</mo><mn>1</mn></mrow><mi>N</mi></munderover><mo>log</mo><mfrac><mrow><mo>exp</mo><mo stretchy="false">(</mo><msub><mi>L</mi><mrow><mi>j</mi><mo>,</mo><mi>j</mi></mrow></msub><mo stretchy="false">)</mo></mrow><mrow><msubsup><mo>&#x2211;</mo><mrow><mi>i</mi><mo>=</mo><mn>1</mn></mrow><mi>N</mi></msubsup><mo>exp</mo><mo stretchy="false">(</mo><msub><mi>L</mi><mrow><mi>i</mi><mo>,</mo><mi>j</mi></mrow></msub><mo stretchy="false">)</mo></mrow></mfrac></mtd>
            </mtr>
            <mtr>
              <mtd columnalign="right"><msub><mi mathvariant="script">L</mi><mtext>CLIP</mtext></msub></mtd>
              <mtd columnalign="left"><mo>=</mo><mfrac><mn>1</mn><mn>2</mn></mfrac><mrow><mo stretchy="true">(</mo><msub><mi mathvariant="script">L</mi><mrow><mi>I</mi><mo>&#x2192;</mo><mi>T</mi></mrow></msub><mo>+</mo><msub><mi mathvariant="script">L</mi><mrow><mi>T</mi><mo>&#x2192;</mo><mi>I</mi></mrow></msub><mo stretchy="true">)</mo></mrow></mtd>
            </mtr>
          </mtable>
        </math>

        <div class="border-l-2 border-red pl-4 text-sm leading-relaxed text-muted">
          <p class="m-0 font-bold text-ink">損失函數代數機制分解：</p>
          <ul class="m-0 mt-2 list-disc pl-5 space-y-1">
            <li>
              <math class="font-serif"><mi>N</mi><mo>=</mo><mn>32</mn><mo>,</mo><mn>768</mn></math>
              ：CLIP 預訓練使用的巨大全域批次大小（透過數百張 V100 GPU 跨節點聚合）。
            </li>
            <li>
              <math class="font-serif"><mi>&#964;</mi><mo>=</mo><mo>exp</mo><mo stretchy="false">(</mo><mo>-</mo><mi>t</mi><mo stretchy="false">)</mo></math>
              ：可學習溫度參數（Learnable Temperature），控制 Softmax
              機率分佈的平滑度或銳利度，在訓練中被裁剪以防止數值溢位（
              <math class="font-serif"><mi>&#964;</mi><mo>&#x2265;</mo><mn>0.01</mn></math>）。
            </li>
            <li>
              <math class="font-serif"><msub><mi>L</mi><mrow><mi>i</mi><mo>,</mo><mi>i</mi></mrow></msub></math>
              （主對角線項目）：<math class="font-serif"><mi>N</mi></math>{' '}
              個真實配對正樣本，損失函數致力於將其數值推向極大。
            </li>
            <li>
              <math class="font-serif"><msub><mi>L</mi><mrow><mi>i</mi><mo>,</mo><mi>j</mi></mrow></msub><mspace width="0.2em"/><mo stretchy="false">(</mo><mi>i</mi><mo>&#x2260;</mo><mi>j</mi><mo stretchy="false">)</mo></math>
              （非對角線項目）：
              <math class="font-serif"><mi>N</mi><mo stretchy="false">(</mo><mi>N</mi><mo>-</mo><mn>1</mn><mo stretchy="false">)</mo></math>
              {' '} 個不匹配負樣本，分母中的指數和對其施加強烈排斥力。
            </li>
            <li>
              <math class="font-serif"><msub><mi mathvariant="script">L</mi><mrow><mi>I</mi><mo>&#x2192;</mo><mi>T</mi></mrow></msub></math>
              {' '} 與{' '}
              <math class="font-serif"><msub><mi mathvariant="script">L</mi><mrow><mi>T</mi><mo>&#x2192;</mo><mi>I</mi></mrow></msub></math>
              ：分別沿橫列（給定影像找文字）與直行（給定文字找影像）進行對稱交叉熵最佳化。
            </li>
          </ul>
        </div>

        <p>
          這項極簡的對稱 InfoNCE
          損失函數，在幾何上產生了令人驚嘆的拉力與斥力效應：在每一輪反向傳播中，同一張圖片與其對應的文字描述被一股強大的吸引力拉向超球體上的同一個幾何點；與此同時，批次中其餘
          32,767 張圖片與文字則扮演無情反例，將所有不相關的特徵相互推開。經過 4
          億對網際網路圖文的洗禮，文字空間與視覺空間的拓撲幾何終於完美熔融為一體。
        </p>
      </div>
