<script>
  // ==========================================
  // 動態實驗室交互邏輯 (CLIENT-SIDE TYPESCRIPT)
  // ==========================================
  document.addEventListener('DOMContentLoaded', () => {
    // ------------------------------------------
    // 1. Tab Switching Logic
    // ------------------------------------------
    const tabMatrix = document.getElementById('clip-tab-matrix');
    const tabZeroshot = document.getElementById('clip-tab-zeroshot');
    const panelMatrix = document.getElementById('clip-panel-matrix');
    const panelZeroshot = document.getElementById('clip-panel-zeroshot');

    if (tabMatrix && tabZeroshot && panelMatrix && panelZeroshot) {
      tabMatrix.addEventListener('click', () => {
        tabMatrix.classList.add('border-2', 'border-red', 'bg-red', 'text-surface');
        tabMatrix.classList.remove('border', 'border-ink/40', 'bg-surface', 'text-ink');
        tabMatrix.setAttribute('aria-selected', 'true');

        tabZeroshot.classList.remove('border-2', 'border-red', 'bg-red', 'text-surface');
        tabZeroshot.classList.add('border', 'border-ink/40', 'bg-surface', 'text-ink');
        tabZeroshot.setAttribute('aria-selected', 'false');

        panelMatrix.classList.remove('hidden');
        panelZeroshot.classList.add('hidden');
      });

      tabZeroshot.addEventListener('click', () => {
        tabZeroshot.classList.add('border-2', 'border-red', 'bg-red', 'text-surface');
        tabZeroshot.classList.remove('border', 'border-ink/40', 'bg-surface', 'text-ink');
        tabZeroshot.setAttribute('aria-selected', 'true');

        tabMatrix.classList.remove('border-2', 'border-red', 'bg-red', 'text-surface');
        tabMatrix.classList.add('border', 'border-ink/40', 'bg-surface', 'text-ink');
        tabMatrix.setAttribute('aria-selected', 'false');

        panelZeroshot.classList.remove('hidden');
        panelMatrix.classList.add('hidden');
      });
    }

    // ------------------------------------------
    // 2. Module 01: Matrix & InfoNCE Loss Logic
    // ------------------------------------------
    const tempSlider = document.getElementById('clip-temp-slider') as HTMLInputElement | null;
    const tempValDisplay = document.getElementById('clip-temp-val');
    const perturbSlider = document.getElementById('clip-perturb-slider') as HTMLInputElement | null;
    const perturbValDisplay = document.getElementById('clip-perturb-val');

    const presetIdealBtn = document.getElementById('clip-preset-ideal');
    const presetRandomBtn = document.getElementById('clip-preset-random');
    const presetConfusedBtn = document.getElementById('clip-preset-confused');

    const inspectInfo = document.getElementById('clip-inspect-info');
    const lossI2TDisplay = document.getElementById('clip-loss-i2t');
    const lossTotalDisplay = document.getElementById('clip-loss-total');

    const cells = document.querySelectorAll<HTMLElement>('.clip-cell');

    type PresetKey = 'ideal' | 'random' | 'confused';

    const baseMatrices: Record<PresetKey, number[][]> = {
      ideal: [
        [0.88, 0.12, 0.05, 0.1],
        [0.09, 0.91, 0.14, 0.08],
        [0.06, 0.11, 0.86, 0.15],
        [0.12, 0.07, 0.13, 0.89],
      ],
      random: [
        [0.15, 0.12, 0.08, 0.14],
        [0.11, 0.16, 0.09, 0.13],
        [0.14, 0.1, 0.15, 0.11],
        [0.09, 0.13, 0.12, 0.14],
      ],
      confused: [
        [0.65, 0.25, 0.3, 0.58],
        [0.35, 0.7, 0.42, 0.28],
        [0.22, 0.38, 0.62, 0.45],
        [0.48, 0.31, 0.39, 0.68],
      ],
    };

    let currentMatrix: number[][] = JSON.parse(JSON.stringify(baseMatrices.ideal));
    let selectedCell = { r: 0, c: 0 };

    function calculateInfoNCE() {
      const tau = parseFloat(tempSlider ? tempSlider.value : '0.07');
      if (tempValDisplay) tempValDisplay.textContent = tau.toFixed(2);

      const perturb = parseFloat(perturbSlider ? perturbSlider.value : '0.12');
      if (perturbValDisplay) perturbValDisplay.textContent = perturb.toFixed(2);

      // Apply perturbation to cell [0, 3] (I1 and T4)
      currentMatrix[0][3] = perturb;

      const N = 4;
      const logits: number[][] = [];
      for (let i = 0; i < N; i++) {
        logits[i] = [];
        for (let j = 0; j < N; j++) {
          logits[i][j] = currentMatrix[i][j] / tau;
        }
      }

      // Row-wise Softmax: P(T_j | I_i)
      const probRow: number[][] = [];
      for (let i = 0; i < N; i++) {
        probRow[i] = [];
        const maxLogit = Math.max(...logits[i]);
        let sumExp = 0;
        for (let j = 0; j < N; j++) {
          sumExp += Math.exp(logits[i][j] - maxLogit);
        }
        for (let j = 0; j < N; j++) {
          probRow[i][j] = Math.exp(logits[i][j] - maxLogit) / sumExp;
        }
      }

      // Column-wise Softmax: P(I_i | T_j)
      const probCol: number[][] = [];
      for (let j = 0; j < N; j++) {
        probCol[j] = [];
        const colLogits = [logits[0][j], logits[1][j], logits[2][j], logits[3][j]];
        const maxLogit = Math.max(...colLogits);
        let sumExp = 0;
        for (let i = 0; i < N; i++) {
          sumExp += Math.exp(logits[i][j] - maxLogit);
        }
        for (let i = 0; i < N; i++) {
          probCol[j][i] = Math.exp(logits[i][j] - maxLogit) / sumExp;
        }
      }

      // Compute losses
      let lossI2T = 0;
      let lossT2I = 0;
      for (let i = 0; i < N; i++) {
        lossI2T += -Math.log(Math.max(probRow[i][i], 1e-9));
        lossT2I += -Math.log(Math.max(probCol[i][i], 1e-9));
      }
      lossI2T /= N;
      lossT2I /= N;
      const totalLoss = (lossI2T + lossT2I) / 2;

      if (lossI2TDisplay) lossI2TDisplay.textContent = lossI2T.toFixed(3);
      if (lossTotalDisplay) lossTotalDisplay.textContent = totalLoss.toFixed(3);

      // Render Cells
      cells.forEach((cell) => {
        const r = parseInt(cell.getAttribute('data-r') || '0', 10);
        const c = parseInt(cell.getAttribute('data-c') || '0', 10);
        const sim = currentMatrix[r][c];
        const p = probRow[r][c];

        // Color intensity based on similarity
        let bgStyle: string;
        let textStyle: string;
        if (sim >= 0.7) {
          bgStyle = `rgba(217, 38, 38, ${Math.min(0.9, 0.2 + sim * 0.7)})`;
          textStyle = 'text-surface font-bold';
        } else if (sim >= 0.4) {
          bgStyle = `rgba(217, 38, 38, ${sim * 0.4})`;
          textStyle = 'text-ink font-bold';
        } else if (sim >= 0.2) {
          bgStyle = `rgba(217, 38, 38, 0.1)`;
          textStyle = 'text-ink';
        } else {
          bgStyle = 'var(--color-surface, #ffffff)';
          textStyle = 'text-muted';
        }

        cell.style.backgroundColor = bgStyle;
        cell.innerHTML = `
          <div class="${textStyle} font-mono text-sm leading-tight">${sim.toFixed(2)}</div>
          <div class="font-mono text-[11px] ${textStyle} opacity-90 mt-0.5">P: ${(p * 100).toFixed(1)}%</div>
        `;

        if (r === selectedCell.r && c === selectedCell.c) {
          cell.classList.add('ring-2', 'ring-red', 'border-red');
        } else {
          cell.classList.remove('ring-2', 'ring-red', 'border-red');
        }
      });

      // Update Inspector
      if (inspectInfo) {
        const r = selectedCell.r;
        const c = selectedCell.c;
        const sim = currentMatrix[r][c];
        const logit = logits[r][c];
        const pRow = probRow[r][c];
        const pCol = probCol[c][r];
        const isDiag = r === c;

        const rowLabels = ['I₁: 衝浪柴犬', 'I₂: 月球騎馬', 'I₃: 台北雨夜', 'I₄: 窗邊橘貓'];
        const colLabels = ['T₁: 衝浪柴犬', 'T₂: 月球騎馬', 'T₃: 台北雨夜', 'T₄: 窗邊橘貓'];

        inspectInfo.innerHTML = `
          <p class="m-0 font-display text-base font-bold text-ink">
            儲存格 [${rowLabels[r]}, ${colLabels[c]}] ${isDiag ? '（主對角線正樣本）' : '（非對角線負樣本）'}
          </p>
          <p class="m-0 font-mono text-xs text-muted">
            餘弦相似度 S: <span class="text-ink font-bold">${sim.toFixed(2)}</span> | 縮放 Logit (S/τ): <span class="text-ink font-bold">${logit.toFixed(2)}</span>
          </p>
          <p class="m-0 font-mono text-xs text-muted">
            影像到文字機率 P(T|I): <span class="text-red font-bold">${(pRow * 100).toFixed(2)}%</span> | 文字到影像機率 P(I|T): <span class="text-red font-bold">${(pCol * 100).toFixed(2)}%</span>
          </p>
        `;
      }
    }

    // Attach Cell Click
    cells.forEach((cell) => {
      cell.addEventListener('click', () => {
        const r = parseInt(cell.getAttribute('data-r') || '0', 10);
        const c = parseInt(cell.getAttribute('data-c') || '0', 10);
        selectedCell = { r, c };
        calculateInfoNCE();
      });
    });

    // Preset Buttons
    function setPreset(name: PresetKey) {
      currentMatrix = JSON.parse(JSON.stringify(baseMatrices[name]));
      if (perturbSlider) perturbSlider.value = currentMatrix[0][3].toString();

      [presetIdealBtn, presetRandomBtn, presetConfusedBtn].forEach((btn) => {
        if (!btn) return;
        btn.classList.remove('border-ink', 'bg-ink', 'text-surface');
        btn.classList.add('border-ink/40', 'bg-surface', 'text-ink');
      });

      const activeBtn =
        name === 'ideal' ? presetIdealBtn : name === 'random' ? presetRandomBtn : presetConfusedBtn;
      if (activeBtn) {
        activeBtn.classList.add('border-ink', 'bg-ink', 'text-surface');
        activeBtn.classList.remove('border-ink/40', 'bg-surface', 'text-ink');
      }

      calculateInfoNCE();
    }

    if (presetIdealBtn) presetIdealBtn.addEventListener('click', () => setPreset('ideal'));
    if (presetRandomBtn) presetRandomBtn.addEventListener('click', () => setPreset('random'));
    if (presetConfusedBtn) presetConfusedBtn.addEventListener('click', () => setPreset('confused'));

    if (tempSlider) tempSlider.addEventListener('input', calculateInfoNCE);
    if (perturbSlider) perturbSlider.addEventListener('input', calculateInfoNCE);

    calculateInfoNCE();

    // ------------------------------------------
    // 3. Module 02: Zero-Shot Decision Wind Tunnel
    // ------------------------------------------
    const imgBtns = document.querySelectorAll<HTMLElement>('.clip-img-btn');
    const promptRadios = document.querySelectorAll<HTMLInputElement>(
      'input[name="clip-prompt-mode"]',
    );
    const probBarsContainer = document.getElementById('clip-prob-bars');
    const promptDisplay = document.getElementById('clip-prompt-display');
    const insightText = document.getElementById('clip-insight-text');

    type ImageKey = 'zebra' | 'banana' | 'crane' | 'xray';
    type PromptMode = 'raw' | 'template' | 'ensemble';

    interface ZeroShotItem {
      title: string;
      candidates: string[];
      sims: Record<PromptMode, number[]>;
      insights: Record<PromptMode, string>;
    }

    let currentImgKey: ImageKey = 'zebra';
    let currentPromptMode: PromptMode = 'template';

    const zeroShotData: Record<ImageKey, ZeroShotItem> = {
      zebra: {
        title: '草原上的斑馬',
        candidates: ['zebra (斑馬)', 'horse (馬)', 'donkey (驢子)', 'tiger (老虎)'],
        sims: {
          raw: [0.72, 0.65, 0.58, 0.4],
          template: [0.86, 0.52, 0.45, 0.32],
          ensemble: [0.91, 0.48, 0.4, 0.28],
        },
        insights: {
          raw: '裸標籤模式下，"zebra" 與 "horse"、"donkey" 相似度相近（0.72 vs 0.65），模型對物種邊界判斷略帶猶豫。',
          template:
            '加入標準模板 "a photo of a zebra." 後，正類別相似度自 0.72 躍升至 0.86，馬與驢子的競爭被有效壓制，Top-1 機率大幅提升至 96%！',
          ensemble:
            '8 種情境模板集成後，模型對斑馬特徵的信心度達到 0.91，負類別機率被均勻壓至 2% 以下，展現出極致的分類強健性。',
        },
      },
      banana: {
        title: '廚房砧板切片香蕉',
        candidates: ['banana (香蕉)', 'plantain (大蕉)', 'kitchen knife (菜刀)', 'lemon (檸檬)'],
        sims: {
          raw: [0.68, 0.64, 0.55, 0.42],
          template: [0.83, 0.58, 0.46, 0.35],
          ensemble: [0.89, 0.51, 0.4, 0.3],
        },
        insights: {
          raw: '畫面中切片的黃色香蕉與大蕉極易混淆，且背景中的菜刀造成了額外的物體注意力分散。',
          template:
            '標準模板 "a photo of a banana." 明確了「主體是香蕉」的攝影意圖，菜刀的權重被自然降解為背景噪訊。',
          ensemble:
            '多模板集成有效平衡了近景特寫（close-up）與完整物件描述，香蕉的判定置信度高達 94.2%。',
        },
      },
      crane: {
        title: '白紙折成的紙鶴',
        candidates: ['origami crane (摺紙鶴)', 'crane (起重機/鶴)', 'bird (鳥類)', 'toy (玩具)'],
        sims: {
          raw: [0.45, 0.62, 0.52, 0.48],
          template: [0.65, 0.5, 0.58, 0.42],
          ensemble: [0.88, 0.38, 0.45, 0.35],
        },
        insights: {
          raw: '【多義詞翻車現場】裸標籤 "crane" 既代表工程起重機也代表鳥類，在紙鶴面前產生嚴重的語意空間撕裂，導致分類置信度混沌。',
          template:
            '模板 "a photo of a origami crane." 藉由構詞限定，將紙鶴從機械起重機與真實活鳥的雙重拉扯中成功拯救出來。',
          ensemble:
            '多提示詞集成徹底鎖定「藝術摺紙手工藝品」子空間，消除多義詞干擾，摺紙鶴以 91.5% 壓倒性勝出！',
        },
      },
      xray: {
        title: '胸部 X 光透視片',
        candidates: [
          'chest x-ray (胸透)',
          'rib cage (肋骨架)',
          'medical scan (醫療掃描)',
          'skeleton (骷髏)',
        ],
        sims: {
          raw: [0.55, 0.52, 0.5, 0.48],
          template: [0.72, 0.56, 0.6, 0.42],
          ensemble: [0.82, 0.48, 0.55, 0.36],
        },
        insights: {
          raw: '面對醫學影像這種極端分佈外（Out-of-Distribution）資料，裸標籤的餘弦相似度普遍偏低（0.50~0.55），各類別分佈平坦。',
          template:
            '透過加入醫療語境模板 "a centered photo of a chest x-ray."，大幅激發了模型在預訓練中見過的醫學圖文記憶。',
          ensemble:
            '集成策略在分佈漂移任務上展現出最大價值：將醫學掃描與胸透的分類準確率自隨機猜測邊緣提升至 85% 以上！',
        },
      },
    };

    function updateZeroShot() {
      const data = zeroShotData[currentImgKey];
      const rawSims = data.sims[currentPromptMode];
      const tau = 0.07;

      // Calculate Softmax
      const logits = rawSims.map((s: number) => s / tau);
      const maxL = Math.max(...logits);
      const exps = logits.map((l: number) => Math.exp(l - maxL));
      const sumExp = exps.reduce((a: number, b: number) => a + b, 0);
      const probs = exps.map((e: number) => e / sumExp);

      // Prompt Display Text
      if (promptDisplay) {
        if (currentPromptMode === 'raw') {
          promptDisplay.textContent = 'Prompt: "{label}" (裸標籤)';
        } else if (currentPromptMode === 'template') {
          promptDisplay.textContent = 'Prompt: "a photo of a {label}." (標準模板)';
        } else {
          promptDisplay.textContent = 'Prompt: 8-Prompt Ensemble Average (多模板集成)';
        }
      }

      // Insight Text
      if (insightText) {
        insightText.textContent = data.insights[currentPromptMode];
      }

      // Render Bars
      if (probBarsContainer) {
        probBarsContainer.innerHTML = '';
        data.candidates.forEach((cand: string, idx: number) => {
          const sim = rawSims[idx];
          const prob = probs[idx];
          const isTop = prob === Math.max(...probs);

          const barItem = document.createElement('div');
          barItem.className = 'space-y-1.5';
          barItem.innerHTML = `
            <div class="flex items-center justify-between text-xs font-mono">
              <span class="font-bold ${isTop ? 'text-red' : 'text-ink'}">${cand}</span>
              <span class="text-muted">餘弦: <strong class="text-ink">${sim.toFixed(2)}</strong> | 機率: <strong class="${isTop ? 'text-red font-bold text-sm' : 'text-ink'}">${(prob * 100).toFixed(1)}%</strong></span>
            </div>
            <div class="h-3 w-full bg-paper border border-line overflow-hidden">
              <div
                class="h-full ${isTop ? 'bg-red' : 'bg-ink/40'} transition-all duration-500"
                style="width: ${(prob * 100).toFixed(1)}%"
              ></div>
            </div>
          `;
          probBarsContainer.appendChild(barItem);
        });
      }
    }

    imgBtns.forEach((btn) => {
      btn.addEventListener('click', () => {
        imgBtns.forEach((b) => {
          b.classList.remove('border-ink', 'bg-ink', 'text-surface');
          b.classList.add('border-ink/40', 'bg-surface', 'text-ink');
        });
        btn.classList.add('border-ink', 'bg-ink', 'text-surface');
        btn.classList.remove('border-ink/40', 'bg-surface', 'text-ink');
        currentImgKey = (btn.getAttribute('data-img') as ImageKey) || 'zebra';
        updateZeroShot();
      });
    });

    promptRadios.forEach((radio) => {
      radio.addEventListener('change', (e: Event) => {
        const target = e.target as HTMLInputElement | null;
        if (target && target.checked) {
          currentPromptMode = target.value as PromptMode;
          updateZeroShot();
        }
      });
    });

    updateZeroShot();
  });
</script>
