          });
          btn.className =
            'px-3 py-1.5 font-mono text-xs font-bold bg-ink text-surface transition cursor-pointer';
          panel.classList.remove('hidden');
        });
      });

      // 3. RoPE 2D Complex Plane Geometry
      const ropeMSlider = document.getElementById('llama-rope-m') as HTMLInputElement | null;
      const ropeNSlider = document.getElementById('llama-rope-n') as HTMLInputElement | null;
      const ropeDimSlider = document.getElementById('llama-rope-dim') as HTMLInputElement | null;

      const ropeMVal = document.getElementById('llama-rope-m-val');
      const ropeNVal = document.getElementById('llama-rope-n-val');
      const ropeDimVal = document.getElementById('llama-rope-dim-val');

      const ropeDelta = document.getElementById('llama-rope-delta');
      const ropeAngle = document.getElementById('llama-rope-angle');
      const ropeAttn = document.getElementById('llama-rope-attn');

      const vecQ = document.getElementById('llama-vec-q');
      const ptQ = document.getElementById('llama-pt-q');
      const lblQ = document.getElementById('llama-lbl-q');

      const vecK = document.getElementById('llama-vec-k');
      const ptK = document.getElementById('llama-pt-k');
      const lblK = document.getElementById('llama-lbl-k');

      const arcDiff = document.getElementById('llama-arc-diff');

      const thetas = [1.0, 0.7499, 0.5623, 0.4217];

      function updateRope() {
        if (!ropeMSlider || !ropeNSlider || !ropeDimSlider) return;

        const m = parseInt(ropeMSlider.value, 10);
        const n = parseInt(ropeNSlider.value, 10);
        const dimIdx = parseInt(ropeDimSlider.value, 10);

        const theta = thetas[dimIdx - 1] || 1.0;

        if (ropeMVal) ropeMVal.textContent = m.toString();
        if (ropeNVal) ropeNVal.textContent = n.toString();
        if (ropeDimVal) {
          const labels = ['i = 1 (最高頻)', 'i = 2 (中高頻)', 'i = 3 (中低頻)', 'i = 4 (最低頻)'];
          ropeDimVal.textContent = labels[dimIdx - 1];
        }

        const deltaPos = m - n;
        const deltaPhi = deltaPos * theta;
        const cosAttn = Math.cos(deltaPhi);

        if (ropeDelta) ropeDelta.textContent = (deltaPos > 0 ? '+' : '') + deltaPos.toString();
        if (ropeAngle) ropeAngle.textContent = `${deltaPhi.toFixed(2)} rad`;
        if (ropeAttn) {
          ropeAttn.textContent = (cosAttn > 0 ? '+' : '') + cosAttn.toFixed(3);
          ropeAttn.className = `text-base ${cosAttn >= 0 ? 'text-emerald-700' : 'text-red'} font-bold`;
        }

        // 2D Rotation Coordinates (Center: 160, 140; Radius: 95)
        const cx = 160;
        const cy = 140;
        const r = 95;

        const phiM = m * theta;
        const phiN = n * theta;

        const qx = cx + r * Math.cos(phiM);
        const qy = cy - r * Math.sin(phiM);

        const kx = cx + r * Math.cos(phiN);
        const ky = cy - r * Math.sin(phiN);

        if (vecQ) {
          vecQ.setAttribute('x2', qx.toFixed(1));
          vecQ.setAttribute('y2', qy.toFixed(1));
        }
        if (ptQ) {
          ptQ.setAttribute('cx', qx.toFixed(1));
          ptQ.setAttribute('cy', qy.toFixed(1));
        }
        if (lblQ) {
          lblQ.setAttribute('x', (qx + 8).toFixed(1));
          lblQ.setAttribute('y', (qy - 5).toFixed(1));
          lblQ.textContent = `R(${m}) q`;
        }

        if (vecK) {
          vecK.setAttribute('x2', kx.toFixed(1));
          vecK.setAttribute('y2', ky.toFixed(1));
        }
        if (ptK) {
          ptK.setAttribute('cx', kx.toFixed(1));
          ptK.setAttribute('cy', ky.toFixed(1));
        }
        if (lblK) {
          lblK.setAttribute('x', (kx - 25).toFixed(1));
          lblK.setAttribute('y', (ky + 15).toFixed(1));
          lblK.textContent = `R(${n}) k`;
        }

        // Connect arc between the two angles
        if (arcDiff) {
          const arcR = 45;
          const arcStartAngle = phiN;
          const arcEndAngle = phiM;
          const startX = cx + arcR * Math.cos(arcStartAngle);
          const startY = cy - arcR * Math.sin(arcStartAngle);
          const endX = cx + arcR * Math.cos(arcEndAngle);
          const endY = cy - arcR * Math.sin(arcEndAngle);

          const largeArc = Math.abs(arcEndAngle - arcStartAngle) > Math.PI ? 1 : 0;
          const sweep = arcEndAngle > arcStartAngle ? 0 : 1;

          arcDiff.setAttribute(
            'd',
            `M ${startX.toFixed(1)} ${startY.toFixed(1)} A ${arcR} ${arcR} 0 ${largeArc} ${sweep} ${endX.toFixed(1)} ${endY.toFixed(1)}`,
          );
        }
      }

      if (ropeMSlider && ropeNSlider && ropeDimSlider) {
        ropeMSlider.addEventListener('input', updateRope);
        ropeNSlider.addEventListener('input', updateRope);
        ropeDimSlider.addEventListener('input', updateRope);
        updateRope();
      }

      // 4. Module 2: Inference Economics & Over-Training TCO
      const queriesSlider = document.getElementById(
        'llama-queries-slider',
      ) as HTMLInputElement | null;
      const tokensSlider = document.getElementById(
        'llama-tokens-slider',
      ) as HTMLInputElement | null;

      const queriesVal = document.getElementById('llama-queries-val');
      const tokensVal = document.getElementById('llama-tokens-val');

      const tcoGpt3 = document.getElementById('llama-tco-gpt3');
      const tco65b = document.getElementById('llama-tco-65b');
      const tco13b = document.getElementById('llama-tco-13b');
      const tco7b = document.getElementById('llama-tco-7b');

      const econIndicator = document.getElementById('llama-econ-indicator');
      const indicatorLabel = document.getElementById('llama-indicator-label');

      function formatMoney(n: number): string {
        if (n >= 1000000) {
          return `$${(n / 1000000).toFixed(2)}M`;
        }
        return `$${Math.round(n).toLocaleString('en-US')}`;
      }

      function updateEconomics() {
        if (!queriesSlider || !tokensSlider) return;

        const logQ = parseFloat(queriesSlider.value);
        const qCount = Math.pow(10, logQ);
        const tokenLen = parseInt(tokensSlider.value, 10);

        if (queriesVal) {
          const labelText =
            logQ < 6
              ? `${Math.round(qCount / 1000)} 萬次`
              : logQ < 8
                ? `${(qCount / 1000000).toFixed(1)} 百萬次`
                : `${(qCount / 100000000).toFixed(1)} 億次`;
          queriesVal.textContent = `${Math.round(qCount).toLocaleString('en-US')} (${labelText})`;
        }
        if (tokensVal) tokensVal.textContent = `${tokenLen} tokens`;

        // TCO Calculation:
        // Training fixed cost ($):
        // GPT-3 175B: 300B tokens -> ~ $380,000
        // LLaMA 65B: 1.4T tokens -> ~ $655,000
        // LLaMA 13B: 1.0T tokens -> ~ $95,000
        // LLaMA 7B: 1.0T tokens -> ~ $48,000

        // Marginal inference cost per query:
        // GPT-3: 175B parameters * 2 * tokenLen FLOPs -> ~$0.025 per 1K tokens
        const costPerK_GPT3 = 0.024;
        const costPerK_65B = 0.0072;
        const costPerK_13B = 0.0014;
        const costPerK_7B = 0.00075;

        const totalGPT3 = 380000 + qCount * (tokenLen / 1000) * costPerK_GPT3;
        const total65B = 655000 + qCount * (tokenLen / 1000) * costPerK_65B;
        const total13B = 95000 + qCount * (tokenLen / 1000) * costPerK_13B;
        const total7B = 48000 + qCount * (tokenLen / 1000) * costPerK_7B;

        if (tcoGpt3) tcoGpt3.textContent = formatMoney(totalGPT3);
        if (tco65b) tco65b.textContent = formatMoney(total65B);
        if (tco13b) tco13b.textContent = formatMoney(total13B);
        if (tco7b) tco7b.textContent = formatMoney(total7B);

        // Calculate savings percentage
        const savings = Math.max(0, ((totalGPT3 - total13B) / totalGPT3) * 100);

        // Update SVG Indicator Position
        // X maps logQ from 5 (60px) to 9 (760px)
        const posX = 60 + ((logQ - 5) / 4) * 700;

        // Y maps log-cost of GPT-3 from $50K (220) to $10M (30)
        // Log10 scale: $50K = 4.7, $10M = 7.0
        const logCost = Math.log10(Math.max(50000, Math.min(15000000, totalGPT3)));
        const posY = 220 - ((logCost - 4.7) / (7.0 - 4.7)) * 190;

        if (econIndicator) {
          econIndicator.setAttribute(
            'transform',
            `translate(${posX.toFixed(1)}, ${posY.toFixed(1)})`,
          );
        }
        if (indicatorLabel) {
          indicatorLabel.textContent = `省下 ${savings.toFixed(1)}% 成本`;
        }
      }

      if (queriesSlider && tokensSlider) {
        queriesSlider.addEventListener('input', updateEconomics);
        tokensSlider.addEventListener('input', updateEconomics);
        updateEconomics();
      }
    });
  </script>
</BaseLayout>
