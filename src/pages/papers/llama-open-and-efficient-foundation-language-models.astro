      // 2. Sub-Tab Switching inside Architecture (RoPE vs RMSNorm vs SwiGLU)
      const subtabRope = document.getElementById('llama-subtab-rope');
      const subtabNorm = document.getElementById('llama-subtab-norm');
      const subtabSwiglu = document.getElementById('llama-subtab-swiglu');
