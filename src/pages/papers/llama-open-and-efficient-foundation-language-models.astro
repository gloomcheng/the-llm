      const subpanelSwiglu = document.getElementById('llama-subpanel-swiglu');

      const subtabs = [
        { btn: subtabRope, panel: subpanelRope },
        { btn: subtabNorm, panel: subpanelNorm },
        { btn: subtabSwiglu, panel: subpanelSwiglu },
      ];

      subtabs.forEach(({ btn, panel }) => {
        if (!btn || !panel) return;
        btn.addEventListener('click', () => {
          subtabs.forEach((item) => {
            if (item.btn && item.panel) {
              item.btn.className =
                'px-3 py-1.5 font-mono text-xs font-medium border border-line bg-surface text-ink hover:border-ink transition cursor-pointer';
              item.panel.classList.add('hidden');
