  <script>
    document.addEventListener('DOMContentLoaded', () => {
      // 1. Main Tab Switching (Architecture vs Inference Economics)
      const tabArch = document.getElementById('llama-tab-arch');
      const tabEcon = document.getElementById('llama-tab-econ');
      const panelArch = document.getElementById('llama-panel-arch');
      const panelEcon = document.getElementById('llama-panel-econ');

