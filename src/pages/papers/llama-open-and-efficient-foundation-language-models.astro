---
import BaseLayout from '../../layouts/BaseLayout.astro';
import { withBase } from '../../lib/paths';
import StoryRail from '../../components/StoryRail.astro';
import PaperReadingLayout from '../../components/PaperReadingLayout.astro';
import AsideCard from '../../components/AsideCard.astro';
import Callout from '../../components/Callout.astro';
import AuthorGrid from '../../components/AuthorGrid.astro';
import EvidenceList from '../../components/EvidenceList.astro';
import PaperMeta from '../../components/PaperMeta.astro';
import PaperNavigation from '../../components/PaperNavigation.astro';
import {
  paper,
  llamaSources,
} from '../../content/papers/llama-open-and-efficient-foundation-language-models';

const shell = 'mx-auto w-[calc(100%-2rem)] max-w-[1120px]';

const story = [
  {
    year: '2022.03',
    label: '理論基石 / CHINCHILLA',
    title: 'Chinchilla 揭示算力分配黃金律：大模型普遍嚴重缺乏數據餵養',
    body: 'DeepMind 證實模型參數量與訓練 token 數應等比例擴展，打破盲目堆疊參數的舊慣性，為數據驅動預訓練奠定根基。',
    status: 'past' as const,
  },
  {
    year: '2022.11',
    label: '閉源壟斷 / CHATGPT',
    title: 'ChatGPT 席捲全球，前沿模型被嚴密鎖在黑盒 API 圍牆之後',
    body: '科技巨頭將頂尖權重封存於雲端伺服器，全球學術界與獨立開發者陷入無法審查、無法本地運行的集體失語。',
    status: 'past' as const,
  },
  {
    year: '2023.02',
    label: '論文發表 / LLAMA',
    title: 'Meta 發表 LLaMA：以推論最佳化與公開資料打破閉源壁壘',
    body: 'Hugo Touvron 等人以 1.4 兆純公開 token 訓練 7B 至 65B 高效模型，13B 擊敗 GPT-3，並向全球學界開放權重。',
    status: 'current' as const,
  },
  {
    year: '2023.03+',
    label: '開源爆發 / CAMBRIAN',
    title: '權重外洩與全生態繁榮：llama.cpp、Alpaca 與本地推論革命',
    body: '社群在數週內攻克量化微調與本機運行，開源生態以燎原之勢打破閉源壟斷，開啟大模型大航海時代。',
    status: 'future' as const,
  },
];

interface TimelineEpoch {
  id: string;
  year: string;
  period: string;
  title: string;
  summary: string;
  sources: Array<{
    source: (typeof llamaSources)[number];
    num: number;
    refCode: string;
    featured?: boolean;
    role: string;
    takeaway: string;
  }>;
}

const timelineEpochs: TimelineEpoch[] = [
  {
    id: 'epoch-2019-2021-architecture',
    year: '2019-2021',
    period: '現代 Transformer 架構三大基石的醞釀',
    title: 'RMSNorm、SwiGLU 與旋轉位置編碼的工程奠基',
    summary:
      '在千億參數量的大規模訓練中，傳統 Post-LayerNorm 梯度不穩、經典 ReLU/GELU 活化表達力受限、以及絕對位置編碼無法外推的問題相繼浮現。Biao Zhang、Noam Shazeer 與 Jianlin Su 等學者分別獨立提出了針對標準化、前饋網路與位置編碼的革命性改進。',
    sources: [
      {
        source: llamaSources.find((s) => s.id === 'paper-2019-rmsnorm')!,
        num: 1,
        refCode: 'S01',
        featured: true,
        role: '標準化革新',
        takeaway:
          '證明去除 LayerNorm 的均值位移僅保留均方根縮放，能在完全保持訓練收斂特性的同時，降低高達 7% 至 64% 的標準化運算開銷。',
      },
      {
        source: llamaSources.find((s) => s.id === 'paper-2020-swiglu')!,
        num: 2,
        refCode: 'S02',
        role: '前饋門控',
        takeaway:
          '將 Swish 激勵函數與門控線性單元（GLU）結合，提供更平滑的梯度傳遞與更豐富的非線性表徵能力。',
      },
      {
        source: llamaSources.find((s) => s.id === 'paper-2021-rope')!,
        num: 3,
        refCode: 'S03',
        featured: true,
        role: '幾何位置編碼',
        takeaway:
          '以二維複數平面正交旋轉矩陣將絕對位置注入 Query 與 Key，內積天然保持相對距離衰減性，為長文本建模奠定幾何理論基礎。',
      },
    ],
  },
  {
    id: 'epoch-2022-compute-optimal',
    year: '2022',
    period: '計算最佳化與數據驅動的覺醒',
    title: 'Chinchilla 定律：大模型普遍缺乏數據餵養',
    summary:
      'DeepMind 在 2022 年發表 Chinchilla，徹底顛覆了 Kaplan 早期過度偏向參數量擴展的結論。研究指出在固定算力預算下，參數量與訓練 token 數應當以 1:1 的同等比例增長。',
    sources: [
      {
        source: llamaSources.find((s) => s.id === 'paper-2022-chinchilla')!,
        num: 4,
        refCode: 'S04',
        featured: true,
        role: '理論淵源',
        takeaway:
          '70B 參數的 Chinchilla 搭配 1.4 兆 token 完勝 280B 的 Gopher，直接啟發了 LLaMA 團隊將海量 token 灌注於小巧模型的推論最佳化設計哲學。',
      },
    ],
  },
  {
    id: 'epoch-2023-llama',
    year: '2023.02',
    period: '開源大模型與推論經濟學的歷史分水嶺',
    title: 'LLaMA：以公開資料訓練的高效開源基礎模型',
    summary:
      'Meta AI 的 Hugo Touvron 等人發表 LLaMA 系列，不僅全面整合 RMSNorm、SwiGLU 與 RoPE 三大結構優勢，更貫徹「推論成本最佳化」的過訓練哲學，並將權重向學術界開放，引發全球開源生態大爆炸。',
    sources: [
      {
        source: llamaSources.find((s) => s.id === 'paper-2023-llama')!,
        num: 5,
        refCode: 'S05',
        featured: true,
        role: '本篇核心',
        takeaway:
          '13B 參數模型在常識推理與問答基準測試上全面追平並超越 175B 的 GPT-3，證明純公開資料足以孕育頂尖智慧，徹底打破閉源巨頭的壟斷神話。',
      },
    ],
  },
];
---

<BaseLayout title={`${paper.chineseTitle} | THE LLM`} description={paper.abstractSummary}>
  <header class={`${shell} pt-10`}>
    <div class="flex gap-3 font-mono text-sm uppercase tracking-[0.08em] text-muted">
      <a class="text-red underline underline-offset-4" href={withBase('/')}>
        THE LLM
      </a>
      <span aria-hidden="true">/</span>
      <span>第 09 章</span>
    </div>

    <div class="grid grid-cols-1 items-end gap-12 py-16 lg:grid-cols-[1.15fr_0.85fr] lg:gap-24">
      <div>
        <p class="mb-5 font-mono text-sm font-semibold uppercase tracking-[0.12em] text-red">
          VOL. 09 / OPEN FOUNDATION
        </p>

        <h1 class="m-0 font-display text-4xl sm:text-5xl lg:text-6xl xl:text-7xl leading-tight tracking-[-0.04em] text-ink">
          <span class="block">LLaMA: Open and Efficient</span>
          <em class="block">Foundation Language Models</em>
        </h1>

        <p class="mt-8 max-w-[52ch] text-lg leading-8 text-muted">
          當科技巨頭紛紛將千億大模型深鎖於黑盒 API 與高昂計費的圍牆花園之後，Meta AI
          反其道而行：以純粹公開的數兆語料、極致過訓練的推論經濟學，以及現代 Transformer
          三大架構基石，打造出能在單張消費級顯示卡上運行的開源基座。這不僅是一篇論文，更是引爆全球開源大航海時代的普羅米修斯之火。
        </p>
      </div>

      <aside class="space-y-6">
        <div class="border border-line bg-surface p-6 sm:p-8">
          <p class="mb-2 font-mono text-xs font-semibold uppercase tracking-wider text-red">
            歷史定錨 / HISTORICAL ANCHOR
          </p>
          <h2 class="m-0 font-display text-2xl text-ink">推論經濟學與開源大爆炸</h2>
          <p class="mt-3 text-sm leading-relaxed text-muted">
            2023 年初，GPT-3 與 ChatGPT
            樹立了強大能力的標竿，卻也讓全球學術界面臨前所未有的「算力殖民」：研究者無法檢視模型權重、無法審查訓練資料、無法進行可重現的機械式可解釋性實驗。LLaMA
            的問世，以 13B 擊敗 175B 的震撼實證，證明了「小模型 +
            海量資料」才是通往下游工業落地與學術平權的真正坦途。
          </p>
        </div>
      </aside>
    </div>

    <PaperMeta
      year={paper.year}
      venue={paper.venue}
      readTime="32 分鐘"
      difficulty="進階 · 系統架構與推論最佳化"
      doi={paper.doi}
    />
  </header>

  <main id="main-content">
    <!-- 歷史縱深導航條 (STORY RAIL) -->
    <section class="border-t border-ink py-12" aria-label="歷史縱深導向">
      <div class={shell}>
        <div class="mb-8">
          <p class="mb-2 font-mono text-xs font-bold uppercase tracking-[0.14em] text-red">
            歷史長河 / THE CHRONOLOGY
          </p>
          <h2 class="m-0 font-display text-2xl sm:text-3xl text-ink">
            從閉源圍牆與黑盒霸權，到推論經濟學引領的開源大航海
          </h2>
        </div>
        <StoryRail events={story} />
      </div>
    </section>

    <!-- 章節 01: 巨頭圍牆與推論經濟學的覺醒 (ZONE A) -->
    <section
      id="inference-economics"
      class={`${shell} border-t border-ink py-16 sm:py-20 lg:py-24 scroll-mt-24`}
      aria-labelledby="inference-economics-title"
    >
      <div class="mb-12 flex flex-col gap-6 lg:flex-row lg:items-end lg:justify-between">
        <div>
          <p class="mb-4 font-mono text-sm font-semibold uppercase tracking-[0.12em] text-red">
            章節 01 · 巨頭圍牆與推論經濟學的覺醒 / THE INFERENCE DIVIDEND & OPEN FOUNDATION
          </p>
          <h2
            id="inference-economics-title"
            class="m-0 font-display text-3xl sm:text-4xl lg:text-5xl leading-tight tracking-tight text-ink"
          >
            <span class="block">算力分配的隱藏盲點：</span>
            <span class="block">
              <em>當單次訓練成本遇上下游億萬次推論</em>
            </span>
          </h2>
        </div>
        <p class="m-0 max-w-[34ch] text-base leading-8 text-muted">
          Chinchilla 追求單次訓練損失最佳化，LLaMA 則以極致過訓練換取終身微薄的推論成本。
        </p>
      </div>

      <PaperReadingLayout class="text-base leading-8 text-ink">
        <div class="space-y-6">
          <p>
            2022 年底，人工智慧領域正沉浸在一場前所未有的狂歡之中。ChatGPT
            的爆發讓全世界驚嘆於大語言模型的驚人對話能力與推理火花，但繁榮的表象背後，全球人工智慧學界卻陷入了集體的深層焦慮。
          </p>

          <p>
            以 OpenAI 為代表的科技巨頭，將這些最強大的基座模型嚴密鎖在雲端 API
            的收費黑盒之後。研究人員輸入一段文字、繳納每千個 token
            數美分的費用，換取一段由未公開權重所吐出的機率預測。你無法看到神經網路內部數百層的活化狀態，無法驗證某個偏見究竟來自預訓練語料還是對齊微調，更無法將模型下載至自己的實驗室伺服器上進行架構魔改或逆向剖析。更嚴峻的是，許多前沿論文所宣稱的卓越表現，皆建立在「私有書籍資料集」或「專利過濾管線」等無法被第三方獨立重現的黑箱之上。人工智慧研究，似乎正在不可逆地蛻變為少數矽谷科技巨擘的特權遊戲。
          </p>

          <Callout variant="paper" class="my-6">
            <p class="m-0 text-sm sm:text-base leading-relaxed text-ink">
              <strong>核心困局：</strong>
              如果研究者連模型權重都無法儲存於本機硬碟，科學界最引以為傲的「獨立驗證」與「機械性可解釋性研究」將名存實亡。全球數千所大學與獨立實驗室，正在淪為科技巨頭雲端服務的終端付費用戶。
            </p>
          </Callout>

          <h3 class="font-display text-2xl text-ink pt-4">
            Chinchilla 的盲點：CapEx 與 OpEx 的世紀拉鋸
          </h3>

          <p>
            正當整個業界盲目相信「模型越大越好」，爭先恐後訓練 280B 的 Gopher 甚至 530B 的
            Megatron-Turing NLG 時，DeepMind 的
            <a
              href={withBase('/papers/training-compute-optimal-large-language-models')}
              class="font-medium text-ink underline decoration-line/80 underline-offset-4 transition-colors hover:text-red hover:decoration-red"
            >
              Chinchilla
            </a>
            論文宛如一記警鐘，指出參數量與訓練 token 應以 1:1 平衡擴展。然而，Meta AI 的 Hugo
            Touvron 團隊敏銳地指出了 Chinchilla 擴展定律背後被所有人忽略的致命假設：
            <strong>Chinchilla 定義的「最佳化」，僅僅是「單次預訓練算力預算下的損失最佳化」</strong>
            。
          </p>

          <p>
            在真實的工業與學術運作中，訓練一個模型是一次性的資本支出（Capital Expenditure,
            CapEx）；然而，模型一旦被部署上線，它將在數個月甚至數年的生命週期中承載數千萬、數億次前向推論查詢。這後續日復一日所消耗的雲端電費、GPU
            租賃費與延遲等待，是永無止境的營運成本（Operational Expenditure, OpEx）。
          </p>

          <p>
            試設想：如果為追求單次訓練的算力最佳化，訓練了一個 175B
            的模型，那麼在往後的每一次推論中，即使使用者只問一句「早安」，伺服器也必須將 1750
            億個參數完整從 High Bandwidth Memory（HBM）載入至計算核心一次。這意味著至少需要 8
            張昂貴的 80GB A100 GPU 透過高速 NVLink 組成張量並行（Tensor
            Parallelism），才能勉強跑起一次推論！
          </p>

          <!-- 圖表 1: 訓練 CapEx vs 終身推論 OpEx 權衡曲線 -->
          <figure
            class="my-8 rounded border border-line bg-surface p-4 sm:p-6"
            role="img"
            aria-labelledby="capex-opex-fig-title"
          >
            <div class="border-b border-line/60 pb-3 mb-4">
              <span class="font-mono text-xs font-bold uppercase tracking-wider text-red">
                圖 1 · 架構決策分析 / THE INFERENCE-OPTIMAL TRADEOFF
              </span>
              <figcaption id="capex-opex-fig-title" class="mt-1 font-display text-lg text-ink">
                預訓練算力（CapEx）與累積推論成本（OpEx）的生命週期總量對比
              </figcaption>
            </div>

            <div class="space-y-4">
              <svg
                viewBox="0 0 900 480"
                class="w-full h-auto"
                fill="none"
                stroke="currentColor"
                aria-label="CapEx 與 OpEx 成本曲線圖"
              >
                <title>推論最佳化過訓練與 Chinchilla 最佳化配置在生命週期中的總成本曲線對比</title>
                <desc>
                  橫軸表示下游推論請求次數，縱軸表示總算力支出。Chinchilla 175B
                  起始訓練成本低但推論斜率極陡，LLaMA 13B
                  起始過訓練成本稍高但推論斜率極為平緩，在跨過數千萬次請求後總成本優勢呈幾何級放大。
                </desc>

                <!-- 頂部圖例區 -->
                <g class="font-sans">
                  <!-- 175B 圖例 -->
                  <line
                    x1="140"
                    y1="32"
                    x2="175"
                    y2="32"
                    stroke="#b6412c"
                    stroke-width="3"
                    stroke-linecap="round"
                  />
                  <circle cx="157" cy="32" r="4.5" fill="#b6412c" />
                  <text x="185" y="36" font-size="12" font-weight="bold" fill="#b6412c">
                    175B 傳統巨型模型
                  </text>
                  <text x="310" y="36" font-size="11" fill="#62665f">
                    （訓練 300B Tokens · 起始 CapEx 較低，但每查詢推論極昂貴）
                  </text>

                  <!-- LLaMA 13B 圖例 -->
                  <line
                    x1="140"
                    y1="56"
                    x2="175"
                    y2="56"
                    stroke="#355b70"
                    stroke-width="3"
                    stroke-linecap="round"
                  />
                  <circle cx="157" cy="56" r="4.5" fill="#355b70" />
                  <text x="185" y="60" font-size="12" font-weight="bold" fill="#355b70">
                    LLaMA 13B 推論最佳化
                  </text>
                  <text x="330" y="60" font-size="11" fill="#62665f">
                    （過訓練 1.0 兆 Tokens · 起始 CapEx 偏高，但每查詢節省 ~13.5×）
                  </text>
                </g>

                <!-- 網格參考線 -->
                <line
                  x1="140"
                  y1="120"
                  x2="650"
                  y2="120"
                  stroke="#d6cec0"
                  stroke-dasharray="3 3"
                  stroke-width="1"
                />
                <line
                  x1="140"
                  y1="180"
                  x2="650"
                  y2="180"
                  stroke="#d6cec0"
                  stroke-dasharray="3 3"
                  stroke-width="1"
                />
                <line
                  x1="140"
                  y1="240"
                  x2="650"
                  y2="240"
                  stroke="#d6cec0"
                  stroke-dasharray="3 3"
                  stroke-width="1"
                />
                <line
                  x1="140"
                  y1="300"
                  x2="650"
                  y2="300"
                  stroke="#d6cec0"
                  stroke-dasharray="3 3"
                  stroke-width="1"
                />

                <!-- 座標軸線 -->
                <line x1="140" y1="90" x2="140" y2="360" stroke="#1e2224" stroke-width="1.5" />
                <line x1="140" y1="360" x2="655" y2="360" stroke="#1e2224" stroke-width="1.5" />
                <polygon points="140,84 136,94 144,94" fill="#1e2224" />
                <polygon points="660,360 650,356 650,364" fill="#1e2224" />

                <!-- Y 軸標籤與 CapEx 刻度 -->
                <text
                  x="130"
                  y="82"
                  text-anchor="end"
                  font-family="monospace"
                  font-size="11"
                  font-weight="bold"
                  fill="#1e2224"
                >
                  總算力支出 (FLOPs)
                </text>
                <circle cx="140" cy="295" r="4.5" fill="#b6412c" />
                <text
                  x="130"
                  y="299"
                  text-anchor="end"
                  font-family="monospace"
                  font-size="11"
                  font-weight="bold"
                  fill="#b6412c"
                >
                  175B CapEx
                </text>
                <circle cx="140" cy="235" r="4.5" fill="#355b70" />
                <text
                  x="130"
                  y="239"
                  text-anchor="end"
                  font-family="monospace"
                  font-size="11"
                  font-weight="bold"
                  fill="#355b70"
                >
                  13B CapEx (過訓練)
                </text>
                <text
                  x="130"
                  y="364"
                  text-anchor="end"
                  font-family="monospace"
                  font-size="11"
                  fill="#62665f"
                >
                  0
                </text>

                <!-- 曲線 1: 傳統 175B 模型 (陡峭 OpEx 斜率) -->
                <path
                  d="M 140 295 L 350 213 L 650 95"
                  stroke="#b6412c"
                  stroke-width="3"
                  stroke-linecap="round"
                />
                <!-- 曲線 2: LLaMA 13B 模型 (平緩 OpEx 斜率) -->
                <path
                  d="M 140 235 L 350 213 L 650 181"
                  stroke="#355b70"
                  stroke-width="3"
