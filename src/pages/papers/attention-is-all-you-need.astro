---
import BaseLayout from '../../layouts/BaseLayout.astro';
import { withBase } from '../../lib/paths';
import PaperMeta from '../../components/PaperMeta.astro';
import PaperReadingLayout from '../../components/PaperReadingLayout.astro';
import StoryRail from '../../components/StoryRail.astro';
import AuthorGrid from '../../components/AuthorGrid.astro';
import PaperNavigation from '../../components/PaperNavigation.astro';
import Callout from '../../components/Callout.astro';
import {
  attentionIsAllYouNeed,
  attentionSources,
} from '../../content/papers/attention-is-all-you-need';

const paper = attentionIsAllYouNeed;
const shell = 'mx-auto w-[calc(100%-2rem)] max-w-[1120px]';
const paperUrl = `https://arxiv.org/abs/${paper.arxivId}`;
const sourceMap: Record<string, (typeof attentionSources)[number]> = Object.fromEntries(
  attentionSources.map((source) => [source.id, source]),
);
const sourceKindMeta: Record<string, { label: string; badge: string }> = {
  paper: {
    label: '一手論文 / DIRECT PAPER',
    badge: 'border border-blue/30 bg-blue/10 text-blue',
  },
  'authorial-account': {
    label: '官方解析 / OFFICIAL REPORT',
    badge: 'border border-amber-600/30 bg-amber-500/10 text-amber-800',
  },
  interview: {
    label: '口述訪談 / INTERVIEW',
    badge: 'border border-red/30 bg-red/10 text-red',
  },
  'later-history': {
    label: '同儕評審 / REVIEW RECORD',
    badge: 'border border-emerald-700/30 bg-emerald-700/10 text-emerald-800',
  },
};

const story = [
  {
    year: '之前',
    label: '問題 / THE PROBLEM',
    title: '翻譯遇到記憶問題',
    body: 'RNN 一個 token 接一個 token 地讀。句子一長，訓練就變慢，也更難記住前面的內容。',
    status: 'past' as const,
  },
  {
    year: '2017',
    label: '論文 / THE PAPER',
    title: 'Attention 成為架構的核心',
    body: 'Transformer 讓每個 token 直接查看其他 token，再一次處理許多位置。',
    status: 'current' as const,
  },
  {
    year: '之後',
    label: '後果 / THE CONSEQUENCE',
    title: '同一個架構，後來擴展成語言模型',
    body: '後來的研究保留 Transformer，改變訓練目標，再把模型規模拉高。',
    status: 'future' as const,
  },
];

interface TimelineSourceItem {
  refCode: string;
  source: (typeof attentionSources)[number];
  isFeatured?: boolean;
}

interface TimelineEpoch {
  id: string;
  year: string;
  epochNumber: string;
  title: string;
  subtitle: string;
  summary: string;
  sources: TimelineSourceItem[];
}

const timelineEpochs: TimelineEpoch[] = [
  {
    id: 'epoch-2014',
    year: '2014',
    epochNumber: '01',
    title: '循環神經網路的記憶極限，與初步對齊嘗試',
    subtitle: 'THE RECURRENT BOTTLENECK & SOFT ALIGNMENT',
    summary:
      '在 Transformer 出現三年前，神經機器翻譯（NMT）的主流是 RNN/LSTM。模型必須把整句長度不一的文字硬塞進一個固定長度的中間向量，造成嚴重的長句遺忘。研究者開始嘗試用注意力機制在解碼時動態「對齊」來源詞。',
    sources: [
      {
        refCode: 'S05',
        source: sourceMap['paper-2014-align-translate'],
      },
      {
        refCode: 'S04',
        source: sourceMap['paper-2014-seq2seq'],
      },
    ],
  },
  {
    id: 'epoch-2015',
    year: '2015',
    epochNumber: '02',
    title: '注意力機制的工程分流，與循環枷鎖未解',
    subtitle: 'GLOBAL VS. LOCAL ATTENTION & PERSISTENT RECURRENCE',
    summary:
      '注意力機制被證實能大幅改善長句翻譯，但當時的研究仍將其視為 RNN 的「輔助外掛」。模型骨幹依然依賴逐步疊加的循環計算，無法平行加速，計算等待依然存在。',
    sources: [
      {
        refCode: 'S06',
        source: sourceMap['paper-2015-attention-nmt'],
      },
    ],
  },
  {
    id: 'epoch-2017',
    year: '2017',
    epochNumber: '03',
    title: '典範轉移：完全拋棄循環，全自注意力橫空出世',
    subtitle: 'PARADIGM SHIFT: SELF-ATTENTION AS THE SOLE ENGINE',
    summary:
      'Google Brain 團隊做出大膽的減法決策：徹底拋棄循環與卷積結構，僅依靠 Self-Attention 與 Multi-Head 機制建立全平行化矩陣運算。這篇論文直接奠定了日後大語言模型（LLM）的全球基石。',
    sources: [
      {
        refCode: 'S01',
        source: sourceMap['paper-2017-arxiv'],
        isFeatured: true,
      },
      {
        refCode: 'S02',
        source: sourceMap['google-uszkoreit-2017'],
      },
      {
        refCode: 'S08',
        source: sourceMap['paper-review-record'],
      },
    ],
  },
  {
    id: 'epoch-2023',
    year: '2023–2024',
    epochNumber: '04',
    title: '大模型浪潮下的回顧：多晶片擴展與硬體協同',
    subtitle: 'RETROSPECTIVE INSIGHTS: MULTI-CHIP SCALING & HARDWARE CO-DESIGN',
    summary:
      '從當初單純為了提升 Google 翻譯訓練速度的工程嘗試，到數年後驅動全球生成式 AI 洪流。共同作者 Aidan Gomez 在多場歷史專訪中，還原了早期的原始動機與 Transformer 跨多晶片擴展的硬體本質。',
    sources: [
      {
        refCode: 'S03',
        source: sourceMap['gomez-time-2023'],
      },
      {
        refCode: 'S07',
        source: sourceMap['gomez-ap-2024'],
      },
    ],
  },
];
---

<BaseLayout
  title="Attention Is All You Need"
  section="paper"
  description="用台灣繁體中文逐句拆解 Attention Is All You Need，以及 2017 年 Transformer 如何誕生。"
>
  <article>
    <header class={`${shell} pt-10`}>
      <div class="flex gap-3 font-mono text-sm uppercase tracking-[0.08em] text-muted">
        <a class="text-red underline underline-offset-4" href={withBase('/')}>
          THE LLM
        </a>
        <span aria-hidden="true">/</span>
        <span>第 01 章</span>
      </div>
      <div class="grid items-end gap-12 py-16 lg:grid-cols-[1.15fr_0.85fr] lg:gap-24">
        <div>
          <p class="mb-5 font-mono text-sm font-semibold uppercase tracking-[0.12em] text-red">
            VOL. 01 / THE ARCHITECTURE
          </p>
          <h1 class="m-0 font-display text-5xl sm:text-6xl lg:text-7xl leading-none tracking-[-0.05em]">
            <span class="block whitespace-nowrap">Attention Is</span>
            <em class="block">All You Need.</em>
          </h1>
          <p class="mt-8 max-w-[52ch] text-lg leading-8 text-muted">
            翻譯最難的不是把每個字換成另一個字，而是判斷句子裡的關係：誰在做事、哪個詞修飾哪個詞、前面提到的東西後面怎麼被指回。2017
            年，這篇論文在 English–German 與 English–French 的機器翻譯 benchmark 上測試
            Transformer，並把 recurrence 從核心路徑拿掉。
          </p>
        </div>
        <aside
          class="border-t-4 border-red bg-surface p-6 shadow-editorial"
          aria-label="這篇論文的一句評語"
        >
          <p class="mb-6 font-mono text-sm font-semibold uppercase tracking-[0.12em] text-red">
            一句評語 / THE SHORT VERDICT
          </p>
          <p class="m-0 max-w-[20ch] font-display text-3xl leading-tight">
            這篇論文把 attention 從輔助機制改成主要計算路徑。
          </p>
          <p class="mt-6 mb-0 text-base leading-7 text-muted">
            論文的原始任務是機器翻譯，不是聊天。
          </p>
        </aside>
      </div>
      <PaperMeta
        year={paper.year}
        venue={paper.venue}
        readTime="28 分鐘"
        difficulty="核心概念"
        doi={paper.doi}
      />
      <div class="flex flex-wrap items-center justify-between gap-y-3 py-4 font-mono text-sm uppercase tracking-[0.04em] text-muted">
        <div class="flex flex-wrap items-center gap-x-6 gap-y-2">
          <span>原始論文</span>
          <a
            class="underline underline-offset-4 hover:text-red"
            href={paperUrl}
            target="_blank"
            rel="noreferrer"
            aria-label="在 arXiv 閱讀原始論文（在新分頁開啟）"
          >
            在 arXiv 閱讀 ↗
          </a>
        </div>
        <div class="flex flex-wrap items-center gap-x-4 gap-y-2 text-xs sm:text-sm">
          <div class="flex items-center gap-1.5">
            <span class="text-muted">上一篇：</span>
            <a
              href={withBase('/papers/a-mathematical-theory-of-communication')}
              class="font-semibold text-muted underline underline-offset-4 hover:text-ink transition-colors"
              aria-label="返回：A Mathematical Theory of Communication"
            >
              ← 資訊理論（Shannon 1948）
            </a>
          </div>
          <span class="text-line hidden sm:inline" aria-hidden="true">
            |
          </span>
          <div class="flex items-center gap-1.5">
            <span class="text-muted">下一篇：</span>
            <a
              href={withBase('/papers/improving-language-understanding-by-generative-pre-training')}
              class="font-semibold text-red underline underline-offset-4 hover:text-ink transition-colors"
              aria-label="跳轉至：Improving Language Understanding by Generative Pre-Training"
            >
              GPT-1 預訓練 ↗
            </a>
          </div>
        </div>
      </div>
    </header>

    <!-- SECTION 1: 歷史開局 / 說書人起手式 (START WITH WHY) -->
    <section
      class={`${shell} border-t border-ink py-16 sm:py-20 lg:py-24`}
      aria-labelledby="history-genesis-title"
    >
      <div class="mb-12 flex flex-col gap-6 lg:flex-row lg:items-end lg:justify-between">
        <div>
          <p class="mb-4 font-mono text-sm font-semibold uppercase tracking-[0.12em] text-red">
            歷史開局 / 2014–2017：大模型前夜
          </p>
          <h2
            id="history-genesis-title"
            class="m-0 font-display text-3xl sm:text-4xl lg:text-5xl leading-tight tracking-tight text-ink"
          >
            <span class="block">從 Seq2Seq 到 Attention：</span>
            <span class="block">
              <em>天下苦 RNN 久矣，三次演進終破循環</em>
            </span>
          </h2>
        </div>
        <p class="m-0 max-w-[34ch] text-base leading-8 text-muted">
          這不是一場預謀好的通用模型革命：Google 團隊當初只是為了解決機房裡昂貴的 GPU 算力被 RNN
          串行等待活活拖死的工程絕境。
        </p>
      </div>

      <PaperReadingLayout>
        <div class="min-w-0 max-w-2xl space-y-6 text-base leading-8 text-muted">
          <p>
            話說在 2017 年那篇驚天動地的《Attention Is All You
            Need》問世之前，自然語言處理（NLP）完全是循環神經網路（RNN）與長短期記憶（LSTM）的天下。
          </p>
          <p>學界為什麼會被困在循環的泥淖裡？這一切，得從人類語言那令人抓狂的「變長」本質說起。</p>

          <h3 class="font-display text-2xl text-ink pt-4">變長序列的迷局：語言不能削足適履</h3>
          <p>
            在 2014 年以前，深度學習的輝煌戰果幾乎全由電腦視覺（如 2012 年奪冠的
            AlexNet）所獨占。那時的卷積神經網路（CNN）或多層感知機（MLP），背後的數學運算是尺寸完全焊死的矩陣乘法——它的根本假設，是
            <strong>輸入與輸出的尺寸必須絕對固定</strong>。
          </p>
          <p>
            最典型的例子是影像分類：不管你拍的是高山還是小狗，進神經網路前都要裁切或縮放成一張寬
            224、高 224 個點的固定像素方格；乘上紅綠藍三通道後，輸入固定是 150,528
            個數字。而模型的輸出，則是從 1,000 種預先定好的名冊（第 1 類是貓、第 2 類是客機、第 3
            類是咖啡杯）中吐出固定 1,000 個機率數字。進出規格嚴絲合縫，矩陣乘法運轉無礙。
          </p>
          <p>
            <strong>然而，人類語言是天然的變長序列（Variable-length Sequence）。</strong> 一句 2
            個字的問候「早安」，可能對應英文 4 個單詞 "Good morning to you"；一段 40
            個字的法文法律條文，可能需要 32
            個字的英文翻譯。語言既沒有固定的長寬像素，也不會乖乖按照固定字數排隊。
          </p>
          <p>
            在當時，面對這種忽長忽短的動態關係，傳統神經網路無從下手。產業界只能依賴傳統「統計機器翻譯（Statistical
            Machine Translation,
            SMT）」。那是一台由工程師手工拼裝的繁瑣流水線：一個模組管斷詞、一個模組查單字字典對齊、一個模組統計片語頻率、另一個模組靠統計機率評估英文語法是否通順。
          </p>
          <p>
            這種拼裝系統最致命的缺陷，在於<strong>「無法實現端到端（End-to-End）學習」</strong>
            。所謂端到端，就是
            <strong>
              「左端直接吃進原始中文，右端直接吐出最終英文；中間沒有人工外掛規則，由同一個神經網路大腦一體包辦」
            </strong>
            。在傳統拼裝系統裡，如果翻譯出來不知所云，工程師根本不知道該怪哪一道工序，錯誤像雪崩般逐層放大，也無法用單一的反向傳播誤差訊號讓全系統自我修正。語言處理，急需一套真正能包辦頭尾的端到端神經架構。
          </p>

          <h3 class="font-display text-2xl text-ink pt-4">思想向量的誕生：首尾相接的雙 LSTM</h3>
          <p>
            2014 年，Google Brain 的 Ilya Sutskever、Oriol Vinyals 與 Quoc Le
            發表了里程碑論文《Sequence to Sequence Learning with Neural Networks》，開創了經典的
            Seq2Seq 架構：{' '}
            <a
              class="text-red underline underline-offset-4"
              href={sourceMap['paper-2014-seq2seq'].url}
              target="_blank"
              rel="noreferrer"
              aria-label="來源 S4：Sequence to Sequence Learning with Neural Networks（在新分頁開啟）"
            >
              [S4]
            </a>
            。他們首次證明：
            <strong>
              只要將兩組循環神經網路（RNN/LSTM）首尾相接，就能讓單一模型學會任意長度到任意長度的映射。
            </strong>
          </p>
          <p>
            但在理解這個架構之前，我們必須先跨過工程術語的鴻溝——
            <strong>
              究竟什麼是「隱藏狀態（Hidden State）」？為什麼它跟人類大腦的認知體驗一模一樣？
            </strong>
          </p>

          <div class="my-6 border-l-4 border-red bg-paper-deep/60 p-5 sm:p-6 space-y-3 text-ink">
            <h4 class="m-0 font-display text-lg font-bold text-red">
              生活直覺：什麼是「隱藏狀態」？
            </h4>
            <p class="m-0 text-base leading-7">想像你在咖啡廳聽朋友說八卦。朋友慢慢開口說：</p>
            <ul class="list-disc pl-5 space-y-1.5 text-sm sm:text-base leading-7 text-muted">
              <li>
                朋友說：<strong>「昨天……」</strong>
                ——此時你的大腦一片空白，只知道時間，在等待主詞出現。
              </li>
              <li>
                朋友接著說：<strong>「小明……」</strong>
                ——你的腦袋立刻更新：「小明昨天怎麼了？」（產生好奇）。
              </li>
              <li>
                朋友接著說：<strong>「在捷運站……」</strong>
                ——你的腦袋又更新了：「他在捷運站摔倒？還是遇到誰？」（場景建立）。
              </li>
              <li>
                朋友最後說：<strong>「遇見主管牽著別人的老婆。」</strong>
                ——你的腦海「轟」的一聲，瞬間形成巨大震驚！
              </li>
            </ul>
            <p class="m-0 text-base leading-7">
              請注意：在聽這段話的每一秒鐘，你腦子裡的理解、情緒與猜想都在即時變化。
              <strong>
                這個「每聽完一個詞，內心當下累積的全部理解與心理小劇場」，在電腦眼裡就叫「狀態（State）」
              </strong>
              。
            </p>
            <p class="m-0 text-base leading-7">
              那為什麼前面要加一個<strong>「隱藏（Hidden）」</strong>
              ？因為外人只能看見輸入的文字（朋友說的話）和輸出的答案（你最後回的話），至於你肚子裡即時翻騰的心路歷程，藏在黑盒子大腦深處，外界看不見，所以工程師稱它為
              <strong>「隱藏狀態」</strong>。在電腦裡，它沒有人類的情緒，只能以一排包含 512
              個小數點數字的<strong>「向量（Vector）」</strong>來記錄。
            </p>
          </div>

          <p>弄懂了這點，你就能看清經典 Seq2Seq 做了多麼精妙、卻又多麼殘酷的事：</p>
          <p>
            左側的<strong>編碼器（Encoder RNN）</strong>
            就像一位聽法文演講的口譯員，逐字讀入句子。每讀一個詞，大腦裡的「內心小劇場」就更新一次（
            <code class="text-xs bg-paper-deep px-1.5 py-0.5">
              h<sub>t</sub> = LSTM(x<sub>t</sub>, h<sub>t-1</sub>)
            </code>
            ）。當讀到最後一個單詞時，口譯員聽完全文那一剎那的最後大腦狀態{' '}
            <code class="text-xs bg-paper-deep px-1.5 py-0.5">
              h<sub>T</sub> ∈ ℝ<sup>512</sup>
            </code>
            ，就被稱為整句話的<strong>「思想向量（Thought Vector）」</strong>。
          </p>
          <p>
            然而，最殘酷的架構代價隨之而來：
            <strong>
              口譯員在聽講過程中，前面每一句累積的所有逐字心路歷程{' '}
              <code class="text-xs bg-paper-deep px-1.5 py-0.5">
                (h₁, h₂, ..., h<sub>T-1</sub>)
              </code>
              ，被命令當場全部清空忘掉！
            </strong>
            為什麼？因為當時右側的<strong>解碼器（Decoder RNN）</strong>只有一個初始接口插槽（
            <code class="text-xs bg-paper-deep px-1.5 py-0.5">
              s₀ = h<sub>T</sub>
            </code>
            ）。在注意力機制發明前，沒有人知道該如何讓模型動態調閱整排筆記。
          </p>
          <p>
            解碼器只能像人類憑記憶複述一樣，孤注一擲地完全憑這最後一瞬間的腦袋殘存印象，
            <strong>自迴歸（Autoregressive）</strong>
            地——講完第一個英文單詞，再依據自己講出的話講下一個單詞——向外吐出翻譯。
          </p>

          <h3 class="font-display text-2xl text-ink pt-4">手心裡的密碼：資訊瓶頸與長句雪崩</h3>
          <p>
            這正是<strong>「資訊瓶頸（Information Bottleneck）」</strong>
            的恐怖之處：好比逼一位口譯員聽完長達 60
            個字的高難度演說，不准動手寫筆記，只准在手心寫下一個 512
            維的數字編碼，然後完全憑這個編碼把整篇演說精準翻成英文。
          </p>
          <p>任何人都知道這違背認知常理。當句子變長時，RNN 遇到了兩個致命死穴：</p>
          <ul class="list-disc pl-5 space-y-2 text-ink">
            <li>
              <strong>前向遺忘與「梯度消失（Vanishing Gradient）」：</strong>
              讀到第 60
              個字時，最後的記憶全被後面的詞佔滿，前面講了什麼早就模糊了；而在模型學習訓練時，翻譯錯誤的修正訊號（梯度）必須從最後一個詞倒推回去修正前面的參數。但在長達數十步的連續傳話中，訊號每往回傳一步就減弱一次，如同長廊裡的傳話遊戲，傳到開頭時早已微弱歸零，模型根本學不會長句的前後呼應。
            </li>
            <li>
              <strong>長句品質斷崖式雪崩：</strong>{' '}
              在機器翻譯領域，評量翻譯水準與專業人類譯者有多吻合的客觀分數叫{' '}
              <strong>BLEU 分數</strong>（0 至 100 分）。2014 年 Cho 等人的實驗證實：
              <strong>
                當句子長度超過 15 至 20 個單詞時，Seq2Seq 的 BLEU 分數呈現斷崖式的雪崩暴跌！
              </strong>
            </li>
          </ul>

          <h3 class="font-display text-2xl text-ink pt-4">第一道曙光：Bahdanau 的注意力補丁</h3>
          <p>
            同年，Dzmitry Bahdanau、Kyunghyun Cho 與 Yoshua Bengio 站了出來，提出了常識性的反問：
            <strong>
              「為什麼不准口譯員做筆記？既然聽講時每一步大腦明明都產生了理解（隱藏狀態），為什麼非要全部扔掉，逼最後一個詞背負全部記憶？」
            </strong>{' '}
            <a
              class="text-red underline underline-offset-4"
              href={sourceMap['paper-2014-align-translate'].url}
              target="_blank"
              rel="noreferrer"
              aria-label="來源 S5：Neural Machine Translation by Jointly Learning to Align and Translate（在新分頁開啟）"
            >
              [S5]
            </a>
          </p>
          <p>
            他們的解法無比直覺：<strong>允許口譯員做便條紙筆記！</strong>
            編碼器每聽一個詞，就撕一張便條紙記下當下的理解{' '}
            <code class="text-xs bg-paper-deep px-1.5 py-0.5">
              [h₁, h₂, ..., h<sub>T</sub>]
            </code>
            ，整齊貼在白板上。解碼器在翻譯英文時，每寫一個單詞，就抬起頭往白板掃視一眼（動態計算匹配權重），需要主詞就看主詞便條，需要動詞就看動詞便條。這套
            <strong>「動態翻筆記」</strong>的機制，就是<strong>注意力（Attention）</strong>
            ！長句遺忘症立刻治癒，BLEU 分數不再隨長度下跌。
          </p>

          <h3 class="font-display text-2xl text-ink pt-4">
            算力時代的死穴：串行排隊的「時序等待牆」
          </h3>
          <p>
            Bahdanau 的便條紙筆記解決了<strong>「記憶容量瓶頸」</strong>
            ，卻撞上了另一道更堅固的物理高牆——<strong>「時序等待牆」</strong>。
          </p>
          <p>
            即便允許做筆記，口譯員依然必須<strong>「一秒一秒排隊聽」</strong>：演講者講完第 1
            句才能記第 1 句，講完第 99 句才能記第 100
            句。這在人類生理上理所當然，但在計算機工程中卻是災難！
          </p>
          <p>
            想像 Google 機房裡有上萬顆頂級 GPU
            運算核心，就像體育場上坐著一萬名隨時能出發的短跑健將。但因為 RNN
            是「大隊接力賽」，全場只准 1 個人在跑道上慢慢交接棒，其餘 9,999
            名健將只能乾坐在看台上嗑瓜子！強大的平行硬體算力被活活浪費在漫長的串行等待中。訓練一個模型動輒耗時數週，昂貴的算力被卡死在時序鏈上。
          </p>

          <h3 class="font-display text-2xl text-ink pt-4">八人拍案而起：徹底砸碎循環的枷鎖</h3>
          <p>
            過去數十年，機器學習工程師始終陷在一個思維盲區：因為人類在「聆聽」語音時是隨時間一秒一秒依序接收聲音訊號，工程師便想當然耳地認為電腦處理文字也必須模仿這種聽覺串流，打造出必須一步一步交接棒的
            RNN。
          </p>
          <p>
            然而，當我們停下腳步、審視人類自身的<strong>視覺閱讀認知機制</strong>
            時，真相完全不是如此。認知心理學與眼動追蹤研究早已證實：人類在閱讀紙頁或螢幕上的文字時，視線從來不是平滑滑動的錄音磁頭，而是依賴極其迅速的
            <strong>「眼跳（Saccades）」</strong>與<strong>「選擇性凝視（Fixations）」</strong>
            。當讀者的目光掃到一個代名詞「牠」時，大腦並不需要把前面五句話的所有字詞重新倒帶播一遍，而是目光瞬間向上跳躍，跨越數十個無關單詞，精準鎖定前文的主詞「那隻受傷的獵犬」。在人類大腦的認知空間中，文字從來不是一條受制於時間的一維單向通道，而是一個資訊同時共存、注意力可以在其間自由穿梭的二維語義畫布。
          </p>
          <p>
            這正是 2017 年夏天，Google Brain 的八位作者發動架構革命的起點：
            <strong>
              「既然文章早就白紙黑字寫在那裡了，為什麼非要逼電腦模仿人類耳朵排隊聽聲音？把這個老牛拉破車的循環外殼（RNN）徹底砸碎！」
            </strong>
          </p>
          <p>
            這八個人做出了震撼 AI 界的大膽創舉：
            <strong>徹底廢除 RNN，讓所有單詞「同時」進場（Attention Is ALL You Need）！</strong>
            他們把整句話的所有單詞在一瞬間同時發給 GPU
            核心，讓每個單詞在進入模型的同一微秒內，同時向全句其他所有單詞發射「雷達探測（Self-Attention）」，直接秒級鎖定前後關聯。
          </p>
          <p>
            在 WMT 2014 機器翻譯評測基準上，他們僅使用 8 張 P100 GPU 訓練 3.5 天，英法翻譯即達到
            41.8 BLEU，英德翻譯達到 28.4 BLEU，刷新所有紀錄{' '}
            <a
              class="text-red underline underline-offset-4"
              href={sourceMap['paper-2017-arxiv'].url}
              target="_blank"
              rel="noreferrer"
              aria-label="來源 S1：Attention Is All You Need（在新分頁開啟）"
            >
              [S1]
            </a>
            。一場席捲整個 AI 歷史的革命，自此揭開序幕。
          </p>
        </div>

