---
import BaseLayout from '../../layouts/BaseLayout.astro';
import PaperMeta from '../../components/PaperMeta.astro';
import PaperReadingLayout from '../../components/PaperReadingLayout.astro';
import StoryRail from '../../components/StoryRail.astro';
import {
  attentionIsAllYouNeed,
  attentionSources,
} from '../../content/papers/attention-is-all-you-need';

const paper = attentionIsAllYouNeed;
const shell = 'mx-auto w-[calc(100%-2rem)] max-w-[1120px]';
const paperUrl = `https://arxiv.org/abs/${paper.arxivId}`;
const sourceMap: Record<string, (typeof attentionSources)[number]> = Object.fromEntries(
  attentionSources.map((source) => [source.id, source]),
);
const sourceKindLabels: Record<string, string> = {
  paper: '論文 / PAPER',
  'authorial-account': '作者文章 / AUTHORIAL ACCOUNT',
  interview: '訪談 / INTERVIEW',
  'later-history': '後續紀錄 / LATER HISTORY',
};
const confidenceLabels: Record<string, string> = {
  direct: '直接',
  corroborated: '交叉印證',
  inference: '推論',
  unknown: '未知',
};
const story = [
  {
    year: '之前',
    label: '問題 / THE PROBLEM',
    title: '翻譯遇到記憶問題。',
    body: 'RNN 一個 token 接一個 token 地讀。句子一長，訓練就變慢，也更難記住前面的內容。',
    status: 'past' as const,
  },
  {
    year: '2017',
    label: '論文 / THE PAPER',
    title: 'Attention 成為架構的核心。',
    body: 'Transformer 讓每個 token 直接查看其他 token，再一次處理許多位置。',
    status: 'current' as const,
  },
  {
    year: '之後',
    label: '後果 / THE CONSEQUENCE',
    title: '同一個架構，後來擴展成語言模型。',
    body: '後來的研究保留 Transformer，改變訓練目標，再把模型規模拉高。',
    status: 'future' as const,
  },
];
---

<BaseLayout
  title="Attention Is All You Need"
  section="paper"
  description="用台灣繁體中文逐句拆解 Attention Is All You Need，以及 2017 年 Transformer 如何誕生。"
>
  <article>
    <header class={`${shell} pt-10`}>
      <div class="flex gap-3 font-mono text-sm uppercase tracking-[0.08em] text-muted">
        <a class="text-red underline underline-offset-4" href="/">
          THE LLM
        </a>
        <span aria-hidden="true">/</span>
        <span>第 01 章</span>
      </div>
      <div class="grid items-end gap-12 py-16 lg:grid-cols-[1.15fr_0.85fr] lg:gap-24">
        <div>
          <p class="mb-5 font-mono text-sm font-semibold uppercase tracking-[0.12em] text-red">
            理論 / THEORY 01
          </p>
          <h1 class="m-0 font-display text-5xl sm:text-6xl lg:text-7xl leading-none tracking-[-0.05em]">
            <span class="block whitespace-nowrap">Attention Is</span>
            <em class="block">All You Need.</em>
          </h1>
          <p class="mt-8 max-w-[52ch] text-lg leading-8 text-muted">
            翻譯最難的不是把每個字換成另一個字，而是判斷句子裡的關係：誰在做事、哪個詞修飾哪個詞、前面提到的東西後面怎麼被指回。2017
            年，這篇論文在 English–German 與 English–French 的機器翻譯 benchmark 上測試
            Transformer，並把 recurrence 從核心路徑拿掉。
          </p>
        </div>
        <aside
          class="border-t-4 border-red bg-surface p-6 shadow-editorial"
          aria-label="這篇論文的一句評語"
        >
          <p class="mb-6 font-mono text-sm font-semibold uppercase tracking-[0.12em] text-red">
            一句評語 / THE SHORT VERDICT
          </p>
          <p class="m-0 max-w-[20ch] font-display text-3xl leading-tight">
            這篇論文把 attention 從輔助機制改成主要計算路徑。
          </p>
          <p class="mt-6 mb-0 text-base leading-7 text-muted">
            論文的原始任務是機器翻譯，不是聊天。
          </p>
        </aside>
      </div>
      <PaperMeta
        year={paper.year}
        venue={paper.venue}
        readTime="28 分鐘"
        difficulty="核心概念"
        doi={paper.doi}
      />
      <div class="flex flex-wrap items-center gap-x-6 gap-y-3 py-4 font-mono text-sm uppercase tracking-[0.04em] text-muted">
        <span>原始論文</span>
        <a
          class="underline underline-offset-4 hover:text-red"
          href={paperUrl}
          target="_blank"
          rel="noreferrer"
          aria-label="在 arXiv 閱讀原始論文（在新分頁開啟）"
        >
          在 arXiv 閱讀 ↗
        </a>
      </div>
    </header>

    <section
      class={`${shell} border-t border-ink py-16 sm:py-20 lg:py-24`}
      aria-labelledby="core-question-title"
    >
      <div class="max-w-none">
        <div>
          <p class="mb-4 font-mono text-sm font-semibold uppercase tracking-[0.12em] text-red">
            問題 / THE PROBLEM
          </p>
          <h2
            id="core-question-title"
            class="m-0 max-w-[13ch] font-display text-5xl sm:text-6xl lg:text-7xl leading-tight tracking-[-0.04em]"
          >
            <span class="block">翻譯一個字時，</span>
            <span class="block">
              <em>答案可能在句子的另一端。</em>
            </span>
          </h2>
          <p class="mt-7 max-w-[40ch] text-base leading-8 text-muted">
            單字表可以告訴你「自己」大致和反身代名詞有關，卻不會告訴你它在這一大段話裡跟著誰。翻譯時，人物、動作順序和代名詞的對象，必須一起看。
          </p>
          <div class="mt-7 max-w-none border border-blue/40 bg-blue/5 p-6 sm:p-8">
            <p class="m-0 font-mono text-sm font-semibold uppercase tracking-[0.12em] text-blue">
              情境案例 / A LONG CASE
            </p>
            <div class="mt-6 grid gap-8 lg:grid-cols-2 lg:gap-12">
              <div>
                <p class="m-0 font-mono text-sm tracking-[0.08em] text-blue">
                  中文原句 / SOURCE SENTENCE
                </p>
                <p class="mt-2 font-display text-base leading-8">
                  上週五下午，碩一的小明把修改三次的研究計畫交給王老師，請系辦寄給兩位口試委員。王老師看完摘要後，提醒他在方法章補上受訪者同意書。那天晚上，小明先把摘要改好，又整理了口試委員的聯絡資料，還重新排版研究計畫。隔天早上，他回到研究室才發現，自己把那份同意書夾在原稿裡，於是先回系辦找回那份同意書，再把修正版寄出，並在信中向委員說明延誤的原因。
                </p>
              </div>
              <div>
                <p class="m-0 font-mono text-sm tracking-[0.08em] text-blue">
                  英文譯法 / ENGLISH TRANSLATION
                </p>
                <p class="mt-2 font-mono text-base leading-7 text-blue">
                  Last Friday afternoon, Xiaoming, a first-year graduate student, submitted the
                  research proposal he had revised three times to Professor Wang and asked the
                  department office to send the proposal to two committee members. After reading the
                  abstract, Professor Wang reminded him to add the participants’ consent form to the
                  methods chapter. That evening, Xiaoming revised the abstract, organized the
                  committee members’ contact information, and reformatted the research proposal. The
                  next morning, when he returned to the lab, he realized that he had left the
                  consent form inside the original draft, so he first returned to the department
                  office to find it, then sent out the revised proposal and explained the delay to
                  the committee members in his email.
                </p>
              </div>
            </div>
            <div class="mt-8 grid gap-px border-y border-blue/30 bg-blue/30 sm:grid-cols-2">
              <div class="bg-paper p-6 sm:p-8">
                <p class="m-0 font-mono text-sm font-semibold tracking-[0.08em] text-blue">
                  誰在做動作？ / SUBJECT
                </p>
                <p class="mt-3 mb-0 text-base leading-8 text-muted">
                  <code>Professor Wang</code> 在 <code>reminded him</code> 裡是動作者，
                  <code>him</code> 才是被提醒的小明；後面的 <code>he realized</code> 和{' '}
                  <code>he first returned</code>
                  ，才是小明回到研究室、回系辦尋找文件。中文的「自己」也跟著小明，英文不另外寫成
                  <code>himself</code>，而是沿用 <code>he</code>。
                </p>
              </div>
              <div class="bg-surface p-6 sm:p-8">
                <p class="m-0 font-mono text-sm font-semibold tracking-[0.08em] text-red">
                  「那份同意書」是哪一份？ / REFERENCE
                </p>
                <p class="mt-3 mb-0 text-base leading-8 text-muted">
                  「那份同意書」回指前面提過的「受訪者同意書」，不是「原稿」；英文因此寫成{' '}
                  <code>the consent form</code>，後面再用 <code>it</code> 找回同一份文件。
                </p>
              </div>
            </div>
            <dl class="mt-8 border-t border-dashed border-blue/30 text-base leading-8 text-muted">
              <div class="grid gap-3 border-b border-dashed border-blue/30 py-5 sm:grid-cols-[7rem_1fr] sm:gap-5">
                <dt class="font-mono text-sm text-blue">小明 / he</dt>
                <dd class="m-0">
                  <code>Professor Wang</code> 是 <code>reminded him</code> 的主詞；<code>him</code>{' '}
                  是接受提醒的小明。到了 <code>he realized</code> 和 <code>he first returned</code>
                  ，主詞才回到小明。
                </dd>
              </div>
              <div class="grid gap-3 border-b border-dashed border-blue/30 py-5 sm:grid-cols-[7rem_1fr] sm:gap-5">
                <dt class="font-mono text-sm text-blue">後</dt>
                <dd class="m-0">
                  <code>After reading the abstract</code>
                  只連接「王老師看完摘要」和「提醒他」；交研究計畫發生在前面，是因為它位於前一個中文句子，不是
                  <code>after</code> 自己額外交代的。
                </dd>
              </div>
              <div class="grid gap-3 border-b border-dashed border-blue/30 py-5 sm:grid-cols-[7rem_1fr] sm:gap-5">
                <dt class="font-mono text-sm text-blue">先、再、才</dt>
                <dd class="m-0">
                  <code>After</code>、<code>When</code>、<code>so</code> 和 <code>then</code>
                  把「看摘要、提醒、發現、尋找、寄出」排出順序；翻譯時還要把中文的「才」和「於是」所帶出的前後關係保留下來。
                </dd>
              </div>
              <div class="grid gap-3 py-5 sm:grid-cols-[7rem_1fr] sm:gap-5">
                <dt class="font-mono text-sm text-blue">那份同意書</dt>
                <dd class="m-0">
                  <code>the consent form</code> 和 <code>it</code>
                  都回到前面提過的「受訪者同意書」；「原稿」是夾住它的另一份文件。
                </dd>
              </div>
            </dl>
          </div>
          <PaperReadingLayout class="mt-12 text-base leading-8 text-muted">
            <div class="min-w-0 max-w-2xl">
              <p class="mb-10">
                模型把輸入切成一串可以依序編號的小片段。這些小片段叫作 <code>token</code>；一個
                token
                可能是一個字、一個詞，也可能只是詞的一部分。這裡說的「位置（position）」就是某個
                token
                在這串輸入裡的編號，不是畫面上的座標。這個編號先回答「它排在哪裡」，還沒有回答另一個問題：讀到第
                4 格的資料後，模型要怎麼把它帶到第 10 格？下面的示意會把幾個 token
                合併成讀者熟悉的詞組，方便追蹤前後距離。
              </p>
              <p class="mb-10">
                早期常用的答案是 <code>RNN</code>。<code>RNN</code> 是 recurrent neural
                network（循環神經網路）：它從左到右讀一串輸入，每讀到一個新的位置，就把「這一格的資料」和「上一格留下的摘要」合在一起，再把合成的結果交給下一格。於是，第
                10 格若要用第 4 格的線索，就只能接收已經一路更新過來的結果。
              </p>
              <p class="mb-10">
                RNN 每一格交給下一格的那串摘要叫作 <code>hidden state</code>
                。它不是暫存的中文字，也不是已經完成的英文翻譯，而是一串固定長度的數字，用來攜帶模型目前認為重要的資訊。每讀一格，模型都會重新整理這串數字；它不是把前面整段話原封不動存起來。
              </p>
              <div class="mb-10 border-l-2 border-blue pl-5 text-base leading-8 text-blue">
                <div class="font-mono">h₁ = f(小明)</div>
                <div class="font-mono">h₂ = f(研究計畫, h₁)</div>
                <div class="font-mono">h₃ = f(王老師, h₂)</div>
                <div class="font-mono">h₄ = f(受訪者同意書, h₃)</div>
                <div class="font-mono">h₅ = f(摘要, h₄)</div>
                <div class="font-mono">h₆ = f(聯絡資料, h₅)</div>
                <div class="font-mono">h₇ = f(研究計畫, h₆)</div>
                <div class="font-mono">h₈ = f(研究室, h₇)</div>
                <div class="font-mono">h₉ = f(原稿, h₈)</div>
                <div class="font-mono">h₁₀ = f(那份同意書, h₉)</div>
                <p class="mt-4 mb-0 font-sans text-base leading-8 text-muted">
                  這裡把幾個詞組合併成一格，方便看清楚路徑；真實模型還會把文字切成更小的 token。每個{' '}
                  <code>hᵢ</code> 都是同樣固定長度的 hidden state；<code>f</code>
                  每次只把目前輸入和前一個固定大小的 state 合成下一個 state。第 4
                  格的「受訪者同意書」要傳到第 10 格的「那份同意書」，中間必須經過第 5、6、7、8、9
                  格。
                </p>
              </div>
              <div class="mb-10 border-y-2 border-red bg-red-soft/30 px-5 py-6 sm:px-7">
                <p class="m-0 text-base leading-8 text-ink">
                  <strong>
                    RNN 的限制不在於它完全讀不到前文，而在於它只能帶著一份固定大小的摘要往前走。
                  </strong>
                  句子越長，後面要找前面的線索時，中間要經過的更新就越多。
                </p>
              </div>
              <p class="mb-10">
                這是資訊容量的限制，常被稱為「記憶瓶頸」；它不是電腦的 RAM 不夠。RNN 的每一格{' '}
                <code>hidden state</code>
                都有固定大小；輸入越長，新的資料越多，模型卻還是要把目前重要的內容塞進同樣大小的一串數字。這就像隨身只帶著一張固定大小的小便箋，每讀到一個新動作，就必須在同一張紙上擦去舊筆記、改寫成最新摘要。它不能把讀過的整段文字原封不動留著，只能一直改寫這份摘要。
              </p>
              <p class="mb-10">
                回到這段案例：讀到「小明」時，模型需要留下「這是整段故事的主角」；讀到王老師、口試委員、受訪者同意書、原稿時，還要保留誰做了什麼、哪些文件彼此相關；讀到「那份同意書」和「他」時，才要把這些資訊用在英文翻譯裡。如果便箋空間有限，中間任何一次改寫都可能讓主角、順序或文件之間的線索被覆蓋或沖淡。這不是說每個
                RNN 翻譯結果都一定會錯，而是這條記憶路徑越長，模型要學的工作越難。
              </p>
              <p class="mb-10">
                訓練時，模型會把自己產生的英文和正確譯文比較，算出
                loss（損失）：這是一個表示「這次預測離目標有多遠」的數字。正確譯文不會直接告訴模型「第
                4 格一定要連到第 10
                格」；模型只能從最後的翻譯結果得到修正方向，再把這個方向用回前面的計算。
              </p>
              <p class="mb-10">
                在 RNN 裡，這個修正訊號得從最後的 <code>h₁₀</code> 沿著 <code>h₉</code>、
                <code>h₈</code> 一格一格傳回
                <code>h₁</code>
                ；路徑越長，訊號越容易變弱或變得不穩定。這是「訓練訊號要走多遠」的問題，和前面「資訊要塞進多大的摘要」有關，但不是同一件事。
              </p>
              <p class="mb-10">
                還有一個不同的限制：前向計算的順序被鎖住。第 10 格必須等第 9 格算完，第 9
                格又必須等第 8 格，所以 GPU 不能在同一層直接同時計算這條 RNN
                鏈上的所有位置。這是等待時間的問題，不是記憶容量的問題。
              </p>
              <p class="mb-10">
                把這些限制放在一起看：RNN
                讓資料沿著同一條鏈往前傳，讓訓練的修正訊號沿著這條鏈往回走，也讓每一格都得等待前一格。要翻譯「那份同意書」時，前面的線索既要塞進固定大小的摘要，又要經過中間每一格才能抵達。這正是作者要改的地方：處理一個位置時，能不能直接查看同一段輸入裡其他位置的資料，少走這段繞路？
              </p>
              <div class="mb-10 border-y border-line py-6">
                <p class="mb-4 font-mono text-sm font-semibold uppercase tracking-[0.12em] text-red">
                  把位置編出來 / NUMBER THE POSITIONS
                </p>
                <ol class="m-0 grid list-none grid-cols-1 gap-x-6 p-0 sm:grid-cols-2 lg:grid-cols-5">
                  <li class="flex items-baseline gap-3 border-b border-line py-3">
                    <span class="font-mono text-sm text-red">01</span>
                    <span>小明</span>
                  </li>
                  <li class="flex items-baseline gap-3 border-b border-line py-3">
                    <span class="font-mono text-sm text-red">02</span>
                    <span>研究計畫</span>
                  </li>
                  <li class="flex items-baseline gap-3 border-b border-line py-3">
                    <span class="font-mono text-sm text-red">03</span>
                    <span>王老師</span>
                  </li>
                  <li class="flex items-baseline gap-3 border-b border-line py-3">
                    <span class="font-mono text-sm text-red">04</span>
                    <span>受訪者同意書</span>
                  </li>
                  <li class="flex items-baseline gap-3 border-b border-line py-3">
                    <span class="font-mono text-sm text-red">05</span>
                    <span>摘要</span>
                  </li>
                  <li class="flex items-baseline gap-3 border-b border-line py-3">
                    <span class="font-mono text-sm text-red">06</span>
                    <span>聯絡資料</span>
                  </li>
                  <li class="flex items-baseline gap-3 border-b border-line py-3">
                    <span class="font-mono text-sm text-red">07</span>
                    <span>研究計畫</span>
                  </li>
                  <li class="flex items-baseline gap-3 border-b border-line py-3">
                    <span class="font-mono text-sm text-red">08</span>
                    <span>研究室</span>
                  </li>
                  <li class="flex items-baseline gap-3 border-b border-line py-3">
                    <span class="font-mono text-sm text-red">09</span>
                    <span>原稿</span>
                  </li>
                  <li class="flex items-baseline gap-3 border-b border-line py-3">
                    <span class="font-mono text-sm text-red">10</span>
                    <span>那份同意書</span>
                  </li>
                </ol>
                <p class="mt-5 mb-0 text-base leading-8 text-muted">
                  這裡先用詞組來數，因為模型實際切出的 <code>token</code>
                  可能更細；先把同一個詞組放在一起，才能看清楚前後相隔多遠。
                </p>
              </div>
              <p class="mb-10">
                有了這個編號，再回到第 10 個位置「那份同意書」。在 RNN 裡，第 10 格只能先接收第 9
                格留下的摘要；如果它需要第 4 格「受訪者同意書」的線索，這條線索就得經過第
                5、6、7、8、9 格，一格一格傳過來。新的做法讓第 10
                格直接把自己的數字資料，和同一段輸入裡的其他位置放在一起比較。
              </p>
              <p class="mb-10">
                第 10 格為什麼不能把每個位置都同樣處理？因為第 4 格「受訪者同意書」和第 9
                格「原稿」對判斷「那份同意書」的幫助不同。模型先替每個位置算一個關聯分數，再把這些分數換成總和為
                1 的權重，最後按照權重把各位置提供的數字資料加在一起。這樣，第 4
                格可以影響得多一點，第 9 格可以影響得少一點；模型得到的是第 10
                格的新數字資料，不是把某個詞原封不動搬過來。
              </p>
              <p class="mb-10">
                這種「先算分數、再換成權重、最後把資料按權重混合」的運算，在翻譯研究裡叫作
                <code>attention</code>
                。這個名字沿自對齊問題：產生一個翻譯詞時，模型不需要把來源句的每個位置當成同樣重要，而是把較大的權重放在當下有用的來源位置上。這裡的
                attention 不是視線，也不是模型真的理解了哪個字；它是一套用數字分配資料份量的計算。{' '}
                <a
                  class="text-red underline underline-offset-4"
                  href={sourceMap['paper-2014-align-translate'].url}
                  target="_blank"
                  rel="noreferrer"
                  aria-label="來源 S5：Neural Machine Translation by Jointly Learning to Align and Translate（在新分頁開啟）"
                >
                  [S5]
                </a>
              </p>
              <p class="mb-10">
                在這個 encoder 的例子裡，第 10 個位置會和第 1 到第 10
                格的每一格比較，也包括它自己。為了讓後面的算例可以手算，文章只列出第 1
                格「小明」、第 4 格「受訪者同意書」和第 9 格「原稿」；第 5、6、7、8
                格一樣會有自己的分數，只是先不把十個數字全部寫出來。因為查找者和候選資料都來自同一段輸入，所以這種
                attention 叫作
                <code>self-attention</code>
                ：同一段輸入中的各個位置互相提供線索，不是模型有意識地看自己。
              </p>
              <p class="mb-10">
                因此，論文標題中的「Attention Is All You Need」不是說模型只剩下
                attention，也不是說其他運算都不重要；它指出的是，跨位置傳遞資訊這件事不必再靠
                recurrence，attention 可以成為主要通道，其他逐點運算仍然存在。
              </p>
              <p class="mb-10">
                這個改動直接回應前面的兩個限制。前向計算時，「那份同意書」可以直接連到「受訪者同意書」，不必先穿過
                <code>h₅</code>、<code>h₆</code>、<code>h₇</code>、<code>h₈</code>、<code>h₉</code>
                等中間狀態；訓練時，最後的翻譯結果要修正這個關聯，也不必只沿著 <code>
                  h₁₀
                </code> 到 <code>h₁</code>
                的鏈傳回去。路徑縮短，不代表模型從此不會遺失資訊，也不保證每次都翻對；它只是讓中間需要轉手的狀態變少，相關的兩個位置比較容易連在一起。
              </p>
              <p class="mb-10">
                不過，「直接連到」有一個前提：第 4 格和第 10
                格必須同時出現在這一層的輸入裡。attention
                不是把模型看過的整個訓練資料庫叫回來，而是在這一次送進模型的那一段文字中，讓各個位置互相比較；這也就是上一段所說的「所有位置」的範圍。
                這段一次能放進模型處理的文字範圍，叫作 context
                window。訓練時，研究團隊把資料切成一段段的輸入，再分批送進
                GPU，每一批都有自己的長度上限。
              </p>
              <p class="mb-10">
                如果真的把 1 兆個 token 放進同一個輸入，dense self-attention
                就要讓每一個位置和其他每一個位置比較，分數表的大小會是 <code>n × n</code>；
                <code>n = 10¹²</code> 時，就是
                <code>10²⁴</code> 個分數。這不是把 GPU
                再加大一點就能輕鬆處理的工作，標準模型不會把這麼長的文字當成一個 context
                window。實際系統會限制輸入長度，或使用分段、局部視窗、稀疏 attention
                等方法降低代價。
              </p>
              <aside class="mb-10 border-l-2 border-blue bg-blue/5 pl-5 text-base leading-8 text-blue">
                <p class="m-0">
                  所以 Transformer
                  解決的是：在一個有限長度的輸入裡，讓不同位置有較短的資訊路徑，並讓 encoder
                  的同層計算更容易平行化；它沒有解決無限長記憶，也沒有消除 attention
                  的記憶體和計算成本。在逐步處理的當下，RNN 只需帶著固定大小的
                  state，代價是每一格都要等待；訓練時為了傳回修正訊號，仍可能需要保留或重算這些
                  state。Transformer 讓同一個 context window
                  裡的多個位置一起算，實作上要處理每個位置的向量和位置之間的分數；即使使用節省記憶體的實作，不把完整分數表留在記憶體裡，輸入變長時，計算與記憶體壓力仍會快速增加。
                </p>
              </aside>
              <p class="mb-10">
                前面說的是「一段有限輸入裡的計算代價」；要看它怎麼完成翻譯，還要把流程分成兩個角色。在機器翻譯裡，
                <code>encoder</code>
                讀入來源句子，為每個來源位置整理出帶有上下文的數字資料；<code>decoder</code>
                再根據這些資料和已經寫出的目標 token，一個 token 一個 token 寫出下一個目標
                token。同一層裡的多個來源位置可以一起做 attention，所以 encoder
                在訓練時能把這些運算交給 GPU 平行處理；decoder 生成英文時，未來的目標 token
                還不存在，仍然要照順序往下寫。
              </p>
            </div>
