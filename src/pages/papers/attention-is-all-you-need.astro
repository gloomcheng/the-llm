                  btn.className =
                    'attention-scenario-btn border border-ink bg-ink text-surface px-3 py-1.5 font-mono text-xs font-bold transition hover:opacity-90 cursor-pointer';

                  const key = btn.dataset.scenario;
                  if (key && scenarios[key]) {
                    currentScenarioKey = key;
                    currentTokens = [...scenarios[key].tokens];
                    currentQueryIndex = scenarios[key].defaultQueryIndex;
                    currentKeyIndex = scenarios[key].defaultKeyIndex;
                    updateSandbox();
                  }
                });
              });

            // Head switcher
            document.querySelectorAll<HTMLButtonElement>('.attention-head-btn').forEach((btn) => {
              btn.addEventListener('click', () => {
                document.querySelectorAll('.attention-head-btn').forEach((b) => {
                  b.setAttribute('aria-pressed', 'false');
                  b.className =
                    'attention-head-btn border border-ink bg-surface text-ink py-1.5 px-2 font-mono text-xs font-semibold text-center cursor-pointer transition hover:bg-paper';
                });
                btn.setAttribute('aria-pressed', 'true');
                btn.className =
                  'attention-head-btn border border-ink bg-ink text-surface py-1.5 px-2 font-mono text-xs font-semibold text-center cursor-pointer transition';

                currentHead = parseInt(btn.dataset.head || '0', 10);
                updateSandbox();
              });
            });

            // Temperature Slider
            const tempSlider = document.getElementById(
              'attention-temperature-slider',
            ) as HTMLInputElement | null;
            const tempVal = document.getElementById('attention-temp-val');
            const tempStatus = document.getElementById('attention-temp-status');
            if (tempSlider && tempVal && tempStatus) {
              tempSlider.addEventListener('input', () => {
                currentTemperature = parseFloat(tempSlider.value);
                tempVal.textContent = currentTemperature.toFixed(1);
                if (currentTemperature < 0.6) {
                  tempStatus.textContent = '極度尖銳 (Argmax 聚光)';
                  tempStatus.className = 'font-mono text-xs text-red font-bold';
                } else if (currentTemperature > 1.8) {
                  tempStatus.textContent = '平坦模糊 (均勻分佈)';
                  tempStatus.className = 'font-mono text-xs text-blue font-bold';
                } else {
                  tempStatus.textContent = '標準平滑';
                  tempStatus.className = 'font-mono text-xs text-muted';
                }
                updateSandbox();
              });
            }

            // Scaling Toggle
            const scaleToggle = document.getElementById(
              'attention-scale-toggle',
            ) as HTMLInputElement | null;
            const scaleWarn = document.getElementById('attention-scale-warning');
            if (scaleToggle && scaleWarn) {
              scaleToggle.addEventListener('change', () => {
                isScalingEnabled = scaleToggle.checked;
                if (isScalingEnabled) {
                  scaleWarn.textContent = '維持內積方差為 1，避免 Softmax 梯度消失';
                  scaleWarn.className = 'm-0 mt-1 font-mono text-xs text-muted';
                } else {
                  scaleWarn.textContent = '未縮放：點積數值過大，導致 Softmax 梯度飽和！';
                  scaleWarn.className = 'm-0 mt-1 font-mono text-xs text-red font-bold';
                }
                updateSandbox();
              });
            }

            // Custom Sentence Form
            const customForm = document.getElementById('attention-custom-form');
            const customInput = document.getElementById(
              'attention-custom-input',
            ) as HTMLInputElement | null;
            if (customForm && customInput) {
              customForm.addEventListener('submit', (e) => {
                e.preventDefault();
                const raw = customInput.value.trim();
                if (!raw) return;

                // Split by spaces or characters if CJK
                let tokens: string[];
                if (raw.includes(' ')) {
                  tokens = raw.split(/\s+/).filter(Boolean);
                } else {
                  // Segment into 2-char chunks or chars
                  tokens = Array.from(raw).slice(0, 12);
                }

                if (tokens.length > 0) {
                  currentTokens = tokens.slice(0, 14); // Limit to 14 tokens for layout clarity
                  currentScenarioKey = 'custom';
                  currentQueryIndex = 0;
                  currentKeyIndex = Math.min(1, currentTokens.length - 1);

                  // Deselect preset tabs
                  document.querySelectorAll('.attention-scenario-btn').forEach((b) => {
                    b.setAttribute('aria-selected', 'false');
                    b.className =
                      'attention-scenario-btn border border-ink bg-paper text-ink px-3 py-1.5 font-mono text-xs font-bold transition hover:bg-paper-deep cursor-pointer';
                  });

                  updateSandbox();
                }
              });
            }

            // View Switcher (Matrix / Arc / Bars)
            document.querySelectorAll<HTMLButtonElement>('.attention-view-btn').forEach((btn) => {
              btn.addEventListener('click', () => {
                document.querySelectorAll('.attention-view-btn').forEach((b) => {
                  b.setAttribute('aria-selected', 'false');
                  b.className =
                    'attention-view-btn border border-ink bg-paper text-ink px-3 py-1 font-mono text-xs font-bold transition hover:bg-paper-deep cursor-pointer';
                });
                btn.setAttribute('aria-selected', 'true');
                btn.className =
                  'attention-view-btn border border-ink bg-ink text-surface px-3 py-1 font-mono text-xs font-bold transition cursor-pointer';

                currentActiveView = btn.dataset.view || 'matrix';
                const matrixView = document.getElementById('attention-view-matrix');
                const arcView = document.getElementById('attention-view-arc');
                const barsView = document.getElementById('attention-view-bars');

                if (matrixView)
                  matrixView.className = currentActiveView === 'matrix' ? 'block' : 'hidden';
                if (arcView) arcView.className = currentActiveView === 'arc' ? 'block' : 'hidden';
                if (barsView)
                  barsView.className = currentActiveView === 'bars' ? 'block' : 'hidden';

                updateSandbox();
              });
            });
          }

          // Initialize on mount
          setupLabListeners();
          updateSandbox();
        </script>
      </div>
    </section>

