              <div class="border border-ink/30 bg-surface p-4 flex flex-col justify-between">
                <div>
                  <div class="flex items-center justify-between mb-2">
                    <span class="font-mono text-xs font-bold text-ink">步驟 4：Softmax 歸一</span>
                    <span class="font-mono text-xs text-muted">eᶻ / ∑eᶻ</span>
                  </div>
                  <p class="font-mono text-xs text-muted leading-relaxed">
                    經指數運算轉為機率分佈，全列相加恆等於 1.0 (100%)。
                  </p>
                </div>
                <div class="mt-4 bg-paper-deep p-2.5 border border-line font-mono text-xs">
                  <div class="text-muted font-mono text-xs">Softmax 權重 (α)：</div>
                  <div id="attention-calc-softmax" class="text-red font-bold text-sm mt-1">
                    0.842 (84.2%)
                  </div>
                </div>
              </div>
            </div>

            <!-- Dynamic Linguistic Explanation -->
            <div class="mt-6 border-t border-line pt-4 flex flex-col sm:flex-row items-start justify-between gap-4">
              <div class="flex-1">
                <span class="font-mono text-xs font-bold text-ink uppercase tracking-wider block mb-1">
                  語意機制與幾何診斷：
                </span>
                <p
                  id="attention-inspector-narrative"
                  class="m-0 text-sm leading-relaxed text-muted"
                >
                  載入中...
                </p>
              </div>
              <div class="bg-surface border border-ink/20 p-3 font-mono text-xs text-ink min-w-[220px]">
                <div class="text-muted font-mono text-xs uppercase font-bold mb-1">
                  公式總結 (VASWANI 2017)
                </div>
                <div class="text-red font-semibold">Attention(Q, K, V) =</div>
                <div>
                  softmax(Q Kᵀ / √d<sub>k</sub>) V
                </div>
              </div>
            </div>
          </div>
        </figure>

        <script>
          interface ScenarioData {
            tokens: string[];
            defaultQueryIndex: number;
            defaultKeyIndex: number;
            // Base logits for 3 heads: [headIndex][queryIndex][keyIndex]
            headLogits?: number[][][];
            title: string;
            description: string;
          }

          // Precomputed realistic baseline logit matrices for standard scenarios
          // Head 0: Coreference / Syntax; Head 1: Local Context; Head 2: Broadcast
          const scenarios: Record<string, ScenarioData> = {
            'winograd-tired': {
              tokens: [
                'The',
                'animal',
                "didn't",
                'cross',
                'the',
                'street',
                'because',
                'it',
                'was',
                'too',
                'tired',
              ],
              defaultQueryIndex: 7, // 'it'
              defaultKeyIndex: 1, // 'animal'
              title: '代名詞「it」在 tired 語境下強烈聚焦於「animal」',
              description:
                '當句子結尾為「tired（疲憊）」時，在經過多層自注意力交互後，代名詞「it」的 Query 向量融合了後文疲憊的語意特徵。由於動物具備疲勞屬性，Query(it) 與 Key(animal) 算出的向量內積顯著最高，經 Softmax 轉換後產生高達 84% 的壓倒性注意力，成功辨識代名詞所指對象！',
            },
            'winograd-wide': {
              tokens: [
                'The',
                'animal',
                "didn't",
                'cross',
                'the',
                'street',
                'because',
                'it',
                'was',
                'too',
                'wide',
              ],
              defaultQueryIndex: 7, // 'it'
              defaultKeyIndex: 5, // 'street'
              title: '末詞換成 wide，「it」焦點瞬間翻轉至「street」',
              description:
                '這是注意力機制最精妙之處：整句話僅將最後一個單詞從「tired」替換成「wide」，沒有任何人工語法規則介入。然而街道具有空間寬度屬性，使得「it」的 Query 向量在高維特徵空間中劇烈轉向，與「street」的 Key 內積激增，注意力佔比瞬間從 5% 暴衝至 81%！',
            },
            'tw-he': {
              tokens: [
                '研究員',
                '通知',
                '受訪者',
                '補簽',
                '同意書',
                '，',
                '因為',
                '他',
                '忘記',
                '簽名',
              ],
              defaultQueryIndex: 7, // '他'
              defaultKeyIndex: 2, // '受訪者'
              title: '代名詞「他」聚焦於「受訪者」',
              description:
                '在臺灣學術倫理情境中，「補簽」的受格主體是「受訪者」，且接續動作為「忘記簽名」。陽性代名詞「他」在自注意力層中，與「受訪者」的 Key 產生高達 79% 的關聯權重，正確鎖定需補簽之對象。',
            },
            'tw-it': {
              tokens: [
                '研究員',
                '通知',
                '受訪者',
                '補簽',
                '同意書',
                '，',
                '因為',
                '它',
                '遺失',
                '在',
                '實驗室',
              ],
              defaultQueryIndex: 7, // '它'
              defaultKeyIndex: 4, // '同意書'
              title: '代名詞換成「它」，注意力立刻轉向「同意書」',
              description:
                '當代名詞由人物的「他」替換為物稱「它」，且後方接續動詞「遺失在實驗室」時，「同意書」作為文件物品，與 Query(它) 向量產生高度共鳴，獲得 83% 的壓倒性注意力！',
            },
          };

          // State
          let currentScenarioKey = 'winograd-tired';
          let currentTokens: string[] = [...scenarios['winograd-tired'].tokens];
          let currentQueryIndex = 7;
          let currentKeyIndex = 1;
          let currentHead = 0; // 0: coreference, 1: local, 2: broadcast
          let currentTemperature = 1.0;
          let isScalingEnabled = true;
          let currentActiveView = 'matrix'; // 'matrix' | 'arc' | 'bars'

          // Compute raw synthetic dot-product logits between all token pairs
          function computeRawLogits(tokens: string[], head: number): number[][] {
            const n = tokens.length;
            const matrix: number[][] = [];

            for (let i = 0; i < n; i++) {
              const row: number[] = [];
              for (let j = 0; j < n; j++) {
                let score: number;
                const tokenI = tokens[i].toLowerCase();
                const tokenJ = tokens[j].toLowerCase();

                if (head === 0) {
                  // Head 0: Coreference / Semantic Dependency Head
                  if (i === j) {
                    score = 12.0; // self-attention baseline
                  } else if (
                    (tokenI === 'it' &&
                      tokenJ === 'animal' &&
                      tokens.some((t) => t.toLowerCase().includes('tired'))) ||
                    (tokenI === 'it' &&
                      tokenJ === 'street' &&
                      tokens.some((t) => t.toLowerCase().includes('wide'))) ||
                    (tokenI === '他' && tokenJ === '受訪者') ||
                    (tokenI === '它' && tokenJ === '同意書')
                  ) {
                    score = 42.8; // dominant coreference resolution
                  } else if (
                    (tokenI === 'it' &&
                      tokenJ === 'street' &&
                      tokens.some((t) => t.toLowerCase().includes('tired'))) ||
                    (tokenI === 'it' &&
                      tokenJ === 'animal' &&
                      tokens.some((t) => t.toLowerCase().includes('wide')))
                  ) {
                    score = 14.5; // suppressed competitor
                  } else if (Math.abs(i - j) === 1) {
                    score = 18.0; // immediate syntactic neighbor
                  } else {
                    // background semantic noise
                    const hash = Math.abs(Math.sin(i * 13 + j * 37)) * 10;
                    score = 6.0 + hash;
                  }
                } else if (head === 1) {
                  // Head 1: Local Context Window Head (Diagonal dominance)
                  const dist = Math.abs(i - j);
                  if (dist === 0) score = 38.0;
                  else if (dist === 1) score = 28.0;
                  else if (dist === 2) score = 16.0;
                  else score = Math.max(2.0, 10.0 - dist * 2);
                } else {
                  // Head 2: Global Broadcast Head (Uniform / first token anchor)
                  if (j === 0)
                    score = 25.0; // sentence start [CLS]/first token anchor
                  else score = 18.0 + Math.sin(i + j) * 4;
                }

                row.push(score);
              }
              matrix.push(row);
            }
            return matrix;
          }

          // Convert raw logits into Softmax probability matrix
          function computeAttentionMatrix(
            tokens: string[],
            head: number,
            temperature: number,
            scaleEnabled: boolean,
          ): { rawLogits: number[][]; scaledLogits: number[][]; weights: number[][] } {
            const rawLogits = computeRawLogits(tokens, head);
            const n = tokens.length;
            const scaledLogits: number[][] = [];
            const weights: number[][] = [];
            const sqrtDk = scaleEnabled ? Math.sqrt(64) : 1.0; // 8.0 or 1.0

            for (let i = 0; i < n; i++) {
              const scaledRow: number[] = [];
              const expRow: number[] = [];

              for (let j = 0; j < n; j++) {
                // Apply scaling by sqrt(d_k) and temperature tau
                const s = rawLogits[i][j] / sqrtDk / temperature;
                scaledRow.push(s);
                expRow.push(Math.exp(s));
              }

              const sumExp = expRow.reduce((acc, val) => acc + val, 0);
              const weightRow = expRow.map((v) => v / (sumExp || 1));

              scaledLogits.push(scaledRow);
              weights.push(weightRow);
            }

            return { rawLogits, scaledLogits, weights };
          }

          // Main render controller
          function updateSandbox() {
            const { rawLogits, scaledLogits, weights } = computeAttentionMatrix(
              currentTokens,
              currentHead,
              currentTemperature,
              isScalingEnabled,
            );

            // Clamp current indices
            if (currentQueryIndex >= currentTokens.length) currentQueryIndex = 0;
            if (currentKeyIndex >= currentTokens.length) currentKeyIndex = 0;

            // 1. Update Token Button Strip
            renderTokenStrip();

            // 2. Render Views
            renderMatrixView(weights);
            renderArcView(weights);
            renderBarsView(weights);

            // 3. Update Mathematical Inspector
            renderInspector(rawLogits, scaledLogits, weights);
          }

          // Render Token Buttons
          function renderTokenStrip() {
            const container = document.getElementById('attention-tokens-container');
            const badge = document.getElementById('attention-current-query-badge');
            if (!container || !badge) return;

            badge.textContent = `目前 Query: [${currentTokens[currentQueryIndex]}] (位置 ${currentQueryIndex})`;

            container.innerHTML = '';
            currentTokens.forEach((tok, idx) => {
              const btn = document.createElement('button');
              btn.type = 'button';
              const isSelected = idx === currentQueryIndex;
              btn.className = isSelected
                ? 'px-3 py-1.5 font-mono text-xs sm:text-sm font-bold border-2 border-red bg-red text-surface transition cursor-pointer shadow-xs'
                : 'px-3 py-1.5 font-mono text-xs sm:text-sm font-medium border border-ink/40 bg-surface text-ink hover:border-ink hover:bg-paper transition cursor-pointer';
              btn.textContent = `${idx}: ${tok}`;
              btn.setAttribute('aria-pressed', isSelected ? 'true' : 'false');
              btn.addEventListener('click', () => {
                currentQueryIndex = idx;
                updateSandbox();
              });
              container.appendChild(btn);
            });
          }

          // Render View 1: N x N Matrix Heatmap
          function renderMatrixView(weights: number[][]) {
            const gridContainer = document.getElementById('attention-matrix-grid');
            if (!gridContainer) return;

            const n = currentTokens.length;
            gridContainer.innerHTML = '';

            // Outer wrapper grid
            const table = document.createElement('table');
            table.className = 'border-collapse text-center font-mono text-xs select-none';

            // Table Header: Columns (Keys)
            const thead = document.createElement('thead');
            const headerRow = document.createElement('tr');

            // Top-left corner cell
            const cornerTh = document.createElement('th');
            cornerTh.className =
              'p-2 border border-line bg-paper-deep text-muted font-normal font-mono text-xs';
            cornerTh.textContent = 'Q \\ K';
            headerRow.appendChild(cornerTh);

            currentTokens.forEach((tok, j) => {
              const th = document.createElement('th');
              const isSelectedKey = j === currentKeyIndex;
              th.className = isSelectedKey
                ? 'p-2 border border-line bg-red text-surface font-bold text-xs truncate max-w-[80px]'
                : 'p-2 border border-line bg-paper-deep text-ink font-semibold text-xs truncate max-w-[80px]';
              th.title = `Key ${j}: ${tok}`;
              th.textContent = tok;
              th.addEventListener('click', () => {
                currentKeyIndex = j;
                updateSandbox();
              });
              headerRow.appendChild(th);
            });
            thead.appendChild(headerRow);
            table.appendChild(thead);

            // Table Body: Rows (Queries)
            const tbody = document.createElement('tbody');
            for (let i = 0; i < n; i++) {
              const tr = document.createElement('tr');
              const isSelectedQuery = i === currentQueryIndex;

              // Row Header (Query Token)
              const rowTh = document.createElement('th');
              rowTh.className = isSelectedQuery
                ? 'p-2 border border-line bg-red text-surface font-bold text-xs text-left truncate max-w-[80px]'
                : 'p-2 border border-line bg-paper-deep text-ink font-semibold text-xs text-left truncate max-w-[80px]';
              rowTh.title = `Query ${i}: ${currentTokens[i]}`;
              rowTh.textContent = `${i}:${currentTokens[i]}`;
              rowTh.addEventListener('click', () => {
                currentQueryIndex = i;
                updateSandbox();
              });
              tr.appendChild(rowTh);

              // Cells
              for (let j = 0; j < n; j++) {
                const td = document.createElement('td');
                const w = weights[i][j];
                const pct = (w * 100).toFixed(1);
                const isSelectedCell = i === currentQueryIndex && j === currentKeyIndex;
                const isCurrentRow = i === currentQueryIndex;

                // Color calculation: interpolate based on weight
                // Higher weight -> vibrant red/ink
                let bgStyle: string;
                let textClass: string;

                if (w > 0.4) {
                  bgStyle = `background-color: rgba(182, 65, 44, ${Math.min(1.0, 0.3 + w * 0.7)});`;
                  textClass = 'text-surface font-bold';
                } else if (w > 0.15) {
                  bgStyle = `background-color: rgba(182, 65, 44, ${w * 0.75});`;
                  textClass = 'text-ink font-semibold';
                } else {
                  bgStyle = `background-color: rgba(53, 91, 112, ${Math.max(0.04, w * 0.5)});`;
                  textClass = 'text-muted';
                }

                if (isSelectedCell) {
                  td.className = `p-2 border-2 border-red cursor-pointer transition-all duration-150 ${textClass} scale-105 z-10 relative font-bold shadow-sm`;
                } else if (isCurrentRow) {
                  td.className = `p-2 border border-ink/40 cursor-pointer hover:border-red transition-all duration-150 ${textClass}`;
                } else {
                  td.className = `p-2 border border-line cursor-pointer hover:border-ink/60 transition-all duration-150 ${textClass}`;
                }

                td.style.cssText = bgStyle;
                td.textContent = `${pct}%`;
                td.title = `Query [${currentTokens[i]}] -> Key [${currentTokens[j]}]: ${pct}%`;

                // Hover & click events
                td.addEventListener('mouseenter', () => {
                  currentQueryIndex = i;
                  currentKeyIndex = j;
                  renderInspector(
                    computeRawLogits(currentTokens, currentHead),
                    computeAttentionMatrix(
                      currentTokens,
                      currentHead,
                      currentTemperature,
                      isScalingEnabled,
                    ).scaledLogits,
                    weights,
                  );
                  renderTokenStrip();
                });

                td.addEventListener('click', () => {
                  currentQueryIndex = i;
                  currentKeyIndex = j;
                  updateSandbox();
                });

                tr.appendChild(td);
              }
              tbody.appendChild(tr);
            }
            table.appendChild(tbody);
            gridContainer.appendChild(table);
          }

          // Render View 2: Dynamic Arc Flow (SVG)
          function renderArcView(weights: number[][]) {
            const svg = document.getElementById('attention-arc-svg');
            if (!svg) return;

            svg.innerHTML = '';
            const n = currentTokens.length;
            const width = 800;
            const padding = 50;
            const stepX = (width - padding * 2) / Math.max(1, n - 1);

            const queryY = 40;
            const keyY = 200;

            const activeRowWeights = weights[currentQueryIndex] || [];

            // Draw connecting arcs from currentQueryIndex to all keys
            const qX = padding + currentQueryIndex * stepX;

            // Draw all arcs
            for (let j = 0; j < n; j++) {
              const kX = padding + j * stepX;
              const w = activeRowWeights[j] || 0;
              const isSelectedKey = j === currentKeyIndex;

              // Cubic or Quadratic Bezier control point
              const midY = (queryY + keyY) / 2 + (j === currentQueryIndex ? -30 : 0);
              const pathD = `M ${qX} ${queryY + 12} Q ${(qX + kX) / 2} ${midY} ${kX} ${keyY - 12}`;

              const path = document.createElementNS('http://www.w3.org/2000/svg', 'path');
              path.setAttribute('d', pathD);
              path.setAttribute('fill', 'none');

              // Stroke width and opacity proportional to attention weight
              const strokeWidth = Math.max(1, w * 12);
              const opacity = isSelectedKey ? 1.0 : Math.max(0.15, w * 1.1);
              const strokeColor = isSelectedKey ? '#b6412c' : w > 0.3 ? '#b6412c' : '#355b70';

              path.setAttribute('stroke', strokeColor);
              path.setAttribute('stroke-width', strokeWidth.toString());
              path.setAttribute('stroke-opacity', opacity.toString());
              path.style.cursor = 'pointer';

              path.addEventListener('click', () => {
                currentKeyIndex = j;
                updateSandbox();
              });

              svg.appendChild(path);
            }

            // Draw Token Nodes (Top: Queries, Bottom: Keys)
            currentTokens.forEach((tok, idx) => {
              const x = padding + idx * stepX;

              // Top node (Query)
              const qCircle = document.createElementNS('http://www.w3.org/2000/svg', 'circle');
              qCircle.setAttribute('cx', x.toString());
              qCircle.setAttribute('cy', queryY.toString());
              qCircle.setAttribute('r', idx === currentQueryIndex ? '10' : '6');
              qCircle.setAttribute('fill', idx === currentQueryIndex ? '#b6412c' : '#1e2224');
              qCircle.style.cursor = 'pointer';
              qCircle.addEventListener('click', () => {
                currentQueryIndex = idx;
                updateSandbox();
              });
              svg.appendChild(qCircle);

              // Top text
              const qText = document.createElementNS('http://www.w3.org/2000/svg', 'text');
              qText.setAttribute('x', x.toString());
              qText.setAttribute('y', (queryY - 15).toString());
              qText.setAttribute('text-anchor', 'middle');
              qText.setAttribute('font-family', 'monospace');
              qText.setAttribute('font-size', '11');
              qText.setAttribute('font-weight', idx === currentQueryIndex ? 'bold' : 'normal');
              qText.setAttribute('fill', idx === currentQueryIndex ? '#b6412c' : '#1e2224');
              qText.textContent = tok;
              svg.appendChild(qText);

              // Bottom node (Key)
              const kCircle = document.createElementNS('http://www.w3.org/2000/svg', 'circle');
              kCircle.setAttribute('cx', x.toString());
              kCircle.setAttribute('cy', keyY.toString());
              kCircle.setAttribute('r', idx === currentKeyIndex ? '10' : '6');
              kCircle.setAttribute('fill', idx === currentKeyIndex ? '#b6412c' : '#355b70');
              kCircle.style.cursor = 'pointer';
              kCircle.addEventListener('click', () => {
                currentKeyIndex = idx;
                updateSandbox();
              });
              svg.appendChild(kCircle);

              // Bottom text
              const kText = document.createElementNS('http://www.w3.org/2000/svg', 'text');
              kText.setAttribute('x', x.toString());
              kText.setAttribute('y', (keyY + 22).toString());
              kText.setAttribute('text-anchor', 'middle');
              kText.setAttribute('font-family', 'monospace');
              kText.setAttribute('font-size', '11');
              kText.setAttribute('font-weight', idx === currentKeyIndex ? 'bold' : 'normal');
              kText.setAttribute('fill', idx === currentKeyIndex ? '#b6412c' : '#355b70');
              kText.textContent = tok;
              svg.appendChild(kText);
            });
          }

          // Render View 3: Bars
          function renderBarsView(weights: number[][]) {
            const container = document.getElementById('attention-bars-container');
            const queryBadge = document.getElementById('attention-bars-query-badge');
            if (!container || !queryBadge) return;

            const activeWeights = weights[currentQueryIndex] || [];
            queryBadge.textContent = `Query: ${currentTokens[currentQueryIndex]} (位置 ${currentQueryIndex})`;
            container.innerHTML = '';

            const maxW = Math.max(...activeWeights);

            currentTokens.forEach((tok, idx) => {
              const w = activeWeights[idx] || 0;
              const pct = (w * 100).toFixed(1);
              const isTop = w === maxW && w > 0.25;
              const isSelectedKey = idx === currentKeyIndex;

              const row = document.createElement('div');
              row.className =
                'grid grid-cols-[6rem_1fr_4rem] items-center gap-3 text-xs p-1.5 border transition cursor-pointer ' +
                (isSelectedKey
                  ? 'border-red bg-surface shadow-xs'
                  : 'border-transparent hover:border-line hover:bg-surface/60');

              row.addEventListener('click', () => {
                currentKeyIndex = idx;
                updateSandbox();
              });

              const label = document.createElement('div');
              label.className =
                isTop || isSelectedKey
                  ? 'font-mono font-bold text-red truncate'
                  : 'font-mono text-ink truncate';
              label.textContent = `${idx}: ${tok}`;

              const barTrack = document.createElement('div');
              barTrack.className =
                'h-5 w-full bg-paper-deep border border-line relative overflow-hidden';

              const barFill = document.createElement('div');
              barFill.className =
                isTop || isSelectedKey
                  ? 'h-full bg-red transition-all duration-300'
                  : 'h-full bg-blue/70 transition-all duration-300';
              barFill.style.width = `${pct}%`;
              barTrack.appendChild(barFill);

              const pctLabel = document.createElement('div');
              pctLabel.className =
                isTop || isSelectedKey
                  ? 'font-mono font-bold text-red text-right'
                  : 'font-mono text-muted text-right';
              pctLabel.textContent = `${pct}%`;

              row.appendChild(label);
              row.appendChild(barTrack);
              row.appendChild(pctLabel);
              container.appendChild(row);
            });
          }

          // Render Step-by-Step Mathematical Inspector Card
          function renderInspector(
            rawLogits: number[][],
            scaledLogits: number[][],
            weights: number[][],
          ) {
            const title = document.getElementById('attention-inspector-title');
            const scorePill = document.getElementById('attention-inspector-score-pill');
            const dotEl = document.getElementById('attention-calc-dot');
            const scaledEl = document.getElementById('attention-calc-scaled');
            const tempEl = document.getElementById('attention-calc-temp');
            const softmaxEl = document.getElementById('attention-calc-softmax');
            const narrativeEl = document.getElementById('attention-inspector-narrative');

            if (
              !title ||
              !scorePill ||
              !dotEl ||
              !scaledEl ||
              !tempEl ||
              !softmaxEl ||
              !narrativeEl
            )
              return;

            const qTok = currentTokens[currentQueryIndex] || '';
            const kTok = currentTokens[currentKeyIndex] || '';
            const rawScore = rawLogits[currentQueryIndex]?.[currentKeyIndex] || 0;
            const scaledScore = scaledLogits[currentQueryIndex]?.[currentKeyIndex] || 0;
            const logitZ = scaledScore / currentTemperature;
            const alpha = weights[currentQueryIndex]?.[currentKeyIndex] || 0;
            const pct = (alpha * 100).toFixed(1);

            title.textContent = `正在檢驗：Query「${qTok}」(位置 ${currentQueryIndex}) 與 Key「${kTok}」(位置 ${currentKeyIndex}) 之張量運算`;
            scorePill.textContent = `Softmax 權重 α = ${pct}%`;

            dotEl.textContent = rawScore.toFixed(2);
            scaledEl.textContent = isScalingEnabled
              ? `${scaledScore.toFixed(2)} (除以 8)`
              : `${scaledScore.toFixed(2)} (未縮放)`;
            tempEl.textContent = `${logitZ.toFixed(2)} (τ=${currentTemperature.toFixed(1)})`;
            softmaxEl.textContent = `${alpha.toFixed(3)} (${pct}%)`;

            // Dynamic Linguistic Diagnosis Narrative
            let diagnosis: string;
            if (
              scenarios[currentScenarioKey] &&
              currentTokens.length === scenarios[currentScenarioKey].tokens.length
            ) {
              if (
                currentQueryIndex === scenarios[currentScenarioKey].defaultQueryIndex &&
                currentKeyIndex === scenarios[currentScenarioKey].defaultKeyIndex
              ) {
                diagnosis = scenarios[currentScenarioKey].description;
              } else if (currentQueryIndex === scenarios[currentScenarioKey].defaultQueryIndex) {
                diagnosis = `此配對非主導關聯。模型正在衡量代名詞「${qTok}」與非目標詞「${kTok}」的相容性。由於兩者在高維語意空間中特徵不匹配，內積僅得 ${rawScore.toFixed(1)}，經 Softmax 後僅分配到 ${pct}% 之邊際權重。`;
              } else {
                diagnosis = `正在檢視自注意力矩陣中任意兩詞「${qTok}」與「${kTok}」的關聯。注意當溫度係數 τ 降低時，高分詞彙將迅速吞噬其餘詞彙之機率；若取消 √d<sub>k</sub> 縮放，分數差距會被劇烈放大，導致梯度飽和。`;
              }
            } else {
              diagnosis = `自訂語句分析中：第 ${currentQueryIndex} 格「${qTok}」作為 Query，與第 ${currentKeyIndex} 格「${kTok}」之 Key 向量進行縮放點積比對。在此組參數設定下，該詞對獲得 ${pct}% 的注意力流通權重。`;
            }

            if (!isScalingEnabled) {
              diagnosis +=
                ' <span class="text-red font-semibold">【警告：已停用 √d<sub>k</sub> 縮放】點積未受方差抑制，數值過大使得 Softmax 進入極度尖銳的梯度飽和區，極端壓抑其他詞彙的學習梯度！</span>';
            }

            narrativeEl.innerHTML = diagnosis;
          }

          // Setup Event Listeners
          function setupLabListeners() {
            // Scenario switcher
            document
              .querySelectorAll<HTMLButtonElement>('.attention-scenario-btn')
              .forEach((btn) => {
                btn.addEventListener('click', () => {
                  document.querySelectorAll('.attention-scenario-btn').forEach((b) => {
