---
import BaseLayout from '../../layouts/BaseLayout.astro';
import { withBase } from '../../lib/paths';
import PaperReadingLayout from '../../components/PaperReadingLayout.astro';
import PaperSectionHeader from '../../components/PaperSectionHeader.astro';
import AsideCard from '../../components/AsideCard.astro';
import Callout from '../../components/Callout.astro';
import AuthorGrid from '../../components/AuthorGrid.astro';
import EvidenceList from '../../components/EvidenceList.astro';
import PaperNavigation from '../../components/PaperNavigation.astro';
import PaperMeta from '../../components/PaperMeta.astro';
import StoryRail from '../../components/StoryRail.astro';
import {
  paper,
  dpoSources,
} from '../../content/papers/direct-preference-optimization-your-language-model-is-secretly-a-reward-model';

const shell = 'mx-auto w-[calc(100%-2rem)] max-w-[1120px]';

interface StoryEvent {
  year: string;
  label: string;
  title: string;
  body: string;
  status?: 'past' | 'current' | 'future';
}

const timelineEvents: StoryEvent[] = [
  {
    year: '1952',
    label: '公理奠基 / BRADLEY-TERRY',
    title: '成對比較與偏好選擇的機率公理',
    body: 'Bradley 與 Terry 提出經典選擇模型，將人類對兩項事物的二元比較轉化為隱含得分的 Sigmoid 機率函數，奠定現代對齊演算法的數學基石。',
    status: 'past',
  },
  {
    year: '2017',
    label: '深度偏好 / DEEP RLHF',
    title: '人類反饋強化學習登陸深度學習',
    body: 'Christiano、Leike 與 Amodei 等人首次將人類成對偏好引入深度強化學習，證明非專家標註足以訓練複雜策略，為大模型對齊探路。',
    status: 'past',
  },
  {
    year: '2022.03',
    label: '典範確立 / INSTRUCTGPT',
    title: 'RLHF 馴服千億大模型與 PPO 實務管線',
    body: 'OpenAI 發表 InstructGPT，確立 SFT → Reward Model → PPO 強化學習黃金三階段，但同時也將業界帶入了維護四座模型的工程泥淖。',
    status: 'past',
  },
  {
    year: '2023.05',
    label: '本篇焦點 / DIRECT PREFERENCE',
    title: '語言模型本身就是獎勵函數：DPO 革命',
    body: '史丹佛大學團隊證明受限 RLHF 存在精確代數閉式解，直接將最佳策略勝算比代入偏好模型，以單一二元交叉熵消滅顯式獎勵模型與強化學習採樣迴圈。',
    status: 'current',
  },
  {
    year: '2023.10',
    label: '理論拓展 / IPO & BEYOND',
    title: '隱式獎勵正規化與離線對齊繁榮',
    body: 'DeepMind 提出 IPO 修正 DPO 潛在的過度擬合問題，隨後 KTO、ORPO、SimPO 等直接偏好演算法百花齊放，徹底重構後訓練版圖。',
    status: 'future',
  },
];
---

<BaseLayout title={`${paper.chineseTitle} | THE LLM`} description={paper.abstractSummary}>
  <!-- HERO HEADER (UNIVERSAL INVARIANT) -->
  <header class={`${shell} pt-10`}>
    <div class="flex gap-3 font-mono text-sm uppercase tracking-[0.08em] text-muted">
      <a class="text-red underline underline-offset-4" href={withBase('/')}>
        THE LLM
      </a>
      <span aria-hidden="true">/</span>
      <span>第 10 章</span>
    </div>

    <div class="grid grid-cols-1 items-end gap-12 py-16 lg:grid-cols-[1.15fr_0.85fr] lg:gap-24">
      <div>
        <p class="mb-5 font-mono text-sm font-semibold uppercase tracking-[0.12em] text-red">
          VOL. 10 / DIRECT PREFERENCE
        </p>

        <h1 class="m-0 font-display text-4xl sm:text-5xl lg:text-6xl xl:text-7xl leading-tight tracking-[-0.04em] text-ink">
          <span class="block">Direct Preference Optimization:</span>
          <em class="block">Your Language Model is Secretly a Reward Model</em>
        </h1>

        <p class="mt-8 max-w-[52ch] text-lg leading-8 text-muted">
          在{' '}
          <a
            href={withBase(
              '/papers/training-language-models-to-follow-instructions-with-human-feedback',
            )}
            class="text-primary hover:underline font-medium"
          >
            InstructGPT
          </a>
          開啟人類反饋強化學習（RLHF）時代後，全球工程師卻陷入了「<strong>PPO 地獄</strong>
          」：原本用於連續控制的
          <strong>PPO</strong>（近端策略最佳化，Proximal Policy
          Optimization）演算法，在面對千億離散文字模型時極端脆弱，記憶體必須同時常駐四座神經網路，超參數極為敏感且採樣極易崩潰。史丹佛大學團隊以極其精妙的數學推導打破僵局，提出
          <strong>DPO</strong>（直接偏好最佳化，Direct Preference
          Optimization）——證明語言模型本身就內建了完美的獎勵函數，徹底消滅顯式獎勵模型與強化學習迴圈，僅憑單一二元交叉熵損失，便能直接且穩定地完成人類偏好對齊。
        </p>
      </div>

      <aside
        class="border-t-4 border-red bg-surface p-6 shadow-editorial"
        aria-label="這篇論文的一句評語"
      >
        <p class="mb-4 sm:mb-6 font-mono text-xs sm:text-sm font-semibold uppercase tracking-[0.12em] text-red">
          一句評語 / THE SHORT VERDICT
        </p>
        <p class="m-0 max-w-[20ch] sm:max-w-[22ch] font-display text-2xl sm:text-3xl leading-tight text-ink">
          你的語言模型從頭到尾都藏著一座完美的獎勵模型。
        </p>
        <p class="mt-6 mb-0 text-sm sm:text-base leading-relaxed sm:leading-7 text-muted">
          DPO（直接偏好最佳化）證明了受限強化學習存在精確代數閉式解，以極簡的二元交叉熵消解了繁瑣脆弱的
          PPO（近端策略最佳化）採樣迴圈，開啟了現代大模型後訓練的平民化對齊浪潮。
        </p>
      </aside>
    </div>

    <!-- 論文規格元數據 -->
    <PaperMeta
      year={paper.year}
      venue={paper.venue}
      readTime="26 分鐘"
      difficulty="核心架構"
      doi={{
        value: paper.doi.value,
        url: paper.doi.url,
      }}
    />
  </header>

  <!-- 歷史進程 StoryRail -->
  <section class="border-y border-line bg-surface/50 py-12" aria-label="歷史轉折總覽">
    <div class={shell}>
      <p class="mb-4 font-mono text-xs font-semibold uppercase tracking-[0.12em] text-red">
        歷史演進視圖 / THE HISTORICAL CONTINUUM
      </p>
      <StoryRail events={timelineEvents} />
    </div>
  </section>

  <!-- 主內文區域 -->
  <main>
    <!-- ========================================== -->
    <!-- 章節 01 · 強化學習的對齊代價與 PPO 泥淖 -->
    <!-- ========================================== -->
    <section class={`${shell} py-16 sm:py-24 border-b border-line`}>
      <PaperSectionHeader
        kicker="章節 01 · 強化學習的對齊代價與 PPO 泥淖 / THE IMPASSE"
        title="馴服機器的昂貴代價：當對齊卡在四座神經網路的記憶體深淵"
      />

      <PaperReadingLayout class="text-base leading-8 text-ink">
        <div class="space-y-6">
          <p>
            2022 年底，ChatGPT
            的橫空出世震撼了全球文明，也讓「人類反饋強化學習（RLHF）」從學術論文的邊陲探索一躍成為人工智慧最神聖的通關密語。在
            <a
              href={withBase(
                '/papers/training-language-models-to-follow-instructions-with-human-feedback',
              )}
              class="text-primary hover:underline font-medium"
            >
              InstructGPT
            </a>
            奠定的黃金典範中，未經對齊的自回歸語言模型就像一座深不可測但喜怒無常的圖書館：它能通曉萬卷典籍，卻只懂得機械地預測下一個
            token，動輒產生幻覺、胡言亂語或噴發有毒偏見。RLHF
            以精妙的三部曲重塑了這座圖書館的守門人——先以示範數據微調（SFT），接著訓練一個評估人類滿意度的獎勵模型（Reward
            Model），最後使用近端策略最佳化（PPO）強化學習演算法，引導模型學會在回答中最大化獎勵得分。
          </p>

          <p>
            然而，當全球研究者與工程團隊試圖在開源世界複製這套魔法時，他們遭遇了一堵難以逾越的工程高牆。PPO
            雖然在理論上具備策略梯度受控更新的數學保證，但在面對以數百億離散文字為動作空間的自回歸神經網路時，其系統複雜度與脆弱性被放大到了極致。
          </p>

          <p>
            首當其衝的是令人窒息的硬體開銷。在標準 PPO
            訓練迴圈中，為了計算每一步的更新梯度，計算節點必須在 GPU 顯示記憶體中
            <strong>同時常駐四座獨立的神經網路</strong>：
          </p>

          <ul class="list-disc pl-6 space-y-2 text-muted">
            <li>
              <strong>
                Actor（行動者策略模型 π<sub>θ</sub>）
              </strong>
              ：負責接收輸入 prompt 並即時生成多條文本回覆，是唯一接受梯度反向傳播更新的主角。
            </li>
            <li>
              <strong>
                Critic（價值評估網路 V<sub>ϕ</sub>）
              </strong>
              ：負責預測當前序列各個 token
              狀態的預期回報，用於計算廣義優勢估計（GAE），需要單獨維護巨大的全連接價值輸出頭與獨立梯度。
            </li>
            <li>
              <strong>
                Reward Model（顯式獎勵模型 r<sub>ψ</sub>）
              </strong>
              ：在第二階段以人類成對排序預先訓練完畢的神經網路，負責為 Actor
              生成的整段文本給予純量評分，必須凍結權重常駐記憶體。
            </li>
            <li>
              <strong>
                Reference Model（基準策略模型 π<sub>ref</sub>）
              </strong>
              ：通常是 SFT 階段結束時的原始模型快照，用於計算 KL 散度懲罰（β D<sub>KL</sub>），防止
              Actor 在追逐獎勵分數時徹底發瘋、喪失流暢語言生成能力。
            </li>
          </ul>

          <p>
            這意味著，如果你想對齊一個 700 億參數的基座模型（如{' '}
            <a
              href={withBase('/papers/llama-open-and-efficient-foundation-language-models')}
              class="text-primary hover:underline font-medium"
            >
              LLaMA-70B
            </a>
            ），僅僅為了把這四個模型的權重、最佳化器狀態（Optimizer
            States）與活化值（Activations）塞進記憶體，就需要數十顆昂貴的 A100/H100
            顯示卡進行複雜的張量平行與管線平行劃分。對於算力資源有限的大學實驗室或獨立開源團隊而言，這道門檻不亞於科技巨頭築起的數位護城河。
          </p>

          <Callout variant="alert" title="PPO 的三大阿基里斯腱：方差、敏感度與獎勵作弊">
            <p class="m-0 text-muted leading-relaxed">
              除了令人望而生畏的硬體門檻，PPO 演算法本身在離散語言空間中更存在嚴重的數值不穩定性：
              <br />
              <br />
              <strong>1. 在線採樣的高方差與延遲瓶頸</strong>：PPO
              屬於在線策略（On-policy）演算法，每更新一次參數，都必須讓 Actor
              完整生成一批全新的文本回覆。這種依賴推論解碼的步驟成為訓練集群的吞吐黑洞，並隨採樣長度呈階梯式暴跌。
              <br />
              <br />
              <strong>2. 價值網路（Critic）難以擬合</strong>
              ：在圍棋或電玩遊戲中，每一步棋盤狀態都有明確的物理規律；但在自然語言中，一篇文章好不好看往往取決於結尾的反轉或前文的鋪陳。在長序列中要求
              Critic 準確預測「第 5 個 token
              的長期價值」，其數值噪聲極其巨大，直接導致策略梯度方向劇烈擺盪。
              <br />
              <br />
              <strong>3. 獎勵作弊（Reward Hacking）</strong>
              ：獎勵模型本身也是一個具有盲點的神經網路。當 PPO 不斷推動 Actor
              鑽取高分時，模型很快會學會諂媚、機械式堆砌禮貌詞彙或無限拉長句子，把分數刷到破表，但內容實質卻變得空洞無比。
            </p>
          </Callout>

          <p>
            面對這片由複雜程式碼、脆落超參數與四倍硬體成本交織而成的泥淖，史丹佛大學的 Rafael
            Rafailov 與 Chelsea Finn 團隊提出了一個直擊靈魂的理論質疑：
          </p>

          <blockquote class="border-l-4 border-red pl-4 italic my-6 text-muted font-display text-lg">
            「我們費盡千辛萬苦訓練一個神經網路去預測分數，再用另一個複雜的強化學習演算法去追逐這個分數——這中間的『獎勵模型』與『PPO
            策略梯度』，真的不可或缺嗎？如果我們的終極目標只是讓好回覆的機率上升、壞回覆的機率下降，我們能不能直接用微調語言模型的方式，一步到位完成這一切？」
          </blockquote>
        </div>

        <aside slot="rail" class="space-y-6">
          <AsideCard kicker="術語辭典 / TERMINOLOGY" title="PPO vs. DPO 核心概念" variant="surface">
            <div class="space-y-3 text-sm text-muted leading-relaxed">
              <p class="m-0">
                <strong class="text-ink">PPO（近端策略最佳化）</strong>
                ：經典強化學習演算法。模型一邊在線生成回覆，一邊由獨立的「獎勵模型」打分，再透過「價值模型」計算梯度更新。宛如教練在跑道邊看學生一邊跑一邊打分試錯，極度耗費視訊記憶體且訓練容易震盪崩潰。
              </p>
              <p class="m-0">
                <strong class="text-ink">DPO（直接偏好最佳化）</strong>：史丹佛團隊開創的無 RL
                對齊技術。直接拿人類預先挑好的「好回答 vs.
                壞回答」成對數據計算偏好勝算比，將對齊簡化為如同微調（SFT）般的直接二元交叉熵分類，徹底告別試錯迴圈。
              </p>
            </div>
          </AsideCard>

          <AsideCard kicker="術語辭典 / TERMINOLOGY" title="KL 散度約束" variant="paper">
            <p class="text-sm text-muted m-0 leading-relaxed">
              Kullback-Leibler
              Divergence，衡量兩個機率分佈差異的非對稱指標。在對齊任務中作為約束項（β D<sub>KL</sub>
              (π<sub>θ</sub> ∥ π<sub>ref</sub>)），防止模型在追逐偏好時過度偏離原始 SFT
              模型，避免語言能力退化或胡言亂語。
            </p>
          </AsideCard>

          <AsideCard kicker="系統瓶頸 / ARCHITECTURE" title="PPO 的四座大山" variant="surface">
            <p class="text-sm text-muted m-0 leading-relaxed">
              Actor（策略）、Critic（價值）、Reward（獎勵）、Reference（參考）。四座千億模型同時並行於顯示記憶體，使得通訊開銷與視訊記憶體佔用成倍翻升，構成了科技巨頭之外無人能輕易承擔的對齊重負。
            </p>
          </AsideCard>
        </aside>
      </PaperReadingLayout>
    </section>

    <!-- ========================================== -->
    <!-- 圖表 01：PPO 與 DPO 系統架構對比 -->
    <!-- ========================================== -->
    <section class={`${shell} py-16 border-b border-line`}>
      <div class="mb-8">
        <p class="font-mono text-xs font-semibold uppercase tracking-[0.12em] text-red">
          系統架構對比圖 / PIPELINE CONTRAST
        </p>
        <h3 class="font-display text-2xl sm:text-3xl text-ink mt-2">
          FIGURE 10.1：告別四模型繁瑣迴圈——從 PPO 到 DPO 的架構大瘦身
        </h3>
        <p class="text-sm sm:text-base text-muted mt-2 max-w-3xl">
          左圖為經典 PPO 管線：在線採樣、四模型共存、價值網絡與獎勵模型雙重逼近；右圖為 DPO
          管線：利用封閉解代數對消，僅需載入單一策略與凍結參考模型，在離線偏好數據上實施標準自監督二元交叉熵反向傳播。
        </p>
      </div>

      <div class="border border-line bg-surface p-4 sm:p-8 overflow-x-auto">
        <svg
          viewBox="0 0 960 480"
          class="w-full h-auto min-w-[760px] font-sans text-xs"
          role="img"
          aria-label="PPO 與 DPO 系統架構對比流程圖"
        >
          <rect width="960" height="480" fill="#fcfaf6" rx="8"></rect>

          <!-- PPO 區塊 (左) -->
          <g transform="translate(30, 20)">
            <rect
              width="430"
              height="440"
              fill="#fff"
              stroke="#e5e0d8"
              stroke-width="1.5"
              rx="6"
              stroke-dasharray="4 4"
            ></rect>
            <text x="20" y="32" class="font-mono font-bold text-red text-sm">
              TRADITIONAL RLHF (PPO PIPELINE)
            </text>
            <text x="20" y="50" class="fill-muted text-xs">
              複雜度：4 座神經網路常駐視訊記憶體 + 在線推論採樣
            </text>

            <!-- 輸入 Prompt -->
            <rect
              x="20"
              y="70"
              width="110"
              height="40"
              fill="#f6f1e7"
              stroke="#1e2224"
              stroke-width="1.5"
              rx="4"
            ></rect>
            <text x="75" y="94" text-anchor="middle" class="font-mono font-bold fill-ink">
              Prompt x
            </text>

            <!-- 箭頭到 Actor -->
            <path
              d="M 130 90 L 165 90"
              stroke="#1e2224"
              stroke-width="1.5"
              fill="none"
              marker-end="url(#arrow-ink)"
            ></path>

            <!-- Actor 模型 (可訓練) -->
            <rect
              x="170"
              y="70"
              width="130"
              height="50"
              fill="#b6412c"
              stroke="#1e2224"
              stroke-width="1.5"
              rx="4"
            ></rect>
            <text x="235" y="92" text-anchor="middle" class="font-bold fill-white">
              Actor Policy π
              <tspan font-size="10" dy="2">
                θ
              </tspan>
            </text>
            <text x="235" y="108" text-anchor="middle" font-size="11" class="fill-white/80">
              (可訓練策略模型)
            </text>

            <!-- 生成回覆 y -->
            <path
              d="M 300 95 L 340 95"
              stroke="#1e2224"
              stroke-width="1.5"
              fill="none"
              marker-end="url(#arrow-ink)"
            ></path>
            <rect
              x="345"
              y="75"
              width="65"
              height="35"
              fill="#f6f1e7"
              stroke="#1e2224"
              stroke-width="1.5"
              rx="4"
            ></rect>
            <text x="377" y="97" text-anchor="middle" class="font-mono font-bold fill-ink">
              Rollout y
            </text>

            <!-- 分流到 3 個評估者 -->
            <path
              d="M 377 110 L 377 155"
              stroke="#1e2224"
              stroke-width="1.5"
              stroke-dasharray="3 3"
              fill="none"
            ></path>

            <!-- 1. Reward Model -->
            <g transform="translate(20, 150)">
              <rect
                x="0"
                y="0"
                width="390"
                height="45"
