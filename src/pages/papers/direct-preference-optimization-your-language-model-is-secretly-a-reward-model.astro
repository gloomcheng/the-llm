  <script>
    document.addEventListener('DOMContentLoaded', () => {
      // 1. Tab Switching (Algebraic Cancellation vs Dynamic Gradient Weighting)
      const tabAlgebra = document.getElementById('dpo-tab-algebra');
      const tabGradient = document.getElementById('dpo-tab-gradient');
      const panelAlgebra = document.getElementById('dpo-panel-algebra');
      const panelGradient = document.getElementById('dpo-panel-gradient');

      if (tabAlgebra && tabGradient && panelAlgebra && panelGradient) {
        tabAlgebra.addEventListener('click', () => {
          tabAlgebra.setAttribute('aria-selected', 'true');
          tabGradient.setAttribute('aria-selected', 'false');
          tabAlgebra.className =
            'px-4 py-2 font-mono text-xs sm:text-sm font-bold border-2 border-red bg-red text-surface transition cursor-pointer';
          tabGradient.className =
            'px-4 py-2 font-mono text-xs sm:text-sm font-medium border border-ink/40 bg-surface text-ink hover:border-ink hover:bg-paper transition cursor-pointer';
          panelAlgebra.classList.remove('hidden');
          panelGradient.classList.add('hidden');
        });

        tabGradient.addEventListener('click', () => {
          tabGradient.setAttribute('aria-selected', 'true');
          tabAlgebra.setAttribute('aria-selected', 'false');
          tabGradient.className =
            'px-4 py-2 font-mono text-xs sm:text-sm font-bold border-2 border-red bg-red text-surface transition cursor-pointer';
          tabAlgebra.className =
            'px-4 py-2 font-mono text-xs sm:text-sm font-medium border border-ink/40 bg-surface text-ink hover:border-ink hover:bg-paper transition cursor-pointer';
          panelGradient.classList.remove('hidden');
          panelAlgebra.classList.add('hidden');
        });
      }

      // 2. Module 1: Algebraic Cancellation Sandbox
      const betaSlider = document.getElementById('dpo-beta-slider') as HTMLInputElement | null;
      const ywSlider = document.getElementById('dpo-yw-ratio-slider') as HTMLInputElement | null;
      const ylSlider = document.getElementById('dpo-yl-ratio-slider') as HTMLInputElement | null;

      const betaVal = document.getElementById('dpo-beta-val');
      const ywVal = document.getElementById('dpo-yw-ratio-val');
      const ylVal = document.getElementById('dpo-yl-ratio-val');

      const rwVal = document.getElementById('dpo-rw-val');
      const rlVal = document.getElementById('dpo-rl-val');
      const diffRw = document.getElementById('dpo-diff-rw');
      const diffRl = document.getElementById('dpo-diff-rl');
      const diffResult = document.getElementById('dpo-diff-result');

      const mDelta = document.getElementById('dpo-m-delta');
      const mProb = document.getElementById('dpo-m-prob');
      const mLoss = document.getElementById('dpo-m-loss');

      function updateAlgebra() {
        if (!betaSlider || !ywSlider || !ylSlider) return;

        const beta = parseFloat(betaSlider.value);
        const ratioW = parseFloat(ywSlider.value);
        const ratioL = parseFloat(ylSlider.value);

        if (betaVal) betaVal.textContent = beta.toFixed(2);
        if (ywVal) ywVal.textContent = `${ratioW.toFixed(2)}×`;
        if (ylVal) ylVal.textContent = `${ratioL.toFixed(2)}×`;

        const rHatW = beta * Math.log(ratioW);
        const rHatL = beta * Math.log(ratioL);
        const deltaR = rHatW - rHatL;

        const prob = 1 / (1 + Math.exp(-deltaR));
        const loss = -Math.log(Math.max(1e-7, prob));

        const rHatWStr = (rHatW > 0 ? '+' : '') + rHatW.toFixed(3);
        const rHatLStr = (rHatL > 0 ? '+' : '') + rHatL.toFixed(3);
        const deltaStr = (deltaR > 0 ? '+' : '') + deltaR.toFixed(3);

        if (rwVal) rwVal.textContent = rHatWStr;
        if (rlVal) rlVal.textContent = rHatLStr;
        if (diffRw) diffRw.textContent = rHatWStr;
        if (diffRl) diffRl.textContent = rHatLStr;
        if (diffResult) diffResult.textContent = deltaStr;

        if (mDelta) mDelta.textContent = deltaStr;
        if (mProb) mProb.textContent = `${(prob * 100).toFixed(1)}%`;
        if (mLoss) mLoss.textContent = loss.toFixed(3);
      }

      if (betaSlider && ywSlider && ylSlider) {
        betaSlider.addEventListener('input', updateAlgebra);
        ywSlider.addEventListener('input', updateAlgebra);
        ylSlider.addEventListener('input', updateAlgebra);
        updateAlgebra();
      }

      // 3. Module 2: Dynamic Gradient Weighting Wind Tunnel
      const btnWrong = document.getElementById('dpo-scenario-wrong');
      const btnTie = document.getElementById('dpo-scenario-tie');
      const btnRight = document.getElementById('dpo-scenario-right');

      const weightNum = document.getElementById('dpo-weight-num');
      const weightBar = document.getElementById('dpo-weight-bar');
      const weightDesc = document.getElementById('dpo-weight-desc');

      const forceW = document.getElementById('dpo-force-w');
      const forceL = document.getElementById('dpo-force-l');
      const barW = document.getElementById('dpo-bar-w');
      const barL = document.getElementById('dpo-bar-l');

      interface ScenarioConfig {
        weight: number;
        desc: string;
        forceVal: string;
        color: string;
      }

      const scenarios: Record<string, ScenarioConfig> = {
        wrong: {
          weight: 0.824,
          desc: '模型當前嚴重看好落敗回覆（r̂_l > r̂_w）！誤差權重接近 1.0，產生最強推拉梯度，強制調高勝出者機率並重重打壓落敗者。',
          forceVal: '0.82',
          color: 'bg-red',
        },
        tie: {
          weight: 0.5,
          desc: '模型當前對兩個選項難分伯仲（r̂_w ≈ r̂_l）！誤差權重恰好為 0.50，以穩健中庸的梯度步幅推動策略向勝者傾斜。',
          forceVal: '0.50',
          color: 'bg-amber-600',
        },
        right: {
          weight: 0.058,
          desc: '模型已經完全掌握正確偏好（r̂_w ≫ r̂_l）！誤差權重自動衰減至接近 0，梯度自我阻尼避免過度擬合與策略漂移。',
          forceVal: '0.06',
          color: 'bg-emerald-700',
        },
      };

      function setScenario(key: string) {
        const sc = scenarios[key];
        if (!sc) return;

        [btnWrong, btnTie, btnRight].forEach((b) => {
          if (b) {
            b.className =
              'px-3 py-1.5 font-mono text-xs font-medium border border-ink/40 bg-surface text-ink hover:border-ink transition cursor-pointer';
          }
        });

        if (key === 'wrong' && btnWrong) {
          btnWrong.className =
            'px-3 py-1.5 font-mono text-xs font-bold bg-red text-surface transition cursor-pointer';
        } else if (key === 'tie' && btnTie) {
          btnTie.className =
            'px-3 py-1.5 font-mono text-xs font-bold bg-ink text-surface transition cursor-pointer';
        } else if (key === 'right' && btnRight) {
          btnRight.className =
            'px-3 py-1.5 font-mono text-xs font-bold bg-emerald-700 text-surface transition cursor-pointer';
        }

        if (weightNum) {
          weightNum.textContent = sc.weight.toFixed(3);
          weightNum.className = `font-mono text-3xl font-bold ${key === 'wrong' ? 'text-red' : key === 'tie' ? 'text-ink' : 'text-emerald-700'}`;
        }
        if (weightBar) {
          weightBar.style.width = `${(sc.weight * 100).toFixed(1)}%`;
          weightBar.className = `h-full ${sc.color} transition-all duration-300`;
        }
        if (weightDesc) {
          weightDesc.textContent = sc.desc;
        }

        if (forceW) forceW.textContent = `+${sc.forceVal}`;
        if (forceL) forceL.textContent = `-${sc.forceVal}`;
        if (barW) barW.style.width = `${(sc.weight * 100).toFixed(1)}%`;
        if (barL) barL.style.width = `${(sc.weight * 100).toFixed(1)}%`;
      }

      if (btnWrong) btnWrong.addEventListener('click', () => setScenario('wrong'));
      if (btnTie) btnTie.addEventListener('click', () => setScenario('tie'));
      if (btnRight) btnRight.addEventListener('click', () => setScenario('right'));

      setScenario('wrong');
    });
  </script>
</BaseLayout>
