  <!-- 客戶端互動腳本 -->
  <script>
    // ==========================================
    // 1. 因果注意力遮罩矩陣互動腳本
    // ==========================================
    const tokens = ['科技', '巨頭', '在', '台灣', '設立', '研發', '中心'];
    const matrixGrid = document.getElementById('causal-matrix-grid');
    const targetText = document.getElementById('causal-target-text');
    const explanation = document.getElementById('causal-explanation');
    const buttons = document.querySelectorAll('.causal-btn');

    const explanations = [
      '當模型處理第 1 個詞「科技」時，只能看見自己。未來 6 個詞（巨頭、在、台灣…）皆被因果遮罩賦予 -∞，權重為精確的零。',
      '處理第 2 個詞「巨頭」時，注意力僅能往前流向「科技」與「巨頭」，模型開始計算兩者之間的合成語意。',
      '處理第 3 個詞「在」時，結合了「科技 巨頭」的主詞特徵，準備接收後續的地點受詞。',
      '處理第 4 個詞「台灣」時，模型將主詞「科技 巨頭」與介系詞「在」進行交叉比對，鎖定在地化語義。',
      '處理第 5 個詞「設立」時，模型注意力強烈聚焦於主詞「科技巨頭」與地點「台灣」，推斷動詞動向。',
      '處理第 6 個詞「研發」時，模型已掌握完整的前文語境，精確預測即將出現的設施名詞。',
      '處理第 7 個詞「中心」時，全句的歷史因果已被完整編碼，此時可用於預測句尾標點或承接下一句。',
    ];

    function updateCausalMatrix(focusIdx: number) {
      if (!matrixGrid || !targetText || !explanation) return;

      matrixGrid.innerHTML = '';
      for (let r = 0; r < 7; r++) {
        for (let c = 0; c < 7; c++) {
          const cell = document.createElement('div');
          cell.className = 'py-1 text-[11px] font-mono transition-colors';
          if (c > r) {
            // 未來位置：遮罩 -inf
            cell.textContent = '-∞';
            cell.className += ' text-muted/30 bg-ink/5';
          } else {
            // 合法注意力位置
            cell.textContent = '1';
            if (r === focusIdx) {
              cell.className += ' text-white bg-red font-bold';
            } else {
              cell.className += ' text-ink bg-line/40';
            }
          }
          matrixGrid.appendChild(cell);
        }
      }

      targetText.textContent = `根據前文推演至「${tokens[focusIdx]}」`;
      explanation.textContent = explanations[focusIdx];

      buttons.forEach((btn, idx) => {
        if (idx === focusIdx) {
          btn.classList.add('bg-red', 'text-white', 'border-red');
          btn.classList.remove('bg-canvas', 'text-ink', 'border-line');
          btn.setAttribute('aria-selected', 'true');
        } else {
          btn.classList.remove('bg-red', 'text-white', 'border-red');
          btn.classList.add('bg-canvas', 'text-ink', 'border-line');
          btn.setAttribute('aria-selected', 'false');
        }
      });
    }

    buttons.forEach((btn) => {
      btn.addEventListener('click', () => {
        const idx = Number(btn.getAttribute('data-idx'));
        updateCausalMatrix(idx);
      });
    });

    updateCausalMatrix(0);

    // ==========================================
    // 2. 任務統一序列化格式切換腳本
    // ==========================================
    interface TaskConfig {
      tokens: string[];
      mechanism: string;
      benchmark: string;
    }

    const taskConfigs: Record<string, TaskConfig> = {
      classification: {
        tokens: ['[Start]', '文本內容 (Text)', '[Extract]'],
        mechanism:
          '將整段文本夾在 [Start] 與 [Extract] 之間。經過 12 層 Transformer 解碼後，末尾 [Extract] 符號的最後一層隱藏狀態向量 <em>h</em><sub><em>l</em></sub><sup><em>m</em></sup> 匯聚了全文語意，直接輸入單一線性投影矩陣 <em>W</em><sub><em>y</em></sub> 輸出類別分佈。',
        benchmark: 'SST-2 情緒分類、IMDb 電影正負評分類。',
      },
      entailment: {
        tokens: ['[Start]', '前提 (Premise)', '[Delim]', '假設 (Hypothesis)', '[Extract]'],
        mechanism:
          '以定界符 [Delim] 隔開兩句話。解碼器在計算注意力時，後方的假設可主動回溯比對前方的每個詞。最終於 [Extract] 處計算三分類（蘊含 / 矛盾 / 中立）之 Logits。',
        benchmark: 'SNLI (史丹佛自然語言推論)、MNLI (多領域自然語言推論)。',
      },
      similarity: {
        tokens: [
          '[Start]',
          '文本 A',
          '[Delim]',
          '文本 B',
          '[Extract]',
          '+',
          '[Start]',
          '文本 B',
          '[Delim]',
          '文本 A',
          '[Extract]',
        ],
        mechanism:
          '由於語義相似度不具方向性（A 似 B 則 B 似 A），GPT-1 將兩種順序分別送入模型，產生各自的 [Extract] 向量後進行逐元素相加（Element-wise Addition），再送入線性層評分，徹底消除順序偏見。',
        benchmark: 'QQP (Quora 重複問題偵測)、MRPC (微軟改寫語料庫)。',
      },
      qa: {
        tokens: ['[Start]', '文章與問題 (Context)', '[Delim]', '候選答案 (Answer ᵢ)', '[Extract]'],
        mechanism:
          '若問題有 N 個候選答案，則將文本與問題複製 N 份，分別拼接各選項。模型計算出 N 個不同的 [Extract] 向量後，通過同一套線性層投影，並在各選項間進行 Softmax 競爭！',
        benchmark: 'RACE 國高中英語閱讀理解多選題、Story Cloze 克漏字。',
      },
    };

    const taskTabs = document.querySelectorAll('.task-tab-btn');
    const seqDisplay = document.getElementById('task-sequence-display');
    const mechDesc = document.getElementById('task-mechanism-desc');
    const benchDesc = document.getElementById('task-benchmark-desc');

    function updateTaskTab(taskKey: string) {
      const config = taskConfigs[taskKey];
      if (!config || !seqDisplay || !mechDesc || !benchDesc) return;

      seqDisplay.innerHTML = '';
      config.tokens.forEach((tok) => {
        const span = document.createElement('span');
        if (tok.startsWith('[')) {
          span.className = 'px-2 py-1 bg-red/15 text-red border border-red/30 font-bold';
        } else if (tok === '+') {
          span.className = 'px-1 text-ink font-bold';
        } else {
          span.className = 'px-2 py-1 bg-surface border border-line text-ink';
        }
        span.textContent = tok;
        seqDisplay.appendChild(span);
      });

      mechDesc.innerHTML = config.mechanism;
      benchDesc.textContent = config.benchmark;

      taskTabs.forEach((tab) => {
        if (tab.getAttribute('data-task') === taskKey) {
          tab.classList.add('bg-red', 'text-white', 'border-red');
          tab.classList.remove('bg-canvas', 'text-ink', 'border-line');
          tab.setAttribute('aria-selected', 'true');
        } else {
          tab.classList.remove('bg-red', 'text-white', 'border-red');
          tab.classList.add('bg-canvas', 'text-ink', 'border-line');
          tab.setAttribute('aria-selected', 'false');
        }
      });
    }

    taskTabs.forEach((tab) => {
      tab.addEventListener('click', () => {
        const key = tab.getAttribute('data-task') || 'classification';
        updateTaskTab(key);
      });
    });

    updateTaskTab('classification');

    // ==========================================
    // 3. 動態擾動實驗單選監聽腳本
    // ==========================================
    interface PerturbData {
      entail: number;
      contra: number;
      neut: number;
      desc: string;
    }

    const perturbRecords: Record<string, PerturbData> = {
      entailment: {
        entail: 96.2,
        contra: 1.8,
        neut: 2.0,
        desc: '「東部各縣市」與「花蓮、台東」在地理常識空間中具備高度蘊含關係，而「停止上班上課」直接對應「無需到班出勤」。在跨過 [Delim] 的多頭自注意力交互中，Extract Token 聚合了兩句的同義語意，輸出極高的蘊含信賴度。',
      },
      contradiction: {
        entail: 2.1,
        contra: 95.1,
        neut: 2.8,
        desc: '前提明確宣告「東部停止上班上課」，但假設卻宣稱「全台灣照常上班上課」。「照常」與「停止」在自回歸注意力中發生劇烈語意衝突，Extract 向量在線性分類頭中激發出高達 95.1% 的壓倒性矛盾 Logits！',
      },
      neutral: {
        entail: 11.2,
        contra: 6.4,
        neut: 82.4,
        desc: '雖然強烈颱風確實可能登陸宜蘭，但前提中僅提及「發布陸上警報」與「停班停課」，完全未提及確切登陸地點。模型精確捕捉到資訊缺口，判定為中立（既不保證發生，亦非邏輯矛盾）。',
      },
    };

    const radios = document.querySelectorAll('input[name="perturb-opt"]');
    const barEntail = document.getElementById('prob-bar-entail');
    const barContra = document.getElementById('prob-bar-contra');
    const barNeut = document.getElementById('prob-bar-neut');
    const valEntail = document.getElementById('prob-val-entail');
    const valContra = document.getElementById('prob-val-contra');
    const valNeut = document.getElementById('prob-val-neut');
    const analysisText = document.getElementById('perturb-analysis-text');

    radios.forEach((radio) => {
      radio.addEventListener('change', (e) => {
        const val = (e.target as HTMLInputElement).value;
        const data = perturbRecords[val];
        if (
          !data ||
          !barEntail ||
          !barContra ||
          !barNeut ||
          !valEntail ||
          !valContra ||
          !valNeut ||
          !analysisText
        )
          return;

        barEntail.style.width = `${data.entail}%`;
        barContra.style.width = `${data.contra}%`;
        barNeut.style.width = `${data.neut}%`;

        valEntail.textContent = `${data.entail}%`;
        valContra.textContent = `${data.contra}%`;
        valNeut.textContent = `${data.neut}%`;

        analysisText.textContent = data.desc;
      });
    });
  </script>
</BaseLayout>
