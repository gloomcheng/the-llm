---
import BaseLayout from '../../layouts/BaseLayout.astro';
import PaperMeta from '../../components/PaperMeta.astro';
import StoryRail from '../../components/StoryRail.astro';
import PaperReadingLayout from '../../components/PaperReadingLayout.astro';
import AsideCard from '../../components/AsideCard.astro';
import AuthorGrid from '../../components/AuthorGrid.astro';
import PaperNavigation from '../../components/PaperNavigation.astro';
import Callout from '../../components/Callout.astro';
import {
  gpt1Paper,
  gpt1Sources,
} from '../../content/papers/improving-language-understanding-by-generative-pre-training';

const shell = 'mx-auto w-[calc(100%-2rem)] max-w-[1120px]';

const story = [
  {
    year: '2013–2018 初',
    label: '桎梏 / THE BOTTLENECK',
    title: '手工標註的資料懸崖與專用網路的工程泥淖',
    body: '監督式學習極度依賴昂貴且有限的人工標註，換一個任務就得重新設計專用神經網路架構，深層模型極易過擬合。',
    status: 'past' as const,
  },
  {
    year: '2018.06',
    label: '突破 / THE PAPER',
    title: 'GPT-1：無監督生成式預訓練的黎明',
    body: '拋棄專用架構，僅用 12 層 Transformer 解碼器在 8 億詞小說上預測下一個字，以統一序列化適配四類任務，橫掃 9 項 SOTA。',
    status: 'current' as const,
  },
  {
    year: '之後',
    label: '遺產 / THE EXPANSION',
    title: '從專用模型到基礎模型，大語言模型時代降臨',
    body: '確立「大數據自回歸預訓練 + 提示/微調」的通用典範，引領 GPT-2、GPT-3、GPT-4 與生成式人工智慧的全面爆發。',
    status: 'future' as const,
  },
];

interface TimelineEpoch {
  id: string;
  year: string;
  period: string;
  title: string;
  summary: string;
  sources: Array<{
    source: (typeof gpt1Sources)[number];
    num: number;
    refCode: string;
    featured?: boolean;
    role: string;
    takeaway: string;
  }>;
}

const timelineEpochs: TimelineEpoch[] = [
  {
    id: 'epoch-2013',
    year: '2013–2015',
    period: '2013–2015 · 靜態詞向量與長篇敘事語料庫',
    title: '預訓練的萌芽：從單字空間到連貫小說文本',
    summary:
      'Mikolov 提出 Word2Vec 證明無監督學習能捕捉詞彙語義，但靜態向量無法分辨一詞多義；Zhu 等人構建 BooksCorpus，為日後深層模型提供了八億詞不中斷的長程故事上下文。',
    sources: [
      {
        source: gpt1Sources.find((s) => s.id === 'paper-2013-word2vec') || {
          id: 'paper-2013-word2vec',
          kind: 'paper',
          title: 'Distributed Representations of Words and Phrases and their Compositionality',
          publisher: 'NeurIPS / arXiv',
          published: '2013-10-16',
          accessed: '2026-09-17',
          url: 'https://arxiv.org/abs/1310.4546',
          supports: ['靜態詞向量的分散式表徵', '詞彙間的線性向量平移特性'],
          limits: '靜態向量無法反映動態上下文，且無法直接捕捉跨句長程語意相依性。',
        },
        num: 4,
        refCode: 'S04',
        role: '靜態向量開山',
        takeaway: '證明未標註文字能訓練語意空間，但每個單詞僅能對應單一固定座標。',
      },
      {
        source: gpt1Sources.find((s) => s.id === 'paper-2015-bookcorpus')!,
        num: 5,
        refCode: 'S05',
        role: '預訓練語料奠基',
        takeaway: '7,000 本未出版小說、8 億詞連續語料，提供跨段落連貫敘事結構。',
      },
    ],
  },
  {
    id: 'epoch-2017',
    year: '2017',
    period: '2017.06 · 注意力架構革命',
    title: '打破循環鏈：自注意力機制的橫空出世',
    summary:
      'Vaswani 等人發表 Transformer，徹底拋棄 RNN 的循序依賴，以 Self-Attention 實現常數級通訊距離與大規模平行訓練，但原始設計仍錨定在機器翻譯的雙塔架構。',
    sources: [
      {
        source: gpt1Sources.find((s) => s.id === 'paper-2017-transformer')!,
        num: 2,
        refCode: 'S02',
        role: '底層骨幹發明',
        takeaway: '提供 Multi-Head Attention 與因果遮罩矩陣，成為 GPT-1 堆疊的基石。',
      },
    ],
  },
  {
    id: 'epoch-2018-early',
    year: '2018 初',
    period: '2018.02–2018.04 · 特徵提取與多任務基準',
    title: '特徵提取的巔峰與評測基準的建立',
    summary:
      'ELMo 利用雙向雙層 LSTM 計算上下文動態詞向量，大幅改進下游任務，但本質上仍是外掛特徵，每個下游任務依舊需要龐雜的專用神經網路；GLUE 基準則為通用語言理解確立了標準靶場。',
    sources: [
      {
        source: gpt1Sources.find((s) => s.id === 'paper-2018-elmo')!,
        num: 3,
        refCode: 'S03',
        role: '動態特徵代表',
        takeaway: '證明上下文表徵的重要性，但仍受困於 LSTM 循序計算與專用架構。',
      },
      {
        source: gpt1Sources.find((s) => s.id === 'paper-2018-glue')!,
        num: 6,
        refCode: 'S06',
        role: '通用評測標竿',
        takeaway: '集結推論、相似度、問答等 11 項任務，檢驗模型是否具備泛化理解力。',
      },
    ],
  },
  {
    id: 'epoch-2018-mid',
    year: '2018 夏',
    period: '2018.06 · 生成式自回歸預訓練的黎明',
    title: '典範轉移：單一解碼器與統一序列化結構',
    summary:
      'Alec Radford、Ilya Sutskever 等人發表 GPT-1，拋棄一切下游專用神經網路，僅用 12 層 Transformer Decoder 在小說文本上預測下一個字，以極簡線性微調橫掃 9 項 SOTA，宣告生成式預訓練時代來臨。',
    sources: [
      {
        source: gpt1Sources.find((s) => s.id === 'paper-2018-gpt1')!,
        num: 1,
        refCode: 'S01',
        featured: true,
        role: '核心奠基文獻',
        takeaway: '確立「大數據自回歸無監督預訓練 + 統一序列化輕量微調」兩階段標準典範。',
      },
    ],
  },
  {
    id: 'epoch-2018-late',
    year: '2018 秋',
    period: '2018.10 · 雙向編碼器與路線分歧',
    title: '雙向克漏字挑戰：BERT 與預訓練架構大分流',
    summary:
      'Google 提出 BERT，改採 Transformer Encoder 並以克漏字（MLM）實現全雙向視野，在短文本理解上超車；OpenAI 則堅持單向自回歸生成路線，為日後的開放生成與零樣本擴展埋下關鍵種子。',
    sources: [
      {
        source: gpt1Sources.find((s) => s.id === 'paper-2018-bert')!,
        num: 7,
        refCode: 'S07',
        role: '雙向對照陣營',
        takeaway: '雙向編碼器雖利於判別式分類，但無法自然推導開放文字生成與自回歸推理。',
      },
    ],
  },
];
---

<BaseLayout
  title="Improving Language Understanding by Generative Pre-Training — GPT-1 (2018)"
  section="paper"
  description="完整拆解 OpenAI GPT-1 論文：無監督自回歸預訓練、因果遮罩機制、打破專用架構的四類統一輸入序列化、動態擾動實驗與零樣本湧現之黎明。"
>
  <article>
    <!-- 頂部頁首導航 -->
    <header class={`${shell} pt-10`}>
      <div class="flex gap-3 font-mono text-sm uppercase tracking-[0.08em] text-muted">
        <a class="text-red underline underline-offset-4" href="/">
          THE LLM
        </a>
        <span aria-hidden="true">/</span>
        <span>第二章</span>
      </div>

      <div class="grid grid-cols-1 items-end gap-12 py-16 lg:grid-cols-[1.15fr_0.85fr] lg:gap-24">
        <div>
          <p class="mb-5 font-mono text-sm font-semibold uppercase tracking-[0.12em] text-red">
            VOL. 02 / GENERATIVE PRE-TRAINING
          </p>
          <h1 class="m-0 font-display text-4xl sm:text-5xl lg:text-6xl leading-tight tracking-[-0.04em] text-ink">
            <span class="block">Improving Language Understanding</span>
            <em class="block">by Generative Pre-Training.</em>
          </h1>
          <p class="mt-8 max-w-[52ch] text-lg leading-8 text-muted">
            在 2018
            年以前，自然語言處理如同中世紀的手工作坊：每換一個任務，工程師就必須重寫一套專用神經網路，並耗資數百萬採集標註資料。OpenAI
            在這篇論文中給出了一個顛覆常識的解答——丟掉所有專用網路，只用 12 層 Transformer
            解碼器在八億詞的小說庫裡「預測下一個字」，便能學會全語言的結構與邏輯。
          </p>
        </div>

        <aside
          class="border-t-4 border-red bg-surface p-6 shadow-editorial"
          aria-label="這篇論文的一句評語"
        >
          <p class="mb-4 font-mono text-xs font-semibold uppercase tracking-[0.12em] text-red">
            一句評語 / THE SHORT VERDICT
          </p>
          <p class="m-0 max-w-[22ch] font-display text-2xl sm:text-3xl leading-snug text-ink">
            預測下一個字不是文字接龍，而是讓機器在未標註的世界裡建構常識與因果。
          </p>
          <p class="mt-6 mb-0 text-sm leading-relaxed text-muted">
            GPT-1
            首次證明：大數據自回歸預訓練搭配極簡線性微調，足以通吃分類、推論、相似度與問答等所有主流
            NLP 任務。
          </p>
        </aside>
      </div>

      <PaperMeta
        year={2018}
        venue="OpenAI Technical Report"
        readTime="25 分鐘"
        difficulty="核心典範"
        doi={{
          value: 'N/A',
          url: 'https://openai.com/research/language-unsupervised',
        }}
      />

      <div class="flex flex-wrap items-center justify-between gap-y-3 py-4 font-mono text-sm uppercase tracking-[0.04em] text-muted">
        <div class="flex flex-wrap items-center gap-x-6 gap-y-2">
          <span>原始文獻</span>
          <a
            class="underline underline-offset-4 hover:text-red transition-colors"
            href="https://cdn.openai.com/research-covers/language-unsupervised/language_understanding_paper.pdf"
            target="_blank"
            rel="noreferrer"
            aria-label="閱讀 OpenAI GPT-1 原始技術論文（在新分頁開啟）"
          >
            閱讀原始 PDF ↗
          </a>
          <span aria-hidden="true">·</span>
          <a
            class="underline underline-offset-4 hover:text-red transition-colors"
            href="#references"
            aria-label="跳轉至十年文獻演進時間軸"
          >
            文獻時間軸 [S01–S07] ↓
          </a>
        </div>
        <div class="flex items-center gap-2 text-xs sm:text-sm">
          <span class="text-muted">上一篇章：</span>
          <a
            href="/papers/attention-is-all-you-need"
            class="font-semibold text-red underline underline-offset-4 hover:text-ink"
            aria-label="返回第一章：Attention Is All You Need"
          >
            ← 第一章 Transformer
          </a>
        </div>
      </div>
    </header>

    <!-- 歷史進程 StoryRail -->
    <section class="border-y border-line bg-surface/50 py-12" aria-label="歷史轉折總覽">
      <div class={shell}>
        <div class="mb-6">
          <p class="font-mono text-xs font-bold text-red uppercase tracking-wider mb-1">
            歷史轉折 / 2013–2018
          </p>
          <h2 class="m-0 font-display text-2xl sm:text-3xl text-ink">
            從標註懸崖到生成式預訓練的歷史轉折
          </h2>
        </div>
        <StoryRail events={story} />
      </div>
    </section>

    <!-- SECTION 1: 歷史開局 / 標註懸崖 (START WITH WHY) -->
    <section
      id="why"
      class={`${shell} border-t border-ink py-16 sm:py-20 lg:py-24 scroll-mt-24`}
      aria-labelledby="history-genesis-title"
    >
      <div class="mb-12 flex flex-col gap-6 lg:flex-row lg:items-end lg:justify-between">
        <div>
          <p class="mb-4 font-mono text-sm font-semibold uppercase tracking-[0.12em] text-red">
            歷史開局 / 2013–2018：標註懸崖
          </p>
          <h2
            id="history-genesis-title"
            class="m-0 font-display text-3xl sm:text-4xl lg:text-5xl leading-tight tracking-tight text-ink"
          >
            <span class="block">大標註時代的絕境：</span>
            <span class="block">
              <em>天下苦人工標註久矣，萬卷無字之書何處安放？</em>
            </span>
          </h2>
        </div>
        <p class="m-0 max-w-[34ch] text-base leading-8 text-muted">
          這是一場對抗資料懸崖的破局之戰：當學界受困於昂貴的人工標籤與專用網路時，OpenAI
          選擇讓解碼器在八億詞的小說世界裡獨自參悟語言。
        </p>
      </div>

      <PaperReadingLayout class="text-base leading-8 text-ink">
        <div class="space-y-6">
          <p class="text-lg leading-relaxed text-ink">
            2018
            年初的自然語言處理（NLP）領域正處於繁榮與窒息交織的奇異時刻。一方面，卷積神經網路（CNN）與長短期記憶模型（LSTM）在各類學術競賽中屢創佳績；但另一方面，所有機器學習從業者心頭都籠罩著一層揮之不去的陰霾：
            <strong>監督式學習的資料懸崖</strong>。
          </p>

          <p>
            在當時，如果你想讓模型辨識醫療診斷書的情緒傾向，你必須聘請昂貴的醫學專家逐字閱讀，手動為數萬筆病歷打上標籤；如果你想開發一個法律合約矛盾偵測系統，法務團隊就得花費數個月標記幾萬對句子。然而，一旦下游需求稍微改變——例如從「情緒判斷」轉移至「醫病問答」——先前花費數百萬台幣標註的資料立刻失去作用，專用的神經網路架構也必須全部推倒重來。
          </p>

          <Callout
            variant="editorial"
            title="語言學習的本質反思：人類是如何掌握語言的？"
            class="my-6"
          >
            <p class="m-0 text-base leading-relaxed text-muted">
              一個七歲的孩子能理解童話故事、推測書中人物的心情、甚至指出故事邏輯的矛盾。但在孩子成長的過程中，從來沒有父母或老師在每一句話後面標註「這句話是主詞」、「情緒評分是正
              0.82」或是「這兩個句子互為矛盾關係」。人類僅憑閱讀童話、聆聽對話，在日常生活中不斷
              <strong>「預測對方下一句要說什麼」</strong>
              ，就自發建構出對語法、因果邏輯與真實世界物理常識的完整理解。
            </p>
          </Callout>

          <p>
            真實世界中，帶有高品質人工標籤的語料極其稀有，頂多數千至數萬筆；但未標註的原始文本——圖書館中的萬卷藏書、網路上的百科論壇與新聞報導——卻浩瀚無垠、取之不盡。機器學習學者長久以來的夢想，就是讓深層模型直接在這些無標註文本中自我學習。
          </p>

          <h3 class="font-display text-2xl text-ink pt-4">
            為什麼 2018 年以前的「無監督預訓練」都未竟全功？
          </h3>

          <p>
            在 GPT-1 出現之前，學界並非沒有嘗試過無監督學習，但先驅者的路徑皆撞上了結構性的天花板：
          </p>

          <div class="space-y-4 my-6">
            <div class="border border-line bg-surface p-5 shadow-sm">
              <div class="flex items-center justify-between mb-2">
                <span class="font-mono text-xs font-bold text-red uppercase">
                  2013 · 靜態詞向量
                </span>
                <span class="font-mono text-xs text-muted">Word2Vec / GloVe</span>
              </div>
              <h4 class="m-0 font-display text-base text-ink">一詞多義的空間坍塌</h4>
              <p class="mt-2 text-sm leading-relaxed text-muted">
                Word2Vec 證明了預訓練能學會「國王 - 男人 + 女人 =
                皇后」的語義向量幾何。但它最大的致命傷是<strong>靜態性</strong>
                ：每個詞在向量空間中只有一個固定座標。「蘋果」無論是指甜脆的水果，還是市值兆元的科技巨擘，其數學表徵完全相同，模型無法根據句子動態改變理解。
              </p>
            </div>

            <div class="border border-line bg-surface p-5 shadow-sm">
              <div class="flex items-center justify-between mb-2">
                <span class="font-mono text-xs font-bold text-blue uppercase">
                  2018 初 · 動態特徵外掛
                </span>
                <span class="font-mono text-xs text-muted">ELMo</span>
              </div>
              <h4 class="m-0 font-display text-base text-ink">專用網路與循環枷鎖未解</h4>
              <p class="mt-2 text-sm leading-relaxed text-muted">
                ELMo 運用雙向雙層 LSTM
                依據上下文計算動態詞向量，解決了一詞多義。但它僅作為「特徵提取器」：下游處理情緒分類時仍需額外搭建分類網路；做問答時又得另外寫一套複雜的比對層。底層
                LSTM 不僅循序運算極慢，且模型主體無法進行端到端微調。
              </p>
            </div>
          </div>

          <p>
            在第一章〈
            <a
              href="/papers/attention-is-all-you-need"
              class="font-medium text-ink underline decoration-line/80 underline-offset-4 transition-colors hover:text-red hover:decoration-red"
            >
              Attention Is All You Need
            </a>
            〉中，我們見證了 Google Brain 發表 Transformer 架構{' '}
            <a href="#epoch-2017" class="text-red font-mono underline underline-offset-4">
              [S02]
            </a>
            ，以自注意力機制（Self-Attention）徹底打破了 RNN 循序傳播的枷鎖，讓 token
            之間能建立即時全域關聯。然而，Google
            團隊最初的視野被牢牢鎖定在「機器翻譯」上，設計的是一套由編碼器（Encoder）與解碼器（Decoder）構成的雙塔翻譯機器，必須仰賴昂貴且平行對齊的雙語監督語料。
          </p>

          <p>
            當時在 OpenAI 擔任研究員的 Alec Radford 與首席科學家 Ilya Sutskever
            敏銳意識到：Transformer 的潛力遠不止於翻譯。促使他們跳出傳統工程框架的，正是對
            <strong>人類語言學習真實過程</strong>的深刻反思。
          </p>
          <p>
            傳統機器學習工程師總習慣把語言視為考卷：要做情緒分析就必須收集幾萬筆標註「正面／負面」的樣本；要做語法分析就得人工標註句法樹。但人類幼童是這樣學會母語的嗎？沒有任何父母會拿著標註好標籤的五萬張考卷塞給嬰兒。認知科學與神經科學中的「預測性編碼（Predictive
            Coding）」理論早已揭示：人類大腦本質上是一部持續運轉的「預測機器」。當我們聆聽他人說話或閱讀故事時，大腦隨時隨地都在無意識地預測「下一個詞」、「下一個動作」乃至「對方的下一個反應」。為了準確猜出小說主角下一句會說出什麼詞，模型不能只背誦字典，它被迫在神經權重中建構出對物理因果、心理意圖乃至社會常識的內部世界模型。
          </p>
