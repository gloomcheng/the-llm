---
import BaseLayout from '../../layouts/BaseLayout.astro';
import { withBase } from '../../lib/paths';
import StoryRail from '../../components/StoryRail.astro';
import PaperReadingLayout from '../../components/PaperReadingLayout.astro';
import PaperSectionHeader from '../../components/PaperSectionHeader.astro';
import AsideCard from '../../components/AsideCard.astro';
import AuthorGrid from '../../components/AuthorGrid.astro';
import PaperMeta from '../../components/PaperMeta.astro';
import PaperNavigation from '../../components/PaperNavigation.astro';
import EvidenceList from '../../components/EvidenceList.astro';
import {
  vitPaper,
  vitTimelineEpochs,
} from '../../content/papers/an-image-is-worth-16x16-words-transformers-for-image-recognition-at-scale';

const paper = vitPaper;
const shell = 'mx-auto w-[calc(100%-2rem)] max-w-[1120px]';

const story = [
  {
    year: '1998–2019',
    label: '桎梏 / CNN HEGEMONY',
    title: '卷積壟斷視覺三十年：局部性與平移等變性的黃金枷鎖',
    body: '從 LeNet-5、AlexNet 到 ResNet，電腦視覺始終依賴滑動卷積核。學界深信圖像本質具有二維空間局部性，而像素級自注意力高達 O(N²) 的二次方記憶體爆炸，使得純 Transformer 跨足視覺看似天方夜譚。',
    status: 'past' as const,
  },
  {
    year: '2020.10',
    label: '破局 / THE ViT LEAP',
    title: '一張圖片等於 16x16 個單字：純 Transformer 全面接管視覺',
    body: 'Dosovitskiy 等人提出石破天驚的極簡切分：將影像切為 16x16 的非重疊 Patch，直接拉平成視覺單字送入標準 Transformer Encoder。在 3 億張影像預訓練下，ViT 徹底打破 CNN 的上限，且算力開銷大幅降低。',
    status: 'current' as const,
  },
  {
    year: '2021–至今',
    label: '大一統 / MULTIMODAL SYNTHESIS',
    title: '語言與視覺終結學科壁壘：跨模態基礎模型的共同母語',
    body: 'ViT 引爆了 Swin、MAE、CLIP 與現代多模態大模型（如 LLaVA、GPT-4V、Gemini）。圖像不再需要特化的卷積骨幹，視覺特徵直接化為 Token 與語言流暢對話，宣告多模態大一統時代正式降臨。',
    status: 'future' as const,
  },
];
---

<BaseLayout
  title="An Image is Worth 16x16 Words: Transformers for Image Recognition at Scale — ViT (2020)"
  section="paper"
  description="深入拆解 Google Brain 2020 年開創性論文 Vision Transformer (ViT)：從 16x16 Patch 切割、線性投影到歸納偏向的尺度分水嶺，見證純 Transformer 如何打破卷積三十年壟斷並奠定多模態大模型基石。"
>
  <article>
    <!-- ========================================== -->
    <!-- HERO HEADER: 嚴格遵循全域視覺規範 (INVARIANT) -->
    <!-- ========================================== -->
    <header class={`${shell} pt-10`}>
      <div class="flex gap-3 font-mono text-sm uppercase tracking-[0.08em] text-muted">
        <a class="text-red underline underline-offset-4" href={withBase('/')}>
          THE LLM
        </a>
        <span aria-hidden="true">/</span>
        <span>第 11 章</span>
      </div>

      <div class="grid grid-cols-1 items-end gap-12 py-16 lg:grid-cols-[1.15fr_0.85fr] lg:gap-24">
        <div>
          <p class="mb-5 font-mono text-sm font-semibold uppercase tracking-[0.12em] text-red">
            VOL. 11 / VISION TRANSFORMER
          </p>

          <h1 class="m-0 font-display text-4xl sm:text-5xl lg:text-6xl xl:text-7xl leading-tight tracking-[-0.04em] text-ink">
            <span class="block">An Image is Worth 16x16 Words:</span>
            <em class="block">Transformers for Image Recognition at Scale</em>
          </h1>

          <p class="mt-8 max-w-[52ch] text-lg leading-8 text-muted">
            在 2020
            年以前，電腦視覺與自然語言處理如同隔著一道不可踰越的學科天塹。學者們深信視覺天生必須依賴卷積滑動窗口來捕捉二維局部紋理。直到
            Google Brain 團隊大膽將照片切成 16x16 像素的小拼圖，直接當作單字送進標準
            Transformer——一場終結卷積三十年統治、開啟跨模態大一統的革命就此爆發。
          </p>
        </div>

        <aside
          class="border-t-4 border-red bg-surface p-6 shadow-editorial"
          aria-label="這篇論文的一句評語"
        >
          <p class="mb-4 sm:mb-6 font-mono text-xs sm:text-sm font-semibold uppercase tracking-[0.12em] text-red">
            一句評語 / THE SHORT VERDICT
          </p>
          <p class="m-0 max-w-[20ch] sm:max-w-[22ch] font-display text-2xl sm:text-3xl leading-tight text-ink">
            丟掉滑動卷積核，讓視覺像素直接以單字姿態走入注意力矩陣。
          </p>
          <p class="mt-6 mb-0 text-sm sm:text-base leading-relaxed sm:leading-7 text-muted">
            ViT 首次證明：只要預訓練資料充足，不含任何空間先驗的標準 Transformer 能夠徹底壓制最強
            CNN，為跨模態多模態模型奠定共同母語。
          </p>
        </aside>
      </div>

      <PaperMeta
        year={paper.year}
        venue={paper.venue}
        readTime="35 分鐘"
        difficulty="核心奠基"
        doi={paper.doi}
      />
    </header>

    <!-- ========================================== -->
    <!-- 歷史前後脈絡 (THE ARC) -->
    <!-- ========================================== -->
    <section class={`${shell} border-t border-line py-16`} aria-labelledby="story-title">
      <p class="mb-8 font-mono text-sm font-semibold uppercase tracking-[0.12em] text-red">
        歷史脈絡 / THE ARC
      </p>
      <StoryRail events={story} variant="list" label="Vision Transformer 的歷史前後脈絡" />
    </section>

    <!-- ========================================== -->
    <!-- 正文區塊：Archetype B 5-Movement 結構 -->
    <!-- ========================================== -->
    <main class={`${shell} border-t border-ink py-16 sm:py-24`}>
      <!-- 章節 01：卷積霸權的雙刃劍 -->
      <section class="mb-24" id="convolutional-impasse" aria-labelledby="impasse-heading">
        <PaperSectionHeader
          id="impasse"
          kicker="章節 01 · 卷積霸權的雙刃劍 / THE IMPASSE"
          title="空間歸納偏向，與像素全域比較的二次方爆炸"
        />
        <PaperReadingLayout>
          <div class="space-y-6 text-base leading-8 text-ink">
            <p>
              要理解 Vision Transformer (ViT) 帶來的衝擊，必須先回到 2020
              年前夕電腦視覺的物理現實。從直覺上看，一張數位圖檔本質上是一個三維數值矩陣：高
              <math class="font-serif"><mi>H</mi></math>、寬
              <math class="font-serif"><mi>W</mi></math>、色彩通道
              <math class="font-serif"><mi>C</mi><mo>=</mo><mn>3</mn></math>
              （紅、綠、藍）。一張日常手機拍攝的照片可能包含上千萬顆像素，即便是經過縮小的標準基準測試影像，例如
              <math class="font-serif"><mn>224</mn><mo>×</mo><mn>224</mn></math>，其背後也是由整整
              150,528 個連續數值緊密排列而成。
            </p>

            <p>
              自 1998 年 Yann LeCun 提出 LeNet-5、2012 年 Alex Krizhevsky 掀起 AlexNet
              深度學習狂潮，乃至 2015 年何愷明等人發明 ResNet 以來，整個 AI
              界達成了一個近乎神聖不可侵犯的共識：
              <strong>
                處理視覺訊號，必須仰賴卷積神經網路（Convolutional Neural Networks, CNN）
              </strong>
              。
            </p>

            <p>
              這種信仰絕非空穴來風，而是源於 CNN
              深深刻在架構骨髓裡的兩大物理先驗，在機器學習理論中被稱為「歸納偏向（Inductive
              Bias）」：
            </p>

            <div class="grid grid-cols-1 md:grid-cols-2 gap-6 my-8 not-prose">
              <div class="border border-line bg-surface p-6 shadow-sm">
                <div class="flex items-center gap-2 mb-3">
                  <span class="h-2 w-2 rounded-full bg-red"></span>
                  <h3 class="m-0 font-display text-lg font-bold text-ink">
                    二維空間局部性 / 2D Locality
                  </h3>
                </div>
                <p class="m-0 text-sm leading-relaxed text-muted">
                  CNN 透過細小的滑動卷積核（如
                  <math class="font-serif"><mn>3</mn><mo>×</mo><mn>3</mn></math> 或
                  <math class="font-serif"><mn>5</mn><mo>×</mo><mn>5</mn></math>
                  ）在特徵圖上逐行掃描。它強硬假設：
                  <strong>
                    相鄰的像素彼此高度相關（構成輪廓、材質與斑塊），而相距遙遠的像素在初始階段彼此獨立
                  </strong>
                  。這使得單個神經元只需與極小的局部區域連線，參數用量大幅減少。
                </p>
              </div>

              <div class="border border-line bg-surface p-6 shadow-sm">
                <div class="flex items-center gap-2 mb-3">
                  <span class="h-2 w-2 rounded-full bg-blue"></span>
                  <h3 class="m-0 font-display text-lg font-bold text-ink">
                    平移等變性 / Translation Equivariance
                  </h3>
                </div>
                <p class="m-0 text-sm leading-relaxed text-muted">
                  同一個卷積核的權重在整張圖像的所有空間位置上嚴格共享。如果一隻柴犬從照片左下角平移到了右上角，卷積核所產生的特徵活化只會在空間座標上同步平移，神經網路不需要在幾百萬個不同座標位置分別重新學習「柴犬長什麼樣子」。
                </p>
              </div>
            </div>

            <p>
              既然卷積先驗如此完美契合自然界的光學投影規律，為什麼 2017
              年在自然語言處理領域稱霸的自注意力機制（Self-Attention）不能順理成章地橫掃電腦視覺？
            </p>

            <p>
              答案在於一個殘酷的計算障礙：
              <strong>全域自注意力對序列長度呈現恐怖的二次方爆炸（Quadratic Complexity）</strong>。
            </p>

            <p>
              在語言模型中，一段文字通常包含幾百到幾千個 Token，計算所有詞彙兩兩成對的注意力矩陣
              <math class="font-serif"><mi>Q</mi><msup><mi>K</mi><mi>T</mi></msup></math>
              尚在硬體承受範圍內。但若直接將圖像中的「每一個像素」當作一個 Token，以一張
              <math class="font-serif"><mn>224</mn><mo>×</mo><mn>224</mn></math>
              的小圖為例，像素序列長度便高達：
            </p>

            <math display="block" class="editorial-math my-6" aria-label="像素序列長度計算">
              <mi>N</mi>
              <mo>=</mo>
              <mi>H</mi>
              <mo>×</mo>
              <mi>W</mi>
              <mo>=</mo>
              <mn>224</mn>
              <mo>×</mo>
              <mn>224</mn>
              <mo>=</mo>
              <mn>50,176</mn>
            </math>

            <p>
              長度為 50,176 的序列，其全域成對注意力權重矩陣的大小為
              <math class="font-serif"><mi>N</mi><mo>×</mo><mi>N</mi><mo>=</mo><mn>50,176</mn><mo>×</mo><mn>50,176</mn><mo>≈</mo><mn>2.5</mn><mo>×</mo><msup><mn>10</mn><mn>9</mn></msup></math>
              。單單一層 Transformer 的一個注意力頭，就需要儲存超過 25 億個浮點數（約 10 GB
              視訊記憶體）；若是一張常見的百萬像素（
              <math class="font-serif"><mn>1024</mn><mo>×</mo><mn>1024</mn></math>）照片，
              <math class="font-serif"><msup><mi>N</mi><mn>2</mn></msup></math> 將直逼
              <strong>1 兆筆運算</strong>！在當時的 GPU 記憶體架構下，前向傳播會在百分之一秒內引爆
              OOM（Out of Memory）癱瘓崩潰。
            </p>

            <p>
              為了繞過這個死穴，2018 至 2020 年間的視覺學界做出了各種妥協：有的只在 CNN 頂部加一層
              Non-local 模組，有的把注意力限制在水平與垂直的軸向（Axial
              Attention），有的限制在鄰近局部像素小窗內。然而，這些折衷方案充滿了高度特化的客製化
              CUDA 算子，缺乏現代 GPU 對通用矩陣乘法的硬體加速優勢，非但無法取代
              CNN，反而使工程實作支離破碎。
            </p>

            <p>
              更關鍵的哲學枷鎖在於：<strong>卷積的局部性是優勢，也是無法打破的認知天花板</strong>
              。在深層 ResNet
              中，一個位於左上角像素的特徵，要想與右下角像素交流，必須經過數十個卷積層的層層傳遞。在跨越這段漫長的路徑時，低階精細特徵早已被降採樣與池化模糊抹平。視覺學界急需一種能同時維持全域視野、又不被百萬像素壓垮的全新典範。
            </p>
          </div>

          <aside slot="rail" class="space-y-6">
            <AsideCard kicker="硬體代價 / HARDWARE CEILING" title="像素級全域注意力的崩潰邊緣">
              <p class="text-sm leading-relaxed text-muted">
                若將圖像中的每個像素都當作獨立 Token 送入 Self-Attention，計算量會隨圖像邊長的四次方
                <math class="font-serif"><mi>O</mi><mo stretchy="false">(</mo><msup><mi>H</mi><mn>2</mn></msup><msup><mi>W</mi><mn>2</mn></msup><mo stretchy="false">)</mo></math>
                劇烈膨脹。一張百萬像素圖片的注意力權重矩陣將包含超過 1 兆個參數，消耗數 TB
                視訊記憶體，這正是 Transformer 過去難以直接踏入視覺領域的核心物理死結。
              </p>
            </AsideCard>
          </aside>
        </PaperReadingLayout>
      </section>

      <!-- 章節 02：核心機制拆解 -->
      <section class="mb-24" id="patch-embeddings-mechanism" aria-labelledby="patch-heading">
        <PaperSectionHeader
          id="patch"
          kicker="章節 02 · 核心機制拆解 / CORE MECHANISM"
          title="Patch 拼圖、線性投影矩陣與動態注意力擾動"
        />
        <PaperReadingLayout>
          <div class="space-y-6 text-base leading-8 text-ink">
            <p>
              2020 年 10 月，Google Brain 柏林與蘇黎世團隊的 Alexey Dosovitskiy、Lucas Beyer
              等人發表了一篇標題無比詩意的論文：
              <strong>《An Image is Worth 16x16 Words》（一張圖片等於 16x16 個單字）</strong>
              。這篇論文破天荒地提出了一個看似極度大膽、甚至略顯粗暴的創見：
            </p>

            <blockquote class="my-6 border-l-4 border-red bg-surface py-4 px-6 text-lg italic text-ink">
              既然像素太多算不動，我們為什麼不把整張圖片切成一塊塊拼圖？每一個 16x16
              像素的小圖塊，不就是一個「視覺單字」嗎？
            </blockquote>

            <p>
              這個神來之筆瞬間化解了困擾學界三年的計算死穴。讓我們以嚴格的數學符號逐步拆解這個流程。
            </p>

            <h3 class="mt-8 mb-4 font-display text-2xl font-bold text-ink">
              1. 圖像切塊與序列拉平（Patch Extraction & Flattening）
            </h3>

            <p>
              給定原始二維彩色圖像
              <math class="font-serif"><mi mathvariant="bold">x</mi><mo>∈</mo><msup><mi mathvariant="double-struck">R</mi><mrow><mi>H</mi><mo>×</mo><mi>W</mi><mo>×</mo><mi>C</mi></mrow></msup></math>
              ，設定預設的圖塊邊長為 <math class="font-serif"><mi>P</mi><mo>=</mo><mn>16</mn></math>
              。模型沿著空間網格將圖像切分成 <math class="font-serif"><mi>N</mi></math>
              個互不重疊的小圖塊，切出的總圖塊數量為：
            </p>

            <math display="block" class="editorial-math my-6" aria-label="圖塊數量計算公式">
              <mi>N</mi>
              <mo>=</mo>
              <mfrac>
                <mrow>
                  <mi>H</mi>
                  <mo>·</mo>
                  <mi>W</mi>
                </mrow>
                <msup><mi>P</mi><mn>2</mn></msup>
              </mfrac>
            </math>

            <p>
              以標準輸入尺寸
              <math class="font-serif"><mn>224</mn><mo>×</mo><mn>224</mn><mo>×</mo><mn>3</mn></math>
              為例，切塊後的總數量為：
            </p>

            <math display="block" class="editorial-math my-6" aria-label="標準 ViT 圖塊數量計算">
              <mi>N</mi>
              <mo>=</mo>
              <mfrac>
                <mrow>
                  <mn>224</mn>
                  <mo>×</mo>
                  <mn>224</mn>
                </mrow>
                <mrow>
                  <mn>16</mn>
                  <mo>×</mo>
                  <mn>16</mn>
                </mrow>
              </mfrac>
              <mo>=</mo>
              <mn>14</mn>
              <mo>×</mo>
              <mn>14</mn>
              <mo>=</mo>
              <mn>196</mn>
            </math>

            <p>
              原本高達 50,176 個像素的窒息序列，瞬間被壓縮成僅有
              <strong>196 個圖塊（Patches）</strong>！序列長度縮減了整整 256
              倍，使得後續自注意力矩陣的計算量暴降了
              <math class="font-serif"><msup><mn>256</mn><mn>2</mn></msup><mo>=</mo><mn>65,536</mn></math>
              倍。
            </p>

            <p>
              每一個小圖塊包含
              <math class="font-serif"><mn>16</mn><mo>×</mo><mn>16</mn><mo>=</mo><mn>256</mn></math>
              顆像素，每個像素有 3 個色彩數值，因此每個圖塊拉平成向量後的維度為：
            </p>

            <math display="block" class="editorial-math my-6" aria-label="圖塊拉平維度計算">
              <msub><mi>D</mi><mtext>patch</mtext></msub>
              <mo>=</mo>
              <msup><mi>P</mi><mn>2</mn></msup>
              <mo>·</mo>
              <mi>C</mi>
              <mo>=</mo>
              <mn>16</mn>
              <mo>×</mo>
              <mn>16</mn>
              <mo>×</mo>
              <mn>3</mn>
              <mo>=</mo>
              <mn>768</mn>
            </math>

            <p>
              整張圖片就此被整齊地重塑為一個矩陣
              <math class="font-serif"><msub><mi mathvariant="bold">x</mi><mi>p</mi></msub><mo>∈</mo><msup><mi mathvariant="double-struck">R</mi><mrow><mi>N</mi><mo>×</mo><mo stretchy="false">(</mo><msup><mi>P</mi><mn>2</mn></msup><mi>C</mi><mo stretchy="false">)</mo></mrow></msup><mo>=</mo><msup><mi mathvariant="double-struck">R</mi><mrow><mn>196</mn><mo>×</mo><mn>768</mn></mrow></msup></math>
              。
            </p>

            <h3 class="mt-8 mb-4 font-display text-2xl font-bold text-ink">
              2. 線性投影與可學習類別標記（Patch Embedding & [CLS] Token）
            </h3>

            <p>
              拉平後的 768 維像素向量還不能直接送入 Transformer，因為模型的隱藏層維度
              <math class="font-serif"><mi>D</mi></math> 可能不同（例如 ViT-Large 的
              <math class="font-serif"><mi>D</mi><mo>=</mo><mn>1024</mn></math>，ViT-Huge 的
              <math class="font-serif"><mi>D</mi><mo>=</mo><mn>1280</mn></math>
              ）。作者引入了一個可訓練的線性投影矩陣
              <math class="font-serif"><mi mathvariant="bold">E</mi><mo>∈</mo><msup><mi mathvariant="double-struck">R</mi><mrow><mo stretchy="false">(</mo><msup><mi>P</mi><mn>2</mn></msup><mi>C</mi><mo stretchy="false">)</mo><mo>×</mo><mi>D</mi></mrow></msup></math>
              ，將每個圖塊映射到統一度量空間中。在工程實作上，這一步完全等價於一個卷積核大小為
              <math class="font-serif"><mn>16</mn><mo>×</mo><mn>16</mn></math>、步幅（Stride）為 16
              的標準二維卷積！
            </p>

            <p>
              與此同時，ViT 借鑑了 BERT 的經典設計：在所有 196
              個圖塊之前，額外拼上一個可學習的隨機初始化特殊向量——
              <strong>
                類別標記（Class Token,
                <math class="font-serif"><msub><mi mathvariant="bold">x</mi><mtext>class</mtext></msub><mo>∈</mo><msup><mi mathvariant="double-struck">R</mi><mi>D</mi></msup></math>
                ）
              </strong>
              。
            </p>

            <p>
              為什麼不直接對所有輸出的圖塊做全域平均池化（Global Average
              Pooling）？這是因為在無歸納偏向的架構中，平均池化會人為賦予每個空間區域等同的權重。而加入一個完全中立、初始無物理位置含義的
              `[CLS]` 標記，能夠強迫 Transformer
              的各層自注意力機制，自主將與最終分類最相關的特徵資訊「路由」匯聚到這個標記中。
