  <script>
    function initVitLab() {
      // 1. Tab Switching
      const tabPatch = document.getElementById('vit-tab-patch');
      const tabBias = document.getElementById('vit-tab-bias');
      const panelPatch = document.getElementById('vit-panel-patch');
      const panelBias = document.getElementById('vit-panel-bias');

      if (!tabPatch || !tabBias || !panelPatch || !panelBias) return;

      tabPatch.addEventListener('click', () => {
        tabPatch.setAttribute('aria-selected', 'true');
        tabPatch.className =
          'px-4 py-2 font-mono text-xs sm:text-sm font-bold border-2 border-red bg-red text-surface transition cursor-pointer';
        tabBias.setAttribute('aria-selected', 'false');
        tabBias.className =
          'px-4 py-2 font-mono text-xs sm:text-sm font-medium border border-ink/40 bg-surface text-ink hover:border-ink hover:bg-paper transition cursor-pointer';
        panelPatch.classList.remove('hidden');
        panelBias.classList.add('hidden');
      });

      tabBias.addEventListener('click', () => {
        tabBias.setAttribute('aria-selected', 'true');
        tabBias.className =
          'px-4 py-2 font-mono text-xs sm:text-sm font-bold border-2 border-red bg-red text-surface transition cursor-pointer';
        tabPatch.setAttribute('aria-selected', 'false');
        tabPatch.className =
          'px-4 py-2 font-mono text-xs sm:text-sm font-medium border border-ink/40 bg-surface text-ink hover:border-ink hover:bg-paper transition cursor-pointer';
        panelBias.classList.remove('hidden');
        panelPatch.classList.add('hidden');
      });

      // 2. Patch Splitting & Linear Projection Sandbox
      const presets = [
        {
          name: '幾何抽象構圖',
          render: (svgG: SVGGElement) => {
            svgG.innerHTML = `
              <rect width="224" height="224" fill="#f4f1ea"/>
              <circle cx="112" cy="112" r="70" fill="#b6412c" fill-opacity="0.8"/>
              <polygon points="40,180 184,180 112,50" fill="#2d5a7b" fill-opacity="0.7"/>
              <rect x="70" y="70" width="84" height="84" fill="#d97736" fill-opacity="0.85"/>
              <circle cx="112" cy="112" r="25" fill="#fffdf8"/>
            `;
          },
        },
        {
          name: '高山地平線',
          render: (svgG: SVGGElement) => {
            svgG.innerHTML = `
              <rect width="224" height="130" fill="#2d5a7b" fill-opacity="0.4"/>
              <circle cx="170" cy="50" r="30" fill="#d97736" fill-opacity="0.8"/>
              <polygon points="0,170 60,90 130,170" fill="#1e2224" fill-opacity="0.7"/>
              <polygon points="80,180 150,80 224,180" fill="#1e2224" fill-opacity="0.85"/>
              <rect y="160" width="224" height="64" fill="#3a5a40" fill-opacity="0.6"/>
            `;
          },
        },
        {
          name: '手寫數字 8 (MNIST 風格)',
          render: (svgG: SVGGElement) => {
            svgG.innerHTML = `
              <rect width="224" height="224" fill="#1e2224"/>
              <circle cx="112" cy="80" r="42" fill="none" stroke="#fffdf8" stroke-width="26"/>
              <circle cx="112" cy="148" r="50" fill="none" stroke="#fffdf8" stroke-width="28"/>
            `;
          },
        },
      ];

      let currentPresetIdx = 0;
      let currentPatchSize = 16; // 8, 16, 32
      let activePatchR = 0;
      let activePatchC = 0;

      const presetContainer = document.getElementById('vit-preset-container');
      const patchSelector = document.getElementById('vit-patch-selector');
      const patchBadge = document.getElementById('vit-patch-badge');
      const patchCountLabel = document.getElementById('vit-patch-count-label');
      const imageGraphics = document.getElementById('vit-image-graphics') as SVGGElement | null;
      const gridLines = document.getElementById('vit-grid-lines') as SVGGElement | null;
      const activePatchRect = document.getElementById(
        'vit-active-patch-rect',
      ) as SVGRectElement | null;
      const canvasSvg = document.getElementById('vit-canvas-svg');

      const activePatchBadge = document.getElementById('vit-active-patch-badge');
      const mathFlatten = document.getElementById('vit-math-flatten');
      const mathPos = document.getElementById('vit-math-pos');
      const metricN = document.getElementById('metric-vit-n');
      const metricSeq = document.getElementById('metric-vit-seq');
      const metricPairs = document.getElementById('metric-vit-pairs');

      function updatePatchDisplay() {
        if (
          !imageGraphics ||
          !gridLines ||
          !activePatchRect ||
          !patchBadge ||
          !patchCountLabel ||
          !activePatchBadge ||
          !mathFlatten ||
          !mathPos ||
          !metricN ||
          !metricSeq ||
          !metricPairs
        )
          return;

        // Render Preset Background
        presets[currentPresetIdx].render(imageGraphics);

        // Update patch grid
        const P = currentPatchSize;
        const gridDim = Math.floor(224 / P);
        const N = gridDim * gridDim;

        patchBadge.textContent =
          P === 16
            ? 'P = 16 × 16 (標準 ViT-Base/16)'
            : P === 32
              ? 'P = 32 × 32 (粗粒度 ViT-Base/32)'
              : 'P = 8 × 8 (超細粒度 ViT-Huge/8)';

        patchCountLabel.textContent = `${gridDim} × ${gridDim} = ${N} 切片`;
        metricN.textContent = N.toString();
        metricSeq.textContent = (N + 1).toString();
        const pairs = (N + 1) * (N + 1);
        metricPairs.textContent = pairs.toLocaleString();

        const flattenDim = P * P * 3;
        mathFlatten.textContent = `P² · C = ${P} × ${P} × 3 = ${flattenDim} 維`;

        // Render Grid Lines
        gridLines.innerHTML = '';
        for (let i = 1; i < gridDim; i++) {
          const coord = i * P;
          // Horizontal line
          const hLine = document.createElementNS('http://www.w3.org/2000/svg', 'line');
          hLine.setAttribute('x1', '0');
          hLine.setAttribute('y1', coord.toString());
          hLine.setAttribute('x2', '224');
          hLine.setAttribute('y2', coord.toString());
          hLine.setAttribute('stroke', '#1e2224');
          hLine.setAttribute('stroke-opacity', '0.4');
          hLine.setAttribute('stroke-width', '1');
          hLine.setAttribute('stroke-dasharray', '2,2');
          gridLines.appendChild(hLine);

          // Vertical line
          const vLine = document.createElementNS('http://www.w3.org/2000/svg', 'line');
          vLine.setAttribute('x1', coord.toString());
          vLine.setAttribute('y1', '0');
          vLine.setAttribute('x2', coord.toString());
          vLine.setAttribute('y2', '224');
          vLine.setAttribute('stroke', '#1e2224');
          vLine.setAttribute('stroke-opacity', '0.4');
          vLine.setAttribute('stroke-width', '1');
          vLine.setAttribute('stroke-dasharray', '2,2');
          gridLines.appendChild(vLine);
        }

        // Keep active patch within boundary
        if (activePatchR >= gridDim) activePatchR = gridDim - 1;
        if (activePatchC >= gridDim) activePatchC = gridDim - 1;

        const patchIndex = activePatchR * gridDim + activePatchC + 1;
        activePatchRect.setAttribute('x', (activePatchC * P).toString());
        activePatchRect.setAttribute('y', (activePatchR * P).toString());
        activePatchRect.setAttribute('width', P.toString());
        activePatchRect.setAttribute('height', P.toString());

        activePatchBadge.textContent = `切片 [${activePatchR}, ${activePatchC}] (#${patchIndex.toString().padStart(2, '0')})`;
        mathPos.textContent = `E_pos^${patchIndex} ∈ ℝ^768`;
      }

      // Presets buttons
      if (presetContainer) {
        presetContainer.innerHTML = '';
        presets.forEach((pr, idx) => {
          const btn = document.createElement('button');
          btn.type = 'button';
          btn.className =
            idx === 0
              ? 'px-3 py-1.5 font-mono text-xs font-bold border-2 border-red bg-red text-surface transition cursor-pointer'
              : 'px-3 py-1.5 font-mono text-xs font-medium border border-ink/40 bg-surface text-ink hover:border-ink hover:bg-paper transition cursor-pointer';
          btn.textContent = pr.name;
          btn.addEventListener('click', () => {
            currentPresetIdx = idx;
            Array.from(presetContainer.children).forEach((c) => {
              (c as HTMLElement).className =
                'px-3 py-1.5 font-mono text-xs font-medium border border-ink/40 bg-surface text-ink hover:border-ink hover:bg-paper transition cursor-pointer';
            });
            btn.className =
              'px-3 py-1.5 font-mono text-xs font-bold border-2 border-red bg-red text-surface transition cursor-pointer';
            updatePatchDisplay();
          });
          presetContainer.appendChild(btn);
        });
      }

      // Patch size selector buttons
      if (patchSelector) {
        patchSelector.innerHTML = '';
        const pSizes = [
          { p: 16, label: 'P = 16 (標準 196 切片)' },
          { p: 32, label: 'P = 32 (粗粒度 49 切片)' },
          { p: 8, label: 'P = 8 (超細粒度 784 切片)' },
        ];
        pSizes.forEach((item, idx) => {
          const btn = document.createElement('button');
          btn.type = 'button';
          btn.className =
            idx === 0
              ? 'px-3.5 py-1.5 font-mono text-xs font-bold border-2 border-red bg-red text-surface transition cursor-pointer'
              : 'px-3.5 py-1.5 font-mono text-xs font-medium border border-ink/40 bg-paper text-ink hover:border-ink transition cursor-pointer';
          btn.textContent = item.label;
          btn.addEventListener('click', () => {
            currentPatchSize = item.p;
            Array.from(patchSelector.children).forEach((c) => {
              (c as HTMLElement).className =
                'px-3.5 py-1.5 font-mono text-xs font-medium border border-ink/40 bg-paper text-ink hover:border-ink transition cursor-pointer';
            });
            btn.className =
              'px-3.5 py-1.5 font-mono text-xs font-bold border-2 border-red bg-red text-surface transition cursor-pointer';
            updatePatchDisplay();
          });
          patchSelector.appendChild(btn);
        });
      }

      // Click on canvas SVG to select patch
      if (canvasSvg) {
        canvasSvg.addEventListener('click', (e) => {
          const rect = canvasSvg.getBoundingClientRect();
          const clickX = ((e.clientX - rect.left) / rect.width) * 224;
          const clickY = ((e.clientY - rect.top) / rect.height) * 224;
          const P = currentPatchSize;
          activePatchC = Math.max(0, Math.min(Math.floor(224 / P) - 1, Math.floor(clickX / P)));
          activePatchR = Math.max(0, Math.min(Math.floor(224 / P) - 1, Math.floor(clickY / P)));
          updatePatchDisplay();
        });
      }

      updatePatchDisplay();

      // 3. Inductive Bias vs Dataset Scale Logic
      interface ScaleDataset {
        id: string;
        label: string;
        title: string;
        scaleBadge: string;
        cnnName: string;
        cnnAcc: number; // %
        vitBaseAcc: number;
        vitHugeAcc: number;
        formulaDesc: string;
        diagnosis: string;
      }

      const scaleDatasets: Record<string, ScaleDataset> = {
        in1k: {
          id: 'in1k',
          label: 'ImageNet-1K (130 萬張)',
          title: '小規模基準：ImageNet-1K 預訓練 (130 萬張影像)',
          scaleBadge: '1.3M 影像 (低資料量)',
          cnnName: 'ResNet-50 (CNN)',
          cnnAcc: 79.3,
          vitBaseAcc: 77.9,
          vitHugeAcc: 74.2,
          formulaDesc:
            '在小規模資料下，CNN 的 2D 局部性與平移等變性是強大的「正規化先驗」；而 ViT 由於缺乏歸納偏向，必須耗費大量參數從頭摸索空間幾何，ViT-Huge 甚至因嚴重過度擬合而暴跌至 74.2%！',
          diagnosis:
            '【卷積壟斷區】此時業界普遍得出「Transformer 不適合電腦視覺」的錯誤結論。事實上並非架構落後，而是缺乏足夠的資料量來填補「歸納偏向的真空」。',
        },
        in21k: {
          id: 'in21k',
          label: 'ImageNet-21K (1400 萬張)',
          title: '中規模基準：ImageNet-21K 預訓練 (1400 萬張影像)',
          scaleBadge: '14M 影像 (中資料量)',
          cnnName: 'BiT-M R152x2 (強 CNN)',
          cnnAcc: 84.4,
          vitBaseAcc: 84.1,
          vitHugeAcc: 85.1,
          formulaDesc:
            '當資料量擴展 10 倍至 1400 萬張時，ViT-Base 追平頂級 CNN，ViT-Huge 開始扭轉劣勢並反超 ResNet！弱歸納偏向的自由度開始展現威力。',
          diagnosis:
            '【均勢轉折點】資料量跨越 1000 萬張門檻後，ViT 已經能自行在淺層自注意力中學會類似 Gabor 濾波器的局部紋理特徵，同時保有全圖遠程關聯的能力。',
        },
        jft300m: {
          id: 'jft300m',
          label: 'JFT-300M (3 億張)',
          title: '超大規模基準：JFT-300M 預訓練 (3 億張影像)',
          scaleBadge: '300M 影像 (海量資料)',
          cnnName: 'BiT-L R152x4 (極限 CNN)',
          cnnAcc: 87.54,
          vitBaseAcc: 87.76,
          vitHugeAcc: 88.55,
          formulaDesc:
            '在 3 億張影像的浩瀚宇宙中，CNN 的局部卷積核反而成了抑制性能躍升的「天花板」；純 Transformer 以 88.55% 創下歷史新紀錄，且訓練算力僅為 BiT-L 的四分之一！',
          diagnosis:
            '【大一統相變】「大數據 + 大模型 + 弱歸納偏向 = 更高上限」的 Scaling 物理鐵律在視覺領域被徹底證實！純 Transformer 正式登基為跨模態的通用架構。',
        },
      };

      let activeDatasetId = 'in1k';

      const datasetContainer = document.getElementById('vit-scale-dataset-container');
      const datasetTitle = document.getElementById('vit-dataset-title');
      const datasetScaleBadge = document.getElementById('vit-dataset-scale-badge');
      const cnnModelName = document.getElementById('vit-cnn-model-name');
      const cnnAccVal = document.getElementById('vit-cnn-acc-val');
      const cnnBar = document.getElementById('vit-cnn-bar');
      const vitBaseAccVal = document.getElementById('vit-base-acc-val');
      const vitBaseBar = document.getElementById('vit-base-bar');
      const vitHugeAccVal = document.getElementById('vit-huge-acc-val');
      const vitHugeBar = document.getElementById('vit-huge-bar');
      const biasFormulaDesc = document.getElementById('vit-bias-formula-desc');
      const scaleDiagnosisText = document.getElementById('vit-scale-diagnosis-text');

      function renderScaleDataset() {
        const d = scaleDatasets[activeDatasetId];
        if (
          !d ||
          !datasetTitle ||
          !datasetScaleBadge ||
          !cnnModelName ||
          !cnnAccVal ||
          !cnnBar ||
          !vitBaseAccVal ||
          !vitBaseBar ||
          !vitHugeAccVal ||
          !vitHugeBar ||
          !biasFormulaDesc ||
          !scaleDiagnosisText
        )
          return;

        datasetTitle.textContent = d.title;
        datasetScaleBadge.textContent = d.scaleBadge;
        cnnModelName.textContent = d.cnnName;

        cnnAccVal.textContent = `${d.cnnAcc.toFixed(1)}%`;
        cnnBar.style.width = `${d.cnnAcc}%`;

        vitBaseAccVal.textContent = `${d.vitBaseAcc.toFixed(1)}%`;
        vitBaseBar.style.width = `${d.vitBaseAcc}%`;

        vitHugeAccVal.textContent = `${d.vitHugeAcc.toFixed(1)}%`;
        vitHugeBar.style.width = `${d.vitHugeAcc}%`;

        biasFormulaDesc.textContent = d.formulaDesc;
        scaleDiagnosisText.textContent = d.diagnosis;
      }

      if (datasetContainer) {
        datasetContainer.innerHTML = '';
        Object.keys(scaleDatasets).forEach((key, idx) => {
          const ds = scaleDatasets[key];
          const btn = document.createElement('button');
          btn.type = 'button';
          btn.className =
            idx === 0
              ? 'px-3 py-1.5 font-mono text-xs font-bold border-2 border-red bg-red text-surface transition cursor-pointer'
              : 'px-3 py-1.5 font-mono text-xs font-medium border border-ink/40 bg-surface text-ink hover:border-ink hover:bg-paper transition cursor-pointer';
          btn.textContent = ds.label;
          btn.addEventListener('click', () => {
            activeDatasetId = key;
            Array.from(datasetContainer.children).forEach((c) => {
              (c as HTMLElement).className =
                'px-3 py-1.5 font-mono text-xs font-medium border border-ink/40 bg-surface text-ink hover:border-ink hover:bg-paper transition cursor-pointer';
            });
            btn.className =
              'px-3 py-1.5 font-mono text-xs font-bold border-2 border-red bg-red text-surface transition cursor-pointer';
            renderScaleDataset();
          });
          datasetContainer.appendChild(btn);
        });
      }

      renderScaleDataset();
    }

    if (document.readyState === 'loading') {
      document.addEventListener('DOMContentLoaded', initVitLab);
    } else {
      initVitLab();
    }
  </script>
</BaseLayout>
