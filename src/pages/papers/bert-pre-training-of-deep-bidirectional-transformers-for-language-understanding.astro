            aria-hidden="true"
          ></div>

          <div class="space-y-24 sm:space-y-32">
            {timelineEpochs.map((epoch) => (
              <div id={epoch.id} class="relative scroll-mt-28">
                <!-- 背景水印年份 -->
                <div
                  class="pointer-events-none select-none absolute -top-12 sm:-top-20 -left-6 sm:left-4 font-display font-black text-8xl sm:text-9xl lg:text-[11rem] leading-none text-ink/[0.04] tracking-tighter"
                  aria-hidden="true"
                >
                  {epoch.year.split('–')[0].replace(/[^0-9]/g, '')}
