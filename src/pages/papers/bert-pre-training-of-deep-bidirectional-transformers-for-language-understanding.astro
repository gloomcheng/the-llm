                          item.featured
                            ? 'border-2 border-ink lg:col-span-2'
                            : 'border-ink/20 hover:border-ink'
                        }`}
                      >
                        <div class="flex items-center justify-between border-b border-line pb-3 mb-3">
                          <span class="font-mono text-xs font-bold text-blue uppercase">
                            [{item.refCode}] {item.role}
                          </span>
                          <span class="font-mono text-xs text-muted">
                            {item.source.published} · {item.source.publisher}
                          </span>
                        </div>

                        <h4 class="m-0 font-display text-lg sm:text-xl text-ink leading-snug">
                          {item.source.title}
                        </h4>

                        <p class="mt-3 text-xs sm:text-sm text-ink/75 leading-relaxed">
                          {item.takeaway}
                        </p>

                        <div class="mt-4 border-t border-line/60 pt-3">
                          <p class="m-0 text-xs text-muted">
                            <span class="font-bold text-ink">邊界限制：</span>
                            {item.source.limits}
                          </p>
                        </div>

                        <div class="mt-4 text-right">
                          <a
                            href={item.source.url}
                            target="_blank"
                            rel="noreferrer"
                            class="font-mono text-xs text-blue underline underline-offset-4 hover:text-ink"
                          >
                            原始來源 ↗
                          </a>
                        </div>
                      </div>
                    ))}
                  </div>
                </div>
              </div>
            ))}
          </div>
        </div>
      </div>
    </section>

    <!-- 參考文獻與史料依據 -->
    <section class={`${shell} border-t border-ink py-16`} aria-label="參考文獻與歷史證物">
