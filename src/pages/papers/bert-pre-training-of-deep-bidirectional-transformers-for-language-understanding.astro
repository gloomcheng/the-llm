                <!-- 標題與節點 -->
                <div class="relative flex items-start gap-4 sm:gap-8 mb-8 sm:mb-12">
                  <div
                    class="hidden md:flex h-9 w-9 flex-shrink-0 items-center justify-center rounded-full border-2 border-blue bg-surface font-mono text-xs font-bold text-blue shadow-sm z-10"
                    aria-hidden="true"
                  >
                    {epoch.year.slice(-2)}
                  </div>

                  <div class="flex-1">
                    <div class="flex flex-wrap items-center gap-3">
                      <span class="font-mono text-xs font-bold uppercase tracking-[0.12em] text-blue">
                        {epoch.period}
                      </span>
                    </div>
                    <h3 class="m-0 mt-1 font-display text-2xl sm:text-3xl text-ink tracking-tight">
                      {epoch.title}
                    </h3>
                    <p class="m-0 mt-2 max-w-[85ch] text-sm sm:text-base text-ink/75 leading-relaxed">
                      {epoch.summary}
                    </p>
                  </div>
                </div>

                <!-- 論文卡片 -->
                <div class="md:ml-16">
                  <div class="grid grid-cols-1 lg:grid-cols-2 gap-6">
                    {epoch.sources.map((item) => (
                      <div
                        id={item.source.id}
