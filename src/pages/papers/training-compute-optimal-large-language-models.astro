  <script>
    function initChinchillaLab() {
      // 1. Tab Switching
      const tabIsoflop = document.getElementById('chinchilla-tab-isoflop');
      const tabBattle = document.getElementById('chinchilla-tab-battle');
      const panelIsoflop = document.getElementById('chinchilla-panel-isoflop');
      const panelBattle = document.getElementById('chinchilla-panel-battle');

      if (!tabIsoflop || !tabBattle || !panelIsoflop || !panelBattle) return;

      tabIsoflop.addEventListener('click', () => {
        tabIsoflop.setAttribute('aria-selected', 'true');
        tabIsoflop.className =
          'px-4 py-2 font-mono text-xs sm:text-sm font-bold border-2 border-red bg-red text-surface transition cursor-pointer';
        tabBattle.setAttribute('aria-selected', 'false');
        tabBattle.className =
          'px-4 py-2 font-mono text-xs sm:text-sm font-medium border border-ink/40 bg-surface text-ink hover:border-ink hover:bg-paper transition cursor-pointer';
        panelIsoflop.classList.remove('hidden');
        panelBattle.classList.add('hidden');
      });

      tabBattle.addEventListener('click', () => {
        tabBattle.setAttribute('aria-selected', 'true');
        tabBattle.className =
          'px-4 py-2 font-mono text-xs sm:text-sm font-bold border-2 border-red bg-red text-surface transition cursor-pointer';
        tabIsoflop.setAttribute('aria-selected', 'false');
        tabIsoflop.className =
          'px-4 py-2 font-mono text-xs sm:text-sm font-medium border border-ink/40 bg-surface text-ink hover:border-ink hover:bg-paper transition cursor-pointer';
        panelBattle.classList.remove('hidden');
        panelIsoflop.classList.add('hidden');
      });

      // 2. IsoFLOP U-Curve & Economics Logic
      interface ComputeBudget {
        id: string;
        label: string;
        flops: number; // FLOPs
        flopsFormatted: string;
        optN: number; // in billions (B)
        optD: number; // in trillions (T)
        desc: string;
      }

      const budgets: Record<string, ComputeBudget> = {
        gopher: {
          id: 'gopher',
          label: 'Gopher / Chinchilla 算力預算 (5.76 × 10²³ FLOPs)',
          flops: 5.76e23,
          flopsFormatted: '5.76 × 10²³ FLOPs',
          optN: 70, // 70B
          optD: 1.4, // 1.4T
          desc: 'DeepMind 投入約 4,000 TPU-days 之旗艦算力。歷史上 Gopher 選擇了 280B + 300B Tokens，而 Chinchilla 證實 70B + 1.4T 才是此預算下的絕對最佳解！',
        },
        gpt3: {
          id: 'gpt3',
          label: 'GPT-3 算力預算 (3.15 × 10²³ FLOPs)',
          flops: 3.15e23,
          flopsFormatted: '3.15 × 10²³ FLOPs',
          optN: 67, // 67B
          optD: 0.78, // 780B
          desc: 'OpenAI 訓練 175B GPT-3 所耗費之總算力。若依據 Chinchilla 處方重新分配，僅需 67B 參數搭配 780B Tokens 即可達到更低損失。',
        },
        llama: {
          id: 'llama',
          label: 'LLaMA-65B 算力預算 (1.20 × 10²⁴ FLOPs)',
          flops: 1.2e24,
          flopsFormatted: '1.20 × 10²⁴ FLOPs',
          optN: 140, // 140B
          optD: 1.43, // 1.43T
          desc: 'Meta 訓練 LLaMA-65B 之算力池。Meta 刻意選擇以 65B 搭配 1.4T Tokens 進行「超前過度訓練」，以極致壓縮終端推論成本。',
        },
      };

      let activeBudgetId = 'gopher';
      let currentN = 70; // billions

      const budgetContainer = document.getElementById('chinchilla-budget-container');
      const paramSlider = document.getElementById(
        'chinchilla-param-slider',
      ) as HTMLInputElement | null;
      const paramBadge = document.getElementById('chinchilla-param-badge');
      const uPath = document.getElementById('chinchilla-u-path');
      const optPoint = document.getElementById('chinchilla-opt-point');
      const optText = document.getElementById('chinchilla-opt-text');
      const cursorLine = document.getElementById('chinchilla-cursor-line');
      const activePoint = document.getElementById('chinchilla-active-point');

      const specN = document.getElementById('spec-n-val');
      const specD = document.getElementById('spec-d-val');
      const specRatio = document.getElementById('spec-ratio-val');
      const specLoss = document.getElementById('spec-loss-val');
      const specVram = document.getElementById('spec-vram-val');
      const specGpu = document.getElementById('spec-gpu-val');
      const specSavings = document.getElementById('spec-savings-val');
      const diagText = document.getElementById('chinchilla-diagnosis-text');

      function calcLoss(nBillions: number, dTokens: number): number {
        const E = 1.6934;
        const A = 406.4;
        const B = 410.7;
        const alpha = 0.3392;
        const beta = 0.2849;
        const nActual = nBillions * 1e9;
        return E + A / Math.pow(nActual, alpha) + B / Math.pow(dTokens, beta);
      }

      function renderIsoflopLab() {
        const bg = budgets[activeBudgetId];
        if (
          !bg ||
          !paramBadge ||
          !uPath ||
          !optPoint ||
          !optText ||
          !cursorLine ||
          !activePoint ||
          !specN ||
          !specD ||
          !specRatio ||
          !specLoss ||
          !specVram ||
          !specGpu ||
          !specSavings ||
          !diagText
        )
          return;

        const nActual = currentN * 1e9;
        const dActual = bg.flops / (6 * nActual);
        const dTrillions = dActual / 1e12;
        const ratio = dActual / nActual;
        const currentLoss = calcLoss(currentN, dActual);

        const optN = bg.optN;
        const optDActual = bg.flops / (6 * optN * 1e9);
        const optLoss = calcLoss(optN, optDActual);

        paramBadge.textContent = `N = ${currentN} 億 (${currentN}B) · ${
          Math.abs(currentN - optN) <= 10
            ? 'Chinchilla 最佳平衡點'
            : currentN < optN
              ? '模型偏小 · 資料負擔重'
              : '模型偏大 · 嚴重訓練不足'
        }`;

        function nToX(n: number): number {
          return 60 + ((n - 10) / 290) * 400;
        }

        function lossToY(l: number): number {
          const clamped = Math.max(1.8, Math.min(2.4, l));
          return 190 - ((clamped - 1.8) / 0.6) * 150;
        }

        const samples = 30;
        let pathStr = '';
        for (let i = 0; i <= samples; i++) {
          const sampleN = 10 + (i / samples) * 290;
          const sampleD = bg.flops / (6 * sampleN * 1e9);
          const sampleL = calcLoss(sampleN, sampleD);
          const px = nToX(sampleN);
          const py = lossToY(sampleL);
          pathStr +=
            i === 0
              ? `M ${px.toFixed(1)} ${py.toFixed(1)}`
              : ` L ${px.toFixed(1)} ${py.toFixed(1)}`;
        }
        uPath.setAttribute('d', pathStr);

        const optX = nToX(optN);
        const optY = lossToY(optLoss);
        optPoint.setAttribute('cx', optX.toFixed(1));
        optPoint.setAttribute('cy', optY.toFixed(1));
        optText.setAttribute('x', optX.toFixed(1));
        optText.setAttribute('y', (optY - 10).toFixed(1));

        const curX = nToX(currentN);
        const curY = lossToY(currentLoss);
        cursorLine.setAttribute('x1', curX.toFixed(1));
        cursorLine.setAttribute('x2', curX.toFixed(1));
        activePoint.setAttribute('cx', curX.toFixed(1));
        activePoint.setAttribute('cy', curY.toFixed(1));

        specN.textContent = `${currentN}B`;
        specD.textContent = `${dTrillions.toFixed(2)} 兆`;
        specRatio.textContent = `${ratio.toFixed(1)}×`;
        specLoss.textContent = `${currentLoss.toFixed(3)} nats`;

        const vramGb = currentN * 2;
        specVram.textContent = `${vramGb} GB`;
        const a100Count = Math.ceil(vramGb / 70);
        specGpu.textContent = `${a100Count} 張 A100 (80GB)`;

        if (currentN <= 70) {
          specSavings.textContent = '推論成本相較 280B 節省 75%';
          specSavings.className = 'font-bold text-red';
        } else if (currentN <= 175) {
          specSavings.textContent = '推論成本相較 280B 節省 38%';
          specSavings.className = 'font-bold text-blue';
        } else {
          specSavings.textContent = '推論成本極高（需跨節點多卡並行）';
          specSavings.className = 'font-bold text-muted';
        }

        if (Math.abs(currentN - optN) <= 10) {
          diagText.textContent = `【黃金平衡點】在 ${bg.flopsFormatted} 算力下，${currentN}B 參數搭配 ${dTrillions.toFixed(2)} 兆 Token 完美落於 IsoFLOP 拋物線谷底（損失 ${currentLoss.toFixed(3)} nats）！資料 / 參數比恰為 20:1，達成訓練與推論的雙重最佳化。`;
        } else if (currentN > optN) {
          const wastePercent = (((currentLoss - optLoss) / optLoss) * 100).toFixed(1);
          diagText.textContent = `【嚴重訓練不足（Gopher / GPT-3 陷阱）】將過多算力堆砌在參數量（${currentN}B），導致每個參數僅分配到 ${ratio.toFixed(1)} 個 Token（遠低於 20:1）。模型因「吃不飽數據」損失偏高（+${wastePercent}%），且推論時需要背負龐大的視訊記憶體開銷。`;
        } else {
          diagText.textContent = `【過訓練（LLaMA 實用主義）】將模型縮小至 ${currentN}B，並餵入超額的 ${dTrillions.toFixed(2)} 兆 Token（D/N = ${ratio.toFixed(1)}×）。雖然訓練損失略高於理論谷底，但模型體積極小，在終端設備部署與高並發推論時性價比極高！`;
        }
      }

      if (budgetContainer) {
        budgetContainer.innerHTML = '';
        Object.keys(budgets).forEach((key, idx) => {
          const bg = budgets[key];
          const btn = document.createElement('button');
          btn.type = 'button';
          btn.className =
            idx === 0
              ? 'px-3 py-1.5 font-mono text-xs font-bold border-2 border-red bg-red text-surface transition cursor-pointer'
              : 'px-3 py-1.5 font-mono text-xs font-medium border border-ink/40 bg-surface text-ink hover:border-ink hover:bg-paper transition cursor-pointer';
          btn.textContent = bg.label;
          btn.addEventListener('click', () => {
            activeBudgetId = key;
            Array.from(budgetContainer.children).forEach((c) => {
              (c as HTMLElement).className =
                'px-3 py-1.5 font-mono text-xs font-medium border border-ink/40 bg-surface text-ink hover:border-ink hover:bg-paper transition cursor-pointer';
            });
            btn.className =
              'px-3 py-1.5 font-mono text-xs font-bold border-2 border-red bg-red text-surface transition cursor-pointer';
            renderIsoflopLab();
          });
          budgetContainer.appendChild(btn);
        });
      }

      if (paramSlider) {
        paramSlider.addEventListener('input', (e) => {
          currentN = parseInt((e.target as HTMLInputElement).value, 10);
          renderIsoflopLab();
        });
      }

      renderIsoflopLab();
    }

    if (document.readyState === 'loading') {
      document.addEventListener('DOMContentLoaded', initChinchillaLab);
    } else {
      initChinchillaLab();
    }
  </script>
</BaseLayout>
