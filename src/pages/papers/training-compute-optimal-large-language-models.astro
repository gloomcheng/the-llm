---
import BaseLayout from '../../layouts/BaseLayout.astro';
import { withBase } from '../../lib/paths';
import StoryRail from '../../components/StoryRail.astro';
import PaperReadingLayout from '../../components/PaperReadingLayout.astro';
import AsideCard from '../../components/AsideCard.astro';
import Callout from '../../components/Callout.astro';
import AuthorGrid from '../../components/AuthorGrid.astro';
import EvidenceList from '../../components/EvidenceList.astro';
import PaperMeta from '../../components/PaperMeta.astro';
import PaperNavigation from '../../components/PaperNavigation.astro';
import {
  chinchillaPaper,
  chinchillaSources,
} from '../../content/papers/training-compute-optimal-large-language-models';

const paper = chinchillaPaper;
const shell = 'mx-auto w-[calc(100%-2rem)] max-w-[1120px]';

const story = [
  {
    year: '2020.01',
    label: '理論 / SCALING LAWS',
    title: 'Kaplan 冪律公式誕生：低估數據重要性，建議算力偏向參數',
    body: 'OpenAI 提出 N ∝ C^0.73 與 D ∝ C^0.27，引導整個學界與工業界將算力極端傾斜於模型參數量擴充。',
    status: 'past' as const,
  },
  {
    year: '2020.05',
    label: '里程碑 / GPT-3',
    title: '1750 億參數 GPT-3 問世，千億參數軍備競賽全面爆發',
    body: 'GPT-3 僅訓練 3000 億 token，但憑藉少樣本湧現能力震撼全球，隨後業界爭相訓練 280B Gopher 與 530B MT-NLG。',
    status: 'past' as const,
  },
  {
    year: '2022.03',
    label: '論文 / CHINCHILLA',
    title: 'DeepMind 發表 Chinchilla：以 1:1 黃金律重寫算力最佳化分配',
    body: 'Jordan Hoffmann 等人訓練 400 餘組模型，證實大模型嚴重「吃不飽數據」；70B Chinchilla 以相同算力完勝 280B Gopher。',
    status: 'current' as const,
  },
  {
    year: '2023.02',
    label: '開源 / LLAMA 浪潮',
    title: 'Meta LLaMA 繼承並超越 Chinchilla，開創推論最佳化過訓練典範',
    body: '為追求終身推論極致性價比，小模型搭配數兆 token 成為現代開源基座標配，彻底改變生成式 AI 工業經濟學。',
    status: 'future' as const,
  },
];

interface TimelineEpoch {
  id: string;
  year: string;
  period: string;
  title: string;
  summary: string;
  sources: Array<{
    source: (typeof chinchillaSources)[number];
    num: number;
    refCode: string;
    featured?: boolean;
    role: string;
    takeaway: string;
  }>;
}

const timelineEpochs: TimelineEpoch[] = [
  {
    id: 'epoch-2020-scaling',
    year: '2020',
    period: '縮放定律的指引與早期偏差',
    title: 'Kaplan 冪律公式與千億模型擴展熱潮',
    summary:
      'Kaplan 等人首次確立自回歸語言模型跨越數個數量級的冪律行為。然而因實驗採用固定步數學習率調度，導致模型在較少 token 時尚未充分收斂，誤導業界認為「模型參數比數據量重要得多」。',
    sources: [
      {
        source: chinchillaSources.find((s) => s.id === 'paper-2020-scaling-laws')!,
        num: 1,
        refCode: 'S01',
        featured: true,
        role: '理論前驅',
        takeaway:
          '提出 N ∝ C^0.73 與 D ∝ C^0.27 的算力分配處方，促使各大實驗室爭先恐後將模型參數推向千億規模。',
      },
      {
        source: chinchillaSources.find((s) => s.id === 'paper-2020-gpt3')!,
        num: 2,
        refCode: 'S02',
        role: '標誌實踐',
        takeaway:
          '1750 億參數的 GPT-3 僅搭配 3000 億 token 預訓練，雖然湧現強大能力，但以計算效率審視屬於典型嚴重訓練不足。',
      },
    ],
  },
  {
    id: 'epoch-2021-giants',
    year: '2021',
    period: '參數軍備競賽與推論維運困境',
    title: 'Gopher 與 MT-NLG 登上千億巔峰，硬體成本不堪重負',
    summary:
      'DeepMind 打造 280B Gopher，微軟與 NVIDIA 聯手推出 530B Megatron-Turing NLG。這些龐然大物在推論時需動輒數十張甚至上百張 GPU 組成複雜管線並行，吞吐量低下且部署極為昂貴。',
    sources: [
      {
        source: chinchillaSources.find((s) => s.id === 'paper-2021-gopher')!,
        num: 3,
        refCode: 'S03',
        featured: true,
        role: '基準對照',
        takeaway:
          'DeepMind 的 280B 旗艦模型，訓練於 3000 億 token MassiveText 上，成為後續 Chinchilla 相同算力對決之核心標靶。',
      },
    ],
  },
  {
    id: 'epoch-2022-chinchilla',
    year: '2022.03',
    period: '計算最佳化化定律的全面修訂',
    title: 'Jordan Hoffmann 等人發表 Chinchilla，破除參數迷信',
    summary:
      '透過對 400 餘個模型的精密實證，證明參數量與訓練 token 數應以 1:1 等比例增長。70B 參數、訓練 1.4 兆 token 的 Chinchilla 在完全相同算力下全面戰勝 280B Gopher。',
    sources: [
      {
        source: chinchillaSources.find((s) => s.id === 'paper-2022-chinchilla')!,
        num: 4,
        refCode: 'S04',
        featured: true,
        role: '本篇核心',
        takeaway:
          '提出最小損失包絡線、IsoFLOP 與參數化擬合三種方法，確立 N ∝ C^0.50 與 D ∝ C^0.50，開啟以高數據比訓練小基座的全新篇章。',
      },
    ],
  },
  {
    id: 'epoch-2023-llama',
    year: '2023–至今',
    period: '開源基座大航海與推論最佳化化',
    title: 'LLaMA 與 Mistral 全面採納高密度數據訓練',
    summary:
      'Meta AI 的 LLaMA 團隊將 Chinchilla 思維推向極致：為降低下游百萬次推論成本，故意對 7B 與 13B 輕量基座進行數兆 token 的深度過訓練，現代開源 AI 生態就此奠定。',
    sources: [
      {
        source: chinchillaSources.find((s) => s.id === 'paper-2023-llama')!,
        num: 5,
        refCode: 'S05',
        featured: true,
        role: '工業演化',
        takeaway:
          '從訓練算力最佳化跨越至推論成本最佳化，7B 模型訓練 1.4 兆 token 匹敵 GPT-3，印證了數據擴充的無盡紅利。',
      },
    ],
  },
];
---

<BaseLayout title={`${paper.chineseTitle} | THE LLM`} description={paper.abstractSummary}>
  <header class={`${shell} pt-10`}>
    <div class="flex gap-3 font-mono text-sm uppercase tracking-[0.08em] text-muted">
      <a class="text-red underline underline-offset-4" href={withBase('/')}>
        THE LLM
      </a>
      <span aria-hidden="true">/</span>
      <span>第 07 章</span>
    </div>

    <div class="grid grid-cols-1 items-end gap-12 py-16 lg:grid-cols-[1.15fr_0.85fr] lg:gap-24">
      <div>
        <p class="mb-5 font-mono text-sm font-semibold uppercase tracking-[0.12em] text-red">
          VOL. 07 / COMPUTE-OPTIMAL
        </p>

        <h1 class="m-0 font-display text-4xl sm:text-5xl lg:text-6xl xl:text-7xl leading-tight tracking-[-0.04em] text-ink">
          <span class="block">Training Compute-Optimal</span>
          <em class="block">Large Language Models</em>
        </h1>

        <p class="mt-8 max-w-[52ch] text-lg leading-8 text-muted">
          當全世界科技巨頭盲目追逐數千億參數的龐然巨獸，DeepMind 重新審視了 400
          餘個模型的訓練軌跡，發現所有千億模型都在「數據飢餓」中嚴重空轉。Chinchilla
          以四分之一參數量擊潰巨獸，確立了參數與數據 1:1 平衡擴展的黃金定律。
        </p>
      </div>

      <aside
        class="border-t-4 border-red bg-surface p-6 shadow-editorial"
        aria-label="這篇論文的一句評語"
      >
        <p class="mb-4 sm:mb-6 font-mono text-xs sm:text-sm font-semibold uppercase tracking-[0.12em] text-red">
          一句評語 / THE SHORT VERDICT
        </p>
        <p class="m-0 max-w-[20ch] sm:max-w-[22ch] font-display text-2xl sm:text-3xl leading-tight text-ink">
          大模型不是越大越聰明，餵飽數據的小模型才是算力與推論的真正王者。
        </p>
        <p class="mt-6 mb-0 text-sm sm:text-base leading-relaxed sm:leading-7 text-muted">
          70B 參數搭配 1.4 兆 token 的 Chinchilla，以完全相同算力全面超越 280B 的 Gopher 與 175B 的
          GPT-3，扭轉了全球大模型的研發航向。
        </p>
      </aside>
    </div>

    <PaperMeta
      year={paper.year}
      venue={paper.venue}
      readTime="30 分鐘"
      difficulty="進階實證理論"
      doi={paper.doi}
    />
  </header>

  <main id="main-content">
    <!-- 歷史縱深導航條 (STORY RAIL) -->
    <section class="border-t border-ink py-12" aria-label="歷史縱深導向">
      <div class={shell}>
        <div class="mb-8">
          <p class="mb-2 font-mono text-xs font-bold uppercase tracking-[0.14em] text-red">
            歷史長河 / THE CHRONOLOGY
          </p>
          <h2 class="m-0 font-display text-2xl sm:text-3xl text-ink">
            從盲目參數軍備，到算力與數據對稱擴展的理性覺醒
          </h2>
        </div>
        <StoryRail events={story} />
      </div>
    </section>

    <!-- 章節 01: 盲目軍備與算力錯覺 (THE IMPASSE) -->
    <section
      id="compute-impasse"
      class={`${shell} border-t border-ink py-16 sm:py-20 lg:py-24 scroll-mt-24`}
      aria-labelledby="compute-impasse-title"
    >
      <div class="mb-12 flex flex-col gap-6 lg:flex-row lg:items-end lg:justify-between">
        <div>
          <p class="mb-4 font-mono text-sm font-semibold uppercase tracking-[0.12em] text-red">
            章節 01 · 盲目軍備與算力錯覺 / THE IMPASSE
          </p>
          <h2
            id="compute-impasse-title"
            class="m-0 font-display text-3xl sm:text-4xl lg:text-5xl leading-tight tracking-tight text-ink"
          >
            <span class="block">千億參數的虛火與盲目軍備：</span>
            <span class="block">
              <em>當龐然巨獸在數據飢餓中空轉</em>
            </span>
          </h2>
        </div>
        <p class="m-0 max-w-[34ch] text-base leading-8 text-muted">
          Kaplan
          縮放定律將全球研發力量導向了參數量的大躍進，但昂貴的千億巨獸卻背負著難以承受的推論代價。
        </p>
      </div>

      <PaperReadingLayout class="text-base leading-8 text-ink">
        <div class="space-y-6">
          <p>
            在 2020 年初，OpenAI 的 Jared Kaplan 等人發表了劃時代的
            <a
              href={withBase('/papers/scaling-laws-for-neural-language-models')}
              class="font-medium text-ink underline decoration-line/80 underline-offset-4 transition-colors hover:text-red hover:decoration-red"
            >
              Scaling Laws
            </a>
            縮放定律。那篇論文以嚴謹的物理測量視角向全世界宣稱：給定新增的浮點運算預算（FLOPs），最佳的分配策略是將高達
            73% 的資源投注於擴大模型參數量（
            <math class="font-serif">
              <mi>N</mi>
              <mo>∝</mo>
              <msup>
                <mi>C</mi>
                <mn>0.73</mn>
              </msup>
            </math>
            ），而僅將微不足道的 27% 分配給訓練資料集（
            <math class="font-serif">
              <mi>D</mi>
              <mo>∝</mo>
              <msup>
                <mi>C</mi>
                <mn>0.27</mn>
              </msup>
            </math>
            ）。換言之，計算資源每增長 10 倍，模型參數量應當膨脹 5.4 倍，而訓練資料量只需要增加區區
            1.86 倍。
          </p>

          <p>
            這份數學處方迅速成為全球人工智慧實驗室奉若神明的圭臬。在隨後的兩年裡，一場人類計算史上罕見的千億參數軍備競賽全面爆發：OpenAI
            率先推出 1750 億參數的 GPT-3，僅僅投餵了 3000 億 token 的數據；AI21 Labs 緊隨其後推出
            1780 億參數的 Jurassic-1；DeepMind 耗費巨資打造了 2800 億參數的 Gopher，數據量同樣停留在
            3000 億 token；而微軟與 NVIDIA 更將這場狂熱推向頂點，聯手發表了參數量高達 5300 億的
            Megatron-Turing NLG（MT-NLG），訓練語料甚至只有可憐的 2700 億 token。
          </p>

          <p>
            然而，這場看似壯觀的技術競逐，卻在工程落地層面撞上了一堵無比堅硬的高牆。一個 5300
            億參數的模型，光是儲存其 FP16 浮點權重就需要超過 1 TB
            的高頻寬記憶體（HBM）。在推論階段，即使不考慮上下文的 KV
            快取，單次前向傳播也必須動用數十台搭載頂級 NVIDIA A100 GPU
            的昂貴伺服器，依賴跨節點的張量並行（Tensor Parallelism）與管線並行（Pipeline
            Parallelism）進行極其繁複的通訊切分。推論延遲居高不下，單次查詢成本宛如吞金怪獸，使得這些千億模型幾乎無法大規模商業化服務一般用戶。
          </p>

          <p>
            更深刻的理論質疑開始在少數學者心中萌生：當我們耗費數百萬美元的電力，讓一個擁有數千億連接的神經網路僅僅匆匆翻閱過
            3000 億個詞元時，這個模型真的「學會」充分利用其龐大的記憶體空間了嗎？如果將 5300
            億參數的模型比喻為一個擁有萬卷書庫的學者，那麼他一生閱讀的文字量，竟然與一個僅有幾十億參數的小學生相差無幾。這種「參數巨碩、數據飢餓」的畸形狀態，究竟是自然法則的必然，還是我們打從一開始就讀錯了縮放定律的導航地圖？
          </p>
        </div>

        <aside slot="rail" class="space-y-6">
          <AsideCard
            kicker="工程代價 / INFERENCE BOTTLENECK"
            title="千億巨獸的推論詛咒：記憶體頻寬與跨節點延遲"
            variant="surface"
          >
            <p class="text-sm sm:text-base leading-relaxed text-muted m-0">
              大語言模型在推論生成每個 token 時，本質上是一個受限於記憶體頻寬（Memory Bandwidth
              Bound）的過程：GPU 必須將全部模型權重從 HBM 完整載入運算單元一次。對於 530B
              模型，每生成一個字就得搬運 1.06 TB 資料。若模型無法塞進單一伺服器節點（8 張
              GPU），跨節點網路的通訊延遲將使推論吞吐量暴跌，維運成本呈幾何級數飆升。
            </p>
          </AsideCard>
        </aside>
      </PaperReadingLayout>
    </section>

    <!-- 章節 02: 算力邊界的實證重構 (THE MECHANISM) -->
    <section
      id="empirical-reconstruction"
      class={`${shell} border-t border-ink py-16 sm:py-20 lg:py-24 scroll-mt-24`}
      aria-labelledby="empirical-reconstruction-title"
    >
      <div class="mb-12 flex flex-col gap-6 lg:flex-row lg:items-end lg:justify-between">
        <div>
          <p class="mb-4 font-mono text-sm font-semibold uppercase tracking-[0.12em] text-red">
            章節 02 · 算力邊界的實證重構 / THE MECHANISM
          </p>
          <h2
            id="empirical-reconstruction-title"
            class="m-0 font-display text-3xl sm:text-4xl lg:text-5xl leading-tight tracking-tight text-ink"
          >
            <span class="block">破除神話的三重實證：</span>
            <span class="block">
              <em>學習率調度陷阱、IsoFLOP 剖面與 1:1 黃金律</em>
            </span>
          </h2>
        </div>
        <p class="m-0 max-w-[34ch] text-base leading-8 text-muted">
          DeepMind 以超過 400 組密集實驗揭開 Kaplan
          原定律的調度偏差，確立參數量與數據量對稱擴展的數學真理。
        </p>
      </div>

      <PaperReadingLayout class="text-base leading-8 text-ink">
        <div class="space-y-6">
          <p>
            2022 年初，DeepMind 的 Jordan Hoffmann、Sebastian Borgeaud、Arthur Mensch 與 Laurent
            Sifre 等人決定重探大模型擴展的底層數學。他們首先抓住了 Kaplan
            原論文中一個致命但長期被忽視的實驗細節：
            <strong>學習率衰減排程（Learning Rate Schedule）的固定步數陷阱</strong>。
          </p>

          <p>
            在現代深度 Transformer 的訓練中，餘弦學習率衰減（Cosine Learning Rate
            Decay）扮演著決定性的角色。當學習率在訓練末期逐漸退火至峰值的 10%
            時，模型權重才會真正沉降至最佳的局部損失極小值谷底。然而，Kaplan 等人在 2020
            年的實驗中，為了節省算力，使用了一個統一固定為 10 萬步（100k
            steps）的學習率退火排程，並在不同步數提前截取中間檢查點來評估模型。
          </p>

          <p>
            這種偷工減料的做法帶來了毀滅性的系統偏差：對於一個只訓練了 2
            萬步的小規模資料實驗，其學習率根本還在高位震盪，尚未經歷關鍵的退火收斂，因此其最終損失被嚴重劣化；相反地，參數量較大的模型由於學習速度快，即使在學習率較高時也能展現相對較好的初期適應力。這個調度上的系統誤差，人為製造了「數據量增長的收益極低、唯有堆砌參數量才能穩定降損」的假象。
          </p>

          <!-- 視覺化圖表：Kaplan 學習率陷阱 vs Chinchilla 精確退火 -->
          <div
            class="my-8 rounded border border-line bg-surface p-6 sm:p-8"
            aria-label="學習率排程偏差比較圖"
          >
            <h3 class="font-display text-xl text-ink mb-2">
              學習率調度陷阱：Kaplan 原方法與 Chinchilla 修正方案
            </h3>
            <p class="text-sm text-muted mb-6">
              Kaplan 採用固定 10 萬步衰減並提前截斷，導致小步數運行尚未進入退火區；Chinchilla
              針對每個目標 token 量獨立調度，確保在預算結束點精確完成餘弦退火。
            </p>
            <div class="overflow-x-auto">
              <svg
                viewBox="0 0 760 260"
                class="w-full h-auto max-w-full font-mono text-xs"
                role="img"
                aria-label="學習率退火排程對比圖表"
              >
                <!-- 坐標軸 -->
                <line x1="60" y1="220" x2="720" y2="220" stroke="#1e2224" stroke-width="2" />
                <line x1="60" y1="20" x2="60" y2="220" stroke="#1e2224" stroke-width="2" />

                <text x="60" y="242" text-anchor="middle" fill="#5e625f">
                  0 步
                </text>
                <text x="240" y="242" text-anchor="middle" fill="#5e625f">
                  2 萬步 (截點 A)
                </text>
                <text x="480" y="242" text-anchor="middle" fill="#5e625f">
                  6 萬步 (截點 B)
                </text>
                <text x="700" y="242" text-anchor="middle" fill="#5e625f">
                  10 萬步 (總排程)
                </text>
                <text x="50" y="25" text-anchor="end" fill="#5e625f">
                  學習率 η
                </text>

                <!-- Kaplan 曲線 (虛線) -->
                <path
                  d="M 60 40 Q 300 60 700 210"
                  fill="none"
                  stroke="#5e625f"
                  stroke-width="2.5"
                  stroke-dasharray="6,4"
                />
                <circle cx="240" cy="62" r="5" fill="#5e625f" />
                <text x="250" y="55" fill="#5e625f" font-weight="bold">
                  Kaplan 提早截斷：η 仍高達 85%！
                </text>

                <!-- Chinchilla 針對 2 萬步專門設計的完整退火曲線 -->
                <path d="M 60 40 Q 120 50 240 210" fill="none" stroke="#b6412c" stroke-width="3" />
                <circle cx="240" cy="210" r="5" fill="#b6412c" />
                <text x="250" y="205" fill="#b6412c" font-weight="bold">
                  Chinchilla 專屬排程：剛好衰減至 10% 充分收斂
                </text>
              </svg>
            </div>
          </div>

          <p>
            為了獲得不可動搖的科學真理，DeepMind
            進行了深度學習歷史上最浩大的實證掃描：他們訓練了超過 400 個自回歸 Transformer
            模型，參數量橫跨 1600 萬（16M）到 100 億（10B），訓練 token 數橫跨 50 億（5B）到 5000
            億（500B）。更關鍵的是，<strong>每一個模型的學習率調度排程都經過單獨設定</strong>
            ，確保餘弦退火的最低點精確落在該模型的目標 token 步數上。
          </p>

          <p>
            在密集採集了數百組訓練軌跡後，研究團隊設計了三種互相獨立、互為印證的數學方法來推導算力最佳化前沿：
          </p>

          <div class="my-6 space-y-4">
            <div class="rounded border border-line bg-paper p-5">
              <h4 class="m-0 font-display text-lg font-bold text-ink">
                方法一：固定 token 預算下的最小損失包絡線（Minimum Loss Envelope）
              </h4>
              <p class="mt-2 mb-0 text-sm leading-relaxed text-muted">
                針對不同的固定訓練 token
                規模，訓練多個不同尺寸的模型，繪製出每組規模下的訓練損失曲線。透過提取所有曲線在不同總運算量
                <math class="font-serif"><mi>C</mi></math> 下的下包絡線（Lower
                Envelope），直接測量出對應最小損失的模型參數量。該方法推導出：
                <math class="font-serif">
                  <mi>N</mi>
                  <mo>∝</mo>
                  <msup>
                    <mi>C</mi>
                    <mn>0.50</mn>
                  </msup>
                </math>，<math class="font-serif">
                  <mi>D</mi>
                  <mo>∝</mo>
                  <msup>
                    <mi>C</mi>
                    <mn>0.50</mn>
                  </msup>
                </math>。
              </p>
            </div>

            <div class="rounded border border-line bg-paper p-5">
              <h4 class="m-0 font-display text-lg font-bold text-ink">
                方法二：等算力剖面拋物線擬合（IsoFLOP Profiles）
              </h4>
              <p class="mt-2 mb-0 text-sm leading-relaxed text-muted">
                將總計算量 <math class="font-serif"><mi>C</mi></math> 嚴格固定在離散級數（例如
                <math class="font-serif">
                  <msup>
                    <mn>10</mn>
                    <mn>19</mn>
                  </msup>
                </math>、<math class="font-serif">
                  <msup>
                    <mn>10</mn>
                    <mn>20</mn>
                  </msup>
                </math>、<math class="font-serif">
                  <msup>
                    <mn>10</mn>
                    <mn>21</mn>
                  </msup>
                </math> FLOPs），在每個給定預算下變化參數量
                <math class="font-serif"><mi>N</mi></math> 與 token 數
                <math class="font-serif"><mi>D</mi></math>。將測試損失對參數量作圖，呈現出平滑的 U
                型拋物線。透過拋物線極小值頂點提取最佳配置點
                <math class="font-serif">
                  <mo>(</mo>
                  <msup>
                    <mi>N</mi>
                    <mo>*</mo>
                  </msup>
                  <mo>,</mo>
                  <msup>
                    <mi>D</mi>
                    <mo>*</mo>
                  </msup>
                  <mo>)</mo>
                </math>
                。實證擬合結果為：
                <math class="font-serif">
                  <mi>N</mi>
                  <mo>∝</mo>
                  <msup>
                    <mi>C</mi>
                    <mn>0.49</mn>
                  </msup>
                </math>，<math class="font-serif">
                  <mi>D</mi>
                  <mo>∝</mo>
                  <msup>
                    <mi>C</mi>
                    <mn>0.51</mn>
                  </msup>
                </math>。
              </p>
            </div>

            <div class="rounded border border-line bg-paper p-5">
              <h4 class="m-0 font-display text-lg font-bold text-ink">
                方法三：參數化損失函數擬合（Parametric Loss Model Fitting）
              </h4>
              <p class="mt-2 mb-0 text-sm leading-relaxed text-muted">
                將自然語言的交叉熵損失直接建模為參數量
                <math class="font-serif"><mi>N</mi></math>
                與數據量
                <math class="font-serif"><mi>D</mi></math>
                的聯合雙變數函數，使用 L-BFGS 演算法在全部實驗資料上進行 Huber 損失最小化擬合。
              </p>
            </div>
          </div>

          <p>
            特別是方法三，為大語言模型的擴展行為提供了極其優美的解析數學形式。論文提出如下的聯合損失函數模型：
          </p>

          <math
            display="block"
            class="editorial-math my-6"
            aria-label="Chinchilla 參數化損失函數方程式：L(N, D) = E + A 除以 N 的 alpha 次方 + B 除以 D 的 beta 次方"
          >
            <mrow>
              <mover>
                <mi>L</mi>
                <mo>^</mo>
              </mover>
              <mo>(</mo>
              <mi>N</mi>
              <mo>,</mo>
              <mi>D</mi>
              <mo>)</mo>
              <mo>=</mo>
              <mi>E</mi>
              <mo>+</mo>
              <mfrac>
                <mi>A</mi>
                <msup>
                  <mi>N</mi>
                  <mi>α</mi>
                </msup>
              </mfrac>
              <mo>+</mo>
              <mfrac>
                <mi>B</mi>
                <msup>
                  <mi>D</mi>
                  <mi>β</mi>
                </msup>
              </mfrac>
            </mrow>
          </math>

          <div class="my-6 rounded border border-line bg-surface p-5">
            <h4 class="m-0 font-display text-base font-bold text-ink">
              公式變數與實證擬合參數詳解
            </h4>
            <ul class="mt-3 mb-0 space-y-2 text-sm leading-relaxed text-muted">
              <li>
                <strong class="text-ink">
                  <math class="font-serif"><mi>E</mi><mo>≈</mo><mn>1.69</mn></math> nats/token
                </strong>
                ：不可約減熵（Irreducible Entropy），代表自然語言文本本身的理論資訊極限（Shannon
                熵下界）。
              </li>
              <li>
                <strong class="text-ink">
                  <math class="font-serif"><mi>A</mi><mo>≈</mo><mn>406.4</mn></math>、
                  <math class="font-serif"><mi>α</mi><mo>≈</mo><mn>0.34</mn></math>
                </strong>
                ：參數量懲罰項。當模型參數量
                <math class="font-serif"><mi>N</mi></math>
                有限時，容量瓶頸帶來的額外損失。
              </li>
              <li>
                <strong class="text-ink">
                  <math class="font-serif"><mi>B</mi><mo>≈</mo><mn>410.7</mn></math>、
                  <math class="font-serif"><mi>β</mi><mo>≈</mo><mn>0.28</mn></math>
                </strong>
                ：數據量懲罰項。當訓練 token 數<math class="font-serif"><mi>D</mi></math>
                有限時，採樣不足帶來的額外損失。
              </li>
            </ul>
          </div>

          <p>
            根據自回歸 Transformer 的前向與反向傳播計算量定理，在無額外重計算（Activation
            Checkpointing）下，每處理一個 token，模型前向傳播需要約
            <math class="font-serif"><mn>2</mn><mi>N</mi></math>
            次浮點運算，反向傳播計算梯度需要約
            <math class="font-serif"><mn>4</mn><mi>N</mi></math>
            次浮點運算，因此總計算預算約束方程為：
          </p>

          <math
            display="block"
            class="editorial-math my-6"
            aria-label="Transformer 訓練計算量約束方程：C 約等於 6 倍的 N 乘 D"
          >
            <mrow>
              <mi>C</mi>
              <mo>≈</mo>
              <mn>6</mn>
              <mi>N</mi>
              <mi>D</mi>
            </mrow>
          </math>

          <p>
            在固定算力預算
            <math class="font-serif"><mi>C</mi></math>
            的約束下（即令
            <math class="font-serif"><mi>D</mi><mo>=</mo><mfrac><mi>C</mi><mrow><mn>6</mn><mi>N</mi></mrow></mfrac></math>
            ），對目標損失函數
            <math class="font-serif"><mover><mi>L</mi><mo>^</mo></mover><mo>(</mo><mi>N</mi><mo>,</mo><mi>D</mi><mo>)</mo></math>
            關於參數量
            <math class="font-serif"><mi>N</mi></math>
            求一階導數並令其為零（
            <math class="font-serif"><mfrac><mrow><mo>∂</mo><mover><mi>L</mi><mo>^</mo></mover></mrow><mrow><mo>∂</mo><mi>N</mi></mrow></mfrac><mo>=</mo><mn>0</mn></math>
            ），即可推導出解析極值解：
          </p>

          <math
            display="block"
            class="editorial-math my-6"
            aria-label="算力最佳化分配指數推導：N 比例於 C 的 a 次方，D 比例於 C 的 b 次方"
          >
            <mrow>
              <msup>
                <mi>N</mi>
                <mo>*</mo>
              </msup>
              <mo>(</mo>
              <mi>C</mi>
              <mo>)</mo>
              <mo>∝</mo>
              <msup>
                <mi>C</mi>
                <mi>a</mi>
              </msup>
              <mo>,</mo>
              <mspace width="1em" />
              <msup>
                <mi>D</mi>
                <mo>*</mo>
              </msup>
              <mo>(</mo>
              <mi>C</mi>
              <mo>)</mo>
              <mo>∝</mo>
              <msup>
                <mi>C</mi>
                <mi>b</mi>
              </msup>
              <mspace width="1em" />
              <mtext>其中</mtext>
              <mspace width="0.5em" />
              <mi>a</mi>
              <mo>=</mo>
              <mfrac>
                <mi>β</mi>
                <mrow>
                  <mi>α</mi>
                  <mo>+</mo>
                  <mi>β</mi>
                </mrow>
              </mfrac>
              <mo>,</mo>
              <mspace width="0.5em" />
              <mi>b</mi>
              <mo>=</mo>
              <mfrac>
                <mi>α</mi>
                <mrow>
                  <mi>α</mi>
                  <mo>+</mo>
                  <mi>β</mi>
                </mrow>
              </mfrac>
            </mrow>
          </math>

          <p>
            將實證擬合出的數值
            <math class="font-serif"><mi>α</mi><mo>≈</mo><mn>0.34</mn></math>與
            <math class="font-serif"><mi>β</mi><mo>≈</mo><mn>0.28</mn></math>
            代入公式：
          </p>

          <math
            display="block"
            class="editorial-math my-6"
            aria-label="代入數值計算最佳化指數：a 約等於 0.45，b 約等於 0.55"
          >
            <mrow>
              <mi>a</mi>
              <mo>=</mo>
              <mfrac>
                <mn>0.28</mn>
                <mrow>
                  <mn>0.34</mn>
                  <mo>+</mo>
                  <mn>0.28</mn>
                </mrow>
              </mfrac>
              <mo>≈</mo>
              <mn>0.45</mn>
              <mo>,</mo>
              <mspace width="1.5em" />
              <mi>b</mi>
              <mo>=</mo>
              <mfrac>
                <mn>0.34</mn>
                <mrow>
                  <mn>0.34</mn>
                  <mo>+</mo>
                  <mn>0.28</mn>
                </mrow>
              </mfrac>
              <mo>≈</mo>
              <mn>0.55</mn>
            </mrow>
          </math>

          <p>
            三種方法匯聚出同一個不容置疑的結論：
            <strong>參數量與訓練資料量的擴展指數極度接近，均約為 0.50（1:1 的等比例分配）</strong>
            。這徹底推翻了 Kaplan 2020 年聲稱的 0.73 : 0.27 偏態分佈！
          </p>

          <Callout variant="editorial">
            <strong class="text-ink">
              Chinchilla 計算最佳化黃金法則（Compute-Optimal Rule）：
            </strong>
            在給定的訓練算力預算下，
            <strong>模型參數量與訓練 token 數應當以 1:1 的等比例同步增長</strong>。算力預算每提升 10
            倍，模型參數量與訓練資料量應各自擴展約 3.16 倍（
            <math class="font-serif"><msqrt><mn>10</mn></msqrt></math>
            ），維持平均<strong>每 1 個模型參數搭配約 20 個訓練 token</strong> 的黃金比例（
            <math class="font-serif"><mi>D</mi><mo>/</mo><mi>N</mi><mo>≈</mo><mn>20</mn></math>
            ）。
          </Callout>
        </div>

