              ></line>
              <text
                x="465"
                y="174"
                text-anchor="end"
                font-family="monospace"
                font-size="10"
                fill="#b6412c"
              >
                Shannon 極限 L_∞
              </text>
              <!-- Curve path -->
              <path id="scaling-curve-path" fill="none" stroke="#1e2224" stroke-width="2.5"></path>
              <!-- Active point -->
              <circle
                id="scaling-curve-point"
                cx="330"
                cy="110"
