---
import BaseLayout from '../../layouts/BaseLayout.astro';
import { withBase } from '../../lib/paths';
import StoryRail from '../../components/StoryRail.astro';
import PaperReadingLayout from '../../components/PaperReadingLayout.astro';
import AsideCard from '../../components/AsideCard.astro';
import Callout from '../../components/Callout.astro';
import AuthorGrid from '../../components/AuthorGrid.astro';
import EvidenceList from '../../components/EvidenceList.astro';
import PaperMeta from '../../components/PaperMeta.astro';
import PaperNavigation from '../../components/PaperNavigation.astro';
import {
  scalingLawsPaper,
  scalingLawsSources,
} from '../../content/papers/scaling-laws-for-neural-language-models';

const paper = scalingLawsPaper;
const shell = 'mx-auto w-[calc(100%-2rem)] max-w-[1120px]';

const story = [
  {
    year: '2019.02',
    label: '前史 / GPT-2 啟發',
    title: '模型規模擴增帶來非線性能力躍升，但缺乏量化規律',
    body: 'GPT-2 展現了參數量推至 15 億時的零樣本突破，但深度學習業界仍將性能提升視為隨機運氣的煉金術。',
    status: 'past' as const,
  },
  {
    year: '2020.01',
    label: '論文 / SCALING LAWS',
    title: '確立參數量、數據量與算力的跨尺度物理冪律',
    body: 'Jared Kaplan 等人以統計物理方法證實：損失遵循精確冪律，性能取決於物理規模而非網路幾何形狀。',
    status: 'current' as const,
  },
  {
    year: '2020.05',
    label: '後續 / GPT-3 驗證',
    title: '以風洞預測信心豪擲千萬美元，敲開千億參數時代',
    body: 'OpenAI 依循縮放定律精準外推，打造 1750 億參數的 GPT-3，印證了損失下降帶來的能力湧現。',
    status: 'future' as const,
  },
];

interface TimelineEpoch {
  id: string;
  year: string;
  period: string;
  title: string;
  summary: string;
  sources: Array<{
    source: (typeof scalingLawsSources)[number];
    num: number;
    refCode: string;
    featured?: boolean;
    role: string;
    takeaway: string;
  }>;
}

const timelineEpochs: TimelineEpoch[] = [
  {
    id: 'epoch-2019-alchemy',
    year: '2019.02',
    period: '深度學習的試誤與煉金術時代',
    title: '規模擴展初露鋒芒，但面臨天文數字級投資風險',
    summary:
      'GPT-2 證實了擴大模型帶來的多任務能力，但缺乏嚴謹理論支持。各大實驗室因擔憂過度擬合與效益遞減，對百億以上參數望而卻步。',
    sources: [
      {
        source: scalingLawsSources.find((s) => s.id === 'paper-2019-gpt2')!,
        num: 1,
        refCode: 'S01',
        featured: true,
        role: '實證前驅',
        takeaway: '展示了從 1.17 億到 15 億參數的連續改進，成為研究團隊探索物理規律的直接誘因。',
      },
      {
        source: scalingLawsSources.find((s) => s.id === 'paper-1948-shannon')!,
        num: 2,
        refCode: 'S02',
        role: '理論底層',
        takeaway: '奠定自然語言不可約減熵（L_∞）的極限邊界，證明語言模型損失無法無限降至零。',
      },
    ],
  },
  {
    id: 'epoch-2020-scaling',
    year: '2020.01',
    period: '神經語言模型物理定律的確立',
    title: 'Kaplan 等人發表縮放定律，以冪律統治深度學習',
    summary:
      '跨越 6 個數量級全面測量，證實損失 L 與 N、D、C 呈平滑冪律下降，確立模型形狀無關性與最佳算力分配處方。',
    sources: [
      {
        source: scalingLawsSources.find((s) => s.id === 'paper-2020-scaling-laws')!,
        num: 3,
        refCode: 'S03',
        featured: true,
        role: '本篇核心',
        takeaway:
          '為大規模模型訓練提供了航空風洞般的精確外推指南，將 AI 研發轉化為可預測的工程科學。',
      },
    ],
  },
  {
    id: 'epoch-2020-gpt3-chinchilla',
    year: '2020–2022',
    period: '千億參數爆發與計算最佳化修正',
    title: 'GPT-3 驗證風洞外推，DeepMind Chinchilla 修正數據分配',
    summary:
      'OpenAI 依循定律成功研製 175B GPT-3；兩年後 DeepMind 指出學習率排程盲點，將算力分配修正為 1:1 對稱等比擴展。',
    sources: [
      {
        source: scalingLawsSources.find((s) => s.id === 'paper-2020-gpt3')!,
        num: 4,
        refCode: 'S04',
        featured: true,
        role: '工程落地',
        takeaway: 'GPT-3 實際測試損失精準落在 Kaplan 定律預測線上，驗證了物理外推的驚人威力。',
      },
      {
        source: scalingLawsSources.find((s) => s.id === 'paper-2022-chinchilla')!,
        num: 5,
        refCode: 'S05',
        role: '後續修正',
        takeaway:
          '修正了 Kaplan 原論文對數據量的低估，確立現代開源模型（如 LLaMA）必備的 Chinchilla 算力最佳化法則。',
      },
    ],
  },
];
---

<BaseLayout
  title={`${paper.title} — ${paper.chineseTitle} | THE LLM`}
  section="paper"
  description="解讀 2020 年 OpenAI 經典論文《Scaling Laws for Neural Language Models》：Jared Kaplan 等人如何揭示參數量、數據量與算力支配大模型性能的精確物理冪律，確立模型形狀無關性與風洞外推方法論。"
>
  <article>
    <!-- 1. Hero Header Visual Anatomy (Universal Invariant) -->
    <header class={`${shell} pt-10`}>
      <div class="flex gap-3 font-mono text-sm uppercase tracking-[0.08em] text-muted">
        <a class="text-red underline underline-offset-4" href={withBase('/')}>
          THE LLM
        </a>
        <span aria-hidden="true">/</span>
        <span>第 05 章</span>
      </div>

      <div class="grid grid-cols-1 items-end gap-12 py-16 lg:grid-cols-[1.15fr_0.85fr] lg:gap-24">
        <div>
          <p class="mb-5 font-mono text-sm font-semibold uppercase tracking-[0.12em] text-red">
            VOL. 05 / THE SCALING LAWS
          </p>

          <h1 class="m-0 font-display text-4xl sm:text-5xl lg:text-6xl xl:text-7xl leading-tight tracking-[-0.04em] text-ink">
            <span class="block">Scaling Laws</span>
            <em class="block">for Neural Language Models.</em>
          </h1>

          <p class="mt-8 max-w-[52ch] text-lg leading-8 text-muted">
            在 2020 年以前，訓練大型神經網路宛如走鋼索的煉金術：耗資數百萬美元、調度上千顆 GPU
            訓練一個模型，誰也無法保證它最終會收斂出驚艷智慧，還是陷入過度擬合與效益遞減的深淵。Jared
            Kaplan 等理論物理學家跨越 6
            個數量級展開密集測量，首度證實語言模型性能受控於嚴格的物理冪律——自此，大模型研發徹底告別盲目試誤，擁有了可精確計算與外推的科學導航圖。
          </p>
        </div>

        <aside
          class="border-t-4 border-red bg-surface p-6 shadow-editorial"
          aria-label="這篇論文的一句評語"
        >
          <p class="mb-4 sm:mb-6 font-mono text-xs sm:text-sm font-semibold uppercase tracking-[0.12em] text-red">
            一句評語 / THE SHORT VERDICT
          </p>
          <p class="m-0 max-w-[20ch] sm:max-w-[22ch] font-display text-2xl sm:text-3xl leading-tight text-ink">
            深度學習不再是撞大運的煉金術，而是能精確外推的統計物理學。
          </p>
          <p class="mt-6 mb-0 text-sm sm:text-base leading-relaxed sm:leading-7 text-muted">
            Kaplan
            等人證明：交叉熵損失與參數量、數據量及算力呈現跨越數個數量級的筆直直線；決定模型上限的是規模本身，而非網路精巧的幾何形狀。
          </p>
        </aside>
      </div>

      <PaperMeta
        year={paper.year}
        venue={paper.venue}
        readTime="28 分鐘"
        difficulty="進階核心"
        doi={paper.doi}
      />
    </header>

    <!-- 2. 歷史進程 StoryRail -->
    <section class="border-y border-line bg-surface/50 py-12" aria-label="歷史轉折總覽">
      <div class={shell}>
        <div class="mb-6">
          <p class="font-mono text-xs font-bold text-red uppercase tracking-wider mb-1">
            歷史轉折 / 2020
          </p>
          <h2 class="m-0 font-display text-2xl sm:text-3xl text-ink">
            從盲目試誤的煉金術，到精確外推的物理新紀元
          </h2>
        </div>
        <StoryRail events={story} />
      </div>
    </section>

    <!-- MOVEMENT 1: 豪賭千萬美元的困境 (THE GAMBLING CRISIS) -->
    <section
      id="gambling-crisis"
      class={`${shell} border-t border-ink py-16 sm:py-20 lg:py-24 scroll-mt-24`}
      aria-labelledby="gambling-crisis-title"
    >
      <div class="mb-12 flex flex-col gap-6 lg:flex-row lg:items-end lg:justify-between">
        <div>
          <p class="mb-4 font-mono text-sm font-semibold uppercase tracking-[0.12em] text-red">
            章節 01 · 豪賭千萬美元的困境 / THE IMPASSE
          </p>
          <h2
            id="gambling-crisis-title"
            class="m-0 font-display text-3xl sm:text-4xl lg:text-5xl leading-tight tracking-tight text-ink"
          >
            <span class="block">投入千萬美元的豪賭困境：</span>
            <span class="block">
              <em>深度學習從盲目試誤到尋找物理地圖</em>
            </span>
          </h2>
        </div>
        <p class="m-0 max-w-[34ch] text-base leading-8 text-muted">
          當每一次擴展都意味著數百萬美元的算力投入與長達數月的訓練風險，深度學習迫切需要一套如同天體物理與熱力學般的確定性規律。
        </p>
      </div>

      <PaperReadingLayout class="text-base leading-8 text-ink">
        <div class="space-y-6">
          <p>
            在傳統軟體工程中，工程師修改一行程式碼，點擊編譯，數秒內就能得到測試回饋；即便系統崩潰，代價也不過是幾次除錯中斷。然而，在
            2019 年底的深度學習領域，工程師面臨的是完全不同的殘酷物理法則：OpenAI 剛以 15 億參數的{' '}
            <a
              href={withBase('/papers/language-models-are-unsupervised-multitask-learners')}
              class="text-primary hover:underline font-medium"
            >
              GPT-2
            </a>{' '}
            震驚了學界，但如果想要更進一步，將模型擴展到 100 億、甚至 1000
            億參數，需要投入多少運算資源？需要收集多少網頁文本？沒有人知道答案。
          </p>

          <p>
            當時業界普遍籠罩在三大直覺恐懼之中：其一是「過度擬合深淵」——經典統計學習理論警告，模型參數若遠遠超過訓練樣本數，網路將迅速記住噪聲而喪失泛化能力；其二是「效益遞減天花板」——神經網路的性能提升是否會像傳統機器學習模型一樣，在參數量達到某個閥值後迅速飽和、陷入平頂；其三是「算力黑洞」——在數千顆
            GPU
            叢集上連續運算數個月，耗資數百萬美元電費與硬體折舊，如果最終損失函數紋風不動甚至中途發散，任何研究機構都難以承受這樣的戰略災難。
          </p>

          <p>
            打破僵局的並不是傳統電腦科學家，而是一群帶著理論物理學背景的研究者。Jared Kaplan
            原為約翰霍普金斯大學的量子場論與理論物理學者，與 Sam McCandlish、Dario Amodei
            等人一道加入 OpenAI。他們審視神經網路的視角徹底顛覆了傳統思維：他們不把 Transformer
            當作複雜的軟體程式碼，而是將其視為一個巨大的「統計力學物理系統」。如同氣體分子的巨觀壓力與溫度遵循理想氣體方程式，包含千億連接的神經網路在巨觀尺度下，必然也存在著某種跨越尺度的普遍數學約束。
          </p>
        </div>

        <aside slot="rail" class="space-y-6">
          <AsideCard
            kicker="直覺崩潰 / INTUITION BREAKDOWN"
            title="工程常識的崩潰：為什麼傳統機器學習的直覺全部失效？"
            variant="surface"
          >
            <p class="text-sm sm:text-base leading-relaxed text-muted m-0">
              在傳統統計學中，VC 維度理論與偏差-方差權衡（Bias-Variance
              Tradeoff）告訴我們模型參數量必須嚴格受限於樣本容量。但在自回歸 Transformer
              的世界裡，研究人員驚訝地發現模型哪怕參數量擴大十倍，只要訓練資料同步微調，測試集上的交叉熵損失（Cross-Entropy
              Loss）居然平滑下降。這種違背古典統計直覺的現象，讓當時的 AI
              研發宛如缺乏航海圖的冒險：所有人都在賭，但誰也說不清勝率幾何。
            </p>
          </AsideCard>
        </aside>
      </PaperReadingLayout>
    </section>

    <!-- MOVEMENT 2: 統治神經網路的物理定律 (THE PHYSICAL POWER LAWS) -->
    <section
      id="power-laws"
      class={`${shell} border-t border-ink py-16 sm:py-20 lg:py-24 scroll-mt-24`}
      aria-labelledby="power-laws-title"
    >
      <div class="mb-12 flex flex-col gap-6 lg:flex-row lg:items-end lg:justify-between">
        <div>
          <p class="mb-4 font-mono text-sm font-semibold uppercase tracking-[0.12em] text-red">
            章節 02 · 統治神經網路的物理定律 / POWER LAWS
          </p>
          <h2
            id="power-laws-title"
            class="m-0 font-display text-3xl sm:text-4xl lg:text-5xl leading-tight tracking-tight text-ink"
          >
            <span class="block">統治神經網路的三大軸線：</span>
            <span class="block">
              <em>參數量、數據量與算力的冪律方程式</em>
            </span>
          </h2>
        </div>
        <p class="m-0 max-w-[34ch] text-base leading-8 text-muted">
          物理學家測量自然常數的嚴謹方法，揭示損失函數不依賴架構微操，而是受控於純粹的物理規模。
        </p>
      </div>

      <PaperReadingLayout class="text-base leading-8 text-ink">
        <div class="space-y-6">
          <p>
            為了測量神經語言模型的宏觀物理規律，Kaplan
            等人展開了一場極其奢華且系統化的實證測量：他們訓練了數百個不同規模的自回歸 Transformer
            模型，參數量橫跨從 700（700 個參數的小玩具）到 16 億（1.6B
            參數的當時頂尖規模），訓練文本橫跨數千萬到數十億 token，浮點計算量跨越 6
            個數量級。當他們將所有實驗資料繪製在「雙對數座標系（Log-Log
            Plot）」時，令人屏息的物理規律浮現了——所有數據點匯聚成一條條近乎完美的筆直直線。
          </p>

          <p>
            在數學上，雙對數座標系下的直線對應著純粹的「冪律分佈（Power
            Law）」。論文指出，決定語言模型測試損失（Test Loss）
            <math class="font-serif"><mi>L</mi></math>
            的，是三個互相關聯但各自獨立起作用的物理維度：非詞表參數量{' '}
            <math class="font-serif"><mi>N</mi></math>、資料集大小
            <math class="font-serif"><mi>D</mi></math> 以及總計算量{' '}
            <math class="font-serif"><mi>C</mi></math>。
          </p>

          <!-- 冪律核心公式 MathML Block -->
          <div class="my-8 rounded border border-line bg-surface p-6 shadow-sm">
            <p class="font-mono text-xs font-semibold uppercase tracking-[0.12em] text-red mb-4">
              公式 01 / 神經語言模型三大單維度冪律方程
            </p>

            <math
              display="block"
              class="editorial-math my-6"
              aria-label="神經語言模型在參數量、數據量與算力下的三大單維度冪律方程式"
            >
              <mrow>
                <mi>L</mi>
                <mo stretchy="false">(</mo>
                <mi>N</mi>
                <mo stretchy="false">)</mo>
                <mo>≈</mo>
                <msup>
                  <mrow>
                    <mo>(</mo>
                    <mfrac>
                      <msub><mi>N</mi><mi>c</mi></msub>
                      <mi>N</mi>
                    </mfrac>
                    <mo>)</mo>
                  </mrow>
                  <msub><mi>α</mi><mi>N</mi></msub>
                </msup>
                <mo>,</mo>
                <mspace width="2em" />
                <mi>L</mi>
                <mo stretchy="false">(</mo>
                <mi>D</mi>
                <mo stretchy="false">)</mo>
                <mo>≈</mo>
                <msup>
                  <mrow>
                    <mo>(</mo>
                    <mfrac>
                      <msub><mi>D</mi><mi>c</mi></msub>
                      <mi>D</mi>
                    </mfrac>
                    <mo>)</mo>
                  </mrow>
                  <msub><mi>α</mi><mi>D</mi></msub>
                </msup>
                <mo>,</mo>
                <mspace width="2em" />
                <mi>L</mi>
                <mo stretchy="false">(</mo>
                <mi>C</mi>
                <mo stretchy="false">)</mo>
                <mo>≈</mo>
                <msup>
                  <mrow>
                    <mo>(</mo>
                    <mfrac>
                      <msub><mi>C</mi><mi>c</mi></msub>
                      <mi>C</mi>
                    </mfrac>
                    <mo>)</mo>
                  </mrow>
                  <msub><mi>α</mi><mi>C</mi></msub>
                </msup>
              </mrow>
            </math>

            <div class="mt-6 grid grid-cols-1 gap-4 border-t border-line/60 pt-4 text-xs sm:grid-cols-3">
              <div>
                <span class="font-serif font-semibold text-ink">
                  參數量冪律軸線（不受數據限制）：
                </span>
                <p class="text-muted mt-1 m-0">
                  <math class="font-serif"><msub><mi>α</mi><mi>N</mi></msub><mo>≈</mo><mn>0.076</mn></math>
                  ，特徵尺度
                  <math class="font-serif"><msub><mi>N</mi><mi>c</mi></msub><mo>≈</mo><mn>8.8</mn><mo>×</mo><msup><mn>10</mn><mn>13</mn></msup></math>
                  。參數量每擴大 10 倍，損失穩定降低約 0.16 nats。
                </p>
              </div>
              <div>
                <span class="font-serif font-semibold text-ink">
                  數據量冪律軸線（不受容量限制）：
                </span>
                <p class="text-muted mt-1 m-0">
                  <math class="font-serif"><msub><mi>α</mi><mi>D</mi></msub><mo>≈</mo><mn>0.095</mn></math>
                  ，特徵尺度
                  <math class="font-serif"><msub><mi>D</mi><mi>c</mi></msub><mo>≈</mo><mn>5.4</mn><mo>×</mo><msup><mn>10</mn><mn>13</mn></msup></math>
                  。訓練 token 每擴大 10 倍，損失穩定降低約 0.20 nats。
                </p>
              </div>
              <div>
                <span class="font-serif font-semibold text-ink">計算量冪律軸線（最佳配置）：</span>
                <p class="text-muted mt-1 m-0">
                  <math class="font-serif"><msub><mi>α</mi><mi>C</mi></msub><mo>≈</mo><mn>0.050</mn></math>
                  ，特徵尺度
