            </svg>

            <!-- Compute Metric Bar -->
            <div class="grid grid-cols-2 sm:grid-cols-3 gap-3 font-mono text-xs border border-line bg-paper p-3">
              <div>
                <span class="text-muted block text-xs">總浮點運算量 C (6ND)：</span>
