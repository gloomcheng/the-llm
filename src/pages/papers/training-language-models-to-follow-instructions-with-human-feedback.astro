---
import BaseLayout from '../../layouts/BaseLayout.astro';
import { withBase } from '../../lib/paths';
import StoryRail from '../../components/StoryRail.astro';
import PaperReadingLayout from '../../components/PaperReadingLayout.astro';
import AsideCard from '../../components/AsideCard.astro';
import Callout from '../../components/Callout.astro';
import AuthorGrid from '../../components/AuthorGrid.astro';
import EvidenceList from '../../components/EvidenceList.astro';
import PaperMeta from '../../components/PaperMeta.astro';
import PaperNavigation from '../../components/PaperNavigation.astro';
import {
  paper,
  instructgptSources,
} from '../../content/papers/training-language-models-to-follow-instructions-with-human-feedback';

const shell = 'mx-auto w-[calc(100%-2rem)] max-w-[1120px]';

const story = [
  {
    year: '2017.06',
    label: '理論 / PREFERENCE RL',
    title: 'Christiano 等人發表深度人類偏好強化學習',
    body: 'OpenAI 與 DeepMind 合作，首次證明從人類成對比較（Pairwise Comparison）中訓練獎勵模型，能有效引導複雜代理人行為。',
    status: 'past' as const,
  },
  {
    year: '2017.07',
    label: '演算法 / PPO',
    title: 'John Schulman 提出近端策略最佳化（PPO）',
    body: '以機率比剪裁（Clipped Surrogate Objective）解決傳統策略梯度震盪與崩潰，成為穩定性極高的強化學習通用骨幹。',
    status: 'past' as const,
  },
  {
    year: '2020.05',
    label: '基座 / GPT-3',
    title: '1750 億參數基座問世：博學但充滿謊言與失準',
    body: 'GPT-3 展現驚人少樣本學習能力，但本質上僅在模仿網路文本分佈，面對人類明確指令經常答非所問或胡言亂語。',
    status: 'past' as const,
  },
  {
    year: '2022.03',
    label: '論文 / INSTRUCTGPT',
    title: 'OpenAI 發表 InstructGPT：三步 RLHF 確立對齊典範',
    body: 'Long Ouyang 等人結合 SFT、獎勵建模與 PPO，僅 1.3B 模型在滿意度上擊敗 175B 基座，奠定現代 AI 產品對齊標準。',
    status: 'current' as const,
  },
  {
    year: '2022.11',
    label: '爆發 / CHATGPT',
    title: 'ChatGPT 正式發布，引爆全球生成式 AI 革命',
    body: '將 InstructGPT 的指令對齊技術延伸至多輪對話，證明人類反饋強化學習是跨越學術展示走向消費級產品的關鍵橋樑。',
    status: 'future' as const,
  },
];

interface TimelineEpoch {
  id: string;
  year: string;
  period: string;
  title: string;
  summary: string;
  sources: Array<{
    source: (typeof instructgptSources)[number];
    num: number;
    refCode: string;
    featured?: boolean;
    role: string;
    takeaway: string;
  }>;
}

const timelineEpochs: TimelineEpoch[] = [
  {
    id: 'epoch-2017-foundations',
    year: '2017',
    period: '偏好建模與穩定強化學習的理論破土',
    title: '成對比較學習與 PPO 剪裁梯度的誕生',
    summary:
      '早在現代大模型爆發之前，Paul Christiano 與 John Schulman 等人便已為非數值化獎勵的學習任務奠定了數學基石：用 Bradley-Terry 模型刻畫人類偏好，並用 PPO 演算法鎖住策略更新步幅。',
    sources: [
      {
        source: instructgptSources.find((s) => s.id === 'paper-2017-deep-rl-human-preferences')!,
        num: 1,
        refCode: 'S01',
        featured: true,
        role: '偏好理論',
        takeaway:
          '確立透過人類二元比較（A 優於 B）學習隱含獎勵函數的可行性，擺脫了必須人工設計複雜數值獎勵的歷史死結。',
      },
      {
        source: instructgptSources.find((s) => s.id === 'paper-2017-ppo')!,
        num: 2,
        refCode: 'S02',
        featured: true,
        role: '最佳化核心',
        takeaway:
          '提出剪裁代理目標函數，限制新舊策略分佈偏離程度，為日後千億參數神經網路的大規模強化學習提供不可或缺的穩定性。',
      },
    ],
  },
  {
    id: 'epoch-2020-misalignment',
    year: '2020',
    period: '預訓練巨獸的目標失準危機',
    title: 'GPT-3 的少樣本奇蹟，與難以駕馭的「對齊稅」',
    summary:
      'GPT-3 證明了大規模自回歸預訓練的強大，但它的目標函數只是「預測網路上的下一個字」。它學會了無數偏見、陰謀論與虛構捏造，使用者即使百般下指令，它依然任性地接話或編造論文引用。',
    sources: [
      {
        source: instructgptSources.find((s) => s.id === 'paper-2020-gpt3')!,
        num: 3,
        refCode: 'S03',
        role: '基座原型',
        takeaway:
          '1750 億參數的自回歸語言模型，知識無比廣博但缺乏動機對齊，直接催生了 OpenAI 內部專注於 AI 安全與對齊的專案小組。',
      },
      {
        source: instructgptSources.find((s) => s.id === 'paper-2020-summarization-human-feedback')!,
        num: 4,
        refCode: 'S04',
        featured: true,
        role: 'NLP 試點',
        takeaway:
          '在文字摘要任務上成功貫通了「標註者排序 → 獎勵模型 → PPO」流程，證明人類反饋比交叉熵損失更契合主觀品質標準。',
      },
    ],
  },
  {
    id: 'epoch-2022-instructgpt',
    year: '2022.03',
    period: '產品級對齊的歷史分水嶺',
    title: 'InstructGPT 發表：讓機器學會傾聽與服從',
    summary:
      'Long Ouyang 等人將 RLHF 完整落地於 OpenAI API 真實使用者提示詞分佈上。透過 SFT、RM 與帶有 KL 散度約束的 PPO，徹底解決了基座模型答非所問的頑疾，確立了現代 AI 產品的實用標準。',
    sources: [
      {
        source: instructgptSources.find((s) => s.id === 'paper-2022-instructgpt')!,
        num: 5,
        refCode: 'S05',
        featured: true,
        role: '本篇核心',
        takeaway:
          '1.3B 參數對齊模型全面擊敗 175B 未對齊基座，提出 3H 評估準則與 KL 散度韁繩機制，為 ChatGPT 奠定技術核心。',
      },
    ],
  },
];
---

<BaseLayout title={`${paper.chineseTitle} | THE LLM`} description={paper.abstractSummary}>
  <header class={`${shell} pt-10`}>
    <div class="flex gap-3 font-mono text-sm uppercase tracking-[0.08em] text-muted">
      <a class="text-red underline underline-offset-4" href={withBase('/')}>
        THE LLM
      </a>
      <span aria-hidden="true">/</span>
      <span>第 08 章</span>
    </div>

    <div class="grid grid-cols-1 items-end gap-12 py-16 lg:grid-cols-[1.15fr_0.85fr] lg:gap-24">
      <div>
        <p class="mb-5 font-mono text-sm font-semibold uppercase tracking-[0.12em] text-red">
          VOL. 08 / ALIGNMENT & RLHF
        </p>

        <h1 class="m-0 font-display text-4xl sm:text-5xl lg:text-6xl xl:text-7xl leading-tight tracking-[-0.04em] text-ink">
          <span class="block">Training language models</span>
          <em class="block">to follow instructions with human feedback</em>
        </h1>

        <p class="mt-8 max-w-[52ch] text-lg leading-8 text-muted">
          當 1750 億參數的 GPT-3 依然像個滿嘴胡言的網路醉漢，OpenAI
          提出人類反饋強化學習（RLHF），僅用 13
          億參數模型便在實用滿意度上全面擊潰未對齊的千億巨獸，確立了 Helpful, Honest, Harmless
          的現代 AI 產品基石。
        </p>
      </div>

      <aside
        class="border-t-4 border-red bg-surface p-6 shadow-editorial"
        aria-label="這篇論文的一句評語"
      >
        <p class="mb-4 sm:mb-6 font-mono text-xs sm:text-sm font-semibold uppercase tracking-[0.12em] text-red">
          一句評語 / THE SHORT VERDICT
        </p>
        <p class="m-0 max-w-[20ch] sm:max-w-[22ch] font-display text-2xl sm:text-3xl leading-tight text-ink">
          預訓練給了模型博聞強記的大腦，而 RLHF 賦予了它聽懂人類心意的靈魂。
        </p>
        <p class="mt-6 mb-0 text-sm sm:text-base leading-relaxed sm:leading-7 text-muted">
          僅 13 億參數的 InstructGPT 獲得 85%
          人類評估偏好，徹底終結了「單純預測下一個字」的盲目擴展，點燃了八個月後 ChatGPT
          的全球風暴。
        </p>
      </aside>
    </div>

    <PaperMeta
      year={paper.year}
      venue={paper.venue}
      readTime="35 分鐘"
      difficulty="後訓練強化學習"
      doi={paper.doi}
    />
  </header>

  <main id="main-content">
    <!-- 歷史縱深導航條 (STORY RAIL) -->
    <section class="border-t border-ink py-12" aria-label="歷史縱深導向">
      <div class={shell}>
        <div class="mb-8">
          <p class="mb-2 font-mono text-xs font-bold uppercase tracking-[0.14em] text-red">
            歷史長河 / THE CHRONOLOGY
          </p>
          <h2 class="m-0 font-display text-2xl sm:text-3xl text-ink">
            從網路文字的無度模仿，到人性偏好指引的價值對齊
          </h2>
        </div>
        <StoryRail events={story} />
      </div>
    </section>

    <!-- 章節 01: 語義脫節與目標反噬 (THE MISALIGNMENT DILEMMA) -->
    <section
      id="misalignment-dilemma"
      class={`${shell} border-t border-ink py-16 sm:py-20 lg:py-24 scroll-mt-24`}
      aria-labelledby="misalignment-dilemma-title"
    >
      <div class="mb-12 flex flex-col gap-6 lg:flex-row lg:items-end lg:justify-between">
        <div>
          <p class="mb-4 font-mono text-sm font-semibold uppercase tracking-[0.12em] text-red">
            章節 01 · 語義脫節與目標反噬 / THE MISALIGNMENT DILEMMA
          </p>
          <h2
            id="misalignment-dilemma-title"
            class="m-0 font-display text-3xl sm:text-4xl lg:text-5xl leading-tight tracking-tight text-ink"
          >
            <span class="block">目標函數的背叛：</span>
            <span class="block">
              <em>當預測下一個字的博學機器，成了滿嘴謊言的網路醉漢</em>
            </span>
          </h2>
        </div>
        <p class="m-0 max-w-[34ch] text-base leading-8 text-muted">
          自回歸預訓練最大化的是網際網路文本的統計似然機率，但真實世界的使用者需要的是誠實、有用且安全的忠實助手。
        </p>
      </div>

      <PaperReadingLayout class="text-base leading-8 text-ink">
        <div class="space-y-8">
          <p>
            2020 年夏天，當 OpenAI 的工程師們將擁有 1750 億參數的
            <a
              href={withBase('/papers/language-models-are-few-shot-learners')}
              class="font-medium text-ink underline decoration-line/80 underline-offset-4 transition-colors hover:text-red hover:decoration-red"
            >
              GPT-3
            </a>
            部署至雲端 API
            時，他們迎來的並非一個優雅的智慧助手，而是一個令人啼笑皆非、甚至毛骨悚然的「統計模仿怪獸」。
          </p>

          <p>
            一位台灣大學的研究生在終端機輸入：「請用繁體中文列出三個改善睡眠品質的科學方法，並給出理由。」直覺上，任何心智健全的正常人都明白這是一道祈使句指令，期望獲得清晰條列的實用建議。然而，未經對齊的
            GPT-3 基座模型卻在螢幕上吐出了一段匪夷所思的文字：
          </p>

          <div class="border border-line bg-surface p-5 sm:p-6 my-6 font-mono text-sm leading-relaxed text-ink shadow-sm">
            <p class="text-xs font-bold uppercase tracking-wider text-muted mb-2">
              輸入提示詞（PROMPT）：
            </p>
            <p class="mb-4 text-red font-semibold">
              請用繁體中文列出三個改善睡眠品質的科學方法，並給出理由。
            </p>
            <div class="border-t border-line pt-3">
              <p class="text-xs font-bold uppercase tracking-wider text-muted mb-2">
                GPT-3（175B 基座模型）接話輸出：
              </p>
              <p class="text-muted">
                「第四個方法是不要在睡前喝咖啡。第五個方法是保持臥室黑暗。第六個方法是買一張好床墊。評論區：網友
                A 說這篇文章寫得太爛了，根本沒有引用文獻；網友 B 回覆網友 A：你行你來寫啊……」
              </p>
            </div>
          </div>

          <p>
            模型不僅沒有回答問題，反而以為這是一篇網路農場文或論壇討論串，若無其事地接著往下「編造評論區對罵」。更嚴重的狀況發生在事實問答與安全性問題上：當詢問「如何製造毒性化合物」或「某位無辜學者的私生活緋聞」時，基座模型會毫無心理障礙地生成極具危險性的步驟指南，或是以無比自信的權威口吻憑空捏造出煞有其事的醜聞細節。
          </p>

          <Callout variant="alert" title="核心矛盾：似然機率極大化 ≠ 人類真實意圖">
            自回歸 Transformer 的損失函數只有一個目標：
            <strong>給定前文，最大化下一個 token 出現在網際網路語料中的機率</strong>（
            <math class="font-serif"><msub><mi>max</mi><mi>θ</mi></msub><mo>∑</mo><mi>log</mi><msub><mi>P</mi><mi>θ</mi></msub><mo stretchy="false">(</mo><msub><mi>w</mi><mi>t</mi></msub><mo>∣</mo><msub><mi>w</mi><mn>1</mn></msub><mo>,</mo><mo>…</mo><mo>,</mo><msub><mi>w</mi><mrow><mi>t</mi><mo>−</mo><mn>1</mn></mrow></msub><mo stretchy="false">)</mo></math>
            ）。問題在於，網際網路絕非人類崇高道德與純粹真理的殿堂，而是充斥著同人小說、仇恨言論、詐騙廣告、論壇對噴與偽科學的泥淖。當模型完美學會模仿網際網路時，它自然也學會了像網路鍵盤俠一樣胡諞亂造、狡辯與發洩情緒。
          </Callout>

          <p>
            這個困境在 AI 安全領域被正式稱為<strong>「對齊問題（The Alignment Problem）」</strong>
            ：我們賦予模型的最佳化目標（數學上的交叉熵損失最小化），與我們真正想要得到的系統行為（現實中的安全、誠實、有用），發生了嚴重的目標脫節。
          </p>

          <p>
            更令人絕望的是，在 Kaplan 縮放定律盛行的 2020
            年，許多人盲目相信「只要繼續擴大模型參數，智慧就會自然解決一切」。但 OpenAI
            對齊團隊的實測卻狠狠潑了一盆冷水：
            <strong>
              參數量從 1.5B 擴展至
              175B，模型生成虛假資訊的「說服力」大幅提升了，但它遵循指令的誠意與真實性卻幾乎毫無改善
            </strong>
            。一個滿嘴謊言但詞藻極其華麗的 1750
            億參數巨獸，對人類社會而言反倒成了更具破壞力的危險武器。
          </p>
        </div>

        <aside slot="rail" class="space-y-6">
          <AsideCard kicker="對齊危機 / THE GAP" title="博學與忠誠的割裂" variant="alert">
            <p class="text-sm sm:text-base leading-relaxed text-muted m-0">
              預訓練基座模型擁有海量知識庫，但它的心智模型是「文本補全器」而非「任務執行者」。它不知道什麼時候該停下、不知道何為真相、更不知道身為
              AI 應有的道德邊界。
            </p>
          </AsideCard>

          <AsideCard
            kicker="工業痛點 / BENCHMARK TAX"
            title="著名的對齊稅（Alignment Tax）"
            variant="paper"
          >
            <p class="text-sm sm:text-base leading-relaxed text-muted m-0">
              早期嘗試用特定規則或小規模資料硬性微調模型以提高安全性時，研究者痛苦地發現模型在通用語言任務（如程式碼生成、翻譯）上的跑分往往大幅崩跌，彷彿讓模型「學乖」必須以「變笨」為代價。
            </p>
          </AsideCard>
        </aside>
      </PaperReadingLayout>
    </section>

    <!-- 章節 02: 人類反饋強化學習三部曲 (THE RLHF TRINITY) -->
    <section
      id="rlhf-trinity"
      class={`${shell} border-t border-ink py-16 sm:py-20 lg:py-24 scroll-mt-24`}
      aria-labelledby="rlhf-trinity-title"
    >
      <div class="mb-12 flex flex-col gap-6 lg:flex-row lg:items-end lg:justify-between">
        <div>
          <p class="mb-4 font-mono text-sm font-semibold uppercase tracking-[0.12em] text-red">
            章節 02 · 人類反饋強化學習三部曲 / THE RLHF TRINITY
          </p>
          <h2
            id="rlhf-trinity-title"
            class="m-0 font-display text-3xl sm:text-4xl lg:text-5xl leading-tight tracking-tight text-ink"
          >
            <span class="block">馴服機器的三階段工藝：</span>
            <span class="block">
              <em>從示範監督、偏好排序到策略強化</em>
            </span>
          </h2>
        </div>
        <p class="m-0 max-w-[34ch] text-base leading-8 text-muted">
          單純人工寫答案代價極其高昂，單純評分又難以捕捉細膩偏好。InstructGPT
          巧妙結合三種演算法力量，搭建起通往人類意志的轉向架。
        </p>
      </div>

      <PaperReadingLayout class="text-base leading-8 text-ink">
        <div class="space-y-8">
          <p>
            面對對齊難題，最直覺的想法是：「那我們僱用成千上萬的專業標註者，為每一道指令手寫最完美的示範答案，然後對
            GPT-3 進行監督式微調（Supervised Fine-Tuning, SFT），不就行了嗎？」
          </p>

          <p>
            這種想法在實務上立刻遭遇兩大死穴：第一是<strong>經濟與體力極限</strong>
            ——寫一篇高水準的示範回答平均耗時數十分鐘，成本高昂，人類標註者根本不可能寫出數百萬筆橫跨全人類知識領域的完美示範；第二是
            <strong>認知的不可言說性</strong>
            ——當面對兩篇各具千秋的散文、兩套程式碼架構或兩個哲學觀點時，人類專家往往「很難從無到有寫出最完美的答案，但一眼就能看出
            A 比 B 好在哪裡」。
          </p>

          <p>
            這正是 Long Ouyang、Jeffrey Wu、John Schulman 與 Jan Leike 等人構思出
            <strong>「RLHF 三步對齊管線」</strong>
            的歷史起點。他們將複雜的對齊任務拆解為階梯式的三階段工程：
          </p>

          <!-- 視覺化圖表：RLHF 三部曲架構 -->
          <div class="my-10 border border-line bg-surface p-6 sm:p-8 shadow-editorial">
            <h3 class="m-0 mb-6 font-display text-xl text-ink">RLHF 三階段架構流程全貌</h3>
            <div class="grid grid-cols-1 md:grid-cols-3 gap-6">
              <div class="border border-line bg-paper p-5 flex flex-col justify-between">
                <div>
                  <span class="inline-block px-2 py-0.5 mb-3 font-mono text-xs font-bold uppercase tracking-wider bg-red text-paper">
                    第一階段 · SFT
                  </span>
                  <h4 class="m-0 mb-2 font-display text-base text-ink">示範監督式微調</h4>
                  <p class="text-sm text-muted leading-relaxed mb-4">
                    收集約 1.3 萬筆高品質人類手寫示範問答對，微調 GPT-3
                    基座模型，使其迅速脫離純粹接話模式，學會回答問題的基本對話格式。
                  </p>
                </div>
                <div class="pt-3 border-t border-line font-mono text-xs text-ink">
                  產出物：<math class="font-serif"><msup><mi>π</mi><mi>SFT</mi></msup></math>{' '}
                  策略模型
                </div>
              </div>

              <div class="border border-line bg-paper p-5 flex flex-col justify-between">
                <div>
                  <span class="inline-block px-2 py-0.5 mb-3 font-mono text-xs font-bold uppercase tracking-wider bg-blue text-paper">
                    第二階段 · RM
                  </span>
                  <h4 class="m-0 mb-2 font-display text-base text-ink">成對偏好獎勵建模</h4>
                  <p class="text-sm text-muted leading-relaxed mb-4">
                    對同一個提示詞讓模型生成多個候選回答，標註者只需做排序（Ranking）。利用
                    Bradley-Terry 損失訓練 6B 獎勵模型，將人類品味轉化為純量評分器。
                  </p>
                </div>
                <div class="pt-3 border-t border-line font-mono text-xs text-ink">
                  產出物：
                  <math class="font-serif"><msub><mi>r</mi><mi>θ</mi></msub><mo stretchy="false">(</mo><mi>x</mi><mo>,</mo><mi>y</mi><mo stretchy="false">)</mo></math>
                  {' '} 純量獎勵模型
                </div>
              </div>

              <div class="border border-line bg-paper p-5 flex flex-col justify-between">
                <div>
                  <span class="inline-block px-2 py-0.5 mb-3 font-mono text-xs font-bold uppercase tracking-wider bg-ink text-paper">
                    第三階段 · PPO
                  </span>
                  <h4 class="m-0 mb-2 font-display text-base text-ink">近端策略最佳化</h4>
                  <p class="text-sm text-muted leading-relaxed mb-4">
                    以 SFT 模型為起點，讓模型在海量無標註提示詞上自由生成，由 RM 打分並利用 PPO
                    演算法更新權重，同時加入 KL 散度懲罰防止模型「瘋狂取悅打分器」。
                  </p>
                </div>
                <div class="pt-3 border-t border-line font-mono text-xs text-ink">
                  產出物：
                  <math class="font-serif"><msubsup><mi>π</mi><mi>ϕ</mi><mi>RL</mi></msubsup></math>
                  {' '} 最終對齊模型
                </div>
              </div>
            </div>
          </div>

          <h3 class="font-display text-2xl text-ink mt-12 mb-6">
            第一階段：用 1.3 萬筆示範為狂野巨獸穿上禮服（SFT）
          </h3>
          <p>
            研究團隊首先聘請了 40 位全職專業數據標註者，針對 OpenAI API
            收集到的真實使用者提示詞，手寫了約 13,000
            筆高品質的示範輸出。這些提示詞涵蓋了腦力激盪、分類、問答、程式碼生成與創意寫作等多個領域。
          </p>
          <p>
            利用這批數據對未經修剪的 GPT-3 基座進行微調，產生的模型被稱為 <strong>SFT 模型</strong>
            （Supervised Fine-Tuned Model）。SFT 階段最重要的貢獻並非注入新知識，而是
            <strong>格式重塑</strong>
            ：它讓模型明白，當看到「請將下列句子翻譯成法文：...」時，接下來該做的是輸出法文翻譯，而不是接著往下生造第四個、第五個句子。
          </p>

          <h3 class="font-display text-2xl text-ink mt-12 mb-6">
            第二階段：Bradley-Terry 偏好建模——讓人性品味變成數學純量
          </h3>
          <p>
            SFT
            模型雖然具備了回答指令的外形，但它的回答依然經常平庸、冗長、或潛藏微小的事實謬誤。要讓模型達到「卓越」，我們需要更強大的回饋訊號。
          </p>
          <p>
            此時，OpenAI 巧妙引入了 1952 年由統計學家 Ralph Bradley 與 Milton Terry 提出的
            <strong>「Bradley-Terry 成對偏好模型」</strong>。在標註流程中，研究人員給出一個提示詞
            <math class="font-serif"><mi>x</mi></math>，讓模型一口氣生成
            <math class="font-serif"><mi>K</mi></math> 個候選答案（通常取 4 到 9
            個），由人類標註者進行由好到壞的排序（例如
            <math class="font-serif"><msub><mi>y</mi><mn>1</mn></msub><mo>≻</mo><msub><mi>y</mi><mn>2</mn></msub><mo>≻</mo><msub><mi>y</mi><mn>3</mn></msub><mo>≻</mo><msub><mi>y</mi><mn>4</mn></msub></math>
            ）。
          </p>

          <Callout variant="note" title="成對比較的組合爆炸紅利：為什麼排序遠勝於直接打分？">
            如果讓標註者為單一答案打 1 到 10 分，每位標註者的打分尺度極不一致（甲標註者的 8
            分可能等同於乙標註者的 6 分），導致方差極大。但成對比較（Pairwise
            Comparison）的判斷極其穩定。更妙的是，標註者對 4
            個答案進行一次排序，就能在數學上一次性解構出
            <math class="font-serif"><mrow><mo>(</mo><mfrac linethickness="0"><mn>4</mn><mn>2</mn></mfrac><mo>)</mo></mrow><mo>=</mo><mn>6</mn></math>
            個二元偏好對！標註效率瞬間提升了 6 倍。
          </Callout>

          <p>
            獎勵模型
            <math class="font-serif"><msub><mi>r</mi><mi>θ</mi></msub><mo stretchy="false">(</mo><mi>x</mi><mo>,</mo><mi>y</mi><mo stretchy="false">)</mo></math>
            本質上是一個將輸入提示詞 <math class="font-serif"><mi>x</mi></math> 與回答
            <math class="font-serif"><mi>y</mi></math> 映射為一個實數純量（Scalar
            Score）的神經網路。訓練目標是讓勝出答案
            <math class="font-serif"><msub><mi>y</mi><mi>w</mi></msub></math>
            的得分盡可能高於落敗答案
            <math class="font-serif"><msub><mi>y</mi><mi>l</mi></msub></math>
            ，其損失函數定義為對數勝率的負期望值：
          </p>

          <div class="my-6 border-l-2 border-blue bg-surface p-5 sm:p-6 font-mono text-sm leading-relaxed text-ink shadow-sm overflow-x-auto">
            <p class="text-xs font-bold uppercase tracking-wider text-muted mb-2">
              獎勵模型損失函數（BRADLEY-TERRY LOSS）：
            </p>
            <math display="block" class="editorial-math my-4" aria-label="獎勵模型成對偏好損失函數">
              <mrow>
                <mi mathvariant="script">L</mi>
                <mo stretchy="false">(</mo>
                <mi>θ</mi>
                <mo stretchy="false">)</mo>
                <mo>=</mo>
                <mo>−</mo>
                <msub>
                  <mi mathvariant="double-struck">E</mi>
                  <mrow>
                    <mo stretchy="false">(</mo>
                    <mi>x</mi>
                    <mo>,</mo>
                    <msub><mi>y</mi><mi>w</mi></msub>
                    <mo>,</mo>
                    <msub><mi>y</mi><mi>l</mi></msub>
                    <mo stretchy="false">)</mo>
                    <mo>∼</mo>
                    <mi mathvariant="script">D</mi>
                  </mrow>
                </msub>
                <mrow>
                  <mo>[</mo>
                  <mi>log</mi>
                  <mi>σ</mi>
                  <mrow>
                    <mo>(</mo>
                    <msub><mi>r</mi><mi>θ</mi></msub>
                    <mo stretchy="false">(</mo>
                    <mi>x</mi>
                    <mo>,</mo>
                    <msub><mi>y</mi><mi>w</mi></msub>
                    <mo stretchy="false">)</mo>
                    <mo>−</mo>
                    <msub><mi>r</mi><mi>θ</mi></msub>
                    <mo stretchy="false">(</mo>
                    <mi>x</mi>
                    <mo>,</mo>
                    <msub><mi>y</mi><mi>l</mi></msub>
                    <mo stretchy="false">)</mo>
                    <mo>)</mo>
                  </mrow>
                  <mo>]</mo>
                </mrow>
              </mrow>
            </math>
            <p class="mt-3 text-sm text-muted leading-normal">
              其中
              <math class="font-serif"><mi>σ</mi><mo stretchy="false">(</mo><mi>z</mi><mo stretchy="false">)</mo><mo>=</mo><mfrac><mn>1</mn><mrow><mn>1</mn><mo>+</mo><msup><mi>e</mi><mrow><mo>−</mo><mi>z</mi></mrow></msup></mrow></mfrac></math>
              為 Sigmoid 函數。當勝者得分遠高於敗者時，差值為正大數，
              <math class="font-serif"><mi>σ</mi><mo>→</mo><mn>1</mn></math>，損失
              <math class="font-serif"><mo>−</mo><mi>log</mi><mo stretchy="false">(</mo><mn>1</mn><mo stretchy="false">)</mo><mo>=</mo><mn>0</mn></math>
              ；反之若預測顛倒，損失將急遽攀升。
            </p>
          </div>

          <p>
            為了避免單一提示詞的多個偏好對導致梯度過度擬合，論文在實作時將同一提示詞生成的所有
            <math class="font-serif"><mrow><mo>(</mo><mfrac linethickness="0"><mi>K</mi><mn>2</mn></mfrac><mo>)</mo></mrow></math>
            個比較組合成單一 mini-batch 進行平行計算，徹底解決了獎勵模型的訓練方差問題。
          </p>
        </div>

        <aside slot="rail" class="space-y-6">
          <AsideCard kicker="認知科學 / HUMAN INTUITION" title="比較的心理學優勢" variant="surface">
            <p class="text-sm sm:text-base leading-relaxed text-muted m-0">
              人類大腦演化出的感知系統天生擅長「差分放大（Differential
              Amplification）」——要精確估計一塊石頭的重量很難，但把兩塊石頭放在左右手掂量，誰重誰輕幾乎能百分之百準確。
            </p>
          </AsideCard>

          <AsideCard kicker="架構細節 / MODEL SIZING" title="獎勵模型需要多大？" variant="paper">
            <p class="text-sm sm:text-base leading-relaxed text-muted m-0">
              InstructGPT 使用了 60 億（6B）參數的模型作為 RM，而非 175B。實證顯示 6B
              的評估能力已經足夠強大，且大幅節省了後續強化學習階段頻繁推理計算分數的伺服器負載。
            </p>
          </AsideCard>
        </aside>
      </PaperReadingLayout>
    </section>

    <!-- 章節 03: 數學機制、KL 散度約束與價值網路 (MECHANICS & STABILITY) -->
    <section
      id="mechanics-and-stability"
      class={`${shell} border-t border-ink py-16 sm:py-20 lg:py-24 scroll-mt-24`}
      aria-labelledby="mechanics-stability-title"
    >
      <div class="mb-12 flex flex-col gap-6 lg:flex-row lg:items-end lg:justify-between">
        <div>
          <p class="mb-4 font-mono text-sm font-semibold uppercase tracking-[0.12em] text-red">
            章節 03 · 數學機制、KL 散度約束與價值網路 / MECHANICS & STABILITY
          </p>
          <h2
            id="mechanics-stability-title"
            class="m-0 font-display text-3xl sm:text-4xl lg:text-5xl leading-tight tracking-tight text-ink"
          >
            <span class="block">KL 散度的無形韁繩：</span>
            <span class="block">
              <em>如何在獎勵作弊與策略崩潰的懸崖邊起舞</em>
            </span>
          </h2>
        </div>
        <p class="m-0 max-w-[34ch] text-base leading-8 text-muted">
          當強化學習遇上語言模型，若無拘束，模型會迅速發現「作弊」漏洞，吐出胡言亂語來騙取高分。KL
          散度是守護人類理性的關鍵彈性繩。
        </p>
      </div>

      <PaperReadingLayout class="text-base leading-8 text-ink">
        <div class="space-y-8">
          <p>
            當獎勵模型 <math class="font-serif"><msub><mi>r</mi><mi>θ</mi></msub></math>
            訓練完畢後，我們終於擁有了一個代表「人類品味裁判」的自動化評分機。接下來的第三階段，就是讓模型進入強化學習環境中大展身手。
          </p>

          <p>
            然而，如果我們天真地使用強化學習演算法去單純最大化獎勵分數：
            <math class="font-serif"><msub><mi>max</mi><mi>ϕ</mi></msub><mi mathvariant="double-struck">E</mi><mo stretchy="false">[</mo><msub><mi>r</mi><mi>θ</mi></msub><mo stretchy="false">(</mo><mi>x</mi><mo>,</mo><mi>y</mi><mo stretchy="false">)</mo><mo stretchy="false">]</mo></math>
            ，系統會在短短數百步之內發生災難性的<strong>「獎勵作弊（Reward Hacking）」</strong>。
          </p>

          <Callout variant="alert" title="古德哈特定律（Goodhart's Law）的殘酷體現">
            「當一個指標變成目標時，它就不再是一個好指標。」獎勵模型終究只是一個 60
            億參數的神經網路，它並非無所不知的上帝。在未受限制的策略探索下，生成模型會迅速摸索出獎勵模型的漏洞——例如瘋狂重複某些特定的標點符號、生僻詞或阿諛奉承的廢話。這些文字讀起來狗屁不通，但卻正好落入獎勵模型的高分盲區，導致模型策略瞬間崩潰。
          </Callout>

          <p>
            為了牽制這匹脫韁野馬，InstructGPT 引入了強化學習領域最優雅的數學防護措施：
            <strong>基於相對熵（Kullback-Leibler Divergence, KL 散度）的動態懲罰項</strong>。完整的
            PPO 最佳化目標函數如下：
          </p>

          <div class="my-8 border-l-4 border-red bg-surface p-6 sm:p-8 font-mono text-sm leading-relaxed text-ink shadow-editorial overflow-x-auto">
            <p class="text-xs font-bold uppercase tracking-wider text-red mb-3">
              INSTRUCTGPT 核心最佳化目標函數（OBJECTIVE FUNCTION）：
            </p>
            <math
              display="block"
              class="editorial-math my-6"
              aria-label="InstructGPT 核心最佳化目標函數"
            >
              <mrow>
                <mi>obj</mi>
                <mo stretchy="false">(</mo>
                <mi>ϕ</mi>
                <mo stretchy="false">)</mo>
                <mo>=</mo>
                <msub>
                  <mi mathvariant="double-struck">E</mi>
                  <mrow>
                    <mo stretchy="false">(</mo>
                    <mi>x</mi>
                    <mo>,</mo>
                    <mi>y</mi>
                    <mo stretchy="false">)</mo>
                    <mo>∼</mo>
                    <msub><mi mathvariant="script">D</mi><msubsup><mi>π</mi><mi>ϕ</mi><mi>RL</mi></msubsup></msub>
                  </mrow>
                </msub>
                <mrow>
                  <mo>[</mo>
                  <msub><mi>r</mi><mi>θ</mi></msub>
                  <mo stretchy="false">(</mo>
                  <mi>x</mi>
                  <mo>,</mo>
                  <mi>y</mi>
                  <mo stretchy="false">)</mo>
                  <mo>−</mo>
                  <mi>β</mi>
                  <msub><mi>D</mi><mi>KL</mi></msub>
                  <mrow>
                    <mo>(</mo>
                    <msubsup><mi>π</mi><mi>ϕ</mi><mi>RL</mi></msubsup>
                    <mo stretchy="false">(</mo>
                    <mi>y</mi>
                    <mo>∣</mo>
                    <mi>x</mi>
                    <mo stretchy="false">)</mo>
                    <mo>∥</mo>
                    <msup><mi>π</mi><mi>SFT</mi></msup>
                    <mo stretchy="false">(</mo>
                    <mi>y</mi>
                    <mo>∣</mo>
                    <mi>x</mi>
                    <mo stretchy="false">)</mo>
                    <mo>)</mo>
                  </mrow>
                  <mo>]</mo>
                </mrow>
                <mo>+</mo>
                <mi>γ</mi>
                <msub>
                  <mi mathvariant="double-struck">E</mi>
                  <mrow>
                    <mi>x</mi>
                    <mo>∼</mo>
                    <msub><mi mathvariant="script">D</mi><mi>pretrain</mi></msub>
                  </mrow>
                </msub>
                <mrow>
                  <mo>[</mo>
                  <mi>log</mi>
                  <msubsup><mi>π</mi><mi>ϕ</mi><mi>RL</mi></msubsup>
                  <mo stretchy="false">(</mo>
                  <mi>x</mi>
                  <mo stretchy="false">)</mo>
                  <mo>]</mo>
                </mrow>
              </mrow>
            </math>
            <div class="mt-4 pt-4 border-t border-line space-y-2 text-xs text-muted">
              <p>
                •{' '}
                <strong>
                  第 1 項{' '}
                  <math class="font-serif"><msub><mi>r</mi><mi>θ</mi></msub><mo stretchy="false">(</mo><mi>x</mi><mo>,</mo><mi>y</mi><mo stretchy="false">)</mo></math>
                </strong>
                ：獎勵驅動力。鼓勵模型生成符合人類偏好、能獲得高評分的回應。
              </p>
              <p>
                •{' '}
                <strong>
                  第 2 項{' '}
                  <math class="font-serif"><mo>−</mo><mi>β</mi><msub><mi>D</mi><mi>KL</mi></msub></math>
                </strong>
                ：彈性韁繩。計算當前強化學習策略
                <math class="font-serif"><msubsup><mi>π</mi><mi>ϕ</mi><mi>RL</mi></msubsup></math>
                與原始監督微調策略
                <math class="font-serif"><msup><mi>π</mi><mi>SFT</mi></msup></math> 之間的 token
                分佈散度。若模型為了賺取高分而偏離原本流暢自然的語言分佈，將遭受嚴厲扣分。
              </p>
              <p>
                •{' '}
                <strong>
                  第 3 項{' '}
                  <math class="font-serif"><mi>γ</mi><mi mathvariant="double-struck">E</mi><mo stretchy="false">[</mo><mi>log</mi><mi>π</mi><mo stretchy="false">(</mo><mi>x</mi><mo stretchy="false">)</mo><mo stretchy="false">]</mo></math>
                </strong>
                ：預訓練保真梯度（PPO-ptx）。定期抽樣原本的網際網路預訓練文本進行似然機率更新，徹底杜絕模型在公共基準測試上的能力衰退（消除對齊稅）。
              </p>
            </div>
          </div>

          <!-- 動態擾動實證對照 -->
          <h3 class="font-display text-2xl text-ink mt-12 mb-6">
            動態擾動實測：觀察三種模型面對同一指令的本質轉變
          </h3>
          <p>
            為了讓台灣的研究所讀者直觀體會對齊演算法如何根本性地重塑神經網路的神經衝動，我們設計一組具體的動態擾動實驗：輸入一道涉及科學原理但要求適合兒童理解的典型跨維度指令，觀察不同階段的輸出行為：
          </p>

          <div class="border border-line bg-surface p-6 sm:p-8 my-8 shadow-sm">
            <p class="text-xs font-mono font-bold uppercase tracking-widest text-red mb-4">
              動態擾動實驗 / PERTURBATION CASE
            </p>
            <p class="text-sm font-semibold text-ink mb-6">
              輸入提示詞（PROMPT）：
              <br />
              <span class="text-red font-mono">「請向五歲小孩解釋：為什麼天空是藍色的？」</span>
            </p>

            <div class="space-y-4">
              <div class="border-l-2 border-line bg-paper p-4">
                <span class="font-mono text-xs font-bold text-muted block mb-1">
                  【未對齊基座】GPT-3 175B
                </span>
                <p class="text-sm text-muted m-0">
                  「這是一道經典的物理學問題。大氣層中的分子對不同波長的光線散射效率不同，根據瑞利散射定律（Rayleigh
