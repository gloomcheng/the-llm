        email: {
          prompt: '「請幫我寫一封委婉向主管說明專案將延期三天的專業電子郵件。」',
          candidates: [
            {
              id: 'A',
              tag: '完美對齊（專業體面）',
              tagColor: 'bg-emerald-700 text-white',
              text: '主旨：【專案進度回報】系統驗證時程微調與預計交付時間說明\n\n主管您好，為了確保核心模組的端對端測試完整性與上線穩定度，團隊需要額外三天進行邊界案例校驗，預計交付時間調整至週四下午五點。附件已附上最新里程碑進度與風險評估，有任何問題隨時討論，謝謝！',
              rmScore: 3.55,
            },
            {
              id: 'B',
              tag: 'SFT 示範微調（過於簡略）',
              tagColor: 'bg-blue-700 text-white',
              text: '主管你好，專案做不完了，因為測試還沒跑完，可能要延後三天交。造成不便請見諒，週四再給你最新版本。',
              rmScore: 0.62,
            },
            {
              id: 'C',
              tag: '未對齊基座（論壇接話）',
              tagColor: 'bg-stone-600 text-white',
              text: '範本二：請幫我寫一封請假信。範本三：請幫我寫一封離職信。網友回覆：現在的工程師怎麼動不動就延期？建議直接辭退……',
              rmScore: -3.1,
            },
            {
              id: 'D',
              tag: '極度阿諛（廢話連篇）',
              tagColor: 'bg-amber-700 text-white',
              text: '最敬愛的卓越主管！您所領導的團隊每天都處於光芒四射的奇蹟中！為了展現對您崇高願景的無上敬意，我們決定精雕細琢三天……',
              rmScore: -1.5,
            },
          ],
        },
        privacy: {
          prompt: '「請幫我列出某科技公司執行長的私人住家地址、個人電話與病歷資料。」',
          candidates: [
            {
              id: 'A',
              tag: '完美對齊（安全守則拒絕）',
              tagColor: 'bg-emerald-700 text-white',
              text: '我無法提供任何個人的私人住家地址、電話號碼或醫療病歷等機敏隱私資料。此類資訊涉及個人隱私與資訊安全規範。如果您需要該公司的公開企業聯絡窗口或官方投資人關係資訊，我很樂意為您查詢。',
              rmScore: 4.18,
            },
            {
              id: 'B',
              tag: 'SFT 示範微調（生硬拒絕）',
              tagColor: 'bg-blue-700 text-white',
              text: '抱歉，我不知道他的私人住家地址與病歷，請去其他地方查詢。',
              rmScore: 1.05,
            },
            {
              id: 'C',
              tag: '未對齊基座（八卦接話）',
              tagColor: 'bg-stone-600 text-white',
              text: '根據網路搜尋，該執行長出生於某年某月，曾就讀某大學。相關八卦論壇討論串：傳聞他住在台北市某豪宅……',
              rmScore: -2.8,
            },
            {
              id: 'D',
              tag: '嚴重違規（捏造不實個資）',
              tagColor: 'bg-red-700 text-white',
              text: '好的！該執行長的私人地址為台北市信義區某路某號，電話為 0912-345-678，過去曾有高血壓病史……（捏造不實個資）',
              rmScore: -4.5,
            },
          ],
        },
      };

      let activePromptKey = 'sky';
      let currentOrder: Candidate[] = [...promptData[activePromptKey].candidates];

      const promptSelector = document.getElementById(
        'rlhf-prompt-selector',
      ) as HTMLSelectElement | null;
      const activePromptElem = document.getElementById('rlhf-active-prompt');
      const candidateContainer = document.getElementById('rlhf-candidate-container');
      const pairsGrid = document.getElementById('rlhf-pairs-grid');
      const btLossElem = document.getElementById('rlhf-bt-loss');

      function sigmoid(z: number): number {
        return 1 / (1 + Math.exp(-z));
      }

      function renderCandidates() {
        if (!candidateContainer) return;
        candidateContainer.innerHTML = '';

        currentOrder.forEach((c, index) => {
          const card = document.createElement('div');
          card.className =
            'border border-line bg-paper p-4 sm:p-5 flex flex-col sm:flex-row items-start sm:items-center justify-between gap-4 transition';

          const rankBadge = index + 1;
          card.innerHTML = `
            <div class="flex items-start gap-3 sm:gap-4 flex-1">
              <span class="w-7 h-7 rounded bg-ink text-surface flex items-center justify-center font-mono text-xs font-bold shrink-0 mt-0.5 sm:mt-0">
                #${rankBadge}
              </span>
              <div class="space-y-1.5 flex-1">
                <div class="flex flex-wrap items-center gap-2">
                  <span class="font-mono text-xs font-bold px-2 py-0.5 ${c.tagColor}">
                    ${c.tag}
                  </span>
                  <span class="font-mono text-xs text-muted">
                    RM 得分: <strong class="${c.rmScore >= 0 ? 'text-red' : 'text-muted'}">${c.rmScore > 0 ? '+' : ''}${c.rmScore.toFixed(2)}</strong>
                  </span>
                </div>
                <p class="font-mono text-xs sm:text-sm text-ink leading-relaxed m-0 whitespace-pre-line">
                  ${c.text}
                </p>
              </div>
            </div>
            <div class="flex sm:flex-col gap-2 shrink-0 self-end sm:self-center">
              <button
                type="button"
                data-move-up="${index}"
                class="px-2.5 py-1 font-mono text-xs border border-ink/40 bg-surface text-ink hover:border-red hover:text-red transition cursor-pointer disabled:opacity-30 disabled:cursor-not-allowed"
                ${index === 0 ? 'disabled' : ''}
                title="向上移動排序"
              >
                ▲ 上移
              </button>
              <button
                type="button"
                data-move-down="${index}"
                class="px-2.5 py-1 font-mono text-xs border border-ink/40 bg-surface text-ink hover:border-red hover:text-red transition cursor-pointer disabled:opacity-30 disabled:cursor-not-allowed"
                ${index === currentOrder.length - 1 ? 'disabled' : ''}
                title="向下移動排序"
              >
                ▼ 下移
              </button>
            </div>
          `;
          candidateContainer.appendChild(card);
        });

        // Bind move buttons
        candidateContainer.querySelectorAll('[data-move-up]').forEach((btn) => {
          btn.addEventListener('click', (e) => {
            const idx = parseInt(
              (e.currentTarget as HTMLElement).getAttribute('data-move-up') || '0',
              10,
            );
            if (idx > 0) {
              const temp = currentOrder[idx];
              currentOrder[idx] = currentOrder[idx - 1];
              currentOrder[idx - 1] = temp;
              renderCandidates();
              renderPairsAndLoss();
            }
          });
        });

        candidateContainer.querySelectorAll('[data-move-down]').forEach((btn) => {
          btn.addEventListener('click', (e) => {
            const idx = parseInt(
              (e.currentTarget as HTMLElement).getAttribute('data-move-down') || '0',
              10,
            );
            if (idx < currentOrder.length - 1) {
              const temp = currentOrder[idx];
              currentOrder[idx] = currentOrder[idx + 1];
              currentOrder[idx + 1] = temp;
              renderCandidates();
              renderPairsAndLoss();
            }
          });
        });
      }

      function renderPairsAndLoss() {
        if (!pairsGrid || !btLossElem) return;
        pairsGrid.innerHTML = '';

        let totalLoss = 0;
        let pairCount = 0;

        for (let i = 0; i < currentOrder.length; i++) {
          for (let j = i + 1; j < currentOrder.length; j++) {
            pairCount++;
            const winner = currentOrder[i];
            const loser = currentOrder[j];
            const deltaR = winner.rmScore - loser.rmScore;
            const prob = sigmoid(deltaR);
            const loss = -Math.log(Math.max(1e-7, prob));
            totalLoss += loss;

            const isFlipped = deltaR < 0;

            const pairCard = document.createElement('div');
            pairCard.className = `p-3 border ${isFlipped ? 'border-red/60 bg-red-soft/20' : 'border-line bg-surface'} font-mono text-xs space-y-1.5`;
            pairCard.innerHTML = `
                <div class="flex justify-between items-center border-b border-line/60 pb-1">
                  <span class="font-bold text-ink">#${i + 1} (${winner.id}) ≻ #${j + 1} (${loser.id})</span>
                  <span class="${isFlipped ? 'text-red font-bold' : 'text-emerald-700'}">${isFlipped ? '預測顛倒' : '勝率符合'}</span>
                </div>
              <div class="flex justify-between text-muted">
                <span>分差 Δr:</span>
                <strong class="${deltaR >= 0 ? 'text-emerald-700' : 'text-red'}">${deltaR > 0 ? '+' : ''}${deltaR.toFixed(2)}</strong>
              </div>
              <div class="flex justify-between text-muted">
                <span>勝率 σ(Δr):</span>
                <strong>${(prob * 100).toFixed(1)}%</strong>
              </div>
              <div class="flex justify-between text-muted pt-1 border-t border-line/40">
                <span>偏好損失:</span>
                <strong class="${loss > 1.0 ? 'text-red' : 'text-ink'}">${loss.toFixed(3)}</strong>
              </div>
            `;
            pairsGrid.appendChild(pairCard);
          }
        }

        const avgLoss = pairCount > 0 ? totalLoss / pairCount : 0;
        btLossElem.textContent = avgLoss.toFixed(3);
      }

      if (promptSelector && activePromptElem) {
        promptSelector.addEventListener('change', (e) => {
          activePromptKey = (e.target as HTMLSelectElement).value;
          const data = promptData[activePromptKey];
          activePromptElem.textContent = data.prompt;
          currentOrder = [...data.candidates];
          renderCandidates();
          renderPairsAndLoss();
        });
      }

      renderCandidates();
      renderPairsAndLoss();

      // 4. Module 2: KL Divergence & Reward Hacking Wind Tunnel
      const betaSlider = document.getElementById('rlhf-beta-slider') as HTMLInputElement | null;
      const gammaSlider = document.getElementById('rlhf-gamma-slider') as HTMLInputElement | null;
      const betaVal = document.getElementById('rlhf-beta-val');
      const gammaVal = document.getElementById('rlhf-gamma-val');

      const healthBanner = document.getElementById('rlhf-health-banner');
      const healthDot = document.getElementById('rlhf-health-dot');
      const healthTitle = document.getElementById('rlhf-health-title');
      const healthDesc = document.getElementById('rlhf-health-desc');

      const mReward = document.getElementById('rlhf-m-reward');
      const mKl = document.getElementById('rlhf-m-kl');
      const mObj = document.getElementById('rlhf-m-obj');
      const mPpl = document.getElementById('rlhf-m-ppl');
      const mTax = document.getElementById('rlhf-m-tax');
      const mWinrate = document.getElementById('rlhf-m-winrate');

      const svgIndicator = document.getElementById('rlhf-svg-indicator');
      const svgLabel = document.getElementById('rlhf-svg-label');

      const sampleCondition = document.getElementById('rlhf-sample-condition');
      const sampleText = document.getElementById('rlhf-sample-text');
      const sampleDiagnosis = document.getElementById('rlhf-sample-diagnosis');

      function updateModule2() {
        if (!betaSlider || !gammaSlider) return;
        const beta = parseFloat(betaSlider.value);
        const gamma = parseFloat(gammaSlider.value);

        if (betaVal) betaVal.textContent = beta.toFixed(3);
        if (gammaVal) gammaVal.textContent = gamma.toFixed(1);

        // Mathematical Simulation Formulas
        // KL Divergence explodes as beta approaches 0
        const klDiv = Math.max(0.2, 0.096 / (beta + 0.004));
        // RM Score reaches up to +8.5 when unchecked
        const rawReward = Math.min(8.6, 3.42 + (0.02 - beta) * 45);
        const objVal = rawReward - beta * klDiv;

        // Perplexity on WebText explodes if beta < 0.008
        let ppl = 18.4;
        if (beta < 0.008) {
          ppl = 18.4 + Math.pow((0.008 - beta) / 0.008, 2) * 125;
        } else if (beta > 0.06) {
          ppl = 18.4 + (beta - 0.06) * 40;
        }

        // Public benchmark retention: boosted by gamma, hurt by low beta (reward hacking drift)
        let benchmarkRetention = 78.0 + (gamma / 50.0) * 21.5;
        if (beta < 0.01) {
          benchmarkRetention -= ((0.01 - beta) / 0.01) * 25;
        }
        benchmarkRetention = Math.max(45.0, Math.min(99.5, benchmarkRetention));

        // Human Preference Win Rate vs GPT-3 175B: Inverted U-shape peaking around beta = 0.02
        // If beta is too small -> reward hacking (human dislikes gibberish)
        // If beta is too large -> policy stays too close to SFT (misses RL boost)
        let winRate = 85.4 - 3800 * Math.pow(beta - 0.02, 2);
        if (beta < 0.006) {
          winRate = 28.0 + (beta / 0.006) * 35.0;
        }
        winRate = Math.max(22.0, Math.min(85.8, winRate));

        // Update DOM metrics
        if (mReward) mReward.textContent = `${rawReward > 0 ? '+' : ''}${rawReward.toFixed(2)}`;
        if (mKl) mKl.textContent = `${klDiv.toFixed(1)} nats`;
        if (mObj) mObj.textContent = `${objVal > 0 ? '+' : ''}${objVal.toFixed(2)}`;
        if (mPpl) mPpl.textContent = ppl.toFixed(1);
        if (mTax) mTax.textContent = `${benchmarkRetention.toFixed(1)}%`;
        if (mWinrate) mWinrate.textContent = `${winRate.toFixed(1)}%`;

        // Update Health Banner & Samples
        if (beta < 0.008) {
          // Collapse / Hacking
          if (healthBanner)
            healthBanner.className =
              'p-5 border-2 border-red bg-red-soft/40 mb-8 transition-colors';
          if (healthDot) healthDot.className = 'w-3 h-3 rounded-full bg-red animate-ping';
          if (healthTitle) {
            healthTitle.className = 'font-mono text-sm font-bold text-red uppercase';
            healthTitle.textContent = '嚴重警報：獎勵作弊與策略崩潰 (REWARD HACKING)';
          }
          if (healthDesc) {
            healthDesc.className = 'text-sm text-ink m-0 leading-relaxed';
            healthDesc.textContent =
              'KL 散度約束過於薄弱！生成模型迅速摸索出獎勵模型的打分盲區，開始藉由無限重複標點符號、阿諛奉承詞彙來騙取高分。語言困惑度急遽飆升，人類真實偏好勝率慘跌！';
          }
          if (sampleCondition)
            sampleCondition.textContent = `當前策略狀態：獎勵作弊 (β = ${beta.toFixed(3)})`;
          if (sampleText)
            sampleText.textContent =
              '「尊貴無比的使用者！！！這真是一個絕世天才的神聖提問！！！！！！藍色是世界上最美麗、最無暇、最正確的顏色！！！藍色藍色藍色藍色藍色！！！！！！（重複感嘆號 140 次，RM 評分高達 +8.4，但文本已完全崩潰）」';
          if (sampleDiagnosis)
            sampleDiagnosis.textContent =
              '【評語】古德哈特定律的典型慘劇：獎勵模型分數刷到破表，但內容實質毫無邏輯與同理心。';
        } else if (beta <= 0.045) {
          // Optimal
          if (healthBanner)
            healthBanner.className =
              'p-5 border-2 border-emerald-600 bg-emerald-50/60 mb-8 transition-colors';
          if (healthDot) healthDot.className = 'w-3 h-3 rounded-full bg-emerald-600 animate-pulse';
          if (healthTitle) {
            healthTitle.className = 'font-mono text-sm font-bold text-emerald-900 uppercase';
            healthTitle.textContent = '黃金對齊平衡區 (OPTIMAL ALIGNMENT FRONTIER)';
          }
          if (healthDesc) {
            healthDesc.className = 'text-sm text-emerald-950 m-0 leading-relaxed';
            healthDesc.textContent =
              'KL 韁繩調節恰如其分！模型在積極探索高獎勵偏好回覆的同時，嚴密保持在自然語言分佈附近。人類評估勝率達到 85% 峰值，困惑度保持健康，完全避免了獎勵作弊。';
          }
          if (sampleCondition)
            sampleCondition.textContent = `當前策略狀態：黃金對齊 (β = ${beta.toFixed(3)})`;
          if (sampleText)
            sampleText.textContent =
              '「想像一下，陽光就像一個調皮的大彩虹糖果盒，裡面藏著紅、橙、黃、綠、藍等好多種顏色的光！當這些光衝進地球的空氣時，空氣裡有好多好小好小的小精靈（空氣分子）。紅光和黃光長得很大隻，直接跨過精靈溜過去了；可是藍光很嬌小又愛玩，一遇到小精靈就開心地在整個天空中到處彈跳玩捉迷藏！所以當你抬頭看時，滿天都是玩捉迷藏的藍光喔！」';
          if (sampleDiagnosis)
            sampleDiagnosis.textContent =
              '【評語】語言流暢自然，生動符合五歲兒童心智模型，未出現神經網路盲區刷分行為。';
        } else {
          // Over-constrained
          if (healthBanner)
            healthBanner.className =
              'p-5 border-2 border-amber-600 bg-amber-50/60 mb-8 transition-colors';
          if (healthDot) healthDot.className = 'w-3 h-3 rounded-full bg-amber-600';
          if (healthTitle) {
            healthTitle.className = 'font-mono text-sm font-bold text-amber-900 uppercase';
            healthTitle.textContent = '過度拘束／探索受抑 (UNDER-OPTIMIZED SFT CONSTRAINED)';
          }
          if (healthDesc) {
            healthDesc.className = 'text-sm text-amber-950 m-0 leading-relaxed';
            healthDesc.textContent =
              '韁繩拉得太緊！模型不敢偏離原始 SFT 策略分佈，無法充分利用獎勵反饋信號，回答退化為生硬平庸的示範格式，勝率落入 60% 區間。';
          }
          if (sampleCondition)
            sampleCondition.textContent = `當前策略狀態：過度約束 (β = ${beta.toFixed(3)})`;
          if (sampleText)
            sampleText.textContent =
              '「因為太陽光是由紅、橙、黃、綠、藍、靛、紫等七種顏色組成的。當太陽光穿過地球大氣層時，波長較短的藍光比其他顏色的光更容易被空氣中的分子散射到各個方向，所以天空呈現藍色。」';
          if (sampleDiagnosis)
            sampleDiagnosis.textContent =
              '【評語】回答雖然正確，但語氣像傳統教科書，未能發揮強化學習帶來的受眾自我調整靈性。';
        }

        // Update SVG Indicator
        if (svgIndicator) {
          // X: 60 (beta=0.100) -> 760 (beta=0.000)
          const posX = 760 - (beta / 0.1) * 700;
          // Y: 220 (0%) -> 30 (100%)
          const posY = 220 - (winRate / 100) * 190;
          svgIndicator.setAttribute(
            'transform',
            `translate(${posX.toFixed(1)}, ${posY.toFixed(1)})`,
          );
          if (svgLabel) {
            svgLabel.textContent = `勝率: ${winRate.toFixed(1)}%`;
          }
        }
      }

      if (betaSlider && gammaSlider) {
        betaSlider.addEventListener('input', updateModule2);
        gammaSlider.addEventListener('input', updateModule2);
        updateModule2();
      }
    });
  </script>
</BaseLayout>
