  <script>
    document.addEventListener('DOMContentLoaded', () => {
      // 1. Tab Switching
      const tabPipeline = document.getElementById('rlhf-tab-pipeline');
      const tabLeash = document.getElementById('rlhf-tab-leash');
      const panelPipeline = document.getElementById('rlhf-panel-pipeline');
      const panelLeash = document.getElementById('rlhf-panel-leash');

      if (tabPipeline && tabLeash && panelPipeline && panelLeash) {
        tabPipeline.addEventListener('click', () => {
          tabPipeline.setAttribute('aria-selected', 'true');
          tabLeash.setAttribute('aria-selected', 'false');
          tabPipeline.className =
            'px-4 py-2 font-mono text-xs sm:text-sm font-bold border-2 border-red bg-red text-surface transition cursor-pointer';
          tabLeash.className =
            'px-4 py-2 font-mono text-xs sm:text-sm font-medium border border-ink/40 bg-surface text-ink hover:border-ink hover:bg-paper transition cursor-pointer';
          panelPipeline.classList.remove('hidden');
          panelLeash.classList.add('hidden');
        });

        tabLeash.addEventListener('click', () => {
          tabLeash.setAttribute('aria-selected', 'true');
          tabPipeline.setAttribute('aria-selected', 'false');
          tabLeash.className =
            'px-4 py-2 font-mono text-xs sm:text-sm font-bold border-2 border-red bg-red text-surface transition cursor-pointer';
          tabPipeline.className =
            'px-4 py-2 font-mono text-xs sm:text-sm font-medium border border-ink/40 bg-surface text-ink hover:border-ink hover:bg-paper transition cursor-pointer';
          panelLeash.classList.remove('hidden');
          panelPipeline.classList.add('hidden');
        });
      }

      // 2. Pipeline Step Selection
      const stepBtns = document.querySelectorAll('.rlhf-step-btn');
      const stageDetail = document.getElementById('rlhf-stage-detail');
      const stageDetails: Record<string, { title: string; desc: string }> = {
        sft: {
          title: '當前檢視階段：PHASE 1 · SFT 示範監督微調',
          desc: '訓練目標為經典交叉熵損失：max 𝔼_(x,y) [log π_θ(y | x)]。此階段核心在於教會模型「聽從指令的對話格式」，但無法解決多候選評估中的細膩品味偏好。',
        },
        rm: {
          title: '當前檢視階段：PHASE 2 · RM 成對偏好獎勵建模',
          desc: '利用 Bradley-Terry 對數勝率損失訓練 6B 純量打分神經網路。標註者只需做排序，C(K, 2) 組合爆炸紅利使資料標註效率大幅躍升。',
        },
        ppo: {
          title: '當前檢視階段：PHASE 3 · PPO 策略強化學習',
          desc: '在 GPU 記憶體中同時部署 Actor、Critic、Ref 與 RM 四座模型。以 RM 分數引導探索，並利用 KL 散度韁繩與 PPO-ptx 預訓練梯度鎖住語言理性。',
        },
      };

      stepBtns.forEach((btn) => {
        btn.addEventListener('click', () => {
          stepBtns.forEach((b) => {
            b.className =
              'rlhf-step-btn text-left p-4 border border-line bg-surface text-ink hover:border-ink/60 transition cursor-pointer';
          });
          btn.className =
            'rlhf-step-btn text-left p-4 border-2 border-red bg-paper text-ink transition cursor-pointer';
          const stepKey = btn.getAttribute('data-step') || 'sft';
          if (stageDetail && stageDetails[stepKey]) {
            stageDetail.innerHTML = `
              <span class="font-mono text-xs font-bold text-red uppercase block mb-1">
                ${stageDetails[stepKey].title}
              </span>
              <p class="m-0 text-muted">
                ${stageDetails[stepKey].desc}
              </p>
            `;
          }
        });
      });

      // 3. Bradley-Terry Candidates & Ranking Sandbox
      interface Candidate {
        id: string;
        tag: string;
        tagColor: string;
        text: string;
        rmScore: number;
      }

      const promptData: Record<
        string,
        {
          prompt: string;
          candidates: Candidate[];
        }
      > = {
        sky: {
          prompt: '「請向五歲小孩解釋：為什麼天空是藍色的？」',
          candidates: [
