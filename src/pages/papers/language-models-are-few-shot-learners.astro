---
import BaseLayout from '../../layouts/BaseLayout.astro';
import { withBase } from '../../lib/paths';
import StoryRail from '../../components/StoryRail.astro';
import PaperReadingLayout from '../../components/PaperReadingLayout.astro';
import AsideCard from '../../components/AsideCard.astro';
import Callout from '../../components/Callout.astro';
import AuthorGrid from '../../components/AuthorGrid.astro';
import EvidenceList from '../../components/EvidenceList.astro';
import PaperMeta from '../../components/PaperMeta.astro';
import PaperNavigation from '../../components/PaperNavigation.astro';
import {
  fewShotPaper,
  fewShotSources,
} from '../../content/papers/language-models-are-few-shot-learners';

const paper = fewShotPaper;
const shell = 'mx-auto w-[calc(100%-2rem)] max-w-[1120px]';

const story = [
  {
    year: '2018.10',
    label: '前史 / 微調典範',
    title: 'BERT 與 GPT-1 確立「預訓練 + 任務微調」標準工作流',
    body: '所有下游任務皆需收集專用標註集，透過反向傳播更新模型權重，每個任務都需要維護一套專屬模型。',
    status: 'past' as const,
  },
  {
    year: '2020.01',
    label: '理論 / SCALING LAWS',
    title: '縮放定律確立：模型規模越大，預訓練損失越低且完全可預測',
    body: 'Kaplan 等人以統計物理證實規模的壓倒性支配力，為千億參數的超級工程提供了不可動搖的投資與研發底氣。',
    status: 'past' as const,
  },
  {
    year: '2020.05',
    label: '論文 / GPT-3',
    title: '1750 億參數引爆上下文學習與少樣本湧現能力',
    body: 'Tom B. Brown 等人證明：凍結全部權重（ΔW = 0），僅憑提示詞中的範例即可即學即用，徹底開闢 Prompt 時代。',
    status: 'current' as const,
  },
  {
    year: '2022.03',
    label: '後續 / 對齊與 CHINCHILLA',
    title: '從機率接龍到意圖對齊，算力最佳化化改寫訓練比例',
    body: 'Chinchilla 指出 GPT-3 數據量嚴重不足；InstructGPT 則引入 RLHF 解決原始大模型「不聽指令與幻覺」的原罪。',
    status: 'future' as const,
  },
];

interface TimelineEpoch {
  id: string;
  year: string;
  period: string;
  title: string;
  summary: string;
  sources: Array<{
    source: (typeof fewShotSources)[number];
    num: number;
    refCode: string;
    featured?: boolean;
    role: string;
    takeaway: string;
  }>;
}

const timelineEpochs: TimelineEpoch[] = [
  {
    id: 'epoch-2018-finetune',
    year: '2018–2019',
    period: '微調典範的統治與隱形天花板',
    title: '任務專用資料集與梯度更新的雙重代價',
    summary:
      'GPT-1 與 BERT 確立了先在大規模語料預訓練、再於下游任務微調的黃金架構。然而每個新任務都需要耗費高昂人力收集標註，且模型在微調集上容易過度擬合並喪失泛化能力。',
    sources: [
      {
        source: fewShotSources.find((s) => s.id === 'paper-2019-gpt2')!,
        num: 1,
        refCode: 'S01',
        featured: true,
        role: '概念萌芽',
        takeaway:
          'GPT-2 首次在 15 億參數上展示 Zero-shot 提示詞的潛力，證明自然語言本身能作為任務輸入介面。',
      },
      {
        source: fewShotSources.find((s) => s.id === 'paper-2020-scaling-laws')!,
        num: 2,
        refCode: 'S02',
        role: '理論依據',
        takeaway:
          'Kaplan 等人確立的冪律曲線，為 GPT-3 擴展至 1750 億參數提供了精確的收斂損失預測。',
      },
    ],
  },
  {
    id: 'epoch-2020-gpt3',
    year: '2020.05',
    period: '千億參數與上下文學習的歷史轉折',
    title: 'Tom B. Brown 等人發表 GPT-3，少樣本學習橫空出世',
    summary:
      '將參數量推升至 1750 億，跨越 8 個模型尺度系統性檢驗。證實在完全不更新權重的前提下，模型僅憑提示詞中的範例即可推導任務規則，並在多個基準上逼近甚至超越微調 SOTA。',
    sources: [
      {
        source: fewShotSources.find((s) => s.id === 'paper-2020-gpt3')!,
        num: 3,
        refCode: 'S03',
        featured: true,
        role: '本篇核心',
        takeaway:
          '確立 In-Context Learning（ICL）為全新的人機協作典範，展現三位數算術、單字重組與程式碼合成等階躍式湧現能力。',
      },
    ],
  },
  {
    id: 'epoch-2022-evolution',
    year: '2022',
    period: '計算最佳化化與意圖對齊的雙軌演進',
    title: 'Chinchilla 修正數據分配，RLHF 馴服原始預訓練基座',
    summary:
      'DeepMind 證明 GPT-3 數據量嚴重吃不飽；OpenAI 則透過 InstructGPT 引入人類反饋強化學習，解決基座模型漫無邊際接龍與難以遵循指令的缺陷。',
    sources: [
      {
        source: fewShotSources.find((s) => s.id === 'paper-2022-chinchilla')!,
        num: 4,
        refCode: 'S04',
        role: '資源修正',
        takeaway:
          '指出參數量與訓練 token 數應以 1:1 等比例增長，70B 的 Chinchilla 憑藉 1.4 兆 token 擊敗 GPT-3。',
      },
      {
        source: fewShotSources.find((s) => s.id === 'paper-2022-instructgpt')!,
        num: 5,
        refCode: 'S05',
        role: '行為對齊',
        takeaway:
          '透過人類反饋強化學習（RLHF）讓 1.3B 模型超越 175B 原始 GPT-3 的滿意度，開啟 ChatGPT 時代。',
      },
    ],
  },
];
---

<BaseLayout title={`${paper.title} | THE LLM`} description={paper.abstractSummary}>
  <main id="main-content">
    <!-- 1. Hero Header -->
    <header class={`${shell} pt-10`}>
      <div class="flex gap-3 font-mono text-sm uppercase tracking-[0.08em] text-muted">
        <a class="text-red underline underline-offset-4" href={withBase('/')}>
          THE LLM
        </a>
        <span aria-hidden="true">/</span>
        <span>第 06 章</span>
      </div>

      <div class="grid grid-cols-1 items-end gap-12 py-16 lg:grid-cols-[1.15fr_0.85fr] lg:gap-24">
        <div>
          <p class="mb-5 font-mono text-sm font-semibold uppercase tracking-[0.12em] text-red">
            VOL. 06 / FEW-SHOT & EMERGENT
          </p>

          <h1 class="m-0 font-display text-4xl sm:text-5xl lg:text-6xl xl:text-7xl leading-tight tracking-[-0.04em] text-ink">
            <span class="block">Language Models</span>
            <em class="block">are Few-Shot Learners.</em>
          </h1>

          <p class="mt-8 max-w-[52ch] text-lg leading-8 text-muted">
            在 2020
            年以前，將語言模型應用於新任務的唯一途徑是「微調」：收集數千筆標註資料，透過反向傳播更新數億個權重參數。然而人類學習新技能從不依賴重新布線大腦——給予兩三個範例，我們便能理解規則。Tom
            B. Brown 等人以 1750 億參數的 GPT-3
            證實：純粹透過預測下一個字訓練的大模型，在完全不更新任何權重（ΔW =
            0）的前提下，僅憑提示詞中的上下文範例，就能在翻譯、問答、推理與寫程式上展現強大的少樣本學習能力。
          </p>
        </div>

        <aside
          class="border-t-4 border-red bg-surface p-6 shadow-editorial"
          aria-label="這篇論文的一句評語"
        >
          <p class="mb-4 sm:mb-6 font-mono text-xs sm:text-sm font-semibold uppercase tracking-[0.12em] text-red">
            一句評語 / THE SHORT VERDICT
          </p>
          <p class="m-0 max-w-[20ch] sm:max-w-[22ch] font-display text-2xl sm:text-3xl leading-tight text-ink">
            不用梯度更新的學習：提示詞裡的範例，就是軟體的新介面。
          </p>
          <p class="mt-6 mb-0 text-sm sm:text-base leading-relaxed sm:leading-7 text-muted">
            GPT-3 將自然語言確立為最通用的程式語言，證明規模擴展能引發質變，開啟由 Prompt
            Engineering 與湧現能力主導的現代生成式 AI 紀元。
          </p>
        </aside>
      </div>

      <PaperMeta
        year={paper.year}
        venue={paper.venue}
        readTime="32 分鐘"
        difficulty="進階核心"
        doi={paper.doi}
      />
    </header>

    <!-- 2. 歷史進程 StoryRail -->
    <section class="border-y border-line bg-surface/50 py-12" aria-label="歷史轉折總覽">
      <div class={shell}>
        <div class="mb-6">
          <p class="font-mono text-xs font-bold text-red uppercase tracking-wider mb-1">
            歷史轉折 / 2020
          </p>
          <h2 class="m-0 font-display text-2xl sm:text-3xl text-ink">
            從梯度微調的專用模型，到零梯度更新的上下文學習
          </h2>
        </div>
        <StoryRail events={story} />
      </div>
    </section>

    <!-- MOVEMENT 1: 微調典範的極限 (THE FINE-TUNING BOTTLENECK) -->
    <section
      id="finetune-bottleneck"
      class={`${shell} border-t border-ink py-16 sm:py-20 lg:py-24 scroll-mt-24`}
      aria-labelledby="finetune-bottleneck-title"
    >
      <div class="mb-12 flex flex-col gap-6 lg:flex-row lg:items-end lg:justify-between">
        <div>
          <p class="mb-4 font-mono text-sm font-semibold uppercase tracking-[0.12em] text-red">
            章節 01 · 微調典範的結構性困境 / THE IMPASSE
          </p>
          <h2
            id="finetune-bottleneck-title"
            class="m-0 font-display text-3xl sm:text-4xl lg:text-5xl leading-tight tracking-tight text-ink"
          >
            <span class="block">微調典範的四重代價：</span>
            <span class="block">
              <em>為什麼機器學習必須擺脫任務專用權重更新</em>
            </span>
          </h2>
        </div>
        <p class="m-0 max-w-[34ch] text-base leading-8 text-muted">
          當每個新任務都需要數千筆高品質標註、梯度反向傳播與獨立模型權重維護，深度學習的規模化落地正面臨無法承受的工程成本。
        </p>
      </div>

      <PaperReadingLayout class="text-base leading-8 text-ink">
        <div class="space-y-6">
          <p>
            在 2018 年至 2020
            年初的自然語言處理領域，整個學界與工業界共同信奉一套標準作業程序：先在大規模未標註文本上預訓練一個通用語言模型（如
            GPT-1 或
            BERT），接著針對特定下游任務——無論是情緒分類、生物醫療實體識別、還是跨語言翻譯——收集數千至數萬筆精心標註的訓練樣本，透過反向傳播演算法持續更新神經網路的所有權重。這種「預訓練
            + 微調」（Pre-train and
            Fine-tune）的兩階段典範，雖然刷新了無數基準測試的最高分紀錄，卻在現實世界的應用中撞上了一面堅硬的工程高牆。
          </p>

          <p>
            這堵高牆由四重難以克服的結構性代價堆砌而成：第一重是「標註數據的枯竭與昂貴」——在常規的新聞分類任務中獲取標註尚稱容易，但在法律合約審查、罕見病理診斷或精密機械故障排查等高度專業領域，獲取數萬筆專家級標註資料的成本極其高昂，甚至在許多長尾場景中根本不可行；第二重是「偽泛化與分佈漂移脆弱性」——微調過程會迫使龐大的預訓練特徵空間過度擬合於狹窄的微調資料集分佈，一旦測試環境中的用語習慣、格式或排版發生些許微調，模型的推論準確率便會發生斷崖式崩潰；第三重是「基礎設施維護的幾何級膨脹」——若一家企業擁有
            100
            個不同的業務語言任務，微調典範要求為每個任務分別保存並部署一份獨立的模型權重副本，這在百億甚至千億參數時代意味著天文數字般的儲存與託管開銷。
          </p>

          <p>
            然而，最深層的矛盾在於認知科學層面：人類智能在學習全新語言任務時，從來不需要重新布線大腦中的神經突觸。當我們被要求將一段中文翻譯成英文、或者判斷一句話是否帶有諷刺意味時，我們只需要在口頭說明中聽取兩三個具體的示範範例，就能即刻掌握規則並執行任務。人類大腦在接收新任務時，神經元的權重連接是恆定凍結的（ΔW
            = 0），所有學習與理解都發生在即時的工作記憶與上下文資訊處理之中。
          </p>

          <p>
            OpenAI 的 Tom B. Brown、Melanie Subbiah、Jared Kaplan 與 Dario Amodei
            等人由此提出了一個大膽的科學假說：既然
            <a
              href={withBase('/papers/scaling-laws-for-neural-language-models')}
              class="font-medium text-ink underline decoration-line/80 underline-offset-4 transition-colors hover:text-red hover:decoration-red"
            >
              Scaling Laws
            </a>
            縮放定律證實了語言模型的損失函數會隨著參數規模的擴展而呈現嚴格的冪律下降，那麼當我們把模型從
            <a
              href={withBase('/papers/language-models-are-unsupervised-multitask-learners')}
              class="font-medium text-ink underline decoration-line/80 underline-offset-4 transition-colors hover:text-red hover:decoration-red"
            >
              GPT-2
            </a>
            的 15 億參數一口氣推升至 1750
            億參數時，這個龐大的自回歸網路是否也能如同人類大腦一般，在完全不更新任何權重的情況下，僅僅藉由閱讀提示詞（Prompt）中的前文示範，就學會此前從未見過的全新任務？這個被稱為「上下文學習」（In-Context
            Learning, ICL）的機制，成為了 GPT-3 撼動整個 AI 領域的核心支點。
          </p>
        </div>

        <div slot="rail" class="space-y-6">
          <AsideCard kicker="典範對比" title="微調 vs 上下文學習">
            <dl class="m-0 space-y-4 text-sm leading-6">
              <div>
                <dt class="font-bold text-ink">傳統微調（Fine-tuning）</dt>
                <dd class="mt-1 text-muted">
                  透過反向傳播計算梯度，更新模型內部全部或部分權重參數（ΔW ≠
                  0）。每個任務都需要專屬資料集與獨立權重檔案。
                </dd>
              </div>
              <div class="border-t border-line pt-3">
                <dt class="font-bold text-red">上下文學習（In-Context Learning）</dt>
                <dd class="mt-1 text-muted">
                  模型權重完全凍結（ΔW =
                  0），零梯度更新。任務規格與範例純粹透過輸入文字序列傳遞，在推論前向傳播中即時完成任務理解。
                </dd>
              </div>
            </dl>
          </AsideCard>

          <Callout
            variant="note"
            kicker="術語精確釐清"
            title="In-Context Learning 不是 Meta-Learning"
          >
            <p class="m-0 text-sm leading-6 text-muted">
              在機器學習文獻中，「元學習」（Meta-Learning）通常指涉專門設計了內外雙迴圈最佳化目標以學會快速調整參數的演算法（如
              MAML）。而 GPT-3 的 In-Context Learning
              並沒有專門的元學習訓練目標，它只是純粹預測下一個字的無監督自回歸模型，少樣本學習能力是純粹在規模擴展過程中自發「湧現」出來的副產品。
            </p>
          </Callout>
        </div>
      </PaperReadingLayout>
    </section>

    <!-- MOVEMENT 2: 1750 億參數的物理矩陣 (THE 175B ARCHITECTURE) -->
    <section
      id="architecture-engineering"
      class={`${shell} border-t border-ink py-16 sm:py-20 lg:py-24 scroll-mt-24`}
      aria-labelledby="architecture-engineering-title"
    >
      <div class="mb-12 flex flex-col gap-6 lg:flex-row lg:items-end lg:justify-between">
        <div>
          <p class="mb-4 font-mono text-sm font-semibold uppercase tracking-[0.12em] text-red">
            章節 02 · 1750 億參數的物理矩陣 / ARCHITECTURE
          </p>
          <h2
            id="architecture-engineering-title"
            class="m-0 font-display text-3xl sm:text-4xl lg:text-5xl leading-tight tracking-tight text-ink"
          >
            <span class="block">千億規模的架構解剖：</span>
            <span class="block">
              <em>交替稀疏注意力與萬卡分散式平行工程</em>
            </span>
          </h2>
        </div>
        <p class="m-0 max-w-[34ch] text-base leading-8 text-muted">
          從 1.25 億到 1750 億，跨越 8 個模型尺度的地毯式對比；如何將超過 350GB 的 FP16
          矩陣切分至數百顆 GPU 叢集中同步運算。
        </p>
      </div>

      <PaperReadingLayout class="text-base leading-8 text-ink">
        <div class="space-y-6">
          <p>
            為了驗證少樣本學習究竟是規模擴展的普遍趨勢，還是僅僅在極端參數下才出現的孤立現象，Tom B.
            Brown 等人在論文中並未孤立地只訓練一個超大模型，而是構建了一個跨越三個數量級、包含 8
            個不同規模的 Transformer 解碼器矩陣梯隊。從最小的 GPT-3 Small（1.25 億參數，相當於原始
            GPT-1 的體量），一路攀升至 GPT-3 XL（13 億參數，逼近 GPT-2
            最大尺寸），最終抵達前所未有的旗艦王者——1750 億參數的 GPT-3 175B。
          </p>

          <p>
            解構 GPT-3 175B 的內部物理規格，這座神經網路巨獸由整整 96 層 Transformer Decoder
            區塊垂直堆疊而成；模型的隱藏層維度（hidden dimension, d<sub>model</sub>）高達
            12,288；每一層配備了 96 個平行的注意力頭，每個頭的投影維度為 d<sub>head</sub> =
            128；前向回饋神經網路（FFN）的中間擴展維度為 4 &times; d<sub>model</sub> =
            49,152；上下文窗口長度（Context Window）則全面擴充至 2,048 個 tokens。
          </p>

          <!-- 8 Models Comparison Table -->
          <div class="my-8 overflow-x-auto border border-line bg-surface p-6 shadow-sm">
            <p class="mb-3 font-mono text-xs font-bold uppercase tracking-wider text-red">
              TABLE 2.1 / 論文正式規格對照表：GPT-3 家族 8 種尺度幾何架構
            </p>
            <table class="w-full border-collapse text-left font-mono text-sm leading-relaxed">
              <thead>
                <tr class="border-b border-ink/20 text-muted">
                  <th class="py-2.5 pr-4 font-semibold">模型代號</th>
                  <th class="py-2.5 pr-4 font-semibold">總參數量 (N)</th>
                  <th class="py-2.5 pr-4 font-semibold">
                    層數 (n<sub>layers</sub>)
                  </th>
                  <th class="py-2.5 pr-4 font-semibold">
                    隱藏維度 (d<sub>model</sub>)
                  </th>
                  <th class="py-2.5 pr-4 font-semibold">
