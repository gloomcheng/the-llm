          !pointFewshot ||
          !stat0shot ||
          !statFewshot ||
          !statGain ||
          !narrativeText
        )
          return;

        benchTitle.textContent = bench.title;
        const curModel = modelSizes[currentModelIndex];
        modelBadge.textContent = `${curModel.name} (${curModel.params}, ${curModel.layers} 層)`;

        function accToY(acc: number): number {
          return 210 - (acc / 100) * 180;
        }

        const pts0 = xCoords.map((x, i) => `${x},${accToY(bench.zeroShot[i])}`).join(' ');
        const ptsFew = xCoords.map((x, i) => `${x},${accToY(bench.fewShot[i])}`).join(' ');

        line0shot.setAttribute('points', pts0);
        lineFewshot.setAttribute('points', ptsFew);

        const activeX = xCoords[currentModelIndex];
        const cur0Y = accToY(bench.zeroShot[currentModelIndex]);
        const curFewY = accToY(bench.fewShot[currentModelIndex]);

        cursorLine.setAttribute('x1', activeX.toString());
        cursorLine.setAttribute('x2', activeX.toString());

        point0shot.setAttribute('cx', activeX.toString());
        point0shot.setAttribute('cy', cur0Y.toString());

        pointFewshot.setAttribute('cx', activeX.toString());
        pointFewshot.setAttribute('cy', curFewY.toString());

        const val0 = bench.zeroShot[currentModelIndex];
        const valFew = bench.fewShot[currentModelIndex];
        const gain = valFew - val0;

        stat0shot.textContent = `${val0.toFixed(1)}%`;
        statFewshot.textContent = `${valFew.toFixed(1)}%`;
        statGain.textContent = `+${gain.toFixed(1)}%`;

        narrativeText.textContent = bench.narrative(currentModelIndex);
      }

      if (benchContainer) {
        benchContainer.innerHTML = '';
        Object.keys(scaleBenchmarks).forEach((key, idx) => {
          const b = scaleBenchmarks[key];
          const btn = document.createElement('button');
          btn.type = 'button';
          btn.className =
            idx === 0
              ? 'px-3 py-1.5 font-mono text-xs font-bold border-2 border-red bg-red text-surface transition cursor-pointer'
              : 'px-3 py-1.5 font-mono text-xs font-medium border border-ink/40 bg-surface text-ink hover:border-ink hover:bg-paper transition cursor-pointer';
          btn.textContent = b.label;
          btn.addEventListener('click', () => {
            activeBenchId = key;
            Array.from(benchContainer.children).forEach((c) => {
              (c as HTMLElement).className =
                'px-3 py-1.5 font-mono text-xs font-medium border border-ink/40 bg-surface text-ink hover:border-ink hover:bg-paper transition cursor-pointer';
            });
            btn.className =
              'px-3 py-1.5 font-mono text-xs font-bold border-2 border-red bg-red text-surface transition cursor-pointer';
            renderScaleLab();
          });
          benchContainer.appendChild(btn);
        });
      }

      if (modelSlider) {
        modelSlider.addEventListener('input', (e) => {
          currentModelIndex = parseInt((e.target as HTMLInputElement).value, 10);
          renderScaleLab();
        });
      }

      renderScaleLab();
    }

    if (document.readyState === 'loading') {
      document.addEventListener('DOMContentLoaded', initGpt3Lab);
    } else {
      initGpt3Lab();
    }
  </script>
</BaseLayout>
