  <script>
    function initGpt3Lab() {
      // 1. Tab Switching
      const tabIcl = document.getElementById('gpt3-tab-icl');
      const tabScale = document.getElementById('gpt3-tab-scale');
      const panelIcl = document.getElementById('gpt3-panel-icl');
      const panelScale = document.getElementById('gpt3-panel-scale');

      if (!tabIcl || !tabScale || !panelIcl || !panelScale) return;

      tabIcl.addEventListener('click', () => {
        tabIcl.setAttribute('aria-selected', 'true');
