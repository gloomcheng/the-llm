---
import BaseLayout from '../../layouts/BaseLayout.astro';
import { withBase } from '../../lib/paths';
import PaperMeta from '../../components/PaperMeta.astro';
import PaperReadingLayout from '../../components/PaperReadingLayout.astro';
import Icon from '../../components/Icon.astro';
import PaperNavigation from '../../components/PaperNavigation.astro';
import StoryRail from '../../components/StoryRail.astro';
import EvidenceList from '../../components/EvidenceList.astro';
import { milestonePapers } from '../../content/papers/milestones';
import { shannonTimelineEpochs } from '../../content/papers/a-mathematical-theory-of-communication';

const paper = milestonePapers.find((p) => p.id === 'a-mathematical-theory-of-communication')!;
const shell = 'mx-auto w-[calc(100%-2rem)] max-w-[1120px]';

const story = [
  {
    year: '之前',
    label: '混沌 / THE VOID',
    title: '資訊是哲學，不是數學。',
    body: '「資訊」只是一個模糊的概念，沒有人知道一條電報線能承載多少「意思」，也沒有數學工具能回答這個問題。',
    status: 'past' as const,
  },
  {
    year: '1948',
    label: '論文 / THE PAPER',
    title: 'Shannon 把資訊變成數字。',
    body: '用「熵」定義資訊量，用馬可夫鏈建出第一個統計語言模型，奠定整個資訊時代的數學基礎。',
    status: 'current' as const,
  },
  {
    year: '之後',
    label: '遺產 / THE LEGACY',
    title: 'Cross-Entropy Loss，七十年後仍是同一條公式。',
    body: '每一個現代語言模型訓練時最佳化的目標，正是 Shannon 1948 年寫下的熵的變形。',
    status: 'future' as const,
  },
];
---

<BaseLayout
  title="A Mathematical Theory of Communication — Shannon 1948"
  section="paper"
  description="用繁體中文拆解 Shannon 1948 年的資訊理論論文：資訊熵、馬可夫語言模型，以及它如何成為現代大語言模型 Cross-Entropy Loss 的根源。"
>
  <article>
    <header class={`${shell} pt-10`}>
      <div class="flex gap-3 font-mono text-sm uppercase tracking-[0.08em] text-muted">
        <a class="text-red underline underline-offset-4" href={withBase('/')}>
          THE LLM
        </a>
        <span aria-hidden="true">/</span>
        <span>序章 / VOL. 00</span>
      </div>

      <div class="grid grid-cols-1 items-end gap-12 py-16 lg:grid-cols-[1.15fr_0.85fr] lg:gap-24">
        <div>
          <p class="mb-5 font-mono text-sm font-semibold uppercase tracking-[0.12em] text-red">
            PROLOGUE / THE GENESIS OF INFORMATION
          </p>
          <h1 class="m-0 font-display text-5xl sm:text-6xl lg:text-7xl leading-none tracking-[-0.05em]">
            <span class="block">A Mathematical</span>
            <em class="block">Theory of Communication.</em>
          </h1>
          <p class="mt-8 max-w-[52ch] text-lg leading-8 text-muted">
            從現代網路通訊協定到大型語言模型，背後均依託於一個在 1948
            年之前未曾被嚴格量化的核心問題：「資訊」到底是什麼？它能否被精確度量？Shannon
            在這篇論文裡首次給出嚴謹的數學定義，奠定了現代數位文明與今日語言模型訓練損失函數的基石。
          </p>
        </div>
        <aside
          class="border-t-4 border-red bg-surface p-6 shadow-editorial"
          aria-label="這篇論文的一句評語"
        >
          <p class="mb-6 font-mono text-sm font-semibold uppercase tracking-[0.12em] text-red">
            一句評語 / THE SHORT VERDICT
          </p>
          <p class="m-0 max-w-[20ch] font-display text-3xl leading-tight">
            這篇論文把「資訊」從哲學問題變成了可計算的數字。
          </p>
          <p class="mt-6 mb-0 text-base leading-7 text-muted">
            Shannon 的原始任務是解決電報雜訊問題，不是設計語言模型。
          </p>
        </aside>
      </div>

      <PaperMeta
        year={paper.year}
        venue={paper.venue}
        readTime="20 分鐘"
        difficulty="核心概念"
        doi={{
          value: '10.1002/j.1538-7305.1948.tb01338.x',
          url: 'https://doi.org/10.1002/j.1538-7305.1948.tb01338.x',
        }}
      />
      <div class="flex flex-wrap items-center justify-between gap-y-3 py-4 font-mono text-sm uppercase tracking-[0.04em] text-muted">
        <div class="flex flex-wrap items-center gap-x-6 gap-y-2">
          <span>原始論文</span>
          <a
            class="underline underline-offset-4 hover:text-red"
            href="https://people.math.harvard.edu/~ctm/home/text/others/shannon/entropy/entropy.pdf"
            target="_blank"
            rel="noreferrer"
            aria-label="在 Bell System Technical Journal 閱讀原始論文（在新分頁開啟）"
          >
            在 BSTJ 閱讀 ↗
          </a>
        </div>
        <div class="flex items-center gap-2 text-xs sm:text-sm">
          <span class="text-muted">下一篇：</span>
          <a
            href={withBase('/papers/attention-is-all-you-need')}
            class="font-semibold text-red underline underline-offset-4 hover:text-ink transition-colors"
            aria-label="跳轉至：Attention Is All You Need"
          >
            Transformer ↗
          </a>
        </div>
      </div>
    </header>

    <!-- WHY：問題從哪裡來 -->
    <section
      class={`${shell} border-t border-ink py-16 sm:py-20 lg:py-24`}
      aria-labelledby="why-title"
    >
      <div class="max-w-none">
        <div>
          <p class="mb-4 font-mono text-sm font-semibold uppercase tracking-[0.12em] text-red">
            章節 01 · 物理困境與資訊定義 / THE IMPASSE
          </p>
          <h2
            id="why-title"
            class="m-0 font-display text-4xl sm:text-5xl lg:text-6xl xl:text-7xl leading-tight tracking-[-0.04em] text-balance"
          >
            <span class="inline-block">「資訊」</span>
            <span class="inline-block">
              能被<em>量化嗎？</em>
            </span>
          </h2>
          <p class="mt-6 max-w-2xl font-sans text-lg sm:text-xl leading-relaxed text-muted text-pretty">
            1948
            年之前，這個問題沒有答案。工程師只知道電報線路會有雜訊，訊號會失真——但「一條線路到底能承載多少資訊」，從來沒有人能用數學說清楚。
          </p>
        </div>

        <PaperReadingLayout class="mt-12 text-base leading-8 text-muted">
          <div class="min-w-0 max-w-2xl">
            <p class="mb-10">
              在 1948 年，電報（Telegraph）是全世界跨越地理距離傳遞訊息的最尖端通訊技術。
            </p>
            <p class="mb-10">
              電報的運作方式非常原始：它是一根跨越城市、甚至沉在大西洋底下的實體金屬銅線。你沒辦法把「文字」或「語音」直接扔進銅線裡，只能由發報員用手指敲擊電鍵開關，將直流電接通與斷開，在線路上產生長短不一的微弱電脈衝——短的叫「點（・）」，長三倍的叫「劃（—）」，這就是摩斯密碼（Morse
              code）。
            </p>
            <p class="mb-10">
              發一封電報極為昂貴，是按字計費的；更致命的難題是<strong>實體雜訊（Noise）</strong>
              ：數百公里的長途電線暴露在雷雨、大氣電磁干擾與金屬導線本身的熱噪聲中。發報端敲出乾淨俐落的短脈衝「點」，經過數百公里衰減與雜訊干擾，傳到接收端時可能已經變成一團鋸齒毛刺。接收員的電磁鐵若稍有誤判，就會把「點」當成「劃」，全句意思徹底走樣。
            </p>

            <!-- 圖 01：電報脈衝波形與雜訊判決圖 -->
            <figure
              class="my-10 border border-ink bg-surface p-6 sm:p-8"
              role="img"
              aria-labelledby="shannon-waveform-title"
            >
              <div class="mb-4 flex items-center justify-between">
                <p class="m-0 font-mono text-xs font-semibold uppercase tracking-[0.12em] text-red">
                  圖 01 / FIGURE 1
                </p>
                <span class="font-mono text-xs text-muted">實體雜訊與位元翻轉</span>
              </div>
              <p id="shannon-waveform-title" class="m-0 font-display text-2xl font-bold text-ink">
                長途銅線上的雜訊干擾與位元判決
              </p>
              <figcaption class="mt-2 mb-6 max-w-xl text-sm leading-relaxed text-muted">
                發報員發出的純淨高低電位方波（點與劃），在穿越數百公里銅線時受到金屬熱噪聲與大氣電磁干擾，疊加鋸齒狀毛刺。接收端電磁鐵依靠固定電壓閾值判斷，當雜訊峰值衝破閾值時，便會產生將「空」誤判為「點」的致命位元翻轉（Bit
                Flip）。
              </figcaption>
              <svg class="block h-auto w-full" viewBox="0 0 680 320" role="img" aria-hidden="true">
                <!-- Track 1: 發送端乾淨方波 -->
                <text
                  x="20"
                  y="38"
                  fill="#1e2224"
                  font-family="LINE Seed TW, sans-serif"
                  font-weight="700"
                  font-size="12"
                >
                  1. 發送端：純淨電壓脈衝（摩斯碼）
                </text>
                <line x1="20" y1="90" x2="660" y2="90" stroke="#d6cec0" stroke-width="1"></line>
                <path
                  d="M 20 90 L 80 90 L 80 55 L 140 55 L 140 90 L 220 90 L 220 55 L 360 55 L 360 90 L 440 90 L 440 55 L 500 55 L 500 90 L 660 90"
                  fill="none"
                  stroke="#1e2224"
                  stroke-width="2.5"
                ></path>
                <text
                  x="110"
                  y="74"
                  text-anchor="middle"
                  fill="#b6412c"
                  font-family="LINE Seed TW, sans-serif"
                  font-weight="700"
                  font-size="11"
                >
                  點 (・)
                </text>
                <text
                  x="290"
                  y="74"
                  text-anchor="middle"
                  fill="#b6412c"
                  font-family="LINE Seed TW, sans-serif"
                  font-weight="700"
                  font-size="11"
                >
                  劃 (—)
                </text>
                <text
                  x="470"
                  y="74"
                  text-anchor="middle"
                  fill="#b6412c"
                  font-family="LINE Seed TW, sans-serif"
                  font-weight="700"
                  font-size="11"
                >
                  點 (・)
                </text>

                <!-- Track 2: 銅線傳輸與高斯熱雜訊 -->
                <text
                  x="20"
                  y="140"
                  fill="#355b70"
                  font-family="LINE Seed TW, sans-serif"
                  font-weight="700"
                  font-size="12"
                >
                  2. 銅線傳輸：衰減＋隨機熱雜訊疊加
                </text>
                <line x1="20" y1="190" x2="660" y2="190" stroke="#d6cec0" stroke-width="1"></line>
                <path
                  d="M 20 190 Q 35 188 50 192 T 80 188 L 82 165 Q 95 160 110 168 T 138 162 L 142 188 Q 160 194 180 187 T 218 191 L 222 163 Q 250 158 290 166 T 358 161 L 362 189 Q 390 193 410 186 T 438 192 L 442 165 Q 460 159 475 166 T 498 163 L 502 189 Q 530 192 560 187 T 590 158 T 620 191 L 660 190"
                  fill="none"
                  stroke="#355b70"
                  stroke-width="2"
                ></path>
                <circle cx="590" cy="158" r="4" fill="#b6412c"></circle>
                <text
                  x="590"
                  y="145"
                  text-anchor="middle"
                  fill="#b6412c"
                  font-family="LINE Seed TW, sans-serif"
                  font-size="10"
                >
                  突發雜訊峰值
                </text>

                <!-- Track 3: 接收端閾值判決 -->
                <text
                  x="20"
                  y="235"
                  fill="#1e2224"
                  font-family="LINE Seed TW, sans-serif"
                  font-weight="700"
                  font-size="12"
                >
                  3. 接收端判決：電磁鐵電壓閾值（超過虛線判定為訊號）
                </text>
                <line
                  x1="20"
                  y1="268"
                  x2="660"
                  y2="268"
                  stroke="#b6412c"
                  stroke-width="1.5"
                  stroke-dasharray="4,4"
                ></line>
                <text
                  x="655"
                  y="262"
                  text-anchor="end"
                  fill="#b6412c"
                  font-family="LINE Seed TW, sans-serif"
                  font-size="10"
                >
                  判決閾值 Vth
                </text>
                <rect x="80" y="278" width="60" height="26" fill="#1e2224"></rect>
                <text
                  x="110"
                  y="295"
                  text-anchor="middle"
                  fill="#ffffff"
                  font-family="LINE Seed TW, sans-serif"
                  font-size="12"
                >
                  判為 1 (點)
                </text>

                <rect x="220" y="278" width="140" height="26" fill="#1e2224"></rect>
                <text
                  x="290"
                  y="295"
                  text-anchor="middle"
                  fill="#ffffff"
                  font-family="LINE Seed TW, sans-serif"
                  font-size="12"
                >
                  判為 1 (劃)
                </text>

                <rect x="440" y="278" width="60" height="26" fill="#1e2224"></rect>
                <text
                  x="470"
                  y="295"
                  text-anchor="middle"
                  fill="#ffffff"
                  font-family="LINE Seed TW, sans-serif"
                  font-size="12"
                >
                  判為 1 (點)
                </text>

                <rect x="565" y="278" width="50" height="26" fill="#b6412c"></rect>
                <text
                  x="590"
                  y="295"
                  text-anchor="middle"
                  fill="#ffffff"
                  font-family="LINE Seed TW, sans-serif"
                  font-size="11"
                >
                  翻轉！(誤判)
                </text>
              </svg>
            </figure>

            <p class="mb-10">
              這就是 Claude Shannon 當年在貝爾實驗室（AT&T Bell
              Labs）面對的現實工程問題：若要在城市之間架設一條長途電報線，工程師的核心挑戰在於：面對不可避免的線路雜訊干擾，這條實體通道在物理極限下到底能傳輸多少真實資訊？
            </p>
            <p class="mb-10">
              已知線路每秒能發送多少脈衝，也已知雜訊電壓幅度，但「資訊量」本身到底是什麼？一封通報「明天下雨」的電報，和一封通報「明天晴天」的電報，帶有一樣多的資訊嗎？在經常降雨的氣候條件下，「明天下雨」所帶來的驚喜程度極低；而若出現罕見的「晴天」，其所消除的不確定性顯然遠大於前者。
            </p>
            <p class="mb-10">
              但這種「驚喜程度」要怎麼變成一個精確的數學數字？在 Shannon 之前，沒有人知道答案。
            </p>

            <div class="mb-10 border-y-2 border-red bg-red/5 px-5 py-6 sm:px-7">
              <p class="m-0 text-base leading-8 text-ink">
                <strong>
                  這是 Shannon
                  要解決的核心問題：給「資訊的多少」一個嚴謹的數學定義，讓工程師可以計算、設計、最佳化通訊系統。
                </strong>
              </p>
            </div>
          </div>

          <aside
            class="border-t-4 border-blue bg-blue/5 p-6 sm:p-8"
            aria-labelledby="context-title"
            slot="rail"
          >
            <p class="m-0 font-mono text-sm font-semibold uppercase tracking-[0.12em] text-blue">
              歷史背景 / CONTEXT
            </p>
            <h3 id="context-title" class="mt-4 mb-6 font-display text-3xl leading-tight">
              Bell Labs, 1948
            </h3>
            <dl class="grid gap-4 border-t border-blue/30 pt-5 text-base leading-8">
              <div>
                <dt class="font-mono text-sm text-blue">時代背景</dt>
                <dd class="m-0 text-muted">
                  二戰剛結束，電報與無線電通訊需求爆炸性成長，如何在有雜訊的線路上可靠傳輸資訊是最迫切的工程問題。
                </dd>
              </div>
              <div>
                <dt class="font-mono text-sm text-blue">前人工作</dt>
                <dd class="m-0 text-muted">
                  Nyquist（1928）與
                  Hartley（1928）已提出通道容量的初步概念，但未考慮訊號機率分佈的影響。
                </dd>
              </div>
              <div>
                <dt class="font-mono text-sm text-blue">Shannon 的突破</dt>
                <dd class="m-0 text-muted">
                  把「機率」引入資訊的定義，徹底完成了前人未完成的工作，並順手建出了語言的統計模型。
                </dd>
              </div>
            </dl>
          </aside>
        </PaperReadingLayout>

        <!-- 圖 02：Shannon 通用通訊系統架構 (1948 電報 ↔ 現代 LLM 對照) -->
        <figure
          class="my-16 w-full border border-ink bg-surface p-6 sm:p-10 shadow-sm"
          role="img"
          aria-labelledby="shannon-fig2-title"
        >
          <div class="mb-4 flex flex-col gap-2 sm:flex-row sm:items-center sm:justify-between border-b border-line pb-4">
            <div>
              <p class="m-0 font-mono text-xs font-semibold uppercase tracking-[0.12em] text-red">
                圖 02 / FIGURE 2
              </p>
              <p
                id="shannon-fig2-title"
                class="mt-1 m-0 font-display text-2xl sm:text-3xl font-bold text-ink"
              >
                Shannon 通用通訊系統架構
              </p>
            </div>
            <span class="font-mono text-xs text-muted">1948 電報銅線 ↔ 2024 LLM 運算鏈</span>
          </div>

          <figcaption class="mt-2 mb-8 max-w-3xl text-sm leading-relaxed text-muted">
            Shannon 在論文開篇提出的經典通訊模型：全世界所有通訊系統（從 1948
            年二戰電報銅線到今日大語言模型的 Prompt 與 Token
            生成）均可抽象為這條五段式的數學轉換鏈。下圖將 1948
            年實體通訊環節與現代語言模型的推論路徑逐段對照。
          </figcaption>

          <!-- 5-Column Responsive Cards -->
          <div class="grid grid-cols-1 gap-4 md:grid-cols-3 lg:grid-cols-5 items-stretch">
            <!-- Node 1: 資訊來源 -->
            <div class="flex flex-col justify-between border border-ink bg-paper-deep p-5">
              <div>
                <div class="flex items-center justify-between">
                  <span class="font-mono text-xs font-bold text-muted">01 / STAGE</span>
                  <span class="border border-ink/30 bg-surface px-1.5 py-0.5 font-mono text-xs font-semibold uppercase text-ink">
                    Source
                  </span>
                </div>
                <h4 class="mt-3 mb-2 font-display text-xl font-bold text-ink">資訊來源</h4>
                <p class="m-0 text-sm text-muted">產生想傳遞的原始訊息</p>
              </div>
              <div class="mt-6 border-t border-line pt-3 space-y-2 text-xs">
                <div>
                  <span class="font-mono font-semibold text-blue">1948 電報：</span>
                  <p class="m-0 text-muted">發報者大腦想說的文字（如「明天下雨」）</p>
                </div>
                <div>
                  <span class="font-mono font-semibold text-red">2024 LLM：</span>
                  <p class="m-0 text-muted">使用者輸入的 Prompt 與任務意圖</p>
                </div>
              </div>
            </div>

            <!-- Node 2: 發送器 -->
            <div class="flex flex-col justify-between border border-ink bg-paper-deep p-5">
              <div>
                <div class="flex items-center justify-between">
                  <span class="font-mono text-xs font-bold text-muted">02 / STAGE</span>
                  <span class="border border-ink/30 bg-surface px-1.5 py-0.5 font-mono text-xs font-semibold uppercase text-ink">
                    Transmitter
                  </span>
                </div>
                <h4 class="mt-3 mb-2 font-display text-xl font-bold text-ink">發送器</h4>
                <p class="m-0 text-sm text-muted">將訊息編碼為通道實體訊號</p>
              </div>
              <div class="mt-6 border-t border-line pt-3 space-y-2 text-xs">
                <div>
                  <span class="font-mono font-semibold text-blue">1948 電報：</span>
                  <p class="m-0 text-muted">電鍵開關（轉成高低電位直流脈衝）</p>
                </div>
                <div>
                  <span class="font-mono font-semibold text-red">2024 LLM：</span>
                  <p class="m-0 text-muted">Tokenizer 與 Word Embedding（轉成數值向量）</p>
                </div>
              </div>
            </div>

            <!-- Node 3: 通訊通道 -->
            <div class="flex flex-col justify-between border-2 border-red bg-red-soft p-5 relative">
              <div>
                <div class="flex items-center justify-between">
                  <span class="font-mono text-xs font-bold text-red">03 / STAGE</span>
                  <span class="border border-red bg-surface px-1.5 py-0.5 font-mono text-xs font-bold uppercase text-red">
                    Channel
                  </span>
                </div>
                <h4 class="mt-3 mb-2 font-display text-xl font-bold text-ink">通訊通道</h4>
