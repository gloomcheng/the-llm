                    XFOML RXKHRJFFJUJ ZLPWCFWKCYJ FFJEYVKCQSGHYD QPAAMKBZAACIBZLHJQD
                  </div>
                </div>
              </div>

              <!-- Right: Next-Token Candidate Probability (5 cols) -->
              <div class="lg:col-span-5 border border-ink bg-surface p-5 sm:p-6 space-y-4">
                <div class="border-b border-line pb-3">
                  <span class="font-mono text-xs font-semibold uppercase tracking-[0.1em] text-red">
                    NEXT-TOKEN PROBABILITY / 條件轉移機率
                  </span>
                  <h4
                    id="shannon-candidate-title"
                    class="mt-1 m-0 font-display text-xl font-bold text-ink"
                  >
                    候選分佈：下一個字符的機率抽樣
                  </h4>
                </div>

                <p class="m-0 text-sm leading-relaxed text-muted">
                  此處展示馬可夫鏈在目前狀態下，根據轉移機率矩陣計算出的 Top 候選抽樣池：
                </p>

                <!-- Candidate probability bars -->
                <div id="shannon-candidates-container" class="space-y-2.5 pt-2"></div>

                <div class="border-t border-line pt-4">
                  <p class="m-0 font-mono text-xs font-bold text-ink mb-1">歷史意義：</p>
                  <p id="shannon-order-desc" class="m-0 text-sm leading-relaxed text-muted">
                    完全獨立同分佈，無任何語意或前後關聯。這證明了若無統計條件約制，符號僅為純隨機雜訊。
                  </p>
                </div>
              </div>
            </div>
          </div>
        </figure>

        <script>
          // ==================== Module 1: Entropy State & Logic ====================
          let currentProb = 0.5;

          function calcEntropy(p: number): number {
            if (p <= 0 || p >= 1) return 0;
            return -p * Math.log2(p) - (1 - p) * Math.log2(1 - p);
          }

          function renderEntropy() {
            const p = currentProb;
            const q = 1 - p;
            const h = calcEntropy(p);

            const probVal = document.getElementById('shannon-prob-val');
            const qVal = document.getElementById('shannon-q-val');
            const cardProbA = document.getElementById('shannon-card-prob-a');
            const cardInfoA = document.getElementById('shannon-card-info-a');
            const cardProbB = document.getElementById('shannon-card-prob-b');
            const cardInfoB = document.getElementById('shannon-card-info-b');
            const cardTotalH = document.getElementById('shannon-card-total-entropy');
            const narrative = document.getElementById('shannon-entropy-narrative');
            const curveDot = document.getElementById('shannon-curve-dot');

            if (probVal) probVal.textContent = p.toFixed(2);
            if (qVal) qVal.textContent = q.toFixed(2);
            if (cardProbA) cardProbA.textContent = `機率 p = ${p.toFixed(2)}`;
            if (cardInfoA) cardInfoA.textContent = `${(-Math.log2(p)).toFixed(3)} bit`;
            if (cardProbB) cardProbB.textContent = `機率 1−p = ${q.toFixed(2)}`;
            if (cardInfoB) cardInfoB.textContent = `${(-Math.log2(q)).toFixed(3)} bit`;
            if (cardTotalH) cardTotalH.textContent = `${h.toFixed(3)} bit`;

            // Update SVG dot: x from 50 (p=0) to 450 (p=1), y from 160 (H=0) to 30 (H=1)
            if (curveDot) {
              const cx = 50 + p * 400;
              const cy = 160 - h * 130;
              curveDot.setAttribute('cx', cx.toString());
              curveDot.setAttribute('cy', cy.toString());
            }

            if (narrative) {
              if (Math.abs(p - 0.5) < 0.05) {
                narrative.textContent =
                  '當 p = 0.5 時，正反面出現機會均等，系統處於最大懸念狀態（H = 1.0 bit）。傳送端無法做任何無損壓縮，接收端每次收到結果都獲得最完整的資訊量。這也是語言模型對下一個 token 完全無法確定時的最大損失狀態。';
              } else if (p > 0.85) {
                narrative.textContent = `當 p = ${p.toFixed(2)} 時，正面極為常見，每次出現正面僅帶來微小的驚訝度（${(-Math.log2(p)).toFixed(2)} bit）；但若出現反面，驚訝度飆升至 ${(-Math.log2(q)).toFixed(2)} bit！整體平均資訊熵降至 ${h.toFixed(2)} bit，具備極高的壓縮空間。`;
              } else if (p < 0.15) {
                narrative.textContent = `當正面機率僅為 ${p.toFixed(2)} 時，反面是壓倒性常態，平均資訊熵為 ${h.toFixed(2)} bit。這等同於語言模型已經極度篤定目標詞彙，交叉熵損失逼近於零。`;
              } else {
                narrative.textContent = `在 p = ${p.toFixed(2)} 下，期望資訊熵為 ${h.toFixed(3)} bit。依照 Shannon 第一編碼定理，每個符號在理論上只需 ${h.toFixed(3)} 個二進位位元即可無損編碼傳輸。`;
              }
            }
          }

          function initEntropyCurve() {
            const path = document.getElementById('shannon-curve-path');
            if (!path) return;
            let d = 'M ';
            for (let i = 1; i <= 99; i++) {
              const p = i / 100;
              const h = calcEntropy(p);
              const x = 50 + p * 400;
              const y = 160 - h * 130;
              d += `${x.toFixed(1)} ${y.toFixed(1)} `;
              if (i === 1) d += 'L ';
            }
            path.setAttribute('d', d);
          }

          // ==================== Module 2: Markov Language Generator ====================
          type MarkovOrder = '0' | '1' | '2' | '3' | 'word2';
          let currentOrder: MarkovOrder = '0';

          const samplePools: Record<
            MarkovOrder,
            { samples: string[]; desc: string; candidates: { tok: string; prob: number }[] }
          > = {
            '0': {
              samples: [
                'XFOML RXKHRJFFJUJ ZLPWCFWKCYJ FFJEYVKCQSGHYD QPAAMKBZAACIBZLHJQD',
                'WZKTV BQGZX PLKJMN OIUYTRE WASDFGH JKLMNB VCXZQWE RTYUIOPLKJH GFDS',
                'MQZBN XCVTR YUIOPH JKLGFD SAWEQMN BVCXZLK JHGTRFD EWQASZX CVBNMKJ',
              ],
              desc: '完全獨立同分佈，26 個英文字母以 1/26 等機率隨機挑選。無任何音節結構，純粹為符號雜訊。',
              candidates: [
                { tok: 'E', prob: 0.038 },
                { tok: 'T', prob: 0.038 },
                { tok: 'A', prob: 0.038 },
                { tok: 'Q', prob: 0.038 },
                { tok: 'Z', prob: 0.038 },
              ],
            },
            '1': {
              samples: [
                'OCRO HLI RGWR NMIELWIS EU LL NBNESEBYA TH EEI ALHENHTTPA OOBTTVA NAH BRL',
                'TEOAN ISER TAH TEE EOIN SHRDLU ETAOIN SHRDLU ETAN ORSE TNIS EATO INSE',
                'EATINO RSHDLC UMPFGY WKVXZJ Q EATIN ORSHD LCUMPF GY WKVXZ JQ EATINO',
              ],
              desc: '依據真實英文單字母頻率抽樣（E 佔 12.7%、T 佔 9.1%）。母音與常用子音顯著增加，開始具有英文輪廓，但尚未形成合法單詞。',
              candidates: [
                { tok: 'E', prob: 0.127 },
                { tok: 'T', prob: 0.091 },
                { tok: 'A', prob: 0.082 },
                { tok: 'O', prob: 0.075 },
                { tok: 'I', prob: 0.07 },
              ],
            },
            '2': {
              samples: [
                'ON IE ANTSOUTINYS ARE T INCTORE ST BE S DEAMY ACHIN D ILONASIVE TUCOOWE AT',
                'TH IS W AS TH AT TH ER E FO R AN D IN G CO M P AN Y TH E PR O B LEM',
                'HE RE IS TH E RES UL T OF TH E CO ND IT IO N AL PR OB AB IL IT Y ST AT E',
              ],
              desc: '看前 1 個字母決定下一個字母：P(cₜ | cₜ₋₁)。開始大量湧現合法的發音雙字母組與音節（如 ON, TH, ARE, IN）。',
              candidates: [
                { tok: 'H (接在 T 後)', prob: 0.385 },
                { tok: 'O (接在 T 後)', prob: 0.142 },
                { tok: 'E (接在 T 後)', prob: 0.118 },
                { tok: 'I (接在 T 後)', prob: 0.085 },
                { tok: 'R (接在 T 後)', prob: 0.062 },
              ],
            },
            '3': {
              samples: [
                'IN NO IST LAT WHEY CRATICT FROURE BIRS GROCID PONDENOME OF DEMONSTURES OF THE REPTATION',
                'THE GENERATION OF ENGLISH WORDS IS INTRODUCED BY THE MARKOV CHAIN EXPERIMENT IN 1948',
                'EVERY LETTER IS DEPENDENT ON THE PRECEDING TWO LETTERS FORMING PSEUDO WORDS',
              ],
              desc: '看前 2 個字母決定下一個字母：P(cₜ | cₜ₋₁, cₜ₋₂)。合法的英文詞綴（-TION, -ING, THE）奇蹟般成型，讀起來宛如未知的真實歐洲語言！',
              candidates: [
                { tok: 'E (接在 TH 後)', prob: 0.62 },
                { tok: 'A (接在 TH 後)', prob: 0.15 },
                { tok: 'I (接在 TH 後)', prob: 0.11 },
                { tok: 'O (接在 TH 後)', prob: 0.055 },
                { tok: 'R (接在 TH 後)', prob: 0.035 },
              ],
            },
            word2: {
              samples: [
                'THE HEAD AND IN FRONTAL ATTACK ON AN ENGLISH WRITER THAT THE CHARACTER OF THIS POINT IS THEREFORE ANOTHER METHOD FOR THE LETTERS',
                'A MATHEMATICAL THEORY OF COMMUNICATION ESTABLISHED THE FOUNDATION OF MODERN INFORMATION SCIENCE AND NATURAL LANGUAGE PROCESSING',
                'THE MODEL PREDICTS THE NEXT TOKEN ACCORDING TO THE PROBABILITY DISTRIBUTION DERIVED FROM LARGE SCALE TRAINING DATA',
              ],
              desc: '看前 1 個詞預測下一個詞：P(wₜ | wₜ₋₁)。語法主謂、冠詞與介系詞結構完全湧現！這正是今日大語言模型自迴歸生成（Next-Token Prediction）的最早原型。',
              candidates: [
                { tok: 'MODEL (接在 THE 後)', prob: 0.28 },
                { tok: 'INFORMATION (接在 THE 後)', prob: 0.22 },
                { tok: 'NEXT (接在 THE 後)', prob: 0.19 },
                { tok: 'LETTERS (接在 THE 後)', prob: 0.12 },
                { tok: 'FIRST (接在 THE 後)', prob: 0.09 },
              ],
            },
          };

          function renderMarkov() {
            const data = samplePools[currentOrder];
            const outputText = document.getElementById('shannon-output-text');
            const orderBadge = document.getElementById('shannon-order-badge');
            const orderDesc = document.getElementById('shannon-order-desc');
            const candidateContainer = document.getElementById('shannon-candidates-container');
            const genStatus = document.getElementById('shannon-gen-status');

            if (!data || !outputText || !orderBadge || !orderDesc || !candidateContainer) return;

            // Pick a random sample from pool
            const randomSample = data.samples[Math.floor(Math.random() * data.samples.length)];
            outputText.textContent = randomSample;

            const badgeNames: Record<MarkovOrder, string> = {
              '0': '0 階：26 字母等機率',
              '1': '1 階：單字母真實頻率',
              '2': '2 階：雙字母條件轉移',
              '3': '3 階：三字母條件轉移',
              word2: '詞級雙詞轉移 (Word Bigram)',
            };
            orderBadge.textContent = badgeNames[currentOrder];
            orderDesc.textContent = data.desc;
            if (genStatus) genStatus.textContent = '生成完畢！';

            // Render candidate probability bars
            candidateContainer.innerHTML = '';
            data.candidates.forEach((cand, idx) => {
              const row = document.createElement('div');
              row.className =
                'grid grid-cols-[7rem_1fr_3.5rem] items-center gap-2 text-xs font-mono';

              const label = document.createElement('div');
              label.className = idx === 0 ? 'font-bold text-red truncate' : 'text-ink truncate';
              label.textContent = cand.tok;

              const barTrack = document.createElement('div');
              barTrack.className =
                'h-4 w-full bg-paper-deep border border-line relative overflow-hidden';

              const barFill = document.createElement('div');
              const pct = (cand.prob * 100).toFixed(1);
              barFill.className = idx === 0 ? 'h-full bg-red' : 'h-full bg-blue/70';
              barFill.style.width = `${pct}%`;
              barTrack.appendChild(barFill);

              const pctLabel = document.createElement('div');
              pctLabel.className =
                idx === 0 ? 'font-bold text-red text-right' : 'text-muted text-right';
              pctLabel.textContent = `${pct}%`;

              row.appendChild(label);
              row.appendChild(barTrack);
              row.appendChild(pctLabel);
              candidateContainer.appendChild(row);
            });
          }

          // Setup Event Listeners
          function setupShannonLab() {
            // 1. Module switcher
            document.querySelectorAll<HTMLButtonElement>('.shannon-module-btn').forEach((btn) => {
              btn.addEventListener('click', () => {
                document.querySelectorAll('.shannon-module-btn').forEach((b) => {
                  b.setAttribute('aria-selected', 'false');
                  b.className =
                    'shannon-module-btn border border-ink bg-paper text-ink px-4 py-2 font-mono text-xs font-bold transition hover:bg-paper-deep cursor-pointer';
                });
                btn.setAttribute('aria-selected', 'true');
                btn.className =
                  'shannon-module-btn border border-ink bg-ink text-surface px-4 py-2 font-mono text-xs font-bold transition hover:opacity-90 cursor-pointer';

                const mod = btn.dataset.module;
                const entropyMod = document.getElementById('shannon-module-entropy');
                const markovMod = document.getElementById('shannon-module-markov');
                if (entropyMod)
                  entropyMod.className = mod === 'entropy' ? 'mt-6 block' : 'mt-6 hidden';
                if (markovMod)
                  markovMod.className = mod === 'markov' ? 'mt-6 block' : 'mt-6 hidden';
              });
            });

            // 2. Entropy prob slider
            const slider = document.getElementById(
              'shannon-prob-slider',
            ) as HTMLInputElement | null;
            if (slider) {
              slider.addEventListener('input', () => {
                currentProb = parseFloat(slider.value);
                // Reset preset buttons styling
                document.querySelectorAll('.shannon-prob-btn').forEach((b) => {
                  b.className =
                    'shannon-prob-btn border border-ink bg-surface text-ink px-3 py-1.5 font-mono text-xs font-bold transition hover:bg-paper-deep cursor-pointer';
                });
                renderEntropy();
              });
            }

            // 3. Preset prob buttons
            document.querySelectorAll<HTMLButtonElement>('.shannon-prob-btn').forEach((btn) => {
              btn.addEventListener('click', () => {
                document.querySelectorAll('.shannon-prob-btn').forEach((b) => {
                  b.className =
                    'shannon-prob-btn border border-ink bg-surface text-ink px-3 py-1.5 font-mono text-xs font-bold transition hover:bg-paper-deep cursor-pointer';
                });
                btn.className =
                  'shannon-prob-btn border border-ink bg-ink text-surface px-3 py-1.5 font-mono text-xs font-bold transition cursor-pointer';

                const p = parseFloat(btn.dataset.prob || '0.5');
                currentProb = p;
                if (slider) slider.value = p.toString();
                renderEntropy();
              });
            });

            // 4. Markov order buttons
            document.querySelectorAll<HTMLButtonElement>('.shannon-order-btn').forEach((btn) => {
              btn.addEventListener('click', () => {
                document.querySelectorAll('.shannon-order-btn').forEach((b) => {
                  b.setAttribute('aria-pressed', 'false');
                  b.className =
                    'shannon-order-btn border border-ink bg-surface text-ink px-3 py-2 font-mono text-xs font-bold transition hover:bg-paper-deep cursor-pointer text-left';
                });
                btn.setAttribute('aria-pressed', 'true');
                btn.className =
                  'shannon-order-btn border border-ink bg-ink text-surface px-3 py-2 font-mono text-xs font-bold transition cursor-pointer text-left';

                currentOrder = (btn.dataset.order as MarkovOrder) || '0';
                renderMarkov();
              });
            });

            // 5. Generate button
            const genBtn = document.getElementById('shannon-generate-btn');
            if (genBtn) {
              genBtn.addEventListener('click', () => {
                renderMarkov();
              });
            }
          }

          // Initial Render
          initEntropyCurve();
          renderEntropy();
          renderMarkov();
          setupShannonLab();
        </script>
      </div>
    </section>

    <!-- WHAT：七十六年後的遺產 -->
    <section class={`${shell} border-t-2 border-ink py-16 sm:py-20`} aria-labelledby="what-title">
      <p class="mb-4 font-mono text-sm font-semibold uppercase tracking-[0.12em] text-red">
        章節 03 · 數位基石與當代損失函數 / THE LEGACY
      </p>
      <h2
        id="what-title"
        class="m-0 font-display text-4xl sm:text-5xl lg:text-6xl leading-tight tracking-[-0.04em] text-balance"
      >
        <span class="inline-block">Cross-Entropy Loss：</span>
        <span class="inline-block">
          <em>七十六年後，還是同一條公式</em>
        </span>
      </h2>
      <p class="mt-6 max-w-2xl font-sans text-lg sm:text-xl leading-relaxed text-muted text-pretty">
        今天你在 Google Colab 訓練一個語言模型，Jupyter Notebook 裡那行{' '}
        <code>loss = F.cross_entropy(...)</code>，它的數學根源就是 Shannon 1948 年寫下的 H 公式。
      </p>

      <PaperReadingLayout class="mt-14 text-base leading-8 text-muted">
        <div class="min-w-0 max-w-2xl">
          <h3 class="mb-8 font-display text-3xl leading-snug text-ink">
            從 Shannon Entropy 到 Cross-Entropy Loss
          </h3>
          <p class="mb-10">Shannon 的資訊熵：</p>
          <div class="mb-6 border-l-2 border-red pl-5 font-mono text-lg text-red">
            H(p) = −∑ p(x) · log p(x)
          </div>
          <p class="mb-10">這描述的是「真實語言分佈 p 的平均資訊量」。</p>
          <p class="mb-10">
            語言模型訓練時，我們有一個真實分佈 <code>p</code>（人類寫的文字）和一個模型的預測分佈{' '}
            <code>q</code>（模型認為下一個詞是什麼）。Cross-Entropy 衡量的是：用模型的{' '}
            <code>q</code> 來描述真實的 <code>p</code>，需要多少額外的 bit：
          </p>
          <div class="mb-6 border-l-2 border-red pl-5 font-mono text-lg text-red">
            H(p, q) = −∑ p(x) · log q(x)
          </div>
          <p class="mb-10">
            Cross-Entropy 越低 → 模型的預測分佈 <code>q</code> 越接近真實分佈 <code>p</code> →
            模型越好。這就是為什麼「最小化 Cross-Entropy
            Loss」等同於「讓模型的語言機率分佈逼近真實人類語言的機率分佈」。
          </p>

          <div class="mb-10 border-y-2 border-red bg-red/5 px-5 py-6 sm:px-7">
            <p class="m-0 text-base leading-8 text-ink">
              <strong>
                GPT、BERT、LLaMA——所有現代語言模型——訓練時每一步 backpropagation
                最佳化的那個數字，都是 Shannon 在 1948 年寫下的 H 公式的直接延伸。這個公式比
                transformer 架構早了 69 年。
              </strong>
            </p>
          </div>

          <h3 class="mb-8 mt-14 font-display text-3xl leading-snug text-ink">
            這篇論文還留下了什麼？
          </h3>
          <ul class="mb-10 space-y-4 list-none p-0">
            <li class="flex gap-4 border-b border-line pb-4">
              <span class="font-mono text-sm text-red shrink-0 pt-1">01</span>
              <div>
                <p class="m-0 font-semibold text-ink">整個資訊時代的數學地基</p>
                <p class="m-0 mt-1 text-muted">
                  從 Wi-Fi 協議、4G/5G 的通道編碼，到 JPEG 壓縮、zip 格式，全部建立在 Shannon
                  的通道容量定理和熵編碼理論上。
                </p>
              </div>
            </li>
            <li class="flex gap-4 border-b border-line pb-4">
              <span class="font-mono text-sm text-red shrink-0 pt-1">02</span>
              <div>
                <p class="m-0 font-semibold text-ink">「語言可以被機率建模」的數學依據</p>
                <p class="m-0 mt-1 text-muted">
                  Shannon
                  第一次嚴格地說：人類語言是一個有統計規律的隨機過程，可以用機率分佈來描述和生成。這讓後來所有語言模型有了合法的數學基礎。
                </p>
              </div>
            </li>
            <li class="flex gap-4 border-b border-line pb-4">
              <span class="font-mono text-sm text-red shrink-0 pt-1">03</span>
              <div>
                <p class="m-0 font-semibold text-ink">Perplexity：語言模型好壞的標準評估指標</p>
                <p class="m-0 mt-1 text-muted">
                  Perplexity（困惑度）= 2 的 Cross-Entropy 次方，直接來自 Shannon
                  Entropy。今天發表語言模型論文，一定要報告 perplexity，而 perplexity 就是 Shannon
                  1948 年那條 H 公式的直接後代。
                </p>
              </div>
            </li>
            <li class="flex gap-4 pb-4">
              <span class="font-mono text-sm text-red shrink-0 pt-1">04</span>
              <div>
                <p class="m-0 font-semibold text-ink">「Scaling」背後的資訊理論直覺</p>
                <p class="m-0 mt-1 text-muted">
                  為什麼訓練資料越多、模型越大，Cross-Entropy Loss
                  就越低？因為更多的訓練資料讓模型能更好地估計語言的真實分佈
                  p；更大的模型有能力逼近更複雜的 p。這個直覺直接來自 Shannon 對熵的定義。
                </p>
              </div>
            </li>
          </ul>
        </div>

        <aside
          class="border-t-4 border-ink bg-paper p-6 sm:p-8"
          aria-labelledby="legacy-title"
          slot="rail"
        >
          <p class="m-0 font-mono text-sm font-semibold uppercase tracking-[0.12em] text-blue">
            技術血緣 / LINEAGE
          </p>
          <h3 id="legacy-title" class="mt-4 mb-6 font-display text-2xl leading-tight">
            Shannon → 現代 LLM
          </h3>
          <dl class="grid gap-5 border-t border-line pt-5 text-sm leading-7">
            <div>
              <dt class="font-mono text-xs text-red uppercase font-bold">Shannon Entropy (1948)</dt>
